@inject NavigationManager NavManager

<style>
    /* FocusOnNavigate focuses the first heading after each route change. Keep
       the focus target for assistive technology without the browser's heavy
       default rectangle around the visible heading. */
    h1:focus, h2:focus, h3:focus, h4:focus, h5:focus, h6:focus {
        outline: 0 !important;
        box-shadow: none !important;
    }
</style>

<paa_frontend.Client.Components.DevDataBanner />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(Layout.EmptyLayout)">
                <style>
                                    @@keyframes fadeInUp {
                                        from {
                                            opacity: 0;
                                            transform: translateY(20px);
                                        }

                                        to {
                                            opacity: 1;
                                            transform: translateY(0);
                                        }
                                    }

                                    @@keyframes float {
                                        0%, 100% {
                                            transform: translateY(0);
                                        }

                                        50% {
                                            transform: translateY(-8px);
                                        }
                                    }

                                    .animate-fade-in-up {
                                        animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                                    }

                                    .animate-float {
                                        animation: float 4s ease-in-out infinite;
                                    }
                </style>

                <div class="min-h-screen bg-[#F8FAFC] flex flex-col items-center justify-center font-sans text-slate-800 relative w-full overflow-hidden p-6">
                    <div class="layout-spray-bg" aria-hidden="true"></div>

                    <div class="relative z-10 flex flex-col items-center text-center max-w-md bg-white/60 backdrop-blur-md p-10 rounded-3xl border border-white/50 shadow-xl scale-95 opacity-0 animate-fade-in-up">
                        <img src="/images/demo-logo.svg" alt="Logo" class="w-20 h-20 object-contain mb-6 drop-shadow animate-float" />
                        <h1 class="text-7xl font-black text-slate-900 tracking-tighter mb-2">404</h1>
                        <h2 class="text-xl font-bold text-slate-700 mb-3">Looks like you're lost.</h2>
                        <p class="text-sm font-medium text-slate-500 mb-8">
                            We couldn't find the page you were looking for. The address might be misspelled, or the page may have moved.
                        </p>

                        <a href="/" class="px-6 py-3 bg-slate-900 hover:bg-slate-800 hover:scale-105 active:scale-95 text-white rounded-xl text-sm font-bold transition-all shadow-md inline-flex items-center gap-2">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                            Back to Safety
                        </a>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
