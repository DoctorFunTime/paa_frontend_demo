@namespace paa_frontend.Client.Components
@inject paa_frontend.Client.Services.Auth.AuthService AuthService
@inject paa_frontend.Client.Services.NotificationService NotificationService
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Text.Json

@if (IsOpen)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <div class="modal-icon-wrap">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-blue-600">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </div>
                <div class="modal-title-area">
                    <h3 class="modal-title">Change Password</h3>
                    <p class="modal-subtitle">
                        @if (ForceChange)
                        {
                            <span>Please update your temporary password to secure your account.</span>
                        }
                        else
                        {
                            <span>Update your password to keep your account secure.</span>
                        }
                    </p>
                </div>
                @if (!ForceChange)
                {
                    <button type="button" class="close-x" @onclick="Close">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                }
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="modal-error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-top:2px; flex-shrink:0;">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            <EditForm Model="model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="modal-body">
                    <div class="form-group">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                            <label class="form-label" for="old-password" style="margin-bottom:0;">
                                @(ForceChange ? "Current (Temporary) Password" : "Current Password")
                            </label>
                            @if (ForceChange && !string.IsNullOrEmpty(DefaultOldPassword))
                            {
                                <span style="font-size:11px;font-weight:700;color:#2563eb;">Pre-filled from login</span>
                            }
                        </div>
                        <div class="input-wrap">
                            <input type="@(showOldPassword ? "text" : "password")"
                                   id="old-password"
                                   class="form-control"
                                   placeholder="Enter current password"
                                   @bind="model.OldPassword" />
                            <button type="button" class="eye-btn" @onclick="() => showOldPassword = !showOldPassword">
                                @if (showOldPassword)
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                }
                                else
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => model.OldPassword)" class="validation-error-msg" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="new-password">New Password</label>
                        <div class="input-wrap">
                            <input type="@(showNewPassword ? "text" : "password")"
                                   id="new-password"
                                   class="form-control"
                                   placeholder="Enter a new password"
                                   @bind="model.NewPassword" />
                            <button type="button" class="eye-btn" @onclick="() => showNewPassword = !showNewPassword">
                                @if (showNewPassword)
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                }
                                else
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => model.NewPassword)" class="validation-error-msg" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="confirm-password">Confirm New Password</label>
                        <div class="input-wrap">
                            <input type="@(showConfirmPassword ? "text" : "password")"
                                   id="confirm-password"
                                   class="form-control"
                                   placeholder="Verify new password"
                                   @bind="model.ConfirmPassword" />
                            <button type="button" class="eye-btn" @onclick="() => showConfirmPassword = !showConfirmPassword">
                                @if (showConfirmPassword)
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                }
                                else
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => model.ConfirmPassword)" class="validation-error-msg" />
                    </div>
                </div>

                <div class="modal-footer">
                    @if (!ForceChange)
                    {
                        <button type="button" class="btn-cancel" @onclick="Close" disabled="@isSubmitting">Cancel</button>
                    }
                    <button type="submit" class="btn-save" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="modal-spinner"></span>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <span>Update Password</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <style>
        .modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 1000;
            background: rgba(15, 23, 42, 0.45);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            animation: modalFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .modal-card {
            width: 100%;
            max-width: 440px;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(24px) saturate(180%);
            -webkit-backdrop-filter: blur(24px) saturate(180%);
            border-radius: 28px;
            border: 1px solid rgba(255, 255, 255, 0.45);
            border-top: 1px solid rgba(255, 255, 255, 0.85);
            border-left: 1px solid rgba(255, 255, 255, 0.60);
            box-shadow:
                0 0 0 1px rgba(255,255,255,0.15) inset,
                0 1px 0 rgba(255,255,255,0.6) inset,
                0 12px 40px rgba(0,0,0,0.15),
                0 32px 80px rgba(0,0,0,0.1);
            padding: 32px;
            animation: modalSlideUp 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
            position: relative;
        }

        .modal-header {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 24px;
        }

        .modal-icon-wrap {
            width: 44px;
            height: 44px;
            background: rgba(37, 99, 235, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .modal-title-area { flex: 1; min-width: 0; }

        .modal-title {
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.3px;
        }

        .modal-subtitle {
            font-size: 13px;
            color: #475569;
            font-weight: 500;
            margin-top: 4px;
            line-height: 1.4;
        }

        .close-x {
            background: none;
            border: none;
            cursor: pointer;
            color: #64748b;
            padding: 4px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s, color 0.15s;
        }
        .close-x:hover { background: rgba(0,0,0,0.05); color: #0f172a; }

        .modal-error {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 14px;
            padding: 12px 16px;
            font-size: 13px;
            color: #dc2626;
            font-weight: 600;
            margin-bottom: 24px;
            animation: modalShake 0.4s cubic-bezier(0.36,0.07,0.19,0.97) both;
        }

        .modal-body { display: flex; flex-direction: column; gap: 18px; margin-bottom: 28px; }

        .form-group { display: flex; flex-direction: column; gap: 6px; }

        .form-label {
            font-size: 11.5px;
            font-weight: 700;
            color: #334155;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .input-wrap { position: relative; }

        .form-control {
            width: 100%;
            padding: 11px 44px 11px 14px;
            font-size: 14px;
            font-weight: 600;
            color: #0f172a;
            background: rgba(255, 255, 255, 0.75);
            border: 1px solid rgba(203, 213, 225, 0.8);
            border-radius: 12px;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
            box-sizing: border-box;
        }
        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .eye-btn {
            position: absolute;
            right: 0; top: 0; bottom: 0;
            width: 44px;
            background: none;
            border: none;
            cursor: pointer;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0 12px 12px 0;
        }
        .eye-btn:hover { color: #0f172a; }

        .validation-error-msg {
            font-size: 11.5px;
            color: #dc2626;
            font-weight: 600;
            margin-top: 2px;
        }

        .modal-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
        }

        .btn-cancel {
            padding: 11px 20px;
            font-size: 14px;
            font-weight: 700;
            color: #475569;
            background: white;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            cursor: pointer;
            transition: background 0.15s, border-color 0.15s;
        }
        .btn-cancel:hover:not(:disabled) { background: #f8fafc; border-color: #94a3b8; }

        .btn-save {
            flex: 1;
            padding: 11px 20px;
            font-size: 14px;
            font-weight: 700;
            color: white;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
            transition: transform 0.1s, box-shadow 0.15s, background 0.15s;
        }
        .btn-save:hover:not(:disabled) {
            background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35);
        }
        .btn-save:active:not(:disabled) { transform: translateY(1px); }
        .btn-save:disabled, .btn-cancel:disabled { opacity: 0.6; cursor: not-allowed; }

        .modal-spinner {
            width: 16px; height: 16px;
            border: 2.2px solid rgba(255,255,255,0.25);
            border-top-color: white;
            border-radius: 50%;
            animation: modalSpin 0.65s linear infinite;
        }

        @@keyframes modalFadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @@keyframes modalSlideUp {
            from { opacity: 0; transform: scale(0.95) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
        @@keyframes modalSpin {
            to { transform: rotate(360deg); }
        }
        @@keyframes modalShake {
            0%, 100% { transform: translateX(0); }
            20%       { transform: translateX(-4px); }
            40%       { transform: translateX(4px); }
            60%       { transform: translateX(-2px); }
            80%       { transform: translateX(2px); }
        }
    </style>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool ForceChange { get; set; } = false;
    [Parameter] public string Username { get; set; } = string.Empty;
    [Parameter] public string DefaultOldPassword { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSuccess { get; set; }

    private ChangePasswordModel model = new();
    private bool showOldPassword;
    private bool showNewPassword;
    private bool showConfirmPassword;
    private bool isSubmitting;
    private string? errorMessage;
    private string resolvedUsername = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            errorMessage = null;
            model = new ChangePasswordModel();

            if (!string.IsNullOrEmpty(DefaultOldPassword))
                model.OldPassword = DefaultOldPassword;

            try
            {
                resolvedUsername = string.IsNullOrEmpty(Username)
                    ? await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "primeappDemo.authUsername") ?? string.Empty
                    : Username;
            }
            catch (Exception ex)
            {
                resolvedUsername = Username ?? string.Empty;
            }
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(resolvedUsername))
        {
            try
            {
                resolvedUsername = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", "primeappDemo.authUsername") ?? string.Empty;
            }
            catch { }
        }

        if (string.IsNullOrWhiteSpace(resolvedUsername))
        {
            errorMessage = "Username is missing. Please sign out and sign in again.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.OldPassword))
        {
            errorMessage = "Please enter your current temporary password.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.NewPassword))
        {
            errorMessage = "Please enter a new password.";
            return;
        }

        if (model.NewPassword.Length < 4)
        {
            errorMessage = "New password must be at least 4 characters long.";
            return;
        }

        if (model.NewPassword != model.ConfirmPassword)
        {
            errorMessage = "New password and confirmation do not match.";
            return;
        }

        if (model.OldPassword.Trim() == model.NewPassword.Trim())
        {
            errorMessage = "New password cannot be the same as the current password.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var cleanOld = model.OldPassword.Trim();
            var cleanNew = model.NewPassword.Trim();
            var cleanUser = resolvedUsername.Trim();

            var response = await AuthService.ChangePasswordAsync(cleanOld, cleanNew, cleanUser);
            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowSuccess("Password changed successfully!");
                await Close();
                await OnSuccess.InvokeAsync();
            }
            else
            {
                errorMessage = await ExtractErrorMessageAsync(response, "Failed to change password. Please check your credentials.");
                if (errorMessage.Contains("credential", StringComparison.OrdinalIgnoreCase) ||
                    errorMessage.Contains("password", StringComparison.OrdinalIgnoreCase))
                {
                    errorMessage += " Please verify that your Current (Temporary) Password is correct.";
                }
                NotificationService.ShowError(errorMessage);
            }
        }
        catch (Exception)
        {
            errorMessage = "An unexpected error occurred.";
            NotificationService.ShowError(errorMessage);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static async Task<string> ExtractErrorMessageAsync(HttpResponseMessage response, string fallbackMessage)
    {
        var raw = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(raw)) return fallbackMessage;

        try
        {
            using var document = JsonDocument.Parse(raw);
            var root = document.RootElement;
            foreach (var propertyName in new[] { "message", "error", "title", "detail" })
            {
                if (root.TryGetProperty(propertyName, out var property) && property.ValueKind == JsonValueKind.String)
                {
                    var value = property.GetString();
                    if (!string.IsNullOrWhiteSpace(value)) return value!;
                }
            }
        }
        catch (JsonException) { }

        return raw.Trim();
    }

    public class ChangePasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Current password is required")]
        public string OldPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "New password is required")]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your new password")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
