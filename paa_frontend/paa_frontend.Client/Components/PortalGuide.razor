<div class="portal-guide">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

<style>
    .portal-guide { max-width: 1100px; margin: 0 auto; padding: 32px 20px 64px; color: #0f172a; line-height: 1.75; overflow-wrap: anywhere; }
    .portal-guide .guide-hero { padding: 28px; border-radius: 24px; background: #0f172a; color: #fff; margin-bottom: 24px; }
    .portal-guide .guide-kicker { font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #a5b4fc; }
    .portal-guide h1 { font-size: clamp(26px, 4vw, 38px); line-height: 1.2; font-weight: 800; margin: 10px 0 16px; }
    .portal-guide .guide-hero p { color: #e2e8f0; max-width: 760px; }
    .portal-guide h2 { font-size: 23px; line-height: 1.35; font-weight: 800; margin: 0 0 16px; }
    .portal-guide h3 { font-size: 17px; font-weight: 750; margin: 24px 0 8px; }
    .portal-guide p { margin: 10px 0; color: #475569; }
    .portal-guide section, .portal-guide .guide-contents { padding: 28px; margin: 20px 0; border: 1px solid #e2e8f0; border-radius: 20px; background: #fff; scroll-margin-top: 96px; }
    .portal-guide a { color: #4338ca; text-decoration: underline; text-underline-offset: 3px; font-weight: 650; }
    .portal-guide a:focus-visible, .portal-guide summary:focus-visible { outline: 3px solid #6366f1; outline-offset: 4px; }
    .portal-guide .guide-hero a { color: #c7d2fe; }
    .portal-guide .guide-links { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 20px; }
    .portal-guide ol { list-style: decimal; padding-left: 24px; }
    .portal-guide ul { list-style: disc; padding-left: 24px; }
    .portal-guide li { padding-left: 4px; margin: 10px 0; color: #334155; }
    .portal-guide .guide-contents ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; }
    .portal-guide .guide-note { padding: 16px 20px; margin: 18px 0; background: #eef2ff; border-left: 4px solid #6366f1; border-radius: 0 12px 12px 0; color: #312e81; }
    .portal-guide dl { margin: 14px 0; }
    .portal-guide dt { font-weight: 750; margin-top: 16px; }
    .portal-guide dd { color: #475569; margin: 4px 0 12px; }
    .portal-guide details { border-top: 1px solid #e2e8f0; padding: 16px 0; }
    .portal-guide summary { cursor: pointer; font-weight: 750; list-style: disclosure-closed; margin-left: 18px; }
    .portal-guide details[open] summary { list-style: disclosure-open; }
    .portal-guide .school-rules-list li { padding: 16px 12px; margin: 0; border-bottom: 1px solid #e2e8f0; }
    .portal-guide .school-rules-list li:last-child { border-bottom: 0; }
    .portal-guide .school-rules-list li::marker { color: #047857; font-weight: 800; }
    @@media(max-width: 640px) {
        .portal-guide { padding: 20px 12px 40px; }
        .portal-guide section, .portal-guide .guide-contents, .portal-guide .guide-hero { padding: 20px; border-radius: 16px; }
        .portal-guide .guide-contents ol { grid-template-columns: 1fr; }
    }
</style>
