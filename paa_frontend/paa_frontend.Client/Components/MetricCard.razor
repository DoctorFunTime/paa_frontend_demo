<a href="@Href" class="block rounded-3xl border border-@Tone-100 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md sm:p-5">
    <div class="text-[0.62rem] font-black uppercase tracking-[0.16em] text-@Tone-500">@Label</div>
    <div class="mt-2 truncate text-xl font-black text-@Tone-700 sm:text-2xl">@Value</div>
    <div class="mt-1 truncate text-[0.68rem] font-semibold text-slate-400">@Hint</div>
</a>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Hint { get; set; } = string.Empty;
    [Parameter] public string Tone { get; set; } = "slate";
    [Parameter] public string Href { get; set; } = "#";
}
