@inject NavigationManager NavManager

<div class="min-h-screen flex flex-col items-center justify-center bg-slate-50 font-sans">
    <div class="flex flex-col items-center gap-3 text-center px-6">
        <div class="w-10 h-10 border-4 border-slate-900 border-t-transparent rounded-full animate-spin"></div>
        <p class="text-sm font-semibold text-slate-600 tracking-wide">Checking your session…</p>
    </div>
</div>

@code {
    private bool redirectStarted;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || redirectStarted) return;
        redirectStarted = true;
        NavManager.NavigateTo("/login", false, true);
    }
}
