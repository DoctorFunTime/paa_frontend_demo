@inherits LayoutComponentBase
@namespace paa_frontend.Client.Layout
@using paa_frontend.Shared.Models
@inject NavigationManager Nav
@inject paa_frontend.Client.Services.Auth.AuthService AuthService
@inject IJSRuntime JSRuntime

<style>
    /* The portal itself must never become wider than the viewport. Individual
       data tables may still scroll inside their own overflow-x-auto wrapper. */
    html, body { max-width: 100%; overflow-x: hidden; }
    .burser-shell { width: 100%; min-width: 0; max-width: 100%; overflow-x: hidden; }
    .burser-shell main { width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; }
    .burser-shell main > * { min-width: 0; max-width: 100%; }
    .burser-shell img, .burser-shell svg { max-width: 100%; }
    .burser-shell button, .burser-shell input, .burser-shell select, .burser-shell textarea { max-width: 100%; }
    @@media (max-width: 640px) {
        .burser-shell header { padding-left: .75rem; padding-right: .75rem; }
        .burser-shell main { padding: .75rem; }
        .burser-shell .overflow-x-auto { max-width: 100%; }
    }
</style>

<div class="burser-shell min-h-screen bg-[#F8FAFC] flex flex-col font-sans text-slate-800 relative">
    <div class="layout-spray-bg" aria-hidden="true"></div>

    <!-- ── Top Navigation ──────────────────────────────────────── -->
    <header class="bg-white/80 backdrop-blur-md sticky border-b border-slate-100 top-0 z-50 flex items-center justify-between px-6 xl:px-8 h-[72px]">
        
        <!-- Brand -->
        <div class="flex items-center gap-3 cursor-pointer" @onclick='() => Nav.NavigateTo("/burser")'>
            <img src="/images/demo-logo.svg" alt="PrimeApp Demo logo" class="w-10 h-10 object-contain drop-shadow-sm" />
            <div class="flex flex-col">
                <span class="font-bold text-slate-900 text-[length:1.1rem] tracking-tight leading-tight hidden sm:block">PrimeApp Demo</span>
                <span class="font-bold text-slate-900 text-base tracking-tight sm:hidden truncate">PrimeApp Demo</span>
                <span class="text-[length:0.65rem] font-semibold text-slate-400 uppercase tracking-wider hidden sm:block">Burser Portal</span>
            </div>
        </div>

        <!-- Primary workflow navigation. Setup and tools are grouped so the header stays usable on smaller screens. -->
        <nav class="hidden lg:flex items-center gap-1 bg-transparent p-1.5 rounded-full">
            <NavLink class="px-3 py-2 rounded-full text-[length:0.875rem] font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-50 transition-colors" activeClass="!bg-[#0F172A] !text-white shadow-md" href="/burser" Match="NavLinkMatch.All">
                Dashboard
            </NavLink>
            <NavLink class="px-3 py-2 rounded-full text-[length:0.875rem] font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-50 transition-colors" activeClass="!bg-[#0F172A] !text-white shadow-md" href="/burser/students" Match="NavLinkMatch.Prefix">
                Students & Accounts
            </NavLink>
            <NavLink class="px-3 py-2 rounded-full text-[length:0.875rem] font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-50 transition-colors" activeClass="!bg-[#0F172A] !text-white shadow-md" href="/burser/transaction/new" Match="NavLinkMatch.Prefix">
                New Transaction
            </NavLink>
            <NavLink class="px-3 py-2 rounded-full text-[length:0.875rem] font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-50 transition-colors" activeClass="!bg-[#0F172A] !text-white shadow-md" href="/burser/reports" Match="NavLinkMatch.Prefix">
                Reports
            </NavLink>
            <NavLink class="px-3 py-2 rounded-full text-[length:0.875rem] font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-50 transition-colors" activeClass="!bg-[#0F172A] !text-white shadow-md" href="/burser/help">Help</NavLink>
            <div class="relative">
                <button class="px-3 py-2 rounded-full text-[length:0.875rem] font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-50 transition-colors flex items-center gap-1" @onclick="ToggleMoreNav">
                    Setup & tools
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                </button>
                @if (isMoreNavOpen)
                {
                    <div class="absolute right-0 top-12 w-56 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl z-50">
                        <NavLink class="block rounded-xl px-4 py-3 text-sm font-bold text-slate-600 hover:bg-slate-50" href="/burser/fees" Match="NavLinkMatch.Prefix">Fee setup<span class="block mt-1 text-xs font-medium text-slate-400">Heads, structures and fee lines</span></NavLink>
                        <NavLink class="block rounded-xl px-4 py-3 text-sm font-bold text-slate-600 hover:bg-slate-50" href="/burser/exchange-rates" Match="NavLinkMatch.Prefix">Exchange rates<span class="block mt-1 text-xs font-medium text-slate-400">Currency conversion rules</span></NavLink>
                        <NavLink class="block rounded-xl px-4 py-3 text-sm font-bold text-slate-600 hover:bg-slate-50" href="/burser/student-pass/scanner" Match="NavLinkMatch.Prefix">Student pass scanner<span class="block mt-1 text-xs font-medium text-slate-400">Validate a pass at the gate</span></NavLink>
                    </div>
                }
            </div>
        </nav>

        <!-- Right Side: Profile & Actions -->
        <div class="flex items-center justify-end gap-3 sm:gap-4">
            <AuthorizeView Roles="SUPER">
                <a href="/super" class="hidden sm:inline-flex rounded-full border border-indigo-100 bg-indigo-50 px-3 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-100">Super portal</a>
            </AuthorizeView>
            
            <!-- Profile Dropdown Handle -->
            <button class="flex items-center gap-2.5 pl-1.5 pr-3 py-1.5 rounded-full border border-slate-200 bg-white hover:bg-slate-50 transition-colors shrink-0">
                <div class="w-7 h-7 rounded-full bg-gradient-to-br from-emerald-800 to-emerald-600 flex items-center justify-center text-white text-[length:0.6875rem] font-bold shadow-sm">
                    BS
                </div>
                <div class="hidden sm:block text-left mr-1">
                    <div class="text-[length:0.75rem] font-bold text-slate-800 leading-none">Burser</div>
                </div>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-slate-400">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </button>

            <!-- Change Password -->
            <button class="hidden md:flex w-10 h-10 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-500 hover:text-blue-600 hover:bg-blue-50 transition-colors shrink-0"
                    @onclick="OpenChangePasswordModal" title="Change Password">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
            </button>

            <!-- Logout -->
            <button class="hidden md:flex w-10 h-10 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-500 hover:text-rose-600 hover:bg-rose-50 transition-colors shrink-0" @onclick="Logout">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </button>

            <!-- Mobile Hamburger -->
            <button class="lg:hidden w-10 h-10 rounded-full bg-white border border-slate-200 flex items-center justify-center shrink-0 hover:bg-slate-50 text-slate-600" @onclick="ToggleMobileMenu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    @if (isMobileMenuOpen) {
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    } else {
                        <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
                    }
                </svg>
            </button>
        </div>
    </header>

    <!-- ── Mobile Menu Dropdown ─────────────────────────────── -->
    @if (isMobileMenuOpen)
    {
        <div class="fixed inset-0 z-40 bg-slate-900/20 backdrop-blur-sm lg:hidden mt-[72px]" @onclick="ToggleMobileMenu"></div>
        <nav class="fixed top-[72px] left-0 w-full bg-white border-b border-slate-100 p-4 flex flex-col gap-2 z-50 lg:hidden shadow-xl animate-fade-in-down">
            <NavLink class="px-5 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-50" activeClass="bg-slate-900 text-white" href="/burser" Match="NavLinkMatch.All" @onclick="ToggleMobileMenu">Dashboard</NavLink>
            <NavLink class="px-5 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-50" activeClass="bg-slate-900 text-white" href="/burser/students" Match="NavLinkMatch.Prefix" @onclick="ToggleMobileMenu">Students & Accounts</NavLink>
            <NavLink class="px-5 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-50" activeClass="bg-slate-900 text-white" href="/burser/transaction/new" Match="NavLinkMatch.Prefix" @onclick="ToggleMobileMenu">New Transaction</NavLink>
            <NavLink class="px-5 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-50" activeClass="bg-slate-900 text-white" href="/burser/reports" Match="NavLinkMatch.Prefix" @onclick="ToggleMobileMenu">Reports <span class="block text-xs font-medium opacity-60">Cashbook and statements</span></NavLink>
            <div class="px-5 pt-3 text-[0.65rem] font-black uppercase tracking-widest text-slate-400">Setup & tools</div>
            <NavLink class="px-5 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-50" activeClass="bg-slate-900 text-white" href="/burser/fees" Match="NavLinkMatch.Prefix" @onclick="ToggleMobileMenu">Fee Setup <span class="block text-xs font-medium opacity-60">Heads, structures and fee lines</span></NavLink>
            <NavLink class="px-5 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-50" activeClass="bg-slate-900 text-white" href="/burser/exchange-rates" Match="NavLinkMatch.Prefix" @onclick="ToggleMobileMenu">Exchange Rates <span class="block text-xs font-medium opacity-60">Currency conversion rules</span></NavLink>
            <NavLink class="px-5 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-50" activeClass="bg-slate-900 text-white" href="/burser/student-pass/scanner" Match="NavLinkMatch.Prefix" @onclick="ToggleMobileMenu">Student Pass Scanner</NavLink>
            
            <div class="h-px bg-slate-100 my-2 w-full"></div>
            <AuthorizeView Roles="SUPER">
                <NavLink class="px-5 py-3 rounded-xl text-sm font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100" activeClass="bg-indigo-600 text-white" href="/super" Match="NavLinkMatch.All" @onclick="ToggleMobileMenu">Super portal</NavLink>
            </AuthorizeView>
            <button class="w-full text-left px-5 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-50 flex items-center gap-3" @onclick="OpenChangePasswordModal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                Change Password
            </button>
            <button class="w-full text-left px-5 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-50 flex items-center gap-3" @onclick="Logout">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Sign Out
            </button>
        </nav>
    }

    <!-- ── Toast Notification ─────────────────────────────────────── -->
    <ToastNotification />

    <!-- ── Main Content ─────────────────────────────────────────── -->
    <main class="flex-1 w-full max-w-[1500px] min-w-0 mx-auto p-4 sm:p-6 md:p-8 animate-fade-in pb-16 relative z-10">
        <CascadingValue Name="PageTitle" Value="@pageTitle">
            @Body
        </CascadingValue>
    </main>

    <ChangePasswordModal @bind-IsOpen="showChangePasswordModal"
                         ForceChange="@isForceChange"
                         Username="@authUsername"
                         DefaultOldPassword="@defaultOldPassword"
                         OnSuccess="HandleForcePasswordChangeSuccess" />
</div>

@code {
    [CascadingParameter(Name = "PageTitle")] private string? pageTitle { get; set; }
    private bool isMobileMenuOpen = false;
    private bool isMoreNavOpen;
    private bool showChangePasswordModal;
    private string authUsername = string.Empty;
    private bool isForceChange;
    private string defaultOldPassword = string.Empty;
    private bool layoutDataLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || layoutDataLoaded) return;
        layoutDataLoaded = true;

        try
        {
            var isDefaultPwd = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", "primeappDemo.isDefaultPassword");
            if (isDefaultPwd == "true")
            {
                isForceChange = true;
                defaultOldPassword = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", "primeappDemo.defaultOldPassword") ?? "";
                authUsername = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", "primeappDemo.authUsername") ?? "";
                showChangePasswordModal = true;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            Console.WriteLine($"[LAYOUT] Could not load layout data");
        }
    }

    private async Task HandleForcePasswordChangeSuccess()
    {
        isForceChange = false;
        defaultOldPassword = string.Empty;
        showChangePasswordModal = false;
        await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "primeappDemo.isDefaultPassword");
        await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "primeappDemo.defaultOldPassword");
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenChangePasswordModal()
    {
        isMobileMenuOpen = false;
        authUsername = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "primeappDemo.authUsername") ?? "";
        isForceChange = false;
        defaultOldPassword = string.Empty;
        showChangePasswordModal = true;
        StateHasChanged();
    }

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;
    private void ToggleMoreNav() => isMoreNavOpen = !isMoreNavOpen;

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", true);
    }
}
