@inherits LayoutComponentBase
@namespace paa_frontend.Client.Layout
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject paa_frontend.Client.Services.Auth.AuthService AuthService

<div class="min-h-screen bg-slate-50 text-slate-800 font-sans">
    <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl">
        <div class="mx-auto flex h-[68px] max-w-[1500px] items-center justify-between gap-3 px-4 sm:h-[76px] sm:px-6 lg:px-8">
            <button class="flex min-w-0 items-center gap-2.5 text-left" @onclick='() => Nav.NavigateTo("/super")'>
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-slate-900 shadow-lg shadow-slate-900/10">
                    <img src="/images/demo-logo.svg" alt="PrimeApp Demo" class="h-8 w-8 object-contain" />
                </span>
                <span class="min-w-0">
                    <span class="block truncate text-sm font-black tracking-tight text-slate-900 sm:text-base">Executive Portal</span>
                    <span class="hidden text-[0.62rem] font-bold uppercase tracking-[0.18em] text-indigo-500 sm:block">Super user workspace</span>
                </span>
            </button>

            <div class="hidden items-center gap-2 lg:flex">
                <a href="/super" class="rounded-full bg-slate-900 px-4 py-2 text-xs font-bold text-white shadow-sm">Overview</a>
                <a href="/admin" class="rounded-full px-4 py-2 text-xs font-bold text-slate-500 hover:bg-slate-100">Admin workspace</a>
                <a href="/burser" class="rounded-full px-4 py-2 text-xs font-bold text-slate-500 hover:bg-slate-100">Finance workspace</a>
                <a href="/super/help" class="rounded-full px-4 py-2 text-xs font-bold text-slate-500 hover:bg-slate-100">Help</a>
                <button class="ml-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-600 hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600" @onclick="Logout">Sign out</button>
            </div>

            <button class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 lg:hidden" @onclick="ToggleMenu" aria-label="Open portal menu">
                @if (menuOpen)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" /></svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                }
            </button>
        </div>
    </header>

    @if (menuOpen)
    {
        <div class="fixed inset-0 z-40 bg-slate-950/20 lg:hidden" @onclick="ToggleMenu"></div>
        <nav class="fixed left-3 right-3 top-[78px] z-50 max-h-[calc(100vh-92px)] overflow-y-auto rounded-3xl border border-slate-200 bg-white p-3 shadow-2xl lg:hidden">
            <a href="/super" @onclick="CloseMenu" class="block rounded-2xl bg-slate-900 px-4 py-3 text-sm font-bold text-white">Overview</a>
            <div class="mt-3 grid grid-cols-2 gap-2">
                <a href="/admin" @onclick="CloseMenu" class="rounded-2xl bg-indigo-50 px-4 py-3 text-xs font-bold text-indigo-700">Admin dashboard</a>
                <a href="/burser" @onclick="CloseMenu" class="rounded-2xl bg-emerald-50 px-4 py-3 text-xs font-bold text-emerald-700">Finance dashboard</a>
            </div>
            <div class="mt-3 rounded-2xl border border-slate-100 bg-slate-50 p-2">
                <div class="px-3 py-2 text-[0.62rem] font-black uppercase tracking-[0.18em] text-slate-400">Administration</div>
                @foreach (var item in AdminLinks)
                {
                    <a href="@item.Href" @onclick="CloseMenu" class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-white">@item.Label</a>
                }
            </div>
            <div class="mt-3 rounded-2xl border border-slate-100 bg-slate-50 p-2">
                <div class="px-3 py-2 text-[0.62rem] font-black uppercase tracking-[0.18em] text-slate-400">Finance operations</div>
                @foreach (var item in FinanceLinks)
                {
                    <a href="@item.Href" @onclick="CloseMenu" class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-white">@item.Label</a>
                }
            </div>
            <button class="mt-3 w-full rounded-2xl px-3 py-3 text-left text-sm font-bold text-rose-600 hover:bg-rose-50" @onclick="Logout">Sign out</button>
        </nav>
    }

    <main class="mx-auto w-full max-w-[1500px] px-4 py-5 pb-10 sm:px-6 sm:py-7 lg:px-8">
        @Body
    </main>

    <nav class="fixed bottom-0 left-0 right-0 z-40 grid grid-cols-4 border-t border-slate-200 bg-white/95 px-2 py-2 shadow-[0_-8px_30px_rgba(15,23,42,0.08)] backdrop-blur lg:hidden">
        <a href="/super" class="flex flex-col items-center gap-1 rounded-xl py-1.5 text-[0.62rem] font-bold text-slate-700"><span class="text-base">⌂</span>Overview</a>
        <a href="/students" class="flex flex-col items-center gap-1 rounded-xl py-1.5 text-[0.62rem] font-bold text-indigo-600"><span class="text-base">♙</span>Students</a>
        <a href="/burser/students" class="flex flex-col items-center gap-1 rounded-xl py-1.5 text-[0.62rem] font-bold text-emerald-600"><span class="text-base">$</span>Accounts</a>
        <button class="flex flex-col items-center gap-1 rounded-xl py-1.5 text-[0.62rem] font-bold text-slate-500" @onclick="ToggleMenu"><span class="text-base">☰</span>More</button>
    </nav>
</div>

@code {
    private bool menuOpen;

    private readonly PortalLink[] AdminLinks =
    {
        new("/students", "Student directory"),
        new("/admin/attendance", "Attendance"),
        new("/admin/teachers", "Teachers"),
        new("/admin/bursers", "Bursers"),
        new("/admin/admins", "Administrators"),
        new("/admin/academics", "Academics"),
        new("/admin/grades/approval", "Marks approval"),
        new("/admin/grades/teacher-analytics", "Teacher analytics"),
        new("/admin/grades/settings", "Grade settings"),
        new("/admin/grades/reports", "Report management"),
        new("/admin/passes", "Student passes"),
        new("/student-pass/scanner", "Pass scanner")
    };

    private readonly PortalLink[] FinanceLinks =
    {
        new("/burser/students", "Students & accounts"),
        new("/burser/transaction/new", "New transaction"),
        new("/burser/reports", "Financial reports"),
        new("/burser/student-finance", "Student finance")
    };

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", true);
    }

    private sealed record PortalLink(string Href, string Label);
}
