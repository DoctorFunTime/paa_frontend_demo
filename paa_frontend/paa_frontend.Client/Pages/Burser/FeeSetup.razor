    }

    private async Task SaveStructureItemAsync()
    {
        if (selectedStructure?.Id is not long structureId)
        {
            NotificationService.ShowError("Select a fee structure first.");
            return;
        }

        isSavingItem = true;
        try
        {
            if (editingItemId.HasValue)
            {
                await FinanceService.UpdateFeeStructureItemAsync(editingItemId.Value, itemAmount, itemIsMandatory, itemPriority);
                structureItems = await LoadFeeStructureItemsSafeAsync(structureId);
                ResetItemEditor();
                NotificationService.ShowSuccess("Fee item updated.");
            }
            else
            {
                if (selectedFeeHeadId <= 0)
                {
                    NotificationService.ShowError("Choose a fee head for the structure item.");
                    isSavingItem = false;
                    return;
                }
                await FinanceService.AddFeeStructureItemAsync(structureId, selectedFeeHeadId, itemAmount, itemIsMandatory, itemPriority);
                structureItems = await LoadFeeStructureItemsSafeAsync(structureId);
                ResetItemEditor();
                NotificationService.ShowSuccess("Fee item added.");
            }
        }
        catch (Exception)
        {
            NotificationService.ShowError($"Could not save fee item");
        }
        finally
        {
            isSavingItem = false;
        }
    }

