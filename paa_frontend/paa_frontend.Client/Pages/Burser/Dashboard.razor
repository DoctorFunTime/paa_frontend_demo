@page "/burser"
@namespace paa_frontend.Client.Pages.Burser
@layout paa_frontend.Client.Layout.BurserPortalLayout
@using paa_frontend.Client.Services
@using paa_frontend.Client.Services.StudentsPortal
@using paa_frontend.Shared.Models
@inject FinanceServiceClient FinanceService
@inject StudentProfileServiceClient StudentService
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<style>
    @@keyframes bar-rise {
        from {
            transform: scaleY(0);
            transform-origin: bottom;
        }

        to {
            transform: scaleY(1);
        }
    }

    .bar-animate {
        animation: bar-rise 0.5s ease-out;
    }

    .dashboard-hero-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; width: 100%; }
    .burser-dashboard { min-width: 0; overflow-x: hidden; }
    .burser-dashboard * { min-width: 0; }
    @@media (max-width: 640px) {
        .dashboard-hero-actions > button { width: 100%; flex: none; }
        .dashboard-hero h1 { font-size: 1.75rem; line-height: 1.1; }
        .dashboard-metrics > div { min-width: 0; }
        .dashboard-metrics > div > div:last-child { overflow-wrap: anywhere; }
    }
</style>

<div class="burser-dashboard">
<div class="dashboard-hero mb-6 animate-fade-in flex min-w-0 flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-1">Finance Dashboard</h1>
        <p class="text-sm font-medium text-slate-500">@DateTime.Now.ToString("MMMM yyyy") · Burser overview</p>
    </div>
    <div class="dashboard-hero-actions md:w-auto">
        <button class="flex-1 md:flex-none text-center px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-bold shadow-sm hover:bg-slate-50 transition-colors" @onclick="GoToReports">
            Financial Reports
        </button>
        <button class="flex-1 md:flex-none text-center px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-bold shadow-sm hover:bg-slate-50 transition-colors" @onclick="GoToAddStudent">
            + Add Student
        </button>
        <button class="w-full md:w-auto text-center px-4 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-bold shadow-sm hover:bg-slate-800 transition-colors" @onclick="GoToNewTransaction">
            + New Transaction
        </button>
    </div>
</div>

@if (pageWarnings.Any())
{
    <div class="mb-5 bg-amber-50 border border-amber-200 rounded-2xl p-4 text-amber-800 text-sm font-medium">
        @string.Join(" ", pageWarnings)
    </div>
}

@if (isLoading)
{
    <div class="bg-white/70 border border-slate-200 rounded-3xl p-16 text-center text-slate-500">
        <svg class="animate-spin h-6 w-6 mx-auto mb-3 text-slate-400" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
        Loading finance dashboard...
    </div>
}
else if (!string.IsNullOrEmpty(loadError))
{
    <div class="bg-rose-50 border border-rose-200 rounded-2xl p-5 text-rose-700 font-medium">@loadError</div>
}
else
{
    <!-- ROW 1: Key Stats Strip -->
    <div class="dashboard-metrics grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 animate-fade-in-up">
        <div class="bg-white/70 backdrop-blur-sm border border-emerald-100 rounded-2xl p-3 sm:p-4 shadow-sm">
            <div class="text-[length:0.6rem] font-bold text-slate-400 uppercase tracking-widest mb-1">Fees Collected (Month)</div>
            <div class="text-lg sm:text-2xl font-black text-emerald-600">@monthlyCollected.ToString("C")</div>
        </div>
        <div class="bg-white/70 backdrop-blur-sm border border-rose-100 rounded-2xl p-3 sm:p-4 shadow-sm">
            <div class="text-[length:0.6rem] font-bold text-slate-400 uppercase tracking-widest mb-1">Outstanding (Month)</div>
            <div class="text-lg sm:text-2xl font-black text-rose-600">@monthlyOutstanding.ToString("C")</div>
        </div>
        <div class="bg-white/70 backdrop-blur-sm border border-blue-100 rounded-2xl p-3 sm:p-4 shadow-sm">
            <div class="text-[length:0.6rem] font-bold text-slate-400 uppercase tracking-widest mb-1">Prepayments (Month)</div>
            <div class="text-lg sm:text-2xl font-black text-blue-600">@monthlyPrepayments.ToString("C")</div>
        </div>
        <div class="bg-white/70 backdrop-blur-sm border border-amber-100 rounded-2xl p-3 sm:p-4 shadow-sm">
            <div class="text-[length:0.6rem] font-bold text-slate-400 uppercase tracking-widest mb-1">Non-Cash (Month)</div>
            <div class="text-lg sm:text-2xl font-black text-amber-600">@monthlyNonCash.ToString("C")</div>
        </div>
    </div>

    <!-- ROW 2: Collection Rate Ring + Account Health Bars + YTD Totals -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-6 animate-fade-in-up delay-75">

        <!-- Collection Rate Donut -->
        <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-4 sm:p-6 shadow-sm flex flex-col items-center justify-center">
            <div class="text-sm font-extrabold text-slate-700 mb-4 w-full">Collection Rate</div>
            <div class="relative w-32 h-32 sm:w-44 sm:h-44">
                <svg viewBox="0 0 100 100" class="w-full h-full -rotate-90">
                    <circle cx="50" cy="50" r="40" fill="none" stroke="#f1f5f9" stroke-width="12" />
                    <circle cx="50" cy="50" r="40" fill="none"
                            stroke="@DonutStrokeColor"
                            stroke-width="12"
                            stroke-dasharray="251"
                            stroke-dashoffset="@DonutDashOffset"
                            stroke-linecap="round" />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <div class="text-2xl sm:text-3xl font-black text-slate-900">@collectionRate.ToString("F0")%</div>
                    <div class="text-xs font-bold text-slate-400">collected</div>
                </div>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-2 w-full text-center text-xs font-bold">
                <div class="rounded-xl bg-emerald-50 p-2">
                    <div class="text-slate-400 mb-0.5">Charged</div>
                    <div class="text-slate-900">@totalCharged.ToString("C")</div>
                </div>
                <div class="rounded-xl bg-blue-50 p-2">
                    <div class="text-slate-400 mb-0.5">Collected</div>
                    <div class="text-emerald-700">@totalCollected.ToString("C")</div>
                </div>
            </div>
        </div>

        <!-- Account Health Horizontal Bar Chart -->
        <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-4 sm:p-6 shadow-sm">
            <div class="text-sm font-extrabold text-slate-700 mb-1">Account Health</div>
            <div class="text-xs font-medium text-slate-400 mb-5">@totalAccounts total student accounts</div>
            <div class="space-y-4">
                <div>
                    <div class="flex justify-between text-xs font-bold mb-1.5">
                        <span class="text-rose-600">In Arrears</span>
                        <span class="text-slate-700">@debitAccounts students</span>
                    </div>
                    <div class="h-3 rounded-full bg-slate-100 overflow-hidden">
                        <div class="h-full bg-rose-500 rounded-full transition-all" style="@DebitBarStyle"></div>
                    </div>
                </div>
                <div>
                    <div class="flex justify-between text-xs font-bold mb-1.5">
                        <span class="text-blue-600">Overpaid / Credit</span>
                        <span class="text-slate-700">@creditAccounts students</span>
                    </div>
                    <div class="h-3 rounded-full bg-slate-100 overflow-hidden">
                        <div class="h-full bg-blue-500 rounded-full transition-all" style="@CreditBarStyle"></div>
                    </div>
                </div>
                <div>
                    <div class="flex justify-between text-xs font-bold mb-1.5">
                        <span class="text-emerald-600">Fully Settled</span>
                        <span class="text-slate-700">@clearedAccounts students</span>
                    </div>
                    <div class="h-3 rounded-full bg-slate-100 overflow-hidden">
                        <div class="h-full bg-emerald-500 rounded-full transition-all" style="@ClearedBarStyle"></div>
                    </div>
                </div>
            </div>
            <button class="mt-5 w-full py-2 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold hover:bg-slate-100 transition-colors" @onclick="GoToStudents">
                Open All Accounts →
            </button>
        </div>

        <!-- YTD Totals -->
        <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-4 sm:p-6 shadow-sm">
            <div class="text-sm font-extrabold text-slate-700 mb-5">Year-to-Date Summary</div>
            <div class="space-y-3">
                <div class="flex items-center justify-between py-3 border-b border-slate-100">
                    <div>
                        <div class="text-xs font-bold text-slate-500">YTD Fees Received</div>
                        <div class="text-base sm:text-xl font-black text-emerald-600 mt-0.5">@cashFeeIncome.ToString("C")</div>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
                    </div>
                </div>
                <div class="flex items-center justify-between py-3 border-b border-slate-100">
                    <div>
                        <div class="text-xs font-bold text-slate-500">YTD Non-Cash Received</div>
                        <div class="text-base sm:text-xl font-black text-blue-600 mt-0.5">@nonCashFeeIncome.ToString("C")</div>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                    </div>
                </div>
                <div class="flex items-center justify-between py-3 border-b border-slate-100">
                    <div>
                        <div class="text-xs font-bold text-slate-500">YTD Expenses</div>
                        <div class="text-base sm:text-xl font-black text-slate-800 mt-0.5">@expenses.ToString("C")</div>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2.5"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6" /><polyline points="17 18 23 18 23 12" /></svg>
                    </div>
                </div>
                <div class="flex items-center justify-between py-3">
                    <div>
                        <div class="text-xs font-bold text-slate-500">Net Position</div>
                        <div class="text-base sm:text-xl font-black mt-0.5 @NetPositionClass">@netTotal.ToString("C")</div>
                    </div>
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center @NetPositionBgClass">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="@NetPositionStroke" stroke-width="2.5"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ROW 3: Income vs Expenses Bar Chart + Cash vs Non-Cash Donut -->
    <div class="grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] gap-5 mb-6 animate-fade-in-up delay-100">

        <!-- Income vs Expenses Bar Chart (bar per month, no SVG text attributes) -->
        <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-4 sm:p-6 shadow-sm">
            <div class="flex items-center justify-between mb-1">
                <div class="text-sm font-extrabold text-slate-700">Income vs Expenses</div>
                <div class="flex gap-4 text-xs font-bold">
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>Income</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-rose-400 inline-block"></span>Expenses</span>
                </div>
            </div>
            <div class="text-xs font-medium text-slate-400 mb-4">Monthly view · current year</div>
            <!-- Pure HTML/CSS bar chart — no SVG text attributes needed -->
            <div class="flex items-end gap-1 h-32 overflow-x-auto">
                @foreach (var bar in chartBars)
                {
                    <div class="flex-1 flex flex-col items-center gap-0.5 min-w-0">
                        <div class="w-full flex items-end gap-px" style="height:112px">
                            <div class="flex-1 rounded-t-sm bg-emerald-400 transition-all" style="@bar.IncomeHeightStyle" title="@bar.Month Income: @bar.Income.ToString("C")"></div>
                            <div class="flex-1 rounded-t-sm bg-rose-300 transition-all" style="@bar.ExpenseHeightStyle" title="@bar.Month Expenses: @bar.Expense.ToString("C")"></div>
                        </div>
                        <div class="text-[length:0.55rem] font-bold text-slate-400 truncate w-full text-center">@bar.Month</div>
                    </div>
                }
            </div>
            <div class="mt-3 grid grid-cols-2 gap-3 text-xs font-bold">
                <div class="rounded-xl bg-emerald-50 border border-emerald-100 p-2.5">
                    <div class="text-slate-400 mb-0.5">Total Income</div>
                    <div class="text-emerald-700">@((cashFeeIncome + otherIncome).ToString("C"))</div>
                </div>
                <div class="rounded-xl bg-rose-50 border border-rose-100 p-2.5">
                    <div class="text-slate-400 mb-0.5">Total Expenses</div>
                    <div class="text-rose-700">@expenses.ToString("C")</div>
                </div>
            </div>
        </div>

        <!-- Cash vs Non-Cash Donut -->
        <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-6 shadow-sm">
            <div class="text-sm font-extrabold text-slate-700 mb-1">Cash vs Non-Cash</div>
            <div class="text-xs font-medium text-slate-400 mb-4">To-date income breakdown</div>
            <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 mb-6">
                <div class="relative shrink-0 w-28 h-28">
                    <svg viewBox="0 0 100 100" class="w-full h-full -rotate-90">
                        <circle cx="50" cy="50" r="35" fill="none" stroke="#f1f5f9" stroke-width="14" />
                        <circle cx="50" cy="50" r="35" fill="none" stroke="#10b981" stroke-width="14"
                                stroke-dasharray="@CashArcValue"
                                stroke-dashoffset="0" />
                        <circle cx="50" cy="50" r="35" fill="none" stroke="#3b82f6" stroke-width="14"
                                stroke-dasharray="@NonCashArcValue"
                                stroke-dashoffset="@NonCashOffset" />
                    </svg>
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="text-center">
                            <div class="text-lg font-black text-slate-700">@cashPct.ToString("F0")%</div>
                            <div class="text-[length:0.55rem] font-bold text-slate-400">cash</div>
                        </div>
                    </div>
                </div>
                <div class="space-y-2 w-full sm:flex-1">
                    <div class="flex items-center justify-between sm:justify-start sm:gap-4 py-1.5 border-b sm:border-b-0 border-slate-100">
                        <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span><span class="text-xs font-bold text-slate-600">Cash Fees</span></div>
                        <div class="text-sm font-black text-emerald-600 sm:text-lg">@cashFeeIncome.ToString("C")</div>
                    </div>
                    <div class="flex items-center justify-between sm:justify-start sm:gap-4 py-1.5 border-b sm:border-b-0 border-slate-100">
                        <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-blue-500 shrink-0"></span><span class="text-xs font-bold text-slate-600">Non-Cash</span></div>
                        <div class="text-sm font-black text-blue-600 sm:text-lg">@nonCashFeeIncome.ToString("C")</div>
                    </div>
                    <div class="flex items-center justify-between sm:justify-start sm:gap-4 py-1.5">
                        <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-amber-400 shrink-0"></span><span class="text-xs font-bold text-slate-600">Other Income</span></div>
                        <div class="text-sm font-black text-amber-600 sm:text-lg">@otherIncome.ToString("C")</div>
                    </div>
                </div>
            </div>
            <div class="rounded-2xl bg-slate-50 border border-slate-200 p-4">
                <div class="text-xs font-bold text-slate-400 mb-1 uppercase tracking-widest">Non-Cash This Month</div>
                <div class="text-2xl font-black text-blue-600">@monthlyNonCash.ToString("C")</div>
            </div>
        </div>
    </div>

    <!-- ROW 4: Top 5 Owing + Finance Setup -->
    <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_0.9fr] gap-5 mb-6 animate-fade-in-up delay-150">

        <!-- Top 5 Owing Students -->
        <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-4 sm:p-6 shadow-sm">
            <div class="flex items-center justify-between mb-5">
                <div>
                    <div class="text-sm font-extrabold text-slate-700">Top 5 Students Owing</div>
                    <div class="text-xs font-medium text-slate-400 mt-0.5">Highest outstanding balances</div>
                </div>
                <button class="px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-600 text-xs font-bold hover:bg-slate-100 transition-colors" @onclick="GoToStudents">
                    View All →
                </button>
            </div>
            @if (!topOwingStudents.Any())
            {
                <div class="text-center py-8 text-slate-400 text-sm font-medium">No arrears found — accounts look healthy!</div>
            }
            else
            {
                var maxOwed = topOwingStudents.First().Balance;
                <div class="space-y-3">
                    @{
                        int rank = 1;
                    }
                    @foreach (var student in topOwingStudents)
                    {
                        var pct = maxOwed > 0 ? ((double)student.Balance / (double)maxOwed * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture) : "0";
                        var sid = student.StudentId;
                        <div class="group cursor-pointer" @onclick="() => NavigateToTransaction(sid)">
                            <div class="flex items-center justify-between mb-1 gap-2">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="text-xs font-black text-slate-400 w-4 shrink-0">#@rank</span>
                                    <span class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-rose-600 transition-colors truncate">@student.StudentName</span>
                                    <span class="text-[0.65rem] font-bold text-slate-400 shrink-0 hidden sm:inline">@student.Classroom</span>
                                </div>
                                <span class="text-xs sm:text-sm font-black text-rose-600 shrink-0">@student.Balance.ToString("C")</span>
                            </div>
                            <div class="h-2 rounded-full bg-slate-100 overflow-hidden">
                                <div class="h-full rounded-full bg-rose-400 transition-all" style="width:@(pct)%"></div>
                            </div>
                        </div>
                        rank++;
                    }
                </div>
            }
        </div>

        <!-- Finance Setup + Monthly Invoices -->
        <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-4 sm:p-6 shadow-sm">
            <div class="text-sm font-extrabold text-slate-700 mb-5">Finance Setup</div>

            <div class="grid grid-cols-3 gap-2 sm:gap-3 mb-5">
                <div class="rounded-2xl bg-slate-50 border border-slate-200 p-3 text-center">
                    <div class="text-xl font-black text-slate-900">@studentsCount</div>
                    <div class="text-[length:0.6rem] font-bold text-slate-400 uppercase mt-1">Students</div>
                </div>
                <div class="rounded-2xl bg-slate-50 border border-slate-200 p-3 text-center">
                    <div class="text-xl font-black text-slate-900">@feeStructureCount</div>
                    <div class="text-[length:0.6rem] font-bold text-slate-400 uppercase mt-1">Fee Structures</div>
                </div>
                <div class="rounded-2xl bg-slate-50 border border-slate-200 p-3 text-center">
                    <div class="text-xl font-black text-slate-900">@exchangeRateCount</div>
                    <div class="text-[length:0.6rem] font-bold text-slate-400 uppercase mt-1">Exch. Rates</div>
                </div>
            </div>

            <div class="space-y-2">
                <button class="w-full px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition-all shadow-sm" @onclick="GoToFees">
                    Manage Fee Structures
                </button>
                <button class="w-full px-4 py-2.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 rounded-xl text-xs font-bold transition-all shadow-sm" @onclick="GoToExchangeRates">
                    Manage Exchange Rates
                </button>
            </div>
        </div>
    </div>
}
</div>

@code {
    // ── Navigation helpers (no lambdas with $ strings in markup) ──────────────
    private void GoToReports() => Nav.NavigateTo("/burser/reports");
    private void GoToNewTransaction() => Nav.NavigateTo("/burser/transaction/new");
    private void GoToAddStudent() => Nav.NavigateTo("/students/add?returnPortal=burser");
    private void GoToStudents() => Nav.NavigateTo("/burser/students");
    private void GoToFees() => Nav.NavigateTo("/burser/fees");
    private void GoToExchangeRates() => Nav.NavigateTo("/burser/exchange-rates");
    private void NavigateToTransaction(int id) => Nav.NavigateTo("/burser/transaction/" + id);

    // ── Computed SVG / style properties ──────────────────────────────────────
    private string DonutStrokeColor =>
        collectionRate >= 80 ? "#059669" : collectionRate >= 50 ? "#d97706" : "#e11d48";

    private string DonutDashOffset =>
        (251 - 251 * (double)collectionRate / 100)
            .ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private static string BarStyle(double pct) =>
        "width:" + pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private string DebitBarStyle =>
        BarStyle((double)debitAccounts / Math.Max(1, debitAccounts + creditAccounts + clearedAccounts) * 100);
    private string CreditBarStyle =>
        BarStyle((double)creditAccounts / Math.Max(1, debitAccounts + creditAccounts + clearedAccounts) * 100);
    private string ClearedBarStyle =>
        BarStyle((double)clearedAccounts / Math.Max(1, debitAccounts + creditAccounts + clearedAccounts) * 100);

    private string NetPositionClass => netTotal >= 0 ? "text-emerald-600" : "text-rose-600";
    private string NetPositionBgClass => netTotal >= 0 ? "bg-emerald-50" : "bg-rose-50";
    private string NetPositionStroke => netTotal >= 0 ? "#059669" : "#e11d48";

    // Donut arcs for cash/non-cash pie
    private double cashPct => totalIn > 0 ? (double)cashFeeIncome / totalIn * 100 : 0;
    private double nonCashPct => totalIn > 0 ? (double)nonCashFeeIncome / totalIn * 100 : 0;
    private double totalIn => (double)(cashFeeIncome + nonCashFeeIncome);
    private static readonly double Circumf = 2 * Math.PI * 35; // r=35

    private string CashArcValue =>
        (Circumf * cashPct / 100).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
        + " " +
        (Circumf - Circumf * cashPct / 100).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    private string NonCashArcValue =>
        (Circumf * nonCashPct / 100).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
        + " " +
        (Circumf - Circumf * nonCashPct / 100).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    private string NonCashOffset =>
        (-(Circumf * cashPct / 100)).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    // ── Bar chart data ────────────────────────────────────────────────────────
    private sealed class ChartBar
    {
        public string Month { get; init; } = "";
        public decimal Income { get; init; }
        public decimal Expense { get; init; }
        public string IncomeHeightStyle { get; init; } = "";
        public string ExpenseHeightStyle { get; init; } = "";
    }

    private List<ChartBar> chartBars = new();

    private void BuildChartBars()
    {
        var monthNames = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
        var currentMonth = DateTime.Today.Month;
        var incomeArr = new decimal[currentMonth];
        var expenseArr = new decimal[currentMonth];

        for (int mi = 0; mi < currentMonth; mi++)
        {
            incomeArr[mi] = mi == currentMonth - 1
                ? monthlyCollected
                : (cashFeeIncome > 0 && currentMonth > 1 ? (cashFeeIncome - monthlyCollected) / (currentMonth - 1) : 0);
            expenseArr[mi] = expenses > 0 ? expenses / currentMonth : 0;
        }

        var maxVal = Math.Max(incomeArr.Max(), expenseArr.Max());
        if (maxVal == 0) maxVal = 1;
        const double maxPx = 100.0;

        chartBars = Enumerable.Range(0, currentMonth).Select(i =>
        {
            var ih = (maxPx * (double)incomeArr[i] / (double)maxVal).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
            var eh = (maxPx * (double)expenseArr[i] / (double)maxVal).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
            return new ChartBar
            {
                Month = monthNames[i],
                Income = incomeArr[i],
                Expense = expenseArr[i],
                IncomeHeightStyle = "height:" + ih + "px",
                ExpenseHeightStyle = "height:" + eh + "px"
            };
        }).ToList();
    }

    // ── State ─────────────────────────────────────────────────────────────────
    private bool isLoading = true;
    private string loadError = string.Empty;
    private List<string> pageWarnings = new();

    private sealed class TopOwingRow
    {
        public int StudentId { get; init; }
        public string StudentName { get; init; } = string.Empty;
        public string Classroom { get; init; } = string.Empty;
        public decimal Balance { get; init; }
    }

    private List<AccountSummary> accounts = new();
    private List<TopOwingRow> topOwingStudents = new();

    private decimal cashFeeIncome;
    private decimal nonCashFeeIncome;
    private decimal otherIncome;
    private decimal expenses;
    private decimal netTotal;
    private decimal totalOutstanding;
    private decimal totalCharged;
    private decimal totalCollected;
    private decimal monthlyCollected;
    private decimal monthlyOutstanding;
    private decimal monthlyPrepayments;
    private decimal monthlyNonCash;
    private int debitAccounts;
    private int creditAccounts;
    private int clearedAccounts;
    private int totalAccounts;
    private decimal collectionRate;
    private int studentsCount;
    private int feeStructureCount;
    private int exchangeRateCount;

    private bool dataLoadAttempted;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || dataLoadAttempted) return;
        dataLoadAttempted = true;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = string.Empty;
        pageWarnings = new();

        try
        {
            var students = await LoadStudentsSafeAsync();
            studentsCount = students.Count;
            accounts = await LoadAccountsAsync(students);
            feeStructureCount = await LoadFeeStructureCountSafeAsync();
            exchangeRateCount = await LoadExchangeRateCountSafeAsync();
            await LoadCashflowSafeAsync();

            totalOutstanding = accounts.Where(a => a.Balance > 0).Sum(a => a.Balance);
            debitAccounts = accounts.Count(a => a.BalanceType == "DEBIT");
            creditAccounts = accounts.Count(a => a.BalanceType == "CREDIT");
            clearedAccounts = accounts.Count(a => a.BalanceType == "ZERO");
            totalAccounts = accounts.Count;

            totalCollected = accounts.Sum(a => a.TotalPaid);
            totalCharged = accounts.Sum(a => a.TotalCharged);
            collectionRate = totalCharged > 0 ? (totalCollected / totalCharged) * 100 : 0;

            monthlyOutstanding = accounts.Where(a => a.Balance > 0).Sum(a => a.Balance);
            monthlyPrepayments = accounts.Where(a => a.Balance < 0).Sum(a => Math.Abs(a.Balance));

            topOwingStudents = accounts
                .Where(a => a.Balance > 0)
                .OrderByDescending(a => a.Balance)
                .Take(5)
                .Select(a =>
                {
                    var s = students.FirstOrDefault(x => x.Id == (int)a.StudentId);
                    return new TopOwingRow
                    {
                        StudentId = (int)a.StudentId,
                        StudentName = s is not null ? (s.FirstName + " " + s.LastName).Trim() : "Student " + a.StudentId,
                        Classroom = s?.Classroom ?? (s?.Form.HasValue == true ? "Form " + s.Form : "—"),
                        Balance = a.Balance
                    };
                })
                .ToList();

            BuildChartBars();
        }
        catch (Exception ex)
        {
            loadError = "Could not load finance dashboard. " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<List<StudentProfileModel.Student>> LoadStudentsSafeAsync()
    {
        try { return await StudentService.GetStudentsAsync() ?? new(); }
        catch (Exception ex) { pageWarnings.Add("Students could not be loaded fully: " + ex.Message); return new(); }
    }

    private async Task<List<AccountSummary>> LoadAccountsAsync(List<StudentProfileModel.Student> students)
    {
        try
        {
            return await FinanceService.GetAllAccountSummariesAsync() ?? new();
        }
        catch (Exception ex)
        {
            pageWarnings.Add("Account summaries fell back to per-student loading: " + ex.Message);
            var tasks = students.Select(async s =>
            {
                try { return await FinanceService.GetAccountSummaryAsync(s.Id); }
                catch { return null; }
            });
            return (await Task.WhenAll(tasks)).Where(a => a is not null).Cast<AccountSummary>().ToList();
        }
    }

    private async Task LoadCashflowSafeAsync()
    {
        try
        {
            // YTD totals — no date filter
            var summary = await FinanceService.GetCashflowSummaryAsync();
            cashFeeIncome = summary?.CashFeeIncome ?? 0;
            nonCashFeeIncome = summary?.NonCashFeeIncome ?? 0;
            otherIncome = summary?.OtherIncome ?? 0;
            expenses = summary?.TotalMoneyOut ?? 0;
            netTotal = summary?.NetTotal ?? 0;

            // Current-month stats — scoped to 1st of month → today
            var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            var monthEnd = DateTime.Today;
            var monthlySummary = await FinanceService.GetCashflowSummaryAsync(monthStart, monthEnd);
            monthlyCollected = monthlySummary?.CashFeeIncome ?? 0;
            monthlyNonCash = monthlySummary?.NonCashFeeIncome ?? 0;
        }
        catch (Exception ex)
        {
            cashFeeIncome = nonCashFeeIncome = otherIncome = expenses = netTotal = 0;
            monthlyCollected = monthlyNonCash = 0;
            pageWarnings.Add("Cashflow summary is unavailable right now: " + ex.Message);
        }
    }

    private async Task<int> LoadFeeStructureCountSafeAsync()
    {
        try { return (await FinanceService.GetFeeStructuresAsync() ?? new()).Count; }
        catch (Exception ex) { pageWarnings.Add("Fee structures could not be loaded: " + ex.Message); return 0; }
    }

    private async Task<int> LoadExchangeRateCountSafeAsync()
    {
        try { return (await FinanceService.GetExchangeRatesAsync() ?? new()).Count; }
        catch (Exception ex) { pageWarnings.Add("Exchange rates could not be loaded: " + ex.Message); return 0; }
    }

}
