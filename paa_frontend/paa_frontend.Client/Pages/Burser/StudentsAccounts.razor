@page "/burser/students"
@namespace paa_frontend.Client.Pages.Burser
@layout paa_frontend.Client.Layout.BurserPortalLayout
@using paa_frontend.Client.Services
@using paa_frontend.Client.Services.StudentsPortal
@using paa_frontend.Shared.Models
@inject StudentProfileServiceClient StudentService
@inject FinanceServiceClient FinanceService
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<style>
    .print-block {
        display: none !important;
    }
    @@media print {
        /* Hide all layout decoration, header, background, etc. */
        header, .fixed, .no-print, img:not(.print-logo) {
            display: none !important;
        }

        /* Reset margins, paddings, and heights on all wrapper elements to collapse them completely */
        .min-h-screen, main, .max-w-\[1500px\] {
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
            background: transparent !important;
            display: block !important;
            width: 100% !important;
            height: auto !important;
            min-height: 0 !important;
        }

        /* Hide all sibling elements of the path to the print area */
        .min-h-screen > *:not(main),
        main > *:not(.printable-accounts-area) {
            display: none !important;
        }

        .print-block {
            display: flex !important;
        }

        /* Format the print-area element to hug the walls */
        .printable-accounts-area {
            display: block !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 2mm 3mm !important; /* narrow margins */
            box-shadow: none !important;
            border: none !important;
            background: white !important;
            box-sizing: border-box !important;
        }

        /* Reduce font sizes and narrow layout spacing */
        .printable-accounts-area, .printable-accounts-area * {
            font-size: 11px !important;
        }

        .printable-accounts-area table th, .printable-accounts-area table td {
            padding: 6px 8px !important;
            font-size: 10px !important;
        }

        .printable-accounts-area table th.no-print,
        .printable-accounts-area table td.no-print {
            display: none !important;
        }

        body, html {
            background: white !important;
            margin: 0 !important;
            padding: 0 !important;
            height: 100% !important;
            overflow: hidden !important;
        }

        @@page {
            size: A4 landscape; /* Tables print better in landscape */
            margin: 2mm !important;
        }
    }
</style>

<div class="burser-accounts-page min-w-0 overflow-x-hidden">
<div class="mb-8 animate-fade-in flex min-w-0 flex-col md:flex-row md:items-end justify-between gap-4 no-print">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-2">Students & Accounts</h1>
        <p class="text-sm font-medium text-slate-500">Review live balances, identify arrears, and jump straight into payment processing.</p>
    </div>
    <div class="flex gap-2 shrink-0">
        <button class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-sm font-bold transition-all shadow-md flex items-center gap-2" @onclick="PrintAccountsAsync">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
            Print Accounts
        </button>
        <button class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-bold transition-all shadow-md flex items-center gap-2" @onclick='() => Nav.NavigateTo("/burser/transaction/new")'>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Transactions
        </button>
    </div>
</div>

<div class="flex flex-col xl:flex-row xl:items-center gap-4 mb-8 animate-fade-in-up no-print">
    <div class="relative flex-1 max-w-sm">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg></span>
        <input class="w-full py-3.5 pl-11 pr-4 bg-white/70 border border-slate-200 rounded-xl text-sm font-bold shadow-sm focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 transition-all placeholder:text-slate-400" type="text" placeholder="Search by name, national ID, or student ID..." value="@searchTerm" @oninput="OnSearch" />
    </div>

    <div class="flex items-center gap-2 overflow-x-auto pb-2 xl:pb-0 hide-scrollbar">
        <div class="flex bg-white/60 p-1.5 border border-slate-200 rounded-xl shadow-sm shrink-0">
            <button class="px-4 py-2 rounded-lg text-xs font-bold transition-colors @(financeFilter == "all" ? "bg-slate-900 text-white shadow-sm" : "text-slate-500 hover:text-slate-800 hover:bg-slate-100/50")" @onclick='() => OnFinanceChange("all")'>All</button>
            <button class="px-4 py-2 rounded-lg text-xs font-bold transition-colors @(financeFilter == "owing" ? "bg-rose-500 text-white shadow-sm" : "text-slate-500 hover:text-slate-800 hover:bg-slate-100/50")" @onclick='() => OnFinanceChange("owing")'>Arrears</button>
            <button class="px-4 py-2 rounded-lg text-xs font-bold transition-colors @(financeFilter == "credit" ? "bg-blue-500 text-white shadow-sm" : "text-slate-500 hover:text-slate-800 hover:bg-slate-100/50")" @onclick='() => OnFinanceChange("credit")'>Credit</button>
            <button class="px-4 py-2 rounded-lg text-xs font-bold transition-colors @(financeFilter == "cleared" ? "bg-emerald-500 text-white shadow-sm" : "text-slate-500 hover:text-slate-800 hover:bg-slate-100/50")" @onclick='() => OnFinanceChange("cleared")'>Cleared</button>
        </div>

        <div class="relative shrink-0">
            <select class="appearance-none pl-4 pr-10 py-3.5 bg-white/60 border border-slate-200 rounded-xl text-xs font-bold text-slate-600 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 shadow-sm" value="@filterForm" @onchange='e => { filterForm = e.Value?.ToString() ?? ""; ApplyFilters(); }'>
                <option value="">All Forms</option>
                @for (int f = 1; f <= 6; f++)
                {
                    <option value="@f">Form @f</option>
                }
            </select>
            <div class="absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9" /></svg></div>
        </div>

        @* ── Balance range filters ── *@
        <div class="flex items-center gap-1.5 shrink-0 bg-white/60 border border-slate-200 rounded-xl px-3 py-2 shadow-sm">
            <span class="text-[0.6rem] font-black text-slate-400 uppercase tracking-widest whitespace-nowrap">Balance</span>
            <span class="text-slate-300 text-xs">≥</span>
            <input type="number" step="0.01" placeholder="Min" class="w-20 bg-transparent border-none outline-none text-xs font-bold text-slate-700 placeholder:text-slate-300"
                   value="@(minBalanceFilter?.ToString() ?? "")"
                   @onchange='e => { minBalanceFilter = decimal.TryParse(e.Value?.ToString(), out var v) ? v : null; ApplyFilters(); }' />
            <span class="text-slate-300 text-xs mx-0.5">·</span>
            <span class="text-slate-300 text-xs">≤</span>
            <input type="number" step="0.01" placeholder="Max" class="w-20 bg-transparent border-none outline-none text-xs font-bold text-slate-700 placeholder:text-slate-300"
                   value="@(maxBalanceFilter?.ToString() ?? "")"
                   @onchange='e => { maxBalanceFilter = decimal.TryParse(e.Value?.ToString(), out var v) ? v : null; ApplyFilters(); }' />
            @if (minBalanceFilter.HasValue || maxBalanceFilter.HasValue)
            {
                <button class="ml-1 text-slate-400 hover:text-rose-500 transition-colors text-xs" title="Clear range"
                        @onclick='() => { minBalanceFilter = null; maxBalanceFilter = null; ApplyFilters(); }'>&times;</button>
            }
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl shadow-sm p-16 text-center text-slate-500">
        Loading student finance accounts...
    </div>
}
else if (!string.IsNullOrEmpty(loadError))
{
    <div class="bg-rose-50 border border-rose-200 rounded-2xl p-5 text-rose-700 font-medium">
        @loadError
    </div>
}
else
{
    <div class="printable-accounts-area relative bg-white overflow-hidden">
        <!-- Print-only Watermark -->
        <div class="hidden print-block absolute inset-0 opacity-[0.03] flex items-center justify-center pointer-events-none">
            <img src="/images/demo-logo.svg" alt="PrimeApp Demo" class="w-[450px] h-[450px] object-contain print-logo" />
        </div>
        
        <!-- Print-only Header -->
        <div class="hidden print-block flex-col w-full pb-4 mb-6">
            <div class="flex justify-between items-start gap-4 pb-4 border-b border-dashed border-stone-400 w-full mb-4">
                <div class="flex gap-3">
                    <img src="/images/demo-logo.svg" alt="PrimeApp Demo" class="w-16 h-16 object-contain print-logo" />
                    <div>
                        <div class="text-[1.35rem] font-black leading-tight uppercase text-slate-900">PrimeApp Demo</div>
                        <div class="text-[0.72rem] font-semibold mt-1 text-slate-500">Equipping youngsters to compete internationally</div>
                        <div class="text-[0.72rem] mt-2 text-slate-500">0783841141 / 0785638463</div>
                        <div class="text-[0.72rem] text-slate-500">cliftonmataruse2@gmail.com</div>
                    </div>
                </div>
                <div class="text-right text-[0.8rem] leading-tight font-semibold text-slate-800">
                    <div>20440</div>
                    <div>VICTORY</div>
                    <div>PARK, RUWA</div>
                </div>
            </div>
            
            <div class="flex justify-between items-center w-full py-1">
                <div>
                    <h3 class="text-base font-black text-emerald-700 uppercase tracking-widest">Students & Accounts Report</h3>
                    <div class="text-[10px] text-slate-500 mt-0.5">Filter: @(financeFilter == "all" ? "All Accounts" : financeFilter == "owing" ? "Arrears" : financeFilter == "credit" ? "Credit" : "Cleared") @(string.IsNullOrEmpty(filterForm) ? "" : $"| Form {filterForm}")</div>
                </div>
                <div class="text-right text-xs text-slate-500 font-bold">
                    Date: @DateTime.Today.ToString("dd MMM yyyy")
                </div>
            </div>
        </div>
        
        <!-- Print-only Summary Info -->
        <div class="hidden print-block mb-6 text-xs text-slate-700 w-full">
            <div class="grid grid-cols-3 gap-4 w-full border border-slate-200 rounded-xl p-4">
                <div><strong>Showing Accounts:</strong> @filteredRows.Count</div>
                <div><strong>Outstanding (Filtered):</strong> @filteredRows.Where(r => r.Balance > 0).Sum(r => r.Balance).ToString("C")</div>
                <div><strong>Total Paid (Filtered):</strong> @filteredRows.Sum(r => r.TotalPaid).ToString("C")</div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6 animate-fade-in-up delay-75 no-print">
        <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-2xl p-5 shadow-sm">
            <div class="text-xs font-black uppercase tracking-widest text-slate-400 mb-2">Showing accounts</div>
            <div class="text-3xl font-black text-slate-900">@filteredRows.Count</div>
            @if (filteredRows.Count != allRows.Count)
            {
                <div class="text-xs font-bold text-slate-400 mt-1">of @allRows.Count total</div>
            }
        </div>
        <div class="bg-white/70 backdrop-blur-sm border border-rose-100 rounded-2xl p-5 shadow-sm">
            <div class="text-xs font-black uppercase tracking-widest text-rose-400 mb-2">Outstanding (filtered)</div>
            <div class="text-3xl font-black text-rose-600">@filteredRows.Where(r => r.Balance > 0).Sum(r => r.Balance).ToString("C")</div>
        </div>
        <div class="bg-white/70 backdrop-blur-sm border border-emerald-100 rounded-2xl p-5 shadow-sm">
            <div class="text-xs font-black uppercase tracking-widest text-emerald-400 mb-2">Total paid (filtered)</div>
            <div class="text-3xl font-black text-emerald-600">@filteredRows.Sum(r => r.TotalPaid).ToString("C")</div>
        </div>
    </div>

    <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl shadow-sm overflow-hidden mb-8 animate-fade-in-up">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[980px]">
                <thead class="bg-slate-50/80 border-b border-slate-200 text-[length:0.65rem] font-black text-slate-400 uppercase tracking-widest">
                    <tr>
                        <th class="py-4 px-6">Student</th>
                        <th class="py-4 px-6">Form / Class</th>
                        <th class="py-4 px-6 text-right">Total Charged</th>
                        <th class="py-4 px-6 text-right">Total Paid</th>
                        <th class="py-4 px-6 text-right border-l border-slate-100">Balance</th>
                        <th class="py-4 px-6">Status</th>
                        <th class="py-4 px-6 w-56 text-right no-print">Quick Action</th>
                    </tr>
                </thead>
                <tbody class="text-sm font-medium text-slate-700 divide-y divide-slate-100">
                    @if (!filteredRows.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-16 text-center">
                                <div class="text-sm font-bold text-slate-800 mb-1">No matching accounts found</div>
                                <p class="text-xs text-slate-500 font-medium">Try adjusting your filters or search term.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int ri = 0;
                        @foreach (var row in pagedRows)
                        {
                            var (bg, fg) = AvatarColor(ri);
                            string ini = $"{row.Student.FirstName?.FirstOrDefault()}{row.Student.LastName?.FirstOrDefault()}";
                            <tr class="hover:bg-slate-50/80 transition-colors group">
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-4">
                                        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-sm font-black shrink-0" style="background:@bg;color:@fg;">@ini</div>
                                        <div>
                                            <div class="text-sm font-extrabold text-slate-900 group-hover:text-emerald-700 transition-colors">@row.FullName</div>
                                            <div class="text-[length:0.65rem] font-bold text-slate-400 mt-1">Student ID: @row.Student.Id | @(row.Student.NationalId ?? "No national ID")</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    <span class="px-2.5 py-1 rounded-md bg-slate-100 border border-slate-200 text-xs font-black text-slate-700">@FormatClassroom(row.Student.Form, row.Student.Classroom)</span>
                                </td>
                                <td class="py-4 px-6 text-right font-black text-slate-900">@row.TotalCharged.ToString("C")</td>
                                <td class="py-4 px-6 text-right font-black text-emerald-600">@row.TotalPaid.ToString("C")</td>
                                <td class="py-4 px-6 text-right border-l border-slate-100">
                                    @if (row.Balance > 0)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-rose-50 border border-rose-100 text-rose-600 font-black shadow-sm">
                                            @row.Balance.ToString("C")
                                        </span>
                                    }
                                    else if (row.Balance < 0)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 border border-blue-100 text-blue-600 font-black shadow-sm">
                                            @Math.Abs(row.Balance).ToString("C") CR
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-50 border border-emerald-100 text-emerald-600 font-black shadow-sm">
                                            Cleared
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6">
                                    <span class="px-3 py-1.5 rounded-lg text-xs font-black @(row.BalanceType == "DEBIT" ? "bg-rose-50 text-rose-600 border border-rose-100" : row.BalanceType == "CREDIT" ? "bg-blue-50 text-blue-600 border border-blue-100" : "bg-emerald-50 text-emerald-600 border border-emerald-100")">
                                        @(row.BalanceType == "DEBIT" ? "In Arrears" : row.BalanceType == "CREDIT" ? "Credit" : "Settled")
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-right no-print">
                                    <div class="flex items-center justify-end gap-2">
                                        <button class="px-4 py-2 bg-white border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-700 text-slate-600 rounded-lg text-xs font-bold transition-all shadow-sm" @onclick="() => NavigateToTransaction(row.Student.Id)">
                                            Record Payment
                                        </button>
                                        <button class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-bold transition-all shadow-sm" @onclick="() => NavigateToReports(row.Student.Id)">
                                            View Statement
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            ri++;
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (filteredRows.Count > pageSize)
        {
            <div class="no-print flex flex-col sm:flex-row items-center justify-between gap-3 px-6 py-4 border-t border-slate-200 bg-slate-50/60">
                <span class="text-xs font-bold text-slate-500">
                    Showing @(((currentPage - 1) * pageSize) + 1)–@(Math.Min(currentPage * pageSize, filteredRows.Count)) of @filteredRows.Count
                </span>
                <div class="flex items-center gap-1.5">
                    <button class="w-8 h-8 rounded-lg flex items-center justify-center border border-slate-200 bg-white text-slate-500 hover:bg-slate-100 disabled:opacity-50 transition-colors"
                            disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)" aria-label="Previous page">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6" /></svg>
                    </button>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        var pageNumber = p;
                        <button class="w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold transition-all @(currentPage == pageNumber ? "bg-emerald-600 text-white shadow-md" : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-100")"
                                @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                    }
                    <button class="w-8 h-8 rounded-lg flex items-center justify-center border border-slate-200 bg-white text-slate-500 hover:bg-slate-100 disabled:opacity-50 transition-colors"
                            disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)" aria-label="Next page">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6" /></svg>
                    </button>
                </div>
            </div>
        }
    </div>
</div>
}

</div>

@code {
    private sealed class StudentAccountRow
    {
        public required StudentProfileModel.Student Student { get; init; }
        public decimal TotalCharged { get; init; }
        public decimal TotalPaid { get; init; }
        public decimal Balance { get; init; }
        public string BalanceType { get; init; } = "ZERO";
        public string FullName => $"{Student.FirstName} {Student.LastName}".Trim();
    }

    private List<StudentAccountRow> allRows = new();
    private List<StudentAccountRow> filteredRows = new();
    private List<StudentAccountRow> pagedRows = new();
    private int currentPage = 1;
    private const int pageSize = 15;
    private int totalPages => (int)Math.Ceiling((double)filteredRows.Count / pageSize);

    private bool isLoading = true;
    private string loadError = string.Empty;
    private string searchTerm = string.Empty;
    private string filterForm = string.Empty;
    private string financeFilter = "all";
    private decimal? minBalanceFilter;
    private decimal? maxBalanceFilter;
    private decimal totalOutstanding;
    private decimal totalPaid;

    private static readonly (string Bg, string Fg)[] Palette = {
        ("rgb(209 250 229)", "#059669"),
        ("rgb(255 237 213)", "#ea580c"),
        ("rgb(224 231 255)", "#4f46e5"),
        ("rgb(254 226 226)", "#e11d48"),
        ("rgb(243 244 246)", "#475569"),
    };

    private (string Bg, string Fg) AvatarColor(int i) => Palette[i % Palette.Length];

    private bool dataLoadAttempted;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || dataLoadAttempted) return;
        dataLoadAttempted = true;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = string.Empty;

        try
        {
            var students = await StudentService.GetStudentsAsync() ?? new List<StudentProfileModel.Student>();
            var accountsByStudentId = new Dictionary<long, AccountSummary>();

            try
            {
                var accounts = await FinanceService.GetAllAccountSummariesAsync() ?? new List<AccountSummary>();
                accountsByStudentId = accounts.ToDictionary(a => a.StudentId, a => a);
            }
            catch
            {
                // Fallback when /api/finance/accounts/all is unstable: load summaries per student.
                var summaryTasks = students.Select(async student =>
                {
                    try
                    {
                        return await FinanceService.GetAccountSummaryAsync(student.Id);
                    }
                    catch
                    {
                        return null;
                    }
                });

                var summaries = await Task.WhenAll(summaryTasks);
                accountsByStudentId = summaries
                    .Where(summary => summary is not null)
                    .Cast<AccountSummary>()
                    .ToDictionary(summary => summary.StudentId, summary => summary);
            }

            allRows = students.Select(student =>
            {
                accountsByStudentId.TryGetValue(student.Id, out var account);
                return new StudentAccountRow
                {
                    Student = student,
                    TotalCharged = account?.TotalCharged ?? 0,
                    TotalPaid = account?.TotalPaid ?? 0,
                    Balance = account?.Balance ?? 0,
                    BalanceType = account?.BalanceType ?? "ZERO"
                };
            }).OrderBy(r => r.Student.LastName).ThenBy(r => r.Student.FirstName).ToList();

            totalOutstanding = allRows.Where(r => r.Balance > 0).Sum(r => r.Balance);
            totalPaid = allRows.Sum(r => r.TotalPaid);
            ApplyFilters();
        }
        catch (Exception ex)
        {
            loadError = $"Could not load burser finance data. {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    }

    private void OnFinanceChange(string filter)
    {
        financeFilter = filter;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = allRows.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(row =>
                row.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (row.Student.NationalId ?? string.Empty).Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                row.Student.Id.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrEmpty(filterForm) && int.TryParse(filterForm, out var form))
        {
            query = query.Where(row => row.Student.Form == form);
        }

        query = financeFilter switch
        {
            "owing"   => query.Where(row => row.Balance > 0),
            "credit"  => query.Where(row => row.Balance < 0),
            "cleared" => query.Where(row => row.Balance == 0),
            _         => query
        };

        // Balance range filters
        if (minBalanceFilter.HasValue)
            query = query.Where(row => row.Balance >= minBalanceFilter.Value);
        if (maxBalanceFilter.HasValue)
            query = query.Where(row => row.Balance <= maxBalanceFilter.Value);

        filteredRows = query.ToList();
        currentPage = 1;
        UpdatePage();
    }

    private void UpdatePage()
        => pagedRows = filteredRows.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private void GoToPage(int page)
    {
        currentPage = Math.Clamp(page, 1, Math.Max(1, totalPages));
        UpdatePage();
    }

    private void NavigateToTransaction(int id) => Nav.NavigateTo($"/burser/transaction/{id}");
    private void NavigateToReports(int id) => Nav.NavigateTo($"/burser/reports?studentId={id}");
    private async Task PrintAccountsAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private static string FormatClassroom(int? form, string? classroom)
    {
        if (form.HasValue && !string.IsNullOrWhiteSpace(classroom))
        {
            if (classroom.StartsWith("Form", StringComparison.OrdinalIgnoreCase))
            {
                return classroom;
            }
            return $"Form {form} {classroom}";
        }
        if (form.HasValue) return $"Form {form}";
        return classroom ?? string.Empty;
    }
}
