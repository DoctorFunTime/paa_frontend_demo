@page "/privacy"
@attribute [AllowAnonymous]
@layout paa_frontend.Client.Layout.MainLayout

<PageTitle>Privacy Notice | PrimeApp Demo</PageTitle>

<div class="min-h-screen bg-slate-50 px-4 py-10 sm:px-6 lg:px-8">
    <article class="mx-auto max-w-4xl rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
        <div class="mb-8 flex items-start gap-4 border-b border-slate-100 pb-7">
            <img src="/images/demo-logo.svg" alt="PrimeApp Demo" class="h-14 w-14 object-contain" />
            <div>
                <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-indigo-600">PrimeApp Demo</p>
                <h1 class="mt-1 text-3xl font-black tracking-tight text-slate-900">Privacy Notice</h1>
                <p class="mt-2 text-sm text-slate-500">Last updated: 10 September 2026</p>
            </div>
        </div>

        <div class="space-y-8 text-sm leading-7 text-slate-600">
            <section><h2 class="text-lg font-extrabold text-slate-900">Development data notice</h2><p>This demo uses the same development API and login service as the main frontend. Records shown here come from that shared development environment.</p></section>
            <section><h2 class="text-lg font-extrabold text-slate-900">Changes and submissions</h2><p>Edits, payments, applications, imports and other submissions made here affect the shared development environment. Use only information you are authorised to enter there.</p></section>
            <section><h2 class="text-lg font-extrabold text-slate-900">Access</h2><p>Use an account issued for the development environment. Access to pages and records depends on the permissions of that account.</p></section>
        </div>

        <a href="/login" class="mt-8 inline-flex rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-slate-800">Back to sign in</a>
    </article>
</div>
