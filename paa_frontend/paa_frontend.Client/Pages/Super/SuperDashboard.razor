@page "/super"
@namespace paa_frontend.Client.Pages.Super
@layout paa_frontend.Client.Layout.SuperPortalLayout
@attribute [Authorize(Roles = "SUPER")]
@using paa_frontend.Shared.Models
@using paa_frontend.Client.Services
@using paa_frontend.Client.Services.StudentsPortal
@inject StudentProfileServiceClient StudentService
@inject FinanceServiceClient FinanceService

<div class="mb-6 flex flex-col gap-4 sm:mb-8 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <div class="mb-2 inline-flex items-center gap-2 rounded-full border border-indigo-100 bg-indigo-50 px-3 py-1 text-[0.65rem] font-black uppercase tracking-[0.16em] text-indigo-600">
            <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span> Super user access
        </div>
        <h1 class="text-2xl font-black tracking-tight text-slate-900 sm:text-4xl">Executive overview</h1>
        <p class="mt-1 text-sm font-medium text-slate-500">A quick view of school operations and financial health.</p>
    </div>
    <div class="text-left text-xs font-semibold text-slate-400 sm:text-right">@DateTime.Now.ToString("dddd, dd MMMM yyyy")<br /><span class="text-indigo-500">Everything important, one place.</span></div>
</div>

@if (isLoading)
{
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        @for (var i = 0; i < 4; i++)
        {
            <div class="h-28 animate-pulse rounded-3xl border border-slate-200 bg-white"></div>
        }
    </div>
}
else
{
    <section class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <MetricCard Label="Students" Value="@studentCount.ToString()" Hint="All enrolled profiles" Tone="indigo" Href="/students" />
        <MetricCard Label="Accounts" Value="@accountCount.ToString()" Hint="Financial accounts" Tone="emerald" Href="/burser/students" />
        <MetricCard Label="Collected" Value="@cashCollected.ToString("C0")" Hint="Current cashflow view" Tone="blue" Href="/burser/reports" />
        <MetricCard Label="Outstanding" Value="@outstanding.ToString("C0")" Hint="Account balances" Tone="rose" Href="/burser/students" />
    </section>
}

<section class="mt-5 grid grid-cols-1 gap-5 xl:grid-cols-[1.35fr_1fr]">
    <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div class="flex items-start justify-between gap-3">
            <div>
                <p class="text-[0.65rem] font-black uppercase tracking-[0.18em] text-indigo-500">Operations</p>
                <h2 class="mt-1 text-xl font-black text-slate-900">Administration workspace</h2>
                <p class="mt-1 text-sm font-medium text-slate-500">Open the existing admin tools without hunting through a long menu.</p>
            </div>
            <a href="/admin" class="rounded-full bg-indigo-600 px-3 py-2 text-xs font-bold text-white shadow-sm hover:bg-indigo-700">Full dashboard</a>
        </div>
        <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3">
            <PortalCard Href="/students" Title="Students" Detail="Directory & records" Icon="♙" Tone="indigo" />
            <PortalCard Href="/admin/attendance" Title="Attendance" Detail="Daily monitoring" Icon="✓" Tone="blue" />
            <PortalCard Href="/admin/teachers" Title="Staff" Detail="Teachers & admins" Icon="◉" Tone="violet" />
            <PortalCard Href="/admin/academics" Title="Academics" Detail="Classes & subjects" Icon="▤" Tone="emerald" />
            <PortalCard Href="/admin/grades/approval" Title="Marks" Detail="Review & approve" Icon="⌁" Tone="amber" />
            <PortalCard Href="/admin/passes" Title="Passes" Detail="Student passes" Icon="→" Tone="slate" />
        </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-slate-900 p-5 text-white shadow-sm sm:p-6">
        <div class="flex items-start justify-between gap-3">
            <div>
                <p class="text-[0.65rem] font-black uppercase tracking-[0.18em] text-emerald-300">Finance</p>
                <h2 class="mt-1 text-xl font-black">Financial workspace</h2>
                <p class="mt-1 text-sm font-medium text-slate-300">Operational finance tools available to the super user.</p>
            </div>
            <a href="/burser" class="rounded-full bg-white/10 px-3 py-2 text-xs font-bold text-white hover:bg-white/20">Full dashboard</a>
        </div>
        <div class="mt-5 grid grid-cols-2 gap-2">
            <PortalCard Href="/burser/students" Title="Accounts" Detail="Student balances" Icon="$" Tone="emerald" Dark="true" />
            <PortalCard Href="/burser/transaction/new" Title="Transactions" Detail="Record payments" Icon="+" Tone="blue" Dark="true" />
            <PortalCard Href="/burser/reports" Title="Reports" Detail="Financial reporting" Icon="▥" Tone="violet" Dark="true" />
            <PortalCard Href="/burser/student-finance" Title="Student finance" Detail="Individual accounts" Icon="◌" Tone="amber" Dark="true" />
        </div>
        <div class="mt-5 grid grid-cols-2 gap-2 border-t border-white/10 pt-4 text-xs font-bold">
            <div><div class="text-slate-400">Cash received</div><div class="mt-1 text-lg text-emerald-300">@cashCollected.ToString("C0")</div></div>
            <div><div class="text-slate-400">Net position</div><div class="mt-1 text-lg text-white">@netPosition.ToString("C0")</div></div>
        </div>
    </div>
</section>

<section class="mt-5 rounded-3xl border border-amber-100 bg-amber-50 p-4 text-sm font-medium text-amber-900 sm:p-5">
    <div class="flex gap-3"><span class="text-lg">i</span><div><strong class="font-black">Super user navigation</strong><p class="mt-1 text-amber-800">Fee setup, exchange rates, and scanner are intentionally excluded from this portal. All other admin and finance tools are grouped above or available from the mobile menu.</p></div></div>
</section>

@code {
    private bool isLoading = true;
    private int studentCount;
    private int accountCount;
    private decimal cashCollected;
    private decimal outstanding;
    private decimal netPosition;

    protected override async Task OnInitializedAsync()
    {
        var studentsTask = LoadStudentsAsync();
        var accountsTask = LoadAccountsAsync();
        var cashflowTask = LoadCashflowAsync();
        await Task.WhenAll(studentsTask, accountsTask, cashflowTask);
        studentCount = studentsTask.Result;
        var accounts = accountsTask.Result;
        accountCount = accounts.Count;
        outstanding = accounts.Where(a => a.Balance > 0).Sum(a => a.Balance);
        var cashflow = cashflowTask.Result;
        cashCollected = cashflow?.CashFeeIncome ?? 0;
        netPosition = cashflow?.NetTotal ?? 0;
        isLoading = false;
    }

    private async Task<int> LoadStudentsAsync()
    {
        try { return (await StudentService.GetStudentsAsync())?.Count ?? 0; }
        catch { return 0; }
    }

    private async Task<List<AccountSummary>> LoadAccountsAsync()
    {
        try { return await FinanceService.GetAllAccountSummariesAsync() ?? new(); }
        catch { return new(); }
    }

    private async Task<CashFlowSummaryDto?> LoadCashflowAsync()
    {
        try { return await FinanceService.GetCashflowSummaryAsync(); }
        catch { return null; }
    }
}
