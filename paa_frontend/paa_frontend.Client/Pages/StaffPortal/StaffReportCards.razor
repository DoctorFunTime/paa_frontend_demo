            OverallComments="An excellent student who shows great initiative.",
            Subjects = new() {
                new() { SubjectName="Physics",          CourseworkMark=82, ExamMark=78, FinalMark=79.2, Grade="B", Comments="Good understanding of kinematics." },
                new() { SubjectName="Mathematics",      CourseworkMark=91, ExamMark=88, FinalMark=88.9, Grade="A", Comments="Outstanding. Keep it up." },
                new() { SubjectName="Chemistry",        CourseworkMark=74, ExamMark=70, FinalMark=71.2, Grade="B", Comments="Solid lab work." },
                new() { SubjectName="English Language", CourseworkMark=68, ExamMark=65, FinalMark=65.9, Grade="C", Comments="Work on essay structure." },
            }
        },
        new() {
