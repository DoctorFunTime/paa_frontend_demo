    private List<MockStudentItem> FilteredMockStudents =>
        string.IsNullOrWhiteSpace(studentSearch)
            ? AllMockStudents
            : AllMockStudents.Where(s =>
                (s.FirstName + " " + s.LastName).Contains(studentSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    // ── Mock data: teachers — mirrors Teacher.java entity ─
    // Fields: id, firstName, lastName, email, gender, phone, nationalId, dateOfBirth, status, createdAt, updatedAt
    private class MockTeacherItem
    {
        public long     Id          { get; set; }
        public string   FirstName   { get; set; } = "";
        public string   LastName    { get; set; } = "";
        public string   Email       { get; set; } = "";
        public string   Gender      { get; set; } = "";
