        new() { Id=101, FirstName="Tariro",  LastName="Moyo",    Email="t.moyo@pamushana.ac.zw",    Gender="Female", Phone="+263 77 123 4567", NationalId="63-100001-F-22", DateOfBirth=new DateOnly(1985,3,15), Status="Active" },
        new() { Id=102, FirstName="Tendai",  LastName="Ncube",   Email="t.ncube@pamushana.ac.zw",   Gender="Male",   Phone="+263 71 234 5678", NationalId="63-100002-M-14", DateOfBirth=new DateOnly(1979,8,22), Status="Active" },
        new() { Id=103, FirstName="Sekai",   LastName="Dube",    Email="s.dube@pamushana.ac.zw",    Gender="Female", Phone="+263 78 345 6789", NationalId="63-100003-F-09", DateOfBirth=new DateOnly(1990,1,30), Status="Active" },
        new() { Id=104, FirstName="Taurai",  LastName="Mutasa",  Email="t.mutasa@pamushana.ac.zw",  Gender="Male",   Phone="+263 73 456 7890", NationalId="63-100004-M-31", DateOfBirth=new DateOnly(1983,6,11), Status="On Leave" },
    };

    // ── Subject list ──────────────────────────────────────
    private List<string> AllSubjects = new()
    {
        "Physics", "Chemistry", "Biology", "Combined Science",
        "Mathematics", "Additional Mathematics",
        "English Language", "English Literature",
        "History", "Geography", "Divinity",
        "Accounts", "Business Studies", "Economics",
        "Art", "Design & Technology",
    };

    // ── Mock history ──────────────────────────────────────
    private List<ReportCardModel> MockHistory = new()
    {
        new() {
            Id=1, StudentId=1001, StudentFirstName="Chiedza", StudentLastName="Mutasa",
            StudentForm=4, StudentClass="4A", Term="Term 1", TermMonth="April", TermYear=2026,
