    private async Task OnFormChangedInternalAsync()
    {
        setup.SubjectName = "";
        setup.Field = "";
        setup.ClassName = "";

        // Load classes first because Forms 1-4 subjects are configured per class.
        await LoadClassesAsync();

        // Auto-select a matching class for this form if available
        if (AvailableClasses.Any())
        {
            var matched = AvailableClasses.FirstOrDefault(c => {
                string cls = c.ToLowerInvariant();
                if (setup.FormNumber == 5 && (cls.Contains("l6") || cls.Contains("lower") || cls.Contains("form 5") || cls.Contains("f5"))) return true;
                if (setup.FormNumber == 6 && (cls.Contains("u6") || cls.Contains("upper") || cls.Contains("form 6") || cls.Contains("f6"))) return true;
                if (setup.FormNumber >= 1 && setup.FormNumber <= 4) return cls.Contains($"form {setup.FormNumber}") || cls.Contains($"f{setup.FormNumber}");
                return false;
            });
            setup.ClassName = matched ?? AvailableClasses.First();
        }

        await LoadSubjectsAsync();
    }

