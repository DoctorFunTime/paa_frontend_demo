            else ShowToast("Update failed", error: true);
        }
        catch { ShowToast("Network error", error: true); }
        finally { isEditing = false; }
    }

    private async Task SubmitAllMarks()
    {
        isSaving = true;
        int saved = 0, errors = 0;
        // The marks endpoint groups records by gradedDate. Saving today's date
        // here made marks entered for an older term disappear from that term's
        // query. Keep the mark date inside the selected term instead.
        var today = GetSelectedTermDate();
        double maxScore = SelectedAssessment?.MaxScore ?? 100.0;

        try
        {
            var rowsToSave = markRows.Where(r => r.Score.HasValue && !r.IsApproved && string.IsNullOrWhiteSpace(r.BlockReason)).ToList();
            if (!rowsToSave.Any())
            {
                if (markRows.Any(r => r.IsApproved))
                    ShowToast("All entered marks are approved by Admin and locked against changes.", error: false);
                else
                    ShowToast("No marks to submit.", error: false);
                return;
            }

            var newRows = rowsToSave.Where(r => !r.IsExisting).ToList();
            var editRows = rowsToSave.Where(r => r.IsExisting).ToList();

            if (setup.AssessmentType == "exam")
            {
                // ── EXAM: bulk create ────────────────────────────────────────────
                if (newRows.Any())
                {
                    var dtos = newRows.Select(r => new ExamMarkDTO
                    {
                        StudentId = r.StudentId,
                        ExamId = SelectedAssessment!.RealId,
                        Score = r.Score!.Value,   // raw mark. Backend expects raw mark for exams, not percentage
                        ActualMark = r.Score!.Value,           // raw mark   → for read-back
                        MaxScore = maxScore,
                        Feedback = r.Feedback,
                        GradedDate = today,
                        TeacherId = currentTeacherId,
                        Term = setup.Term, TermYear = setup.TermYear,
                    }).ToList();

                    var result = await AssessmentService.BulkSetExamMarksAsync(dtos);
                    if (result == null) errors += newRows.Count;
                    else saved += result.Count;
                }

                // ── EXAM: bulk edit ──────────────────────────────────────────────
                if (editRows.Any())
                {
                    var dtos = editRows.Select(r => new ExamMarkDTO
                    {
                        Id = r.ExistingId,
                        StudentId = r.StudentId,
                        ExamId = SelectedAssessment!.RealId,
                        Score = r.Score!.Value,   // raw mark; backend converts it to a percentage during edit
                        ActualMark = r.Score!.Value,
                        MaxScore = maxScore,
                        Feedback = r.Feedback,
                        GradedDate = today,
                        TeacherId = currentTeacherId,
                        Term = setup.Term, TermYear = setup.TermYear,
                    }).ToList();

                    var result = await AssessmentService.BulkEditExamMarksAsync(dtos);
                    if (result == null) errors += editRows.Count;
                    else saved += result.Count;
                }
            }
            else
            {
                // ── COURSEWORK: bulk create ──────────────────────────────────────
                if (newRows.Any())
                {
                    var dtos = newRows.Select(r => new CourseworkDTO
                    {
                        StudentId = r.StudentId,
                        AssignmentId = setup.AssessmentType == "assignment" ? SelectedAssessment!.RealId : null,
                        TestId = setup.AssessmentType == "test" ? SelectedAssessment!.RealId : null,
                        Score = r.Score!.Value,          // backend converts raw mark to percentage
                        Feedback = r.Feedback,
                        GradedDate = today,
                        TeacherId = currentTeacherId,
                        Term = setup.Term, TermYear = setup.TermYear,
                    }).ToList();

                    var result = await AssessmentService.BulkSetCourseworkMarksAsync(dtos);
                    if (result == null) errors += newRows.Count;
                    else saved += result.Count;
                }

                // ── COURSEWORK: bulk edit ────────────────────────────────────────
                if (editRows.Any())
                {
                    var dtos = editRows.Select(r => new CourseworkDTO
                    {
                        Id = r.ExistingId,   // required — backend looks up by this
                        StudentId = r.StudentId,
                        AssignmentId = setup.AssessmentType == "assignment" ? SelectedAssessment!.RealId : null,
                        TestId = setup.AssessmentType == "test" ? SelectedAssessment!.RealId : null,
                        Score = r.Score!.Value,          // backend stores coursework as a percentage
                        Feedback = r.Feedback,
                        GradedDate = today,
                        TeacherId = currentTeacherId,
                        Term = setup.Term, TermYear = setup.TermYear,
                    }).ToList();

                    var result = await AssessmentService.BulkEditCourseworkMarksAsync(dtos);
                    if (result == null) errors += editRows.Count;
                    else saved += result.Count;
                }
            }

            // Mark rows as submitted in the UI
            foreach (var row in rowsToSave)
                row.Submitted = true;

            ShowToast(errors > 0
                ? $"{saved} marks saved, {errors} failed"
                : $"{saved} marks submitted successfully",
                error: errors > 0);

            if (errors == 0)
            {
                step = 0;
                await LoadDashboardDataAsync();
            }
        }
        finally { isSaving = false; }
    }

    // ── Step 3: mark rows ────────────────────────────────
    private class MarkRow
    {
        public long    StudentId   { get; set; }
        public string  StudentName { get; set; } = "";
        public string  NationalId  { get; set; } = "";
        /// <summary>Raw mark as entered by the teacher (0 – MaxScore).</summary>
        public double? Score       { get; set; }
        public string  Feedback    { get; set; } = "";
        public bool    IsExisting  { get; set; }
        public long    ExistingId  { get; set; }
        public bool    Submitted   { get; set; }
        public bool    IsApproved  { get; set; }
        public string  BlockReason { get; set; } = "";

        /// <summary>Live percentage derived from Score / MaxScore * 100 — updated whenever Score changes.</summary>
        public double? LivePct(double maxScore) =>
            Score.HasValue && maxScore > 0 ? Score.Value / maxScore * 100.0 : null;
    }

    private static bool ClassMatchesFormAndName(string? classroom, int form, string selectedClass)
    {
        if (string.IsNullOrWhiteSpace(classroom) || string.IsNullOrWhiteSpace(selectedClass))
            return false;

        static string Normalize(string value) =>
            new string(value.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();

        var actual = Normalize(classroom);
        var selected = Normalize(selectedClass);
        var formText = form.ToString();

        // The enrollment service accepts stream-only names and full class codes.
        if (actual == selected || actual == formText + selected || actual == selected + formText)
            return true;

        if (actual.StartsWith("form" + formText))
            actual = actual[("form" + formText).Length..];
        else if (actual.StartsWith(formText))
            actual = actual[formText.Length..];

        if (selected.StartsWith("form" + formText))
            selected = selected[("form" + formText).Length..];
        else if (selected.StartsWith(formText))
            selected = selected[formText.Length..];

        return actual == selected;
    }

