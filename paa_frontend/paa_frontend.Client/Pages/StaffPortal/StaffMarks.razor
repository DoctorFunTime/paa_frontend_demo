    private List<string> GetClassesForLevel(string level)
    {
        if (level == "form1to4") return olevelClasses;
        if (level == "alevel") return alevelClasses;
        return new List<string>();
    }

    private async Task LoadDashboardDataAsync()
    {
        isLoadingDashboard = true;
        StateHasChanged();

        try
        {
            var olevelClassesTask = OClassService.GetAllOlevelClassNamesAsync();
            var alevelClassesTask = AClassService.GetAllAlevelClassNamesAsync();
            var alevelSubjectsTask = SubjectService.GetALevelSubjectsAsync();
            var studentsTask = StudentProfileService.GetStudentsAsync();
            var alevelChoicesTask = SubjectService.GetStudentALevelSubjectChoicesAsync();

            await Task.WhenAll(
                olevelClassesTask, alevelClassesTask, alevelSubjectsTask,
                studentsTask, alevelChoicesTask
            );

            olevelClasses = olevelClassesTask.Result?.Select(c => c.ClassName ?? "").Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c).ToList() ?? new();
            juniorClasses = olevelClasses.ToList();
            alevelClasses = alevelClassesTask.Result?.Select(c => c.ClassName ?? "").Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c).ToList() ?? new();

            allDashboardClasses.Clear();
            allDashboardClasses.AddRange(juniorClasses);
            allDashboardClasses.AddRange(olevelClasses);
            allDashboardClasses.AddRange(alevelClasses);
            allDashboardClasses = allDashboardClasses.Distinct().OrderBy(c => c).ToList();

            alevelSubjectIdToNameMap.Clear();
            subjectIdToNameMap.Clear();
            allDashboardSubjects.Clear();

            if (alevelSubjectsTask.Result != null)
            {
                foreach (var s in alevelSubjectsTask.Result)
                {
                    if (s.Id > 0 && !string.IsNullOrWhiteSpace(s.SubjectName))
                    {
                        string name = s.SubjectName.Trim();
                        alevelSubjectIdToNameMap[s.Id] = name;
                        subjectIdToNameMap[s.Id] = name;
                        allDashboardSubjects.Add(name);
                    }
                }
            }
            allDashboardSubjects = allDashboardSubjects.Distinct().OrderBy(s => s).ToList();

            allStudents = studentsTask.Result ?? new();
            alevelChoices = alevelChoicesTask.Result ?? new();

            await FetchAllAssessmentsAsync();
        }
        catch (Exception)
        {
            ShowToast("Failed to load dashboard data.", error: true);
        }
        finally
        {
            isLoadingDashboard = false;
            StateHasChanged();
        }
    }

    private async Task<SubjectsModel.Form1to4StudentSubjectChoices?> TryGetForm1to4StudentSubjectsAsync(long studentId)
    {
        try
        {
            var saved = await SubjectService.GetForm1to4StudentSubjectsAsync(studentId);
            if (saved?.Subjects?.Any() == true) return saved;

            var student = allStudents.FirstOrDefault(s => s.Id == studentId);
            if (student?.Form is >= 1 and <= 4 && !string.IsNullOrWhiteSpace(student.Classroom))
            {
                var classSetup = await SubjectService.GetForm1to4ClassSubjectsAsync(student.Form.Value, student.Classroom);
                if (classSetup?.Subjects?.Any() == true)
                {
                    return new SubjectsModel.Form1to4StudentSubjectChoices
                    {
                        StudentId = studentId,
                        Form = student.Form.Value,
                        ClassName = student.Classroom,
                        Subjects = classSetup.Subjects.ToList()
                    };
                }
            }

            return saved;
        }
        catch
        {
            return null;
        }
    }

    private bool StudentHasForm1to4Subject(long studentId, string subjectName)
        => form1to4StudentSubjects.TryGetValue(studentId, out var subjects)
           && subjects.Any(s => string.Equals(s, subjectName, StringComparison.OrdinalIgnoreCase));

    private async Task FetchAllAssessmentsAsync()
    {
        allAssessments.Clear();

        try
        {
            var assignmentsF12Task = AssessmentService.GetAssignmentsAsync("form1to4", "");
            var assignmentsALTask  = AssessmentService.GetAssignmentsAsync("alevel", "");

            var testsF12Task = AssessmentService.GetTestsAsync("form1to4", "");
            var testsALTask  = AssessmentService.GetTestsAsync("alevel", "");

            var examsF12Task = AssessmentService.GetExamsAsync("form1to4", "");
            var examsALTask  = AssessmentService.GetExamsAsync("alevel", "");

            await Task.WhenAll(
                assignmentsF12Task, assignmentsALTask,
                testsF12Task, testsALTask,
                examsF12Task, examsALTask
            );

            AddDashboardItems(assignmentsF12Task.Result, "form1to4", "assignment");
            AddDashboardItems(assignmentsALTask.Result, "alevel", "assignment");

            AddDashboardItems(testsF12Task.Result, "form1to4", "test");
            AddDashboardItems(testsALTask.Result, "alevel", "test");

            AddDashboardItems(examsF12Task.Result, "form1to4", "exam");
            AddDashboardItems(examsALTask.Result, "alevel", "exam");

            allAssessments = allAssessments.OrderByDescending(a => a.RealId).ToList();
            
            ApplyFilters();

            _ = FetchStatsForAssessmentsAsync();
        }
        catch (Exception)
        {
            ShowToast("Error fetching assessments.", error: true);
        }
    }

    private void AddDashboardItems<T>(List<T>? list, string level, string type)
    {
        if (list == null) return;
        foreach (var item in list)
        {
            long id = 0;
            long subjectId = 0;
            string title = "";
            double maxScore = 100;
            double weight = 0.20;
            long? teacherId = null;
            string term = "Term 1";
            int? termYear = null;
            string? subjectName = null;
            int? assessmentForm = null;
            string? assessmentClassName = null;

            if (item is AssignmentsDTO a)
            {
                id = a.Id ?? 0;
                subjectId = a.SubjectId ?? 0;
                title = a.Title ?? "";
                maxScore = a.MaxScore;
                weight = a.Weight;
                teacherId = a.TeacherId;
                term = a.Term ?? ResolveTermFromDate(a.DueDate); termYear = a.TermYear ?? a.DueDate?.Year;
                subjectName = a.SubjectName?.Trim();
                assessmentForm = a.Form;
                assessmentClassName = a.ClassName;
            }
            else if (item is TestsDTO t)
            {
                id = t.Id ?? 0;
                subjectId = t.SubjectId ?? 0;
                title = t.Title ?? "";
                maxScore = t.MaxScore;
                weight = t.Weight;
                teacherId = t.TeacherId;
                term = t.Term ?? ResolveTermFromDate(t.TestDate); termYear = t.TermYear ?? t.TestDate?.Year;
                subjectName = t.SubjectName?.Trim();
                assessmentForm = t.Form;
                assessmentClassName = t.ClassName;
            }
            else if (item is ExamsDTO e)
            {
                id = e.Id ?? 0;
                subjectId = e.SubjectId ?? 0;
                title = e.Title ?? "";
                maxScore = e.MaxScore;
                weight = e.Weight;
                teacherId = e.TeacherId;
                term = e.Term ?? ResolveTermFromDate(e.ExamDate); termYear = e.TermYear ?? e.ExamDate?.Year;
                subjectName = e.SubjectName?.Trim();
                assessmentForm = e.Form;
                assessmentClassName = e.ClassName;
            }

            if (id == 0) continue;

            string field = "";

            if (string.IsNullOrWhiteSpace(subjectName) && string.Equals(level, "alevel", StringComparison.OrdinalIgnoreCase))
            {
                alevelSubjectIdToNameMap.TryGetValue(subjectId, out subjectName);
            }

            if (!string.IsNullOrWhiteSpace(subjectName) &&
                !allDashboardSubjects.Contains(subjectName, StringComparer.OrdinalIgnoreCase))
                allDashboardSubjects.Add(subjectName);

            allAssessments.Add(new DashboardAssessmentModel
            {
                Id = id,
                RealId = id,
                SubjectId = subjectId,
                Title = title,
                MaxScore = maxScore,
                Weight = weight,
                TeacherId = teacherId,
                Level = level,
                Type = type,
                SubjectName = subjectName ?? $"Subject ID #{subjectId}",
                Field = "",
                Term = term,
                TermYear = termYear,
                Form = assessmentForm,
                ClassName = assessmentClassName,
                TotalCount = 0
            });
        }
    }

    private static string ResolveTermFromDate(DateOnly? date) => date?.Month switch
    {
        null => "Term 1",
        1 or 2 or 3 or 4 => "Term 1",
        5 or 6 or 7 or 8 => "Term 2",
        _ => "Term 3"
    };

    private int CalculateTotalEligibleStudents(DashboardAssessmentModel assessment)
    {
        if (!allStudents.Any()) return 0;
        int form = assessment.Form ?? GetDefaultFormForLevel(assessment.Level);
        var cohort = allStudents.Where(s => s.Form == form);
        if (!string.IsNullOrWhiteSpace(assessment.ClassName))
            cohort = cohort.Where(s => ClassMatchesFormAndName(s.Classroom, form, assessment.ClassName));

        if (assessment.Level == "alevel")
        {
            if (string.IsNullOrWhiteSpace(assessment.SubjectName)) return 0;
            var eligibleStudentIds = alevelChoices
                .Where(c => c.Subjects != null && c.Subjects.Any(sub => string.Equals(sub.Trim(), assessment.SubjectName.Trim(), StringComparison.OrdinalIgnoreCase)))
                .Select(c => c.StudentId)
                .ToHashSet();
            return cohort.Count(s => eligibleStudentIds.Contains((long)s.Id));
        }

        // Forms 1–4 subjects are configured per class. The dashboard card is
        // therefore measured against the selected class cohort; student-level
        // subject overrides are resolved when the mark sheet is opened.
        return cohort.Count();
    }

    private void ApplyFilters()
    {
        if (currentTeacherId <= 0)
        {
            filteredAssessments = new();
            return;
        }

        var temp = allAssessments.Where(a => a.TeacherId == currentTeacherId);

        if (!string.IsNullOrWhiteSpace(searchTitle))
        {
            temp = temp.Where(a => a.Title.Contains(searchTitle, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filterLevel))
        {
            temp = temp.Where(a => string.Equals(a.Level, filterLevel, StringComparison.OrdinalIgnoreCase));
        }

        if (filterForm > 0)
        {
            string formLevel = filterForm switch
            {
                >= 1 and <= 4 => "form1to4",
                >= 5 and <= 6 => "alevel",
                _ => ""
            };
            temp = temp.Where(a => string.Equals(a.Level, formLevel, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filterSubject))
        {
            temp = temp.Where(a => string.Equals(a.SubjectName, filterSubject, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filterType))
        {
            temp = temp.Where(a => string.Equals(a.Type, filterType, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filterTerm))
        {
            temp = temp.Where(a => string.Equals(a.Term, filterTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filterClass))
        {
            string cls = filterClass.Trim().ToLowerInvariant();
            temp = temp.Where(a => {
                // Primary: if we have real classroom data from marks, use it directly
                if (a.Classrooms.Any())
                {
                    int markedForm = filterForm > 0 ? filterForm : GetDefaultFormForLevel(a.Level);
                    return a.Classrooms.Any(c => ClassMatchesFormAndName(c, markedForm, filterClass));
                }

                // Fallback: use the explicit form filter when available. This
                // avoids guessing from a code such as 1A or 3B.
                int targetForm = filterForm > 0 ? filterForm : GetDefaultFormForLevel(a.Level);
                string classLevel = targetForm switch
                {
                    >= 1 and <= 4 => "form1to4",
                    >= 5 and <= 6 => "alevel",
                    _ => ""
                };

                if (!string.Equals(a.Level, classLevel, StringComparison.OrdinalIgnoreCase))
                    return false;

                if (classLevel == "alevel")
                {
                    var studentsInClass = allStudents.Where(s => s.Form == targetForm && ClassMatchesFormAndName(s.Classroom, targetForm, filterClass)).Select(s => (long)s.Id).ToHashSet();
                    return alevelChoices.Any(c => studentsInClass.Contains(c.StudentId) && 
                        c.Subjects != null && c.Subjects.Any(sub => string.Equals(sub, a.SubjectName, StringComparison.OrdinalIgnoreCase)));
                }

                var studentsInForm14Class = allStudents
                    .Where(s => s.Form == targetForm && ClassMatchesFormAndName(s.Classroom, targetForm, filterClass))
                    .Select(s => (long)s.Id);
                return studentsInForm14Class.Any(studentId => StudentHasForm1to4Subject(studentId, a.SubjectName));
            });
        }

        filteredAssessments = temp.ToList();
    }

    private async Task FetchStatsForAssessmentsAsync()
    {
        using var limiter = new SemaphoreSlim(6);
        var tasks = allAssessments.Select(async assessment =>
        {
            await limiter.WaitAsync();
            try
            {
                if (assessment.Type == "assignment")
                {
                    var marks = await AssessmentService.GetMarksByAssignmentAsync(assessment.RealId);
                    PopulateStatsFromMarks(assessment, marks);
                }
                else if (assessment.Type == "test")
                {
                    var marks = await AssessmentService.GetMarksByTestAsync(assessment.RealId);
                    PopulateStatsFromMarks(assessment, marks);
                }
                else if (assessment.Type == "exam")
                {
                    var marks = await AssessmentService.GetMarksByExamAsync(assessment.RealId);
                    PopulateStatsFromMarks(assessment, marks);
                }
            }
            catch { }
            finally { limiter.Release(); }
        }).ToList();

        await Task.WhenAll(tasks);
        StateHasChanged();
    }

    private void PopulateStatsFromMarks(DashboardAssessmentModel assessment, IEnumerable<object>? marks)
    {
        if (marks == null || !marks.Any())
        {
            assessment.GradedCount = 0;
            assessment.AverageScore = null;
            assessment.PassRate = 0;
            return;
        }

        List<double> scores = new();
        assessment.Classrooms.Clear();
        foreach (var m in marks)
        {
            if (m is CourseworkDTO cw && cw.Score.HasValue)
            {
                scores.Add(cw.Score.Value);
                var student = allStudents.FirstOrDefault(s => (long)s.Id == cw.StudentId);
                if (student?.Classroom != null) assessment.Classrooms.Add(student.Classroom);
            }
            else if (m is ExamMarkDTO ex && ex.Score.HasValue)
            {
                scores.Add(ex.Score.Value);
                var student = allStudents.FirstOrDefault(s => (long)s.Id == ex.StudentId);
                if (student?.Classroom != null) assessment.Classrooms.Add(student.Classroom);
            }
        }

        assessment.TotalCount = CalculateTotalEligibleStudents(assessment);

        assessment.GradedCount = scores.Count;
        if (scores.Any())
        {
            assessment.AverageScore = scores.Average();
            // Scores from the DB are already percentages (0–100); compare against 50 directly
            int passCount = scores.Count(s => s >= 50.0);
            assessment.PassRate = (double)passCount / scores.Count;
        }
        else
        {
            assessment.AverageScore = null;
            assessment.PassRate = 0;
        }
    }

