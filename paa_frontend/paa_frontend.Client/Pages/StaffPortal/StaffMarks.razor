    // ── New assessment form ───────────────────────────────
    private AssignmentsDTO newAssessment = new() { MaxScore = 100, Weight = 0.50 };
    private double newAssessmentWeightPercent = 50;

    private async Task CreateAssessment()
    {
        if (string.IsNullOrWhiteSpace(newAssessment.Title) || newAssessmentWeightPercent is < 0 or > 100)
        {
            ShowToast("Weight must be between 0% and 100%", error: true);
            return;
        }

        // Assessments created from the staff portal must always belong to the
        // logged-in teacher. Previously a missing/unreadable localStorage userId
        // silently sent teacherId=null, creating records that the dashboard and
        // Step 2 correctly filtered out.
        if (currentTeacherId <= 0)
        {
            ShowToast("Your teacher profile could not be identified. Please sign in again and retry.", error: true);
            return;
        }

        newAssessment.Weight = newAssessmentWeightPercent / 100d;
        isCreating = true;

        try
        {
            // Build clean DTOs without SubjectId — the backend resolves it from subjectName
            bool ok = (setup.Level, setup.AssessmentType) switch
            {
                // A-Level
                ("alevel", "assignment") => await AssessmentService.AddAlevelAssignmentAsync(setup.SubjectName, new AssignmentsDTO { Title = newAssessment.Title, MaxScore = newAssessment.MaxScore, Weight = newAssessment.Weight, DueDate = GetSelectedTermDate(), TeacherId = currentTeacherId, Term = setup.Term, TermYear = setup.TermYear }),
                ("alevel", "test")       => await AssessmentService.AddAlevelTestAsync(setup.SubjectName, new TestsDTO { Title = newAssessment.Title, MaxScore = newAssessment.MaxScore, Weight = newAssessment.Weight, TestDate = GetSelectedTermDate(), TeacherId = currentTeacherId, Term = setup.Term, TermYear = setup.TermYear }),
                ("alevel", "exam")       => await AssessmentService.AddAlevelExamAsync(setup.SubjectName, new ExamsDTO { Title = newAssessment.Title, MaxScore = newAssessment.MaxScore, Weight = newAssessment.Weight, ExamDate = GetSelectedTermDate(), TeacherId = currentTeacherId, Term = setup.Term, TermYear = setup.TermYear }),

                // Unified Forms 1–4
                ("form1to4", "assignment") => await AssessmentService.AddForm1to4AssignmentAsync(setup.SubjectName, new AssignmentsDTO { Title = newAssessment.Title, MaxScore = newAssessment.MaxScore, Weight = newAssessment.Weight, DueDate = GetSelectedTermDate(), TeacherId = currentTeacherId, Form = setup.FormNumber, ClassName = setup.ClassName, Term = setup.Term, TermYear = setup.TermYear }),
                ("form1to4", "test")       => await AssessmentService.AddForm1to4TestAsync(setup.SubjectName, new TestsDTO { Title = newAssessment.Title, MaxScore = newAssessment.MaxScore, Weight = newAssessment.Weight, TestDate = GetSelectedTermDate(), TeacherId = currentTeacherId, Form = setup.FormNumber, ClassName = setup.ClassName, Term = setup.Term, TermYear = setup.TermYear }),
                ("form1to4", "exam")       => await AssessmentService.AddForm1to4ExamAsync(setup.SubjectName, new ExamsDTO { Title = newAssessment.Title, MaxScore = newAssessment.MaxScore, Weight = newAssessment.Weight, ExamDate = GetSelectedTermDate(), TeacherId = currentTeacherId, Form = setup.FormNumber, ClassName = setup.ClassName, Term = setup.Term, TermYear = setup.TermYear }),

                _ => false
            };

            if (ok)
            {
                showNewAssessmentModal = false;
                newAssessment = new() { MaxScore = 100, Weight = 0.50 };
                newAssessmentWeightPercent = 50;
                ShowToast("Assessment created — reloading list…");
                if (step == 0)
                {
                    await LoadDashboardDataAsync();
                }
                else
                {
                    await LoadAssessmentsAsync();
                }
            }
            else ShowToast("Failed to create assessment", error: true);
        }
        catch { ShowToast("Network error — check API connection", error: true); }
        finally { isCreating = false; }
    }

