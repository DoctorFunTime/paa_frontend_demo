    private List<MarkRow> markRows = new();

    /// <summary>
    /// Loads students eligible for the selected subject and class.
    /// Uses GetStudentsAsync (all pages) for all levels — avoids unreliable level-specific endpoints.
    /// A-Level additionally cross-references subject choices.
    /// </summary>
    private async Task<HashSet<long>> GetAssessmentStudentIdsAsync()
    {
        if (SelectedAssessment == null || SelectedAssessment.RealId <= 0)
            return new HashSet<long>();

        try
        {
            if (setup.AssessmentType == "exam")
            {
                var marks = await AssessmentService.GetMarksByExamAsync(SelectedAssessment.RealId);
                return marks?.Select(m => m.StudentId).ToHashSet() ?? new HashSet<long>();
            }

            var coursework = setup.AssessmentType == "assignment"
                ? await AssessmentService.GetMarksByAssignmentAsync(SelectedAssessment.RealId)
                : await AssessmentService.GetMarksByTestAsync(SelectedAssessment.RealId);
            return coursework?.Select(m => m.StudentId).ToHashSet() ?? new HashSet<long>();
        }
        catch
        {
            // The saved assessment context remains the fallback for a new
            // assessment or when its marks endpoint has no rows yet.
            return new HashSet<long>();
        }
    }

    private async Task LoadStudentsAsync()
    {
        isLoadingStudents = true;
        markRows.Clear();
        StateHasChanged();
        try
        {
            // Single source of truth: paginated GetStudentsAsync (now fetches all pages)
            var all = await StudentProfileService.GetStudentsAsync();

            // Match Teacher Analytics: when marks already exist, resolve the
            // cohort from the students attached to those marks rather than
            // relying on stale card/filter context.
            var markedStudentIds = await GetAssessmentStudentIdsAsync();
            if (markedStudentIds.Count > 0)
            {
                var markedStudents = all.Where(s => markedStudentIds.Contains((long)s.Id)).ToList();
                var resolvedForm = markedStudents
                    .Where(s => s.Form.HasValue)
                    .GroupBy(s => s.Form!.Value)
                    .OrderByDescending(g => g.Count())
                    .Select(g => (int?)g.Key)
                    .FirstOrDefault();
                if (resolvedForm.HasValue)
                    setup.FormNumber = resolvedForm.Value;

                var resolvedClass = markedStudents
                    .Where(s => !string.IsNullOrWhiteSpace(s.Classroom))
                    .GroupBy(s => s.Classroom!.Trim(), StringComparer.OrdinalIgnoreCase)
                    .OrderByDescending(g => g.Count())
                    .Select(g => g.Key)
                    .FirstOrDefault();
                if (!string.IsNullOrWhiteSpace(resolvedClass))
                    setup.ClassName = resolvedClass;
            }

            // Filter by the selected form and normalize the supported classroom formats
            // (A, 1A, 1-A, and Form 1 A) before applying the class boundary.
            var formStudents = all.Where(s => s.Form.GetValueOrDefault(0) == setup.FormNumber);

            // Further narrow by class if one was selected
            if (!string.IsNullOrWhiteSpace(setup.ClassName))
                formStudents = formStudents.Where(s => ClassMatchesFormAndName(s.Classroom, setup.FormNumber, setup.ClassName));

            var eligibleStudents = formStudents.ToList();
            var effectiveSubjectsByStudent = new Dictionary<long, HashSet<string>>();

            if (setup.FormNumber is >= 1 and <= 4)
            {
                // Class subjects are the default. Only an explicitly saved student
                // choice list can remove a subject for that student.
                var classSetup = await SubjectService.GetForm1to4ClassSubjectsAsync(setup.FormNumber, setup.ClassName);
                var classSubjects = new HashSet<string>(classSetup?.Subjects ?? new(), StringComparer.OrdinalIgnoreCase);
                var subjectTasks = eligibleStudents.ToDictionary(
                    s => (long)s.Id,
                    s => SubjectService.GetForm1to4StudentSubjectsAsync(s.Id));
                await Task.WhenAll(subjectTasks.Values);

                foreach (var student in eligibleStudents)
                {
                    var saved = subjectTasks.TryGetValue(student.Id, out var task) ? task.Result : null;
                    effectiveSubjectsByStudent[student.Id] = new HashSet<string>(
                        saved?.Subjects?.Any() == true ? saved.Subjects : classSubjects,
                        StringComparer.OrdinalIgnoreCase);
                }
            }

            if (setup.Level == "alevel")
            {
                // A-Level: only students who have this subject in their subject choices
                var choices = await SubjectService.GetStudentALevelSubjectChoicesAsync();
                var eligible = choices
                    .Where(c => c.Subjects != null && c.Subjects.Any(sub =>
                        string.Equals(sub, setup.SubjectName, StringComparison.OrdinalIgnoreCase)))
                    .Select(c => c.StudentId)
                    .ToHashSet();

                eligibleStudents = eligibleStudents.Where(s => eligible.Contains((long)s.Id)).ToList();
            }
            markRows = eligibleStudents.Select(s => new MarkRow
            {
                StudentId   = s.Id,
                StudentName = $"{s.FirstName} {s.LastName}".Trim(),
                NationalId  = s.NationalId ?? "",
                BlockReason = effectiveSubjectsByStudent.TryGetValue(s.Id, out var subjects) &&
                              !subjects.Contains(setup.SubjectName)
                    ? "Student opted out of this subject"
                    : ""
            }).ToList();

            // ── Pre-load existing marks so the table is never empty ─────────────
            if (SelectedAssessment != null)
            {
                if (setup.AssessmentType == "exam")
                {
                    var existing = await AssessmentService.GetMarksByExamAsync(SelectedAssessment.RealId);
                    if (existing != null && existing.Any())
                    {
                        var dict = existing.GroupBy(m => m.StudentId).ToDictionary(g => g.Key, g => g.First());
                        foreach (var row in markRows)
                        {
                            if (dict.TryGetValue(row.StudentId, out var hit))
                            {
                                // Prefer actualMark (raw) from the DTO; fall back to reverse-calculating
                                // from the percentage score only if actualMark is zero (legacy records).
                                row.Score = hit.ActualMark > 0
                                    ? Math.Round(hit.ActualMark, 2)
                                    : (hit.Score.HasValue && SelectedAssessment.MaxScore > 0
                                        ? Math.Round(hit.Score.Value / 100.0 * SelectedAssessment.MaxScore, 2)
                                        : null);
                                row.Feedback   = hit.Feedback ?? "";
                                row.IsExisting = true;
                                row.ExistingId = hit.Id ?? 0;
                            }
                        }
                    }
                }
                else
                {
                    List<CourseworkDTO>? existing = setup.AssessmentType == "assignment"
                        ? await AssessmentService.GetMarksByAssignmentAsync(SelectedAssessment.RealId)
                        : await AssessmentService.GetMarksByTestAsync(SelectedAssessment.RealId);

                    if (existing != null && existing.Any())
                    {
                        var dict = existing.GroupBy(m => m.StudentId).ToDictionary(g => g.Key, g => g.First());
                        foreach (var row in markRows)
                        {
                            if (dict.TryGetValue(row.StudentId, out var hit))
                            {
                                // Score on CourseworkDTO is a percentage (0–100); convert back to raw mark.
                                row.Score = hit.Score.HasValue && SelectedAssessment.MaxScore > 0
                                    ? Math.Round(hit.Score.Value / 100.0 * SelectedAssessment.MaxScore, 2)
                                    : null;
                                row.Feedback   = hit.Feedback ?? "";
                                row.IsExisting = true;
                                row.ExistingId = hit.Id ?? 0;
                            }
                        }
                    }
                }
            }

            // ── Check if marks for this term are already approved by admin ─────
            try
            {
                var reportCardTasks = markRows.Select(async r =>
                {
                    try
                    {
                        var cards = await AssessmentService.GetStudentReportCardsAsync(r.StudentId);
                        var cardForTerm = cards?.FirstOrDefault(c =>
                            string.Equals(c.Term, setup.Term, StringComparison.OrdinalIgnoreCase) &&
                            c.TermYear == setup.TermYear);
                        if (cardForTerm?.AdminApproved == true)
                        {
                            r.IsApproved = true;
                            if (string.IsNullOrWhiteSpace(r.BlockReason))
                                r.BlockReason = "Marks approved by Admin — locked";
                        }
                    }
                    catch { }
                }).ToList();
                await Task.WhenAll(reportCardTasks);
            }
            catch { }

            if (!markRows.Any())
                ShowToast("No students matched this form and class.", error: false);
        }
        catch (Exception) { ShowToast("Could not load students.", error: true); }
        finally { isLoadingStudents = false; StateHasChanged(); }
    }

    // ── Toast helper ─────────────────────────────────────
    private async void ShowToast(string msg, bool error = false)
    {
        _toastCts?.Cancel();
        toastMsg = msg;
        toastIsError = error;
        StateHasChanged();
        _toastCts = new System.Threading.CancellationTokenSource();
        try
        {
            await Task.Delay(3500, _toastCts.Token);
            toastMsg = "";
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private bool IsInTerm(DateOnly date, string term)
    {
        var (s, e) = GradeHelper.TermMonthRange(term);
        int m = date.Month;
        return s <= e ? (m >= s && m <= e) : (m >= s || m <= e);
    }

    private DateOnly GetSelectedTermDate()
    {
        var (startMonth, _) = GradeHelper.TermMonthRange(setup.Term);
        return new DateOnly(setup.TermYear, startMonth, 1);
    }
