@page "/staff/marks"
@namespace paa_frontend.Client.Pages.Staff
@layout paa_frontend.Client.Layout.StaffPortalLayout
@using paa_frontend.Client.Services.StaffPortal
@using paa_frontend.Client.Services.Admin
@using paa_frontend.Shared.Models
@using paa_frontend.Client.Services
@using static paa_frontend.Shared.Models.Admin.AlevelClassesModel
@using static paa_frontend.Shared.Models.Admin.OlevelClassesModel
@using static paa_frontend.Shared.Models.Admin.Form1and2Model
@inject AssessmentServiceClient AssessmentService
@inject StudentProfileServiceClient StudentProfileService
@inject StudentSubjectServiceClient SubjectService
@inject AlevelClassServiceClient AClassService
@inject OlevelClassServiceClient OClassService
@inject AdminGradesServiceClient GradesService
@inject NavigationManager Nav
@inject paa_frontend.Client.Services.Auth.CustomAuthStateProvider AuthState
@inject IJSRuntime JS

<CascadingValue Name="PageTitle" Value="@pageTitle">

<style>
@@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');
:root {
    --blue:#4f46e5;--blue-dim:#eef2ff;--ink:#0f172a;--ink2:#475569;--ink3:#94a3b8;
    --bg:#f8fafc;--card:#ffffff;--green:#16a34a;--green-dim:#dcfce7;
    --amber:#d97706;--amber-dim:#fef3c7;--red:#e11d48;--red-dim:#fee2e2;
    --border:#e2e8f0;--shadow:0 4px 6px -1px rgba(0,0,0,0.05),0 2px 4px -1px rgba(0,0,0,0.03);
    --radius:20px; font-family:'Sora',sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--ink);}
a{text-decoration:none;color:inherit;}
input,select,button,textarea{font-family:'Sora',sans-serif;}

.page-wrap{padding:28px 32px;max-width:1400px;margin:0 auto;overflow-x:hidden;}
.breadcrumb{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--ink3);margin-bottom:20px;}
.breadcrumb a{color:var(--ink3);} .breadcrumb a:hover{color:var(--blue);}
.breadcrumb-sep{color:var(--border);}

.page-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:24px;gap:16px;flex-wrap:wrap;}
.page-title{font-size:22px;font-weight:700;color:var(--ink);letter-spacing:-0.5px;margin-bottom:3px;}
.page-sub{font-size:13px;color:var(--ink3);}

.btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:11px 20px;min-height:44px;background:var(--blue);color:white;border:none;border-radius:12px;font-size:13.5px;font-weight:700;cursor:pointer;transition:all 0.15s;}
.btn-primary:hover:not(:disabled){background:#4338ca;transform:translateY(-1px);box-shadow:0 4px 12px rgba(79,70,229,0.25);}
.btn-primary:disabled{opacity:0.5;cursor:not-allowed;transform:none;}
.btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:10px 16px;min-height:44px;background:var(--card);color:var(--ink2);border:1.5px solid var(--border);border-radius:12px;font-size:13.5px;font-weight:700;cursor:pointer;transition:all 0.15s;}
.btn-ghost:hover{background:var(--bg);border-color:#cbd5e1;color:var(--ink);}
.btn-danger{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:var(--red-dim);color:var(--red);border:1px solid transparent;border-radius:9px;font-size:12px;font-weight:700;cursor:pointer;transition:all 0.15s;}
.btn-danger:hover{background:var(--red);color:white;}

/* hero header */
.hero{background:linear-gradient(135deg,#1e1b4b 0%,#312e81 45%,#4338ca 100%);border-radius:24px;padding:26px 30px;color:#fff;margin-bottom:22px;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 80% 20%,rgba(255,255,255,0.08) 0%,transparent 60%);}
.hero-eyebrow{display:inline-block;padding:4px 12px;border-radius:999px;background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.2);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px;}
.hero-title{font-size:24px;font-weight:800;letter-spacing:-0.5px;margin-bottom:4px;}
.hero-sub{font-size:13px;color:rgba(255,255,255,0.8);font-weight:500;max-width:520px;}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap;position:relative;z-index:1;}
.hero .btn-ghost{background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.25);color:#fff;}
.hero .btn-ghost:hover{background:rgba(255,255,255,0.2);}

/* step tabs */
.step-tabs{display:flex;gap:4px;border-bottom:1px solid var(--border);margin-bottom:28px;position:sticky;top:0;background:var(--bg);z-index:20;padding-top:4px;}
.step-tab{display:flex;align-items:center;gap:8px;padding:13px 20px;min-height:44px;border:none;background:transparent;font-size:12.5px;font-weight:800;text-transform:uppercase;letter-spacing:0.04em;color:var(--ink3);cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-1px;font-family:'Sora',sans-serif;transition:all 0.15s;white-space:nowrap;}
.step-tab:hover{color:var(--ink2);}
.step-tab.active{color:var(--blue);border-bottom-color:var(--blue);}
.step-num{width:20px;height:20px;border-radius:50%;background:rgba(0,0,0,0.06);font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;color:var(--ink3);text-transform:none;}
.step-tab.active .step-num{background:var(--blue);color:white;}
.step-tab.done .step-num{background:var(--green);color:white;}
.step-tab.done{color:var(--ink2);}
.step-progress-mobile{display:none;font-size:11px;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:0.05em;margin:0 0 10px;}

/* two-col layout */
.two-col{display:grid;grid-template-columns:320px 1fr;gap:24px;align-items:start;}
.panel-card{background:var(--card);border-radius:var(--radius);border:1px solid var(--border);padding:22px;box-shadow:var(--shadow);}
.panel-title{font-size:13px;font-weight:800;color:var(--ink);margin-bottom:14px;text-transform:uppercase;letter-spacing:0.04em;}
.form-group{margin-bottom:16px;}
.form-label{font-size:11px;font-weight:800;color:var(--ink2);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:7px;display:block;}
.form-control{width:100%;padding:11px 14px;min-height:44px;border:1.5px solid var(--border);border-radius:12px;font-size:14px;color:var(--ink);background:var(--card);outline:none;transition:all 0.15s;}
.form-control:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(79,70,229,0.1);}
.form-control:disabled{background:var(--bg);color:var(--ink3);cursor:not-allowed;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.form-hint{font-size:11.5px;color:var(--ink3);margin-top:5px;}

/* assessment list */
.assessment-list{display:flex;flex-direction:column;gap:8px;}
.assessment-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;border:1.5px solid var(--border);cursor:pointer;transition:all 0.12s;background:transparent;}
.assessment-item:hover{border-color:rgba(26,79,255,0.3);background:var(--blue-dim);}
.assessment-item.active{border-color:var(--blue);background:var(--blue-dim);}
.ai-type{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;}
.ai-info{flex:1;min-width:0;}
.ai-title{font-size:12.5px;font-weight:500;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.ai-meta{font-size:10.5px;color:var(--ink3);margin-top:1px;font-family:'JetBrains Mono',monospace;}
.ai-weight{font-size:11px;color:var(--ink3);flex-shrink:0;font-family:'JetBrains Mono',monospace;}

/* marks table */
.marks-table-wrap{background:var(--card);border-radius:var(--radius);border:1px solid var(--border);overflow:visible;box-shadow:var(--shadow);}
.marks-table-scroll{overflow:hidden;border-radius:var(--radius) var(--radius) 0 0;}
.marks-table{width:100%;border-collapse:collapse;}
.marks-table th{padding:10px 14px;text-align:left;font-size:10.5px;font-weight:600;color:var(--ink3);text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border);background:rgba(0,0,0,0.01);}
.marks-table td{padding:9px 14px;border-bottom:1px solid rgba(0,0,0,0.04);font-size:13px;color:var(--ink2);vertical-align:middle;}
.marks-table tbody tr:last-child td{border-bottom:none;}
.marks-table tbody tr:hover{background:rgba(26,79,255,0.015);}
.mark-input{width:90px;padding:6px 10px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-family:'JetBrains Mono',monospace;color:var(--ink);background:var(--bg);text-align:center;outline:none;transition:all 0.15s;}
.mark-input:focus{border-color:var(--blue);background:var(--card);}
.mark-input.grade-a{border-color:var(--green);background:var(--green-dim);color:#008a5a;}
.mark-input.grade-b{border-color:var(--blue);background:var(--blue-dim);color:var(--blue);}
.mark-input.grade-c{border-color:var(--blue);background:rgba(26,79,255,0.06);color:var(--blue);}
.mark-input.grade-d{border-color:var(--amber);background:var(--amber-dim);color:#9a6800;}
.mark-input.grade-e{border-color:var(--amber);background:rgba(245,158,11,0.06);color:#9a6800;}
.mark-input.grade-u{border-color:var(--red);background:var(--red-dim);color:var(--red);}
.feedback-input{width:100%;padding:6px 10px;border:1.5px solid var(--border);border-radius:8px;font-size:12px;color:var(--ink);background:var(--bg);outline:none;}
.feedback-input:focus{border-color:var(--blue);background:var(--card);}

.pill{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:999px;font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:0.04em;}
.pill-green{background:var(--green-dim);color:#15803d;}
.pill-blue{background:var(--blue-dim);color:var(--blue);}
.pill-amber{background:var(--amber-dim);color:#b45309;}
.pill-red{background:var(--red-dim);color:var(--red);}
.pill-gray{background:#f1f5f9;color:var(--ink3);}

.submit-bar{position:sticky;bottom:0;z-index:15;background:rgba(255,255,255,0.92);backdrop-filter:blur(8px);border-top:1px solid var(--border);border-radius:0 0 var(--radius) var(--radius);}
.summary-bar{display:flex;gap:20px;padding:14px 20px;flex-wrap:wrap;}
.sb-item{display:flex;flex-direction:column;gap:2px;}
.sb-label{font-size:10px;color:var(--ink3);font-weight:700;text-transform:uppercase;letter-spacing:0.5px;}
.sb-val{font-size:15px;font-weight:700;color:var(--ink);font-family:'JetBrains Mono',monospace;}

.toast{position:fixed;bottom:24px;right:24px;padding:13px 18px;border-radius:12px;font-size:13px;font-weight:500;display:flex;align-items:center;gap:8px;box-shadow:0 8px 32px rgba(0,0,0,0.15);z-index:999;animation:slideIn 0.2s ease;}
.toast-success{background:var(--green);color:white;}
.toast-error{background:var(--red);color:white;}
.screen-loader{position:fixed;inset:0;background:rgba(15,23,42,0.42);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;z-index:2000;color:white;}
.screen-loader-card{display:flex;align-items:center;gap:12px;background:rgba(15,23,42,0.94);border-radius:14px;padding:18px 22px;box-shadow:0 16px 45px rgba(0,0,0,0.25);font-size:13px;font-weight:600;}
.screen-loader-spinner{width:20px;height:20px;border:3px solid rgba(255,255,255,0.35);border-top-color:white;border-radius:50%;animation:spin 0.8s linear infinite;}
@@keyframes spin{to{transform:rotate(360deg)}}
@@keyframes slideIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}

/* modal */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:500;display:flex;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(2px);}
.modal{background:var(--card);border-radius:var(--radius);padding:24px;max-width:480px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,0.2);}
.modal-title{font-size:16px;font-weight:600;color:var(--ink);margin-bottom:16px;}
.modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:20px;}

.empty-state{text-align:center;padding:48px 20px;color:var(--ink3);}
.skeleton{background:linear-gradient(90deg,#e2e8f0 25%,#f8fafc 37%,#e2e8f0 63%);background-size:400% 100%;animation:marksSkeleton 1.4s ease infinite;border-radius:12px;}
.marks-dashboard-skeleton{display:grid;gap:16px;}
.workflow-loading-block{display:flex;align-items:center;gap:14px;padding:24px;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);color:var(--ink2);font-size:13px;font-weight:600;}
.workflow-spinner{width:24px;height:24px;border:3px solid var(--border);border-top-color:var(--blue);border-radius:50%;animation:staff-spin .8s linear infinite;flex-shrink:0;}
@@keyframes staff-spin{to{transform:rotate(360deg)}}
.marks-skeleton-hero{height:150px;border-radius:24px;}
.marks-skeleton-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.marks-skeleton-stat{height:116px;border-radius:18px;}
.marks-skeleton-list{height:300px;border-radius:20px;}
@@keyframes marksSkeleton{0%{background-position:100% 0;}100%{background-position:-100% 0;}}
.empty-icon{margin:0 auto 14px;width:48px;height:48px;background:rgba(0,0,0,0.04);border-radius:12px;display:flex;align-items:center;justify-content:center;}

@@keyframes fadeUp{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
.a1{animation:fadeUp .3s ease both;}
.a2{animation:fadeUp .3s .06s ease both;}
.a3{animation:fadeUp .3s .12s ease both;}

@@media(max-width:900px){
    .page-wrap{padding:14px 12px;}
    .page-header{align-items:flex-start;}
    .hero{padding:20px;border-radius:20px;}
    .hero-title{font-size:20px;}
    .hero-actions{width:100%;}
    .hero-actions .btn-ghost{flex:1;}
    .step-tabs{overflow-x:auto;white-space:nowrap;padding-bottom:6px;scrollbar-width:none;-ms-overflow-style:none;margin-bottom:6px;}
    .step-tabs::-webkit-scrollbar{display:none;}
    .step-tab{flex:0 0 auto;padding:10px 14px;}
    .step-progress-mobile{display:block;}
    .two-col{grid-template-columns:1fr;}
    .form-row{grid-template-columns:1fr;}
    .assessment-list{gap:10px;}
    .assessment-item{align-items:flex-start;flex-wrap:wrap;}
    .assessment-item .btn-ghost{margin-left:0 !important;}
    .assessment-dashboard-card{padding:16px !important;}
    .assessment-dashboard-card > div:last-child{flex-direction:column;gap:8px;}
    .assessment-dashboard-card .btn-primary,
    .assessment-dashboard-card .btn-ghost{width:100%;justify-content:center;}
    .assessment-dashboard-card .btn-ghost{margin-right:0 !important;}
    .assessments-grid{grid-template-columns:1fr !important;}
    .summary-bar{gap:12px;padding:12px 14px;}
    .marks-skeleton-stats{grid-template-columns:1fr;}
    .summary-bar .sb-item{min-width:calc(50% - 6px);}
    .marks-table-wrap{
        background:transparent;
        border:none;
        box-shadow:none;
        overflow:visible;
    }
    .marks-table,
    .marks-table thead,
    .marks-table tbody,
    .marks-table tr,
    .marks-table td{display:block;width:100%;}
    .marks-table thead{display:none;}
    .marks-table tbody tr{
        margin:12px 8px;
        border:1px solid var(--border);
        border-radius:12px;
        overflow:hidden;
        background:var(--card);
        box-shadow:var(--shadow);
    }
    .marks-table td{
        display:flex;
        align-items:flex-start;
        justify-content:space-between;
        gap:12px;
        padding:12px 16px;
        overflow-wrap:anywhere;
        word-break:break-word;
        min-width:0;
    }
    .marks-table td::before{
        content:attr(data-label);
        flex:0 0 38%;
        font-size:10px;
        font-weight:600;
        text-transform:uppercase;
        letter-spacing:0.5px;
        color:var(--ink3);
        padding-top:3px;
    }
    .marks-table td > *{
        flex:1;
        min-width:0;
    }
    /* Score + % sit side by side on mobile to save vertical space */
    .marks-table td[data-label^="Score"],
    .marks-table td[data-label="%"]{
        display:inline-flex;
        width:50%;
        border-bottom:none;
    }
    .marks-table td[data-label="%"]{
        border-bottom:1px solid rgba(0,0,0,0.04);
    }
    .mark-input,
    .feedback-input{
        width:100%;
        min-height:44px;
    }
    .feedback-input{
        min-height:44px;
    }
    .submit-bar{
        margin:0 -12px;
        padding:0 12px;
        box-shadow:0 -4px 16px rgba(0,0,0,0.06);
    }
    .summary-bar{padding:12px 4px 4px;}
    .summary-bar .sb-item{min-width:calc(50% - 10px);}
    .panel-card{padding:16px;}
    .modal{padding:18px;}
    .dropzone{padding:20px !important;}
}

@@media(max-width:600px){
    .page-wrap{padding:12px 8px;}
    .hero{padding:18px 16px;border-radius:18px;}
    .hero-title{font-size:19px;}
    .hero-actions{display:grid;grid-template-columns:1fr;gap:8px;}
    .hero-actions .btn-primary,.hero-actions .btn-ghost{width:100%;}
    .step-tabs{margin-left:-8px;margin-right:-8px;padding-left:4px;padding-right:4px;}
    .step-tab{font-size:10.5px;padding:10px 12px;letter-spacing:.02em;}
    .panel-card{padding:14px;border-radius:16px;}
    .assessment-item{padding:11px 10px;}
    .marks-table tbody tr{margin:10px 0;border-radius:10px;}
    .marks-table td{padding:10px 12px;gap:8px;}
    .marks-table td::before{flex-basis:34%;font-size:9px;}
    .summary-bar{gap:10px;}
    .summary-bar .sb-item{min-width:calc(50% - 8px);}
}

@@media(max-width:900px){
    .two-col{grid-template-columns:1fr;}
    .form-row{grid-template-columns:1fr;}
    .page-wrap{padding:16px;}
}
.assessment-dashboard-card:hover {
    transform: translateY(-3px);
    border-color: var(--blue) !important;
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
}
@@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
</style>

<div class="page-wrap">
    @if (isOpeningMarks)
    {
        <div class="screen-loader" role="status" aria-live="polite">
            <div class="screen-loader-card"><span class="screen-loader-spinner"></span>Loading marks table…</div>
        </div>
    }

    <!-- Breadcrumb -->
    <div class="breadcrumb a1">
        <a href="/staff">Staff Portal</a>
        <span class="breadcrumb-sep">›</span>
        <span style="color:var(--ink2);">Enter Marks</span>
    </div>

    <!-- Hero header (matches Admin Marks Review styling) -->
    <div class="hero a1">
        <div style="position:relative;z-index:1;display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;">
            <div>
                <span class="hero-eyebrow">Staff Portal</span>
                <div class="hero-title">Enter Marks</div>
                <div class="hero-sub">Create assessments and record student scores for assignments, tests, and exams. Admin reviews and approves marks once submitted.</div>
            </div>
            <div class="hero-actions">

                <button class="btn-primary" @onclick='() => showNewAssessmentModal = true'>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    New Assessment
                </button>
            </div>
        </div>
    </div>

    <!-- Primary staff marks areas -->
    <div class="step-tabs a2">
        <button class="step-tab @(step == 0 ? "active" : "")" @onclick="() => { step = 0; cameFromDashboard = false; }">Edit Marks</button>
        <button class="step-tab @(step > 0 ? "active" : "")" @onclick="GoToStep1ForNewAssessment">Assessment Setup</button>
    </div>

    <!-- Assessment setup steps -->
    @{
        int currentStepNum = step == 0 ? 0 : (cameFromDashboard && step == 3 ? 2 : step);
        int totalSteps = cameFromDashboard ? 2 : 3;
    }
    @if (step > 0)
    {
        <div class="step-progress-mobile">Step @currentStepNum of @totalSteps</div>
    }
    @if (step > 0)
    {
    <div class="step-tabs a2">
        <button class="step-tab @(step >= 1 && !cameFromDashboard ? (step > 1 ? "done" : "active") : "")" @onclick="() => { step = 1; cameFromDashboard = false; }">
            <span class="step-num">@(step > 1 && !cameFromDashboard ? "✓" : "1")</span>
            Setup
        </button>
        <button class="step-tab @(step >= 2 && !cameFromDashboard ? (step > 2 ? "done" : "active") : "")" @onclick="() => { if(step > 1) { step = 2; cameFromDashboard = false; } }">
            <span class="step-num">@(step > 2 && !cameFromDashboard ? "✓" : "2")</span>
            Select Assessment
        </button>
        <button class="step-tab @(step >= 3 ? "active" : "")" @onclick="() => { if(step > 2) step = 3; }">
            <span class="step-num">@(cameFromDashboard ? "2" : "3")</span>
            Enter &amp; Submit Marks
        </button>
    </div>
    }

    @if (isOpeningMarks || isLoadingStudents)
    {
        <div class="workflow-loading-block a3" role="status" aria-live="polite">
            <span class="workflow-spinner"></span>
            <span>@(isOpeningMarks ? "Preparing the marks editor…" : "Loading the student mark sheet…")<small style="display:block;color:var(--ink3);font-weight:500;margin-top:3px;">Your selections are being loaded. This may take a moment on a slow connection.</small></span>
        </div>
    }

    <!-- ══ STEP 0: MY ASSESSMENTS DASHBOARD ══ -->
    @if (step == 0)
    {
        <div class="a3">
            @if (isLoadingDashboard)
            {
                <div class="marks-dashboard-skeleton" aria-label="Loading assessments dashboard" role="status">
                    <div class="skeleton marks-skeleton-hero"></div>
                    <div class="marks-skeleton-stats">
                        <div class="skeleton marks-skeleton-stat"></div>
                        <div class="skeleton marks-skeleton-stat"></div>
                        <div class="skeleton marks-skeleton-stat"></div>
                    </div>
                    <div class="skeleton marks-skeleton-list"></div>
                </div>
            }
            else
            {
                <!-- Stats row -->
                <div class="stats-row" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 28px;">
                    <div class="stat-card" style="background: linear-gradient(135deg, #4338ca, var(--blue)); color: white; border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); position: relative; overflow: hidden;">
                        <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.85;">Total Assessments</div>
                        <div style="font-size: 32px; font-weight: 700; margin-top: 8px; font-family: 'JetBrains Mono', monospace;">@filteredAssessments.Count</div>
                        <div style="font-size: 12px; margin-top: 4px; opacity: 0.75;">@(string.IsNullOrWhiteSpace(filterClass) ? $"{allAssessments.Count(a => a.TeacherId == currentTeacherId)} created by you" : $"in {filterClass}")</div>
                        <div style="position: absolute; right: -10px; bottom: -10px; opacity: 0.15;">
                            <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/></svg>
                        </div>
                    </div>
                    <div class="stat-card" style="background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); position: relative; overflow: hidden;">
                        <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--ink3);">Average Class Score</div>
                        <div style="font-size: 32px; font-weight: 700; margin-top: 8px; color: var(--ink); font-family: 'JetBrains Mono', monospace;">
                            @(filteredAssessments.Where(a => a.AverageScore.HasValue).Select(a => a.AverageScore!.Value).DefaultIfEmpty(0).Average().ToString("F1"))%
                        </div>
                        <div style="font-size: 12px; margin-top: 4px; color: var(--ink3);">@(string.IsNullOrWhiteSpace(filterClass) ? "Across all graded student marks" : $"Filtered to {filterClass}")</div>
                        <div style="position: absolute; right: -10px; bottom: -10px; opacity: 0.05; color: var(--ink);">
                            <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
                        </div>
                    </div>
                    <div class="stat-card" style="background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); position: relative; overflow: hidden;">
                        <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--ink3);">Completion Rate</div>
                        <div style="font-size: 32px; font-weight: 700; margin-top: 8px; color: var(--ink); font-family: 'JetBrains Mono', monospace;">
                            @{
                                int totalEligible = filteredAssessments.Sum(a => a.TotalCount);
                                int totalGraded = filteredAssessments.Sum(a => a.GradedCount);
                                double completion = totalEligible > 0 ? (double)totalGraded / totalEligible * 100 : 0;
                            }
                            @completion.ToString("F0")%
                        </div>
                        <div style="font-size: 12px; margin-top: 4px; color: var(--ink3);">@totalGraded / @totalEligible total grades recorded</div>
                        <div style="position: absolute; right: -10px; bottom: -10px; opacity: 0.05; color: var(--ink);">
                            <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                        </div>
                    </div>
                </div>

                <!-- Filters panel -->
                <div class="panel-card" style="margin-bottom: 24px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:16px;">
                        <div class="panel-title" style="margin-bottom:0; font-size:14px;">Filters &amp; Search</div>
                        <button class="btn-ghost" style="font-size:11px; padding:4px 8px; flex-shrink:0;" @onclick="ResetDashboardFilters">Clear Filters</button>
                    </div>
                    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; align-items: end;">
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label">Search Title</label>
                            <input class="form-control" type="text" placeholder="Search by title…" @bind="searchTitle" @bind:after="ApplyFilters" />
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label">Form</label>
                            <select class="form-control" @bind="filterForm" @bind:after="OnFilterFormChanged">
                                <option value="0">— All Forms —</option>
                                <option value="1">Form 1</option>
                                <option value="2">Form 2</option>
                                <option value="3">Form 3</option>
                                <option value="4">Form 4</option>
                                <option value="5">Form 5</option>
                                <option value="6">Form 6</option>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label">Class</label>
                            <select class="form-control" @bind="filterClass" @bind:after="ApplyFilters">
                                <option value="">— All Classes —</option>
                                @foreach (var c in GetFilteredDashboardClasses())
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label">Subject</label>
                            <select class="form-control" @bind="filterSubject" @bind:after="ApplyFilters">
                                <option value="">— All Subjects —</option>
                                @foreach (var s in GetFilteredDashboardSubjects())
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label">Type</label>
                            <select class="form-control" @bind="filterType" @bind:after="ApplyFilters">
                                <option value="">— All Types —</option>
                                <option value="assignment">Assignment</option>
                                <option value="test">Test</option>
                                <option value="exam">Exam</option>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label">Term</label>
                            <select class="form-control" @bind="filterTerm" @bind:after="ApplyFilters">
                                <option value="">— All Terms —</option>
                                <option value="Term 1">Term 1</option>
                                <option value="Term 2">Term 2</option>
                                <option value="Term 3">Term 3</option>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0; display:flex; align-items:center; gap:8px; height: 38px;">
                            <input type="checkbox" id="myAssessmentsOnly" checked disabled style="width: 16px; height: 16px; accent-color: var(--blue);" />
                            <label for="myAssessmentsOnly" style="font-size: 12px; font-weight: 500; color: var(--ink2); cursor: default; user-select: none; margin: 0;">My Assessments Only</label>
                            <span class="pill pill-blue" style="font-size:10px;">Locked</span>
                        </div>
                    </div>
                </div>

                <!-- Assessments Grid -->
                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:16px;">
                    <div style="font-size:14px; font-weight:700; color:var(--ink);">Your Assessments</div>
                    <button class="btn-primary" style="padding:9px 16px; font-size:12.5px;" @onclick="GoToStep1ForNewAssessment">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Create Assignment / Test
                    </button>
                </div>
                @if (!filteredAssessments.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/></svg></div>
                        <div style="font-size:14px; font-weight:500; color:var(--ink2);">No assessments match your filters</div>
                        <div style="font-size:12px; margin-top:4px;">Try modifying your search or filters above.</div>
                    </div>
                }
                else
                {
                    <div class="assessments-grid" style="display:grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;">
                        @foreach (var a in filteredAssessments)
                        {
                            string typeBg = a.Type == "exam" ? "rgba(124,58,237,0.12)" : a.Type == "test" ? "rgba(245,158,11,0.12)" : "rgba(26,79,255,0.10)";
                            string typeColor = a.Type == "exam" ? "#7c3aed" : a.Type == "test" ? "#b45309" : "var(--blue)";
                            string levelLabel = a.Level == "alevel" ? "A-Level" : a.Level == "olevel" ? "O-Level" : "Junior";
                            string classLabel = GetAssessmentDisplayClass(a);
                            
                            <div class="panel-card assessment-dashboard-card" style="display:flex; flex-direction:column; justify-content:space-between; transition: all 0.2s; border-color: var(--border); cursor:pointer;" @onclick="() => OpenMarksFromDashboardAsync(a, classLabel)">
                                <div>
                                    <!-- Badges -->
                                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; gap:8px;">
                                        <span class="pill" style="background:@typeBg; color:@typeColor; text-transform:uppercase; font-weight:700; font-size:10px;">@a.Type</span>
                                        <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; justify-content:flex-end;">
                                            <span class="pill" style="background:var(--blue-dim); color:var(--blue); font-weight:700; font-size:10px;" title="Class: @classLabel">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align:-1px; margin-right:3px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                                @classLabel
                                            </span>
                                            <span style="font-size:11px; color:var(--ink3); font-weight:500;">@levelLabel</span>
                                        </div>
                                    </div>

                                    <!-- Subject & Title -->
                                    <div style="font-size:15px; font-weight:700; color:var(--ink); line-height: 1.3;">@a.Title</div>
                                    <div style="font-size:12px; color:var(--ink2); font-weight:500; margin-top:2px;">@a.SubjectName</div>

                                    <!-- Max Score and Weight -->
                                    <div style="display:flex; gap:16px; margin-top:12px; border-top:1px solid rgba(0,0,0,0.04); padding-top:12px; margin-bottom:14px;">
                                        <div>
                                            <div style="font-size:9px; text-transform:uppercase; color:var(--ink3); font-weight:600;">Max Score</div>
                                            <div style="font-size:14px; font-weight:600; color:var(--ink); font-family: 'JetBrains Mono', monospace;">@a.MaxScore pts</div>
                                        </div>
                                        <div>
                                            <div style="font-size:9px; text-transform:uppercase; color:var(--ink3); font-weight:600;">Weight</div>
                                            <div style="font-size:14px; font-weight:600; color:var(--ink); font-family: 'JetBrains Mono', monospace;">@((a.Weight * 100).ToString("F0"))%</div>
                                        </div>
                                    </div>

                                    <!-- Stats bar -->
                                    <div style="background: var(--bg); border-radius: 8px; padding: 10px 12px; margin-bottom:16px;">
                                        @if (a.GradedCount > 0)
                                        {
                                            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px;">
                                                <span style="font-size:11px; color:var(--ink2); font-weight:500;">Average</span>
                                                <span style="font-size:12px; font-weight:700; color:var(--ink); font-family: 'JetBrains Mono', monospace;">@(a.AverageScore?.ToString("F1") ?? "—")%</span>
                                            </div>
                                            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
                                                <span style="font-size:11px; color:var(--ink2); font-weight:500;">Pass Rate (≥50%)</span>
                                                <span class="pill @(a.PassRate >= 0.7 ? "pill-green" : a.PassRate >= 0.4 ? "pill-amber" : "pill-red")" style="font-weight:600; font-size:10px;">@((a.PassRate * 100).ToString("F0"))% pass</span>
                                            </div>
                                            
                                            <!-- Progress/Grading completeness -->
                                            <div>
                                                <div style="display:flex; justify-content:space-between; font-size:10px; color:var(--ink3); margin-bottom:3px;">
                                                    <span>Grading Progress</span>
                                                    <span>@a.GradedCount / @(a.TotalCount > 0 ? a.TotalCount.ToString() : "—") students</span>
                                                </div>
                                                @if (a.TotalCount > 0)
                                                {
                                                    <div style="height:4px; background:rgba(0,0,0,0.06); border-radius:2px; overflow:hidden;">
                                                        <div style="height:100%; width:@((double)a.GradedCount / a.TotalCount * 100)%; background:var(--green); border-radius:2px;"></div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="font-size:11px; color:var(--ink3); text-align:center; padding:4px 0; font-style:italic;">
                                                No marks submitted yet
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div style="display:flex; gap:8px; border-top: 1px solid rgba(0,0,0,0.04); padding-top:12px;">
                                    <button type="button" class="btn-primary" style="flex:1; justify-content:center; padding: 7px 12px; font-size: 12px;" @onclick:stopPropagation="true" @onclick="() => OpenMarksFromDashboardAsync(a, classLabel)">
                                        Enter / Edit Marks
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }

    <!-- ══ STEP 1: SETUP ══ -->
    @if (step == 1)
    {
        <div class="two-col a3">
            <div class="panel-card">
                <div class="panel-title">Assessment Context</div>

                <div class="form-group">
                    <label class="form-label">Form</label>
                    <select class="form-control" @bind="setup.FormNumber" @bind:after="OnFormChangedInternalAsync">
                        <option value="0">— Select Form —</option>
                        <option value="1">Form 1</option>
                        <option value="2">Form 2</option>
                        <option value="3">Form 3</option>
                        <option value="4">Form 4</option>
                        <option value="5">Form 5</option>
                        <option value="6">Form 6</option>
                    </select>
                    <div class="form-hint">
                        @if (setup.FormNumber >= 1 && setup.FormNumber <= 4)
                        { <span>Subjects come from the selected Form 1–4 class setup</span> }
                        else if (setup.FormNumber >= 5 && setup.FormNumber <= 6)
                        { <span>A-Level — subjects from A-Level catalogue</span> }
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Class</label>
                    @if (isLoadingClasses)
                    {
                        <select class="form-control" disabled><option>Loading classes…</option></select>
                    }
                    else
                    {
                        <select class="form-control" @bind="setup.ClassName" @bind:after="OnClassChangedInternalAsync">
                            <option value="">— Select Class —</option>
                            @foreach (var c in AvailableClasses)
                            {
                                <option>@c</option>
                            }
                        </select>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">Subject</label>
                    <select class="form-control" @bind="setup.SubjectName">
                        <option value="">— Select Subject —</option>
                        @foreach (var s in AvailableSubjects)
                        {
                            <option>@s</option>
                        }
                    </select>
                    @if (isLoadingSubjects)
                    {
                        <div class="form-hint" style="color:var(--blue);">Loading subjects…</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(subjectLoadError))
                    {
                        <div class="form-hint" style="color:var(--red);">@subjectLoadError</div>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">Assessment Type</label>
                    <select class="form-control" @bind="setup.AssessmentType">
                        <option value="assignment">Assignment</option>
                        <option value="test">Test</option>
                        <option value="exam">Exam</option>
                    </select>
                    <div class="form-hint">
                        @if (setup.AssessmentType == "exam")
                        { <span>Marks are stored as exam marks (separate from coursework)</span> }
                        else
                        { <span>Marks are stored as coursework and contribute to the term average</span> }
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Term</label>
                    <select class="form-control" @bind="setup.Term">
                        <option>Term 1</option>
                        <option>Term 2</option>
                        <option>Term 3</option>
                    </select>
                    @{
                        var (ms, me) = GradeHelper.TermMonthRange(setup.Term);
                    }
                    <div class="form-hint">Marks will be scoped to months @ms–@me</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Academic year</label>
                    <input class="form-control" type="number" min="2000" max="2100" @bind="setup.TermYear" />
                    <div class="form-hint">Used when saving and editing marks.</div>
                </div>

            </div>
            <div>
                <div class="panel-card" style="margin-bottom:16px;">
                    <div class="panel-title">What happens next</div>
                    <div style="display:flex;flex-direction:column;gap:10px;">
                        @{
                            var steps = new[] {
                                ("1", "Select an existing assessment or create a new one for this subject and term", "var(--blue)"),
                                ("2", "Enter each student's score — assignments & tests go to coursework; exams are stored separately", "var(--green)"),
                                ("3", "Submit marks — existing marks are updated, not duplicated; partial saves are allowed", "var(--amber)"),
                                ("4", "After submission the admin reviews your marks, generates the report card, and approves it for student view — you don't need to do anything further", "var(--ink3)"),
                            };
                        }
                        @foreach (var (n, desc, col) in steps)
                        {
                            <div style="display:flex;gap:12px;align-items:flex-start;">
                                <div style="width:24px;height:24px;border-radius:6px;background:@col;opacity:0.15;flex-shrink:0;margin-top:1px;"></div>
                                <div style="font-size:12.5px;color:var(--ink2);">@desc</div>
                            </div>
                        }
                    </div>
                </div>

                <div style="display:flex;justify-content:flex-end;margin-top:24px;">
                    <button class="btn-primary"
                            disabled="@(!IsStep1Valid || isLoadingAssessments)"
                            @onclick="GoToStep2Async">
                        @(isLoadingAssessments ? "Loading…" : "Continue — Select Assessment")
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ══ STEP 2: SELECT ASSESSMENT ══ -->
    @if (step == 2)
    {
        <div class="two-col a3">
            <div class="panel-card">
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:12px;">
                    <div class="panel-title" style="margin-bottom:0;">Available Assessments</div>
                    <button class="btn-ghost" style="font-size:11.5px;padding:6px 10px;flex-shrink:0;" @onclick='() => showNewAssessmentModal = true'>+ New</button>
                </div>
                <div style="font-size:11px;color:var(--ink3);margin-bottom:12px;">
                    @setup.SubjectName · @CapitaliseFirst(setup.AssessmentType) · @setup.Term
                </div>

                @if (!MockAssessments.Any())
                {
                    <div class="empty-state" style="padding:24px 0;">
                        <div class="empty-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/></svg></div>
                        <div style="font-size:13px;font-weight:500;color:var(--ink2);">No assessments yet</div>
                        <div style="font-size:12px;margin-top:4px;">Create one using the button above</div>
                    </div>
                }
                else
                {
                    <div class="assessment-list">
                        @foreach (var a in MockAssessments)
                        {
                            bool sel = selectedAssessmentId == a.Id;
                            string typeLabel = setup.AssessmentType == "exam" ? "EX" : setup.AssessmentType == "test" ? "T" : "A";
                            string typeBg = setup.AssessmentType == "exam" ? "rgba(124,58,237,0.15)" : setup.AssessmentType == "test" ? "rgba(245,158,11,0.15)" : "rgba(26,79,255,0.12)";
                            string typeColor = setup.AssessmentType == "exam" ? "#7c3aed" : setup.AssessmentType == "test" ? "#9a6800" : "var(--blue)";
                            <div class="assessment-item @(sel ? "active" : "")" @onclick="() => SelectAssessment(a.Id)">
                                <div class="ai-type" style="background:@typeBg;color:@typeColor;">@typeLabel</div>
                                <div class="ai-info">
                                    <div class="ai-title">@a.Title</div>
                                    <div class="ai-meta">max @a.MaxScore pts · weight @(a.Weight * 100)%</div>
                                </div>
                                @if (sel)
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div>
                @if (SelectedAssessment != null)
                {
                    <div class="panel-card" style="margin-bottom:16px;">
                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:12px;">
                            <div class="panel-title" style="margin-bottom:0;min-width:0;flex:1 1 auto;overflow-wrap:anywhere;">Selected: @SelectedAssessment.Title</div>
                        </div>
                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(90px,1fr));gap:12px;">
                            @{
                                var details = new[] {
                                    ("Max Score", SelectedAssessment.MaxScore.ToString("F0") + " pts"),
                                    ("Weight",    (SelectedAssessment.Weight * 100).ToString("F0") + "%"),
                                    ("Subject",   setup.SubjectName),
                                };
                            }
                            @foreach (var (dl, dv) in details)
                            {
                                <div style="padding:12px;background:var(--bg);border-radius:10px;">
                                    <div style="font-size:10px;color:var(--ink3);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">@dl</div>
                                    <div style="font-size:15px;font-weight:600;color:var(--ink);font-family:'JetBrains Mono',monospace;">@dv</div>
                                </div>
                            }
                        </div>
                        <div style="margin-top:12px;font-size:12px;color:var(--ink3);background:var(--blue-dim);border-radius:8px;padding:9px 12px;">
                            Scores will be submitted out of <strong style="color:var(--blue);">@SelectedAssessment.MaxScore</strong> — the weight is applied at report card generation.
                        </div>
                    </div>
                }

                <div style="display:flex;gap:8px;justify-content:space-between;">
                    <button class="btn-ghost" @onclick="() => step = 1">← Back</button>
                    <button class="btn-primary" disabled="@(selectedAssessmentId == 0 || isLoadingStudents)" @onclick="GoToStep3Async">
                        @(isLoadingStudents ? "Loading students…" : "Enter Marks")
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ══ STEP 3: ENTER & SUBMIT MARKS ══ -->
    @if (step == 3)
    {
        <div class="a3">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:10px;">
                <div>
                    <div style="font-size:15px;font-weight:600;color:var(--ink);">
                        @SelectedAssessment?.Title — @setup.SubjectName
                    </div>
                    <div style="font-size:12px;color:var(--ink3);margin-top:3px;">
                        @setup.Term · @setup.ClassName · Max score: @SelectedAssessment?.MaxScore pts · Weight: @((SelectedAssessment?.Weight ?? 0) * 100)%
                        · Date: @GetSelectedTermDate().ToString("dd MMM yyyy")
                        (term months @GradeHelper.TermMonthRange(setup.Term).Start–@GradeHelper.TermMonthRange(setup.Term).End)
                    </div>
                </div>
                <div style="display:flex;gap:8px;">
                    <button class="btn-ghost" @onclick="() => step = 2">← Back</button>
                </div>
            </div>
            <div style="display:flex;align-items:end;gap:10px;flex-wrap:wrap;margin-bottom:14px;padding:10px 12px;background:#f8f9ff;border:1px solid #e4e7ff;border-radius:10px;">
                <div class="form-group" style="margin:0;min-width:130px;">
                    <label class="form-label">Term</label>
                    <select class="form-control" @bind="setup.Term"><option>Term 1</option><option>Term 2</option><option>Term 3</option></select>
                </div>
                <div class="form-group" style="margin:0;width:125px;">
                    <label class="form-label">Academic year</label>
                    <input class="form-control" type="number" min="2000" max="2100" @bind="setup.TermYear" />
                </div>
                <div class="form-hint" style="margin-bottom:8px;">This period will be saved with new and edited marks.</div>
            </div>

            @if (markRows.Any(r => r.IsApproved))
            {
                <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:11px 16px;margin-bottom:16px;display:flex;align-items:center;gap:10px;font-size:12.5px;color:#1e40af;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <span>Marks for <strong>@markRows.Count(r => r.IsApproved) student(s)</strong> have been <strong>approved by Admin</strong> and are locked from further editing.</span>
                </div>
            }

            <div class="marks-table-wrap">
                <div class="marks-table-scroll">
                <table class="marks-table">
                    <thead>
                        <tr>
                            <th style="width:36px;">#</th>
                            <th>Student</th>
                            <th>National ID</th>
                            <th>Score / @SelectedAssessment?.MaxScore</th>
                            <th>%</th>
                            <th>Grade</th>
                            <th>Why editing is unavailable</th>
                            <th style="width:80px;text-align:center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int ri = 1;
                            double maxScoreForTable = SelectedAssessment?.MaxScore ?? 100.0;
                            foreach (var row in markRows)
                            {
                                double? livePct = row.LivePct(maxScoreForTable);
                                string grade = livePct.HasValue ? GradeHelper.ToGrade(livePct.Value) : "—";
                                string gradeClass = livePct.HasValue ? "grade-" + grade.ToLower() : "";
                                var rowRef = row;
                                <tr style="@(row.IsApproved ? "background:rgba(240,249,255,0.6);" : "")">
                                    <td data-label="#" style="color:var(--ink3);font-size:11.5px;font-family:'JetBrains Mono',monospace;">@ri</td>
                                    <td data-label="Student">
                                        <div style="font-size:13px;font-weight:500;color:var(--ink);display:flex;align-items:center;gap:6px;">
                                            @row.StudentName
                                            @if (row.IsApproved)
                                            {
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0369a1" stroke-width="2.5" title="Approved by Admin"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                            }
                                        </div>
                                        <div style="font-size:11px;color:var(--ink3);margin-top:1px;font-family:'JetBrains Mono',monospace;">ID: @row.StudentId</div>
                                    </td>
                                    <td data-label="National ID" style="font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--ink3);"><span style="min-width:0;overflow-wrap:anywhere;word-break:break-word;">@row.NationalId</span></td>
                                    <td data-label="Score / @SelectedAssessment?.MaxScore">
                                        <input class="mark-input @gradeClass"
                                               type="number" min="0" max="@maxScoreForTable"
                                               value="@(row.Score.HasValue ? ((int)row.Score.Value).ToString() : "")"
                                               placeholder="—"
                                                disabled="@(row.IsApproved || !string.IsNullOrWhiteSpace(row.BlockReason))"
                                                title="@row.BlockReason"
                                               @oninput="e => {
                                                   if (double.TryParse(e.Value?.ToString(), out var v))
                                                       rowRef.Score = Math.Round(Math.Min(v, maxScoreForTable), 2);
                                                   else
                                                       rowRef.Score = null;
                                               }" />
                                    </td>
                                    <td data-label="%">
                                        @if (livePct.HasValue)
                                        {
                                            <span style="font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:600;color:@GradeHelper.ToColor(livePct.Value);">
                                                @livePct.Value.ToString("F1")%
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--ink3);font-size:12px;">—</span>
                                        }
                                    </td>
                                    <td data-label="Grade">
                                        @if (livePct.HasValue)
                                        {
                                            <span class="pill @GradeHelper.ToPillClass(grade)">@grade</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--ink3);font-size:12px;">—</span>
                                        }
                                    </td>
                                    <td data-label="Why editing is unavailable">
                                        @if (!string.IsNullOrWhiteSpace(row.BlockReason))
                                        {
                                            <span style="font-size:11px;color:#b45309;font-weight:700;">@row.BlockReason</span>
                                        }
                                        else
                                        {
                                            <span style="font-size:11px;color:var(--ink3);">Can edit</span>
                                        }
                                    </td>
                                    <td data-label="Status" style="text-align:center;">
                                        @if (row.IsApproved)
                                        {
                                            <span class="pill" style="background:#e0f2fe;color:#0369a1;font-weight:700;display:inline-flex;align-items:center;gap:3px;" title="Approved by Admin — locked">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                                Approved
                                            </span>
                                        }
                                        else if (row.Submitted)
                                        {
                                            <span class="pill pill-green">Saved</span>
                                        }
                                        else if (row.IsExisting)
                                        {
                                            <span class="pill pill-amber">Edit</span>
                                        }
                                        else
                                        {
                                            <span class="pill pill-gray">New</span>
                                        }
                                    </td>
                                </tr>
                                ri++;
                            }
                        }
                    </tbody>
                </table>
                </div>

                <!-- Summary bar + submit (sticky so it's always reachable) -->
                <div class="submit-bar">
                <div class="summary-bar">
                    @{
                        double maxScoreBar = SelectedAssessment?.MaxScore ?? 100.0;
                        var scoredRows = markRows.Where(r => r.Score.HasValue).ToList();
                        double avgPct = scoredRows.Any()
                            ? scoredRows.Average(r => r.LivePct(maxScoreBar) ?? 0)
                            : 0;
                        int passCount = scoredRows.Count(r => (r.LivePct(maxScoreBar) ?? 0) >= 50.0);
                        int failCount = scoredRows.Count(r => (r.LivePct(maxScoreBar) ?? 0) < 50.0);
                    }
                    <div class="sb-item">
                        <span class="sb-label">Entered</span>
                        <span class="sb-val">@scoredRows.Count / @markRows.Count</span>
                    </div>
                    <div class="sb-item">
                        <span class="sb-label">Average</span>
                        <span class="sb-val">@(scoredRows.Any() ? avgPct.ToString("F1") + "%" : "—")</span>
                    </div>
                    <div class="sb-item">
                        <span class="sb-label">Pass (≥50%)</span>
                        <span class="sb-val" style="color:var(--green);">@passCount</span>
                    </div>
                    <div class="sb-item">
                        <span class="sb-label">Fail</span>
                        <span class="sb-val" style="color:var(--red);">@failCount</span>
                    </div>
                    @if (markRows.Any(r => r.IsApproved))
                    {
                        <div class="sb-item">
                            <span class="sb-label">Approved</span>
                            <span class="sb-val" style="color:#0369a1;">@markRows.Count(r => r.IsApproved)</span>
                        </div>
                    }
                    <div class="sb-item">
                        <span class="sb-label">New</span>
                        <span class="sb-val" style="color:var(--blue);">@markRows.Count(r => !r.IsExisting && !r.Submitted && !r.IsApproved)</span>
                    </div>
                    <div class="sb-item">
                        <span class="sb-label">Updates</span>
                        <span class="sb-val" style="color:var(--amber);">@markRows.Count(r => r.IsExisting && !r.IsApproved)</span>
                    </div>
                </div>

                <div style="display:flex;justify-content:flex-end;gap:8px;padding:0 20px 16px;">
                    <button class="btn-primary" style="width:100%;max-width:260px;" @onclick="SubmitAllMarks" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <span>Submit All Marks</span>
                        }
                    </button>
                </div>
                </div>
            </div>
        </div>
    }

</div>

<!-- ══ NEW ASSESSMENT MODAL ══ -->
@if (showNewAssessmentModal)
{
    <div class="modal-overlay" @onclick='() => showNewAssessmentModal = false'>
        <div class="modal" style="max-width: 520px;" @onclick:stopPropagation="true">
            <div class="modal-title">
                Create New Assessment
            </div>
            
            @if (step == 0)
            {
                <!-- Dashboard context selectors -->
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Form</label>
                        <select class="form-control" @bind="setup.FormNumber" @bind:after="OnModalFormChangedInternalAsync">
                            <option value="0">— Select —</option>
                            <option value="1">Form 1</option>
                            <option value="2">Form 2</option>
                            <option value="3">Form 3</option>
                            <option value="4">Form 4</option>
                            <option value="5">Form 5</option>
                            <option value="6">Form 6</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Assessment Type</label>
                        <select class="form-control" @bind="setup.AssessmentType">
                            <option value="assignment">Assignment</option>
                            <option value="test">Test</option>
                            <option value="exam">Exam</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Subject</label>
                    <select class="form-control" @bind="setup.SubjectName">
                        <option value="">— Select Subject —</option>
                        @foreach (var s in AvailableSubjects)
                        {
                            <option>@s</option>
                        }
                    </select>
                    @if (isLoadingSubjects)
                    {
                        <div class="form-hint" style="color:var(--blue);">Loading subjects…</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(subjectLoadError))
                    {
                        <div class="form-hint" style="color:var(--red);">@subjectLoadError</div>
                    }
                </div>
            }
            else
            {
                <div style="font-size:12px;color:var(--ink3);margin-bottom:16px;background:var(--blue-dim);padding:9px 12px;border-radius:8px;">
                    @setup.SubjectName · Form @setup.FormNumber
                </div>
            }

            <div class="form-group">
                <label class="form-label">Title</label>
                <input class="form-control" type="text" placeholder="e.g. Midterm Test 1" @bind="newAssessment.Title" />
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Max Score</label>
                    <input class="form-control" type="number" placeholder="e.g. 100" @bind="newAssessment.MaxScore" />
                    <div class="form-hint">Raw score stored in <code style="font-family:'JetBrains Mono',monospace;">max_score</code></div>
                </div>
                <div class="form-group">
                    <label class="form-label">Weight (%)</label>
                    <input class="form-control" type="number" step="1" min="0" max="100" placeholder="e.g. 50" @bind="newAssessmentWeightPercent" />
                    <div class="form-hint">Enter a percentage, for example 50 for 50% of the final grade</div>
                </div>
            </div>

            <div class="modal-actions">
                <button class="btn-ghost" @onclick='() => showNewAssessmentModal = false'>Cancel</button>
                <button class="btn-primary" @onclick="CreateAssessment" disabled="@(isCreating || string.IsNullOrWhiteSpace(newAssessment.Title) || (step == 0 && !IsStep1Valid))">
                    @(isCreating ? "Creating…" : "Create Assessment")
                </button>
            </div>
        </div>
    </div>
}

<!-- ══ BULK IMPORT MODAL ══ -->
@if (showBulkModal)
{
    <div class="modal-overlay" @onclick='() => showBulkModal = false'>
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-title">Bulk Import Marks</div>
            <div style="font-size:12px;color:var(--ink3);background:var(--blue-dim);padding:9px 12px;border-radius:8px;margin-bottom:14px;">
                Submits a list of mark DTOs via the bulk marks endpoints. Assignment and test marks go to the coursework table; exam marks go to the exam marks table.
            </div>
            <div class="dropzone" style="border:2px dashed var(--border);border-radius:12px;padding:32px;text-align:center;background:var(--bg);margin-bottom:14px;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--ink3)" stroke-width="1.5" style="margin:0 auto 10px;display:block;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <div style="font-size:14px;font-weight:500;color:var(--ink2);margin-bottom:6px;">Drop CSV / Excel here</div>
                <div style="font-size:12px;color:var(--ink3);">
                    Required columns: <code style="font-family:'JetBrains Mono',monospace;">student_id, assignment_id (or test_id / exam_id), score, feedback</code>
                </div>
            </div>
            <div style="font-size:12px;color:var(--ink3);">
                Each row maps to a <code style="font-family:'JetBrains Mono',monospace;">CourseworkDTO</code> or <code style="font-family:'JetBrains Mono',monospace;">ExamMarkDTO</code>. The graded date defaults to today.
            </div>
            <div class="modal-actions">
                <button class="btn-ghost" @onclick='() => showBulkModal = false'>Cancel</button>
                <button class="btn-primary" @onclick='() => showBulkModal = false'>Import &amp; Submit</button>
            </div>
        </div>
    </div>
}

<!-- ══ EDIT ASSESSMENT MODAL ══ -->
@if (showEditAssessmentModal && SelectedAssessment != null)
{
    <div class="modal-overlay" @onclick='() => showEditAssessmentModal = false'>
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-title">Edit @CapitaliseFirst(setup.AssessmentType): @SelectedAssessment.Title</div>
            <div class="form-group">
                <label class="form-label">Title</label>
                <input class="form-control" type="text" @bind="editTitle" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Max Score</label>
                    <input class="form-control" type="number" @bind="editMaxScore" />
                </div>
                <div class="form-group">
                    <label class="form-label">Weight (%)</label>
                    <input class="form-control" type="number" step="1" min="0" max="100" @bind="editWeightPercent" />
                    <div class="form-hint">Enter a percentage, for example 50 for 50%</div>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group"><label class="form-label">Term</label><select class="form-control" @bind="editTerm"><option>Term 1</option><option>Term 2</option><option>Term 3</option></select></div>
                <div class="form-group"><label class="form-label">Academic year</label><input class="form-control" type="number" min="2000" max="2100" @bind="editTermYear" /></div>
            </div>
            <div class="modal-actions">
                <button class="btn-ghost" @onclick='() => showEditAssessmentModal = false'>Cancel</button>
                <button class="btn-primary" @onclick="SaveEditAssessment" disabled="@isEditing">
                    @(isEditing ? "Saving…" : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

<!-- ══ QUICK ENTER MARKS MODAL (DASHBOARD) ══ -->
@if (showDashboardClassSelectModal && dashboardSelectedAssessment != null)
{
    <div class="modal-overlay" @onclick='() => showDashboardClassSelectModal = false'>
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-title" style="margin-bottom:8px;">
                Enter Marks: @dashboardSelectedAssessment.Title
            </div>
            <div style="font-size:12px;color:var(--ink3);margin-bottom:16px;">
                @dashboardSelectedAssessment.SubjectName · @CapitaliseFirst(dashboardSelectedAssessment.Type) · @(dashboardSelectedAssessment.Level == "alevel" ? "A-Level" : dashboardSelectedAssessment.Level == "olevel" ? "O-Level" : "Junior")
            </div>
            
            <div class="form-group">
                <label class="form-label">Class</label>
                <select class="form-control" value="@dashboardSelectClass" @onchange='(e) => { dashboardSelectClass = e.Value?.ToString() ?? ""; OnDashboardClassChanged(); }'>
                    <option value="">— Select Class —</option>
                    @foreach (var c in GetClassesForLevel(dashboardSelectedAssessment.Level))
                    {
                        <option>@c</option>
                    }
                </select>
                <div class="form-hint">Select the student class to record scores for</div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Form Number</label>
                    <select class="form-control" @bind="dashboardSelectForm">
                        <option value="0">— Select —</option>
                        <option value="1">Form 1</option>
                        <option value="2">Form 2</option>
                        <option value="3">Form 3</option>
                        <option value="4">Form 4</option>
                        <option value="5">Form 5</option>
                        <option value="6">Form 6</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Term</label>
                    <select class="form-control" @bind="dashboardSelectTerm">
                        <option>Term 1</option>
                        <option>Term 2</option>
                        <option>Term 3</option>
                    </select>
                </div>
            </div>

            <div class="modal-actions">
                <button class="btn-ghost" @onclick='() => showDashboardClassSelectModal = false'>Cancel</button>
                <button class="btn-primary" 
                        disabled="@(string.IsNullOrEmpty(dashboardSelectClass) || dashboardSelectForm == 0)"
                        @onclick="ConfirmQuickEnterMarks">
                    Continue to Enter Marks
                </button>
            </div>
        </div>
    </div>
}

<!-- Toast -->
@if (!string.IsNullOrEmpty(toastMsg))
{
    <div class="toast @(toastIsError ? "toast-error" : "toast-success")">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        @toastMsg
    </div>
}

</CascadingValue>

@code {
    private readonly string pageTitle = "Enter Marks";
    private int step = 1;
    private bool isSaving        = false;
    private bool isCreating      = false;
    private bool isLoadingSubjects   = false;
    private string subjectLoadError = "";
    private bool isLoadingAssessments = false;
    private bool isLoadingStudents   = false;
    private bool isLoadingOLevelFields = false;
    private bool isOpeningMarks = false;
    private bool showNewAssessmentModal = false;
    private bool showBulkModal = false;
    private long currentTeacherId = 0;
    private long dashboardAssessmentIdToSelect = 0;

    protected override async Task OnInitializedAsync()
    {
        step = 0;
        await LoadDashboardDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userIdStr = await JS.InvokeAsync<string?>("sessionStorage.getItem", "primeappDemo.userId");
                if (long.TryParse(userIdStr, out var tid) && tid > 0)
                {
                    currentTeacherId = tid;
                    ApplyFilters();
                    if (step == 2)
                    {
                        await LoadAssessmentsAsync();
                    }
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    // ── Dashboard state & filters ─────────────────────────
    private bool isLoadingDashboard = false;
    private List<DashboardAssessmentModel> allAssessments = new();
    private List<DashboardAssessmentModel> filteredAssessments = new();

    private List<string> juniorClasses = new();
    private List<string> olevelClasses = new();
    private List<string> alevelClasses = new();
    private List<string> allDashboardClasses = new();
    private List<string> allDashboardSubjects = new();
    private Dictionary<long, string> subjectIdToNameMap = new();
    private Dictionary<long, string> alevelSubjectIdToNameMap = new();
    private List<SubjectsModel.GetStudentALevelSubjectChoices> alevelChoices = new();
    private Dictionary<long, List<string>> form1to4StudentSubjects = new();
    private List<StudentProfileModel.Student> allStudents = new();

    private string searchTitle = "";
    private string filterLevel = "";
    private int filterForm = 0;
    private string filterClass = "";
    private string filterSubject = "";
    private string filterType = "";
    private string filterTerm = "";
    private bool filterOnlyMyAssessments = true;

    // Quick enter marks modal state
    private bool showDashboardClassSelectModal = false;
    private DashboardAssessmentModel? dashboardSelectedAssessment = null;
    private string dashboardSelectClass = "";
    private int dashboardSelectForm = 0;
    private string dashboardSelectTerm = "Term 1";
    private bool cameFromDashboard = false;

    private void ResetDashboardFilters()
    {
        searchTitle = "";
        filterLevel = "";
        filterForm = 0;
        filterClass = "";
        filterSubject = "";
        filterType = "";
        filterTerm = "";
        filterOnlyMyAssessments = true;
        ApplyFilters();
    }

    private void OnFilterFormChanged()
    {
        filterClass = "";
        ApplyFilters();
    }

    private IEnumerable<string> GetFilteredDashboardSubjects()
    {
        IEnumerable<DashboardAssessmentModel> source = allAssessments;
        if (filterForm > 0)
            source = source.Where(a => a.Form == filterForm ||
                (a.Form == null && ((filterForm <= 4 && a.Level == "form1to4") || (filterForm >= 5 && a.Level == "alevel"))));
        if (!string.IsNullOrWhiteSpace(filterClass))
            source = source.Where(a => string.IsNullOrWhiteSpace(a.ClassName) ||
                ClassMatchesFormAndName(a.ClassName, a.Form ?? GetDefaultFormForLevel(a.Level), filterClass));
        return source.Select(a => a.SubjectName)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s);
    }

    private List<string> GetFilteredDashboardClasses()
    {
        if (filterForm <= 0) return allDashboardClasses;
        if (filterForm is >= 1 and <= 4)
        {
            // The Forms 1-4 class registry stores stream names (for example A),
            // while student profiles may contain A, 1A, or Form 1 A. Use the
            // actual profile values so the dashboard filter matches marks/attendance.
            return allStudents
                .Where(s => s.Form == filterForm && !string.IsNullOrWhiteSpace(s.Classroom))
                .Select(s => s.Classroom!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(c => c)
                .ToList();
        }
        if (filterForm == 5)
        {
            return alevelClasses.Where(c => {
                string cls = c.ToLowerInvariant();
                if (cls.Contains("u6")) return false;
                return true;
            }).ToList();
        }
        if (filterForm == 6)
        {
            return alevelClasses.Where(c => {
                string cls = c.ToLowerInvariant();
                if (cls.Contains("l6")) return false;
                return true;
            }).ToList();
        }
        return allDashboardClasses;
    }

    private int GetDefaultFormForLevel(string level) => level switch
    {
        "form1to4" => 1,
        "alevel" => 5,
        _ => 1
    };

    /// <summary>
    /// Existing assessments are opened in the dedicated marks editor. The setup wizard is
    /// reserved for creating a new assessment and is not involved in editing marks.
    /// </summary>
    private static bool IsFormValidForLevel(int form, string level) => level switch
    {
        "form1to4" => form >= 1 && form <= 4,
        "alevel"    => form >= 5 && form <= 6,
        _           => form >= 1 && form <= 6
    };

    private static int ExtractFormFromText(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return 0;
        var lower = text.ToLowerInvariant();

        var match = System.Text.RegularExpressions.Regex.Match(lower, @"\b(?:form|f)\s*([1-6])\b");
        if (match.Success && int.TryParse(match.Groups[1].Value, out int formNum))
            return formNum;

        if (lower.Contains("u6") || lower.Contains("upper 6") || lower.Contains("upper sixth"))
            return 6;
        if (lower.Contains("l6") || lower.Contains("lower 6") || lower.Contains("lower sixth"))
            return 5;

        return 0;
    }

    private string GetAssessmentDisplayClass(DashboardAssessmentModel a)
    {
        // 1. If classroom data is known from submitted marks, show it
        if (a.Classrooms.Any())
        {
            if (a.Classrooms.Count <= 2)
                return string.Join(", ", a.Classrooms.OrderBy(c => c));
            return $"{string.Join(", ", a.Classrooms.OrderBy(c => c).Take(2))} +{a.Classrooms.Count - 2}";
        }

        // Resolve form from assessment title or student records. Dashboard
        // filters are search controls and never represent stored assessment data.
        int form = GetDefaultFormForLevel(a.Level);
        if (!string.IsNullOrWhiteSpace(a.Title))
        {
            int titleForm = ExtractFormFromText(a.Title);
            if (titleForm > 0 && IsFormValidForLevel(titleForm, a.Level))
                form = titleForm;
        }
        else if (filterForm > 0 && IsFormValidForLevel(filterForm, a.Level))
        {
            form = filterForm;
        }

        if (form == 5) return "Form 5 (L6)";
        if (form == 6) return "Form 6 (U6)";
        if (form >= 1 && form <= 4) return $"Form {form}";

        return a.Level switch
        {
            "alevel"    => "A-Level",
            "form1to4" => "Forms 1–4",
            _           => "All Classes"
        };
    }

    /// <summary>
    /// Invoked when a teacher clicks an assessment card (or its "Enter / Edit Marks" button)
    /// on the dashboard. Pre-fills all Step 1 selections (Form, Field, Subject, Type, Term, Class)
    /// before transitioning so the teacher sees the correct context ready to continue or edit.
    /// </summary>
    private async Task GoToStep1FromDashboard(DashboardAssessmentModel assessment, string displayedClass = "")
    {
        int defaultForm  = GetDefaultFormForLevel(assessment.Level);
        int guessedForm  = assessment.Form is > 0 ? assessment.Form.Value : defaultForm;

        // Helper: resolve the form number from a classroom name via allStudents
        int? FormFromClass(string cls) =>
            allStudents
                .FirstOrDefault(s => string.Equals(s.Classroom, cls, StringComparison.OrdinalIgnoreCase))
                ?.Form;

        // 1. Best source: classrooms derived from existing marks
        if (assessment.Classrooms.Any())
        {
            foreach (var cls in assessment.Classrooms.OrderBy(c => c))
            {
                var f = FormFromClass(cls);
                if (f.HasValue && IsFormValidForLevel(f.Value, assessment.Level))
                {
                    guessedForm = f.Value;
                    break;
                }
            }
        }

        // 2. A dashboard filter is only a search filter. It must never replace
        // the assessment's own class context when opening marks.
        if (guessedForm == defaultForm && filterForm > 0 && IsFormValidForLevel(filterForm, assessment.Level))
        {
            guessedForm = filterForm;
        }

        // 3. Try checking title for Form/F/L6/U6 patterns
        if (guessedForm == defaultForm && !string.IsNullOrWhiteSpace(assessment.Title))
        {
            int f = ExtractFormFromText(assessment.Title);
            if (f > 0 && IsFormValidForLevel(f, assessment.Level))
                guessedForm = f;
        }

        // 4. Check class strings for form patterns
        if (guessedForm == defaultForm)
        {
            var candidates = new List<string>();
            candidates.AddRange(assessment.Classrooms);
            foreach (var c in candidates)
            {
                int f = ExtractFormFromText(c);
                if (f > 0 && IsFormValidForLevel(f, assessment.Level))
                {
                    guessedForm = f;
                    break;
                }
            }
        }

        setup.FormNumber     = guessedForm;
        setup.SubjectName    = assessment.SubjectName?.Trim() ?? "";
        setup.Field          = "";
        setup.AssessmentType = assessment.Type?.Trim().ToLowerInvariant() switch
        {
            "test" => "test",
            "exam" => "exam",
            _      => "assignment"
        };
        setup.Term           = !string.IsNullOrWhiteSpace(assessment.Term)
            ? assessment.Term
            : (!string.IsNullOrWhiteSpace(filterTerm) ? filterTerm : "Term 1");

        // The dashboard card has already resolved the class label. Use that
        // exact value when it is a real catalogue class instead of recomputing
        // the context from marks or filters.
        if (!string.IsNullOrWhiteSpace(displayedClass))
        {
            var displayedForm = ExtractFormFromText(displayedClass);
            if (displayedForm > 0 && IsFormValidForLevel(displayedForm, assessment.Level))
                setup.FormNumber = displayedForm;
        }

        // Load classes first so dashboard navigation can resolve the selected class
        // against the current class catalogue.
        await LoadClassesAsync();

        // Use a class only when the assessment has exactly one known class. If it
        // has none or several, the editor asks the teacher instead of guessing.
        string preferredClass = !string.IsNullOrWhiteSpace(assessment.ClassName)
            ? assessment.ClassName
            : !string.IsNullOrWhiteSpace(displayedClass) &&
                                !displayedClass.StartsWith("Form ", StringComparison.OrdinalIgnoreCase) &&
                                !string.Equals(displayedClass, "A-Level", StringComparison.OrdinalIgnoreCase) &&
                                !string.Equals(displayedClass, "Forms 1–4", StringComparison.OrdinalIgnoreCase)
            ? displayedClass
            : assessment.Classrooms.Count == 1
            ? assessment.Classrooms.Single()
            : "";

        if (!string.IsNullOrWhiteSpace(preferredClass))
        {
            var matchedClass = AvailableClasses.FirstOrDefault(c => string.Equals(c, preferredClass, StringComparison.OrdinalIgnoreCase));
            if (matchedClass != null)
            {
                setup.ClassName = matchedClass;
            }
            else
            {
                AvailableClasses.Insert(0, preferredClass);
                setup.ClassName = preferredClass;
            }
        }
        else
        {
            setup.ClassName = "";
        }

        // Load subjects after the class because Forms 1-4 subjects are class-scoped.
        await LoadSubjectsAsync();

        // Keep the assessment's subject selected when it is still offered by the class.
        if (!string.IsNullOrWhiteSpace(setup.SubjectName))
        {
            var matchedSub = AvailableSubjects.FirstOrDefault(s => string.Equals(s, setup.SubjectName, StringComparison.OrdinalIgnoreCase));
            if (matchedSub != null)
                setup.SubjectName = matchedSub;
            else if (setup.FormNumber is < 1 or > 4)
                AvailableSubjects.Insert(0, setup.SubjectName);
            else
            {
                // Preserve the subject stored on the existing assessment. A
                // class catalogue refresh must never relabel an old test.
                AvailableSubjects.Insert(0, setup.SubjectName);
            }
        }

        selectedAssessmentId          = 0;
        dashboardAssessmentIdToSelect = assessment.Id;
        cameFromDashboard             = false;

        step = 1;
        StateHasChanged();
    }

    /// <summary>
    private async Task OpenMarksFromDashboardAsync(DashboardAssessmentModel assessment, string displayedClass = "")
    {
        isOpeningMarks = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            await GoToStep1FromDashboard(assessment, displayedClass);
            if (step != 1) return;

            if (string.IsNullOrWhiteSpace(setup.ClassName))
            {
                // Class is not persisted on the current assessment record. Ask
                // explicitly instead of opening the first/incorrect class.
                dashboardSelectedAssessment = assessment;
                dashboardSelectClass = "";
                dashboardSelectForm = setup.FormNumber;
                dashboardSelectTerm = setup.Term;
                showDashboardClassSelectModal = true;
                return;
            }

            // Preserve the stored assessment identity and go straight to the mark rows.
            MockAssessments.Clear();
            MockAssessments.Add(new AssignmentModel
            {
                Id = assessment.Id,
                RealId = assessment.RealId,
                SubjectId = assessment.SubjectId,
                Title = assessment.Title,
                MaxScore = assessment.MaxScore,
                Weight = assessment.Weight,
                TeacherId = assessment.TeacherId
            });
            selectedAssessmentId = assessment.Id;
            cameFromDashboard = true;
            await GoToStep3Async();
        }
        finally
        {
            isOpeningMarks = false;
        }
    }

