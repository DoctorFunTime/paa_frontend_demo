    /// Clears any leftover setup from a previous flow and jumps straight to Step 1
    /// (Setup) with blank fields so the teacher can create a brand-new assessment
    /// from scratch, picking Form, Subject, Type, Term and Class themselves.
    /// </summary>
    private void GoToStep1ForNewAssessment()
    {
        setup = new SetupModel();
        selectedAssessmentId = 0;
        MockAssessments.Clear();
        AvailableSubjects = new();
        AvailableClasses = new();
        cameFromDashboard = false;
