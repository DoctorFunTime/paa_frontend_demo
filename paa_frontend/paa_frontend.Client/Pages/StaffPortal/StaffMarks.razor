    }

    private void StartDashboardClassSelect(DashboardAssessmentModel assessment)
    {
        dashboardSelectedAssessment = assessment;
        
        string targetClass = !string.IsNullOrEmpty(filterClass) ? filterClass : setup.ClassName;
        int targetForm = filterForm > 0 ? filterForm : setup.FormNumber;

        if (targetForm <= 0)
        {
            targetForm = GetDefaultFormForLevel(assessment.Level);
        }

        // If no class is set but marks already exist, use the known classroom(s) directly
        if (string.IsNullOrEmpty(targetClass) && assessment.Classrooms.Any())
        {
            // Pick the first known classroom (alphabetically)
            targetClass = assessment.Classrooms.OrderBy(c => c).First();
            // Look up the real form number from an actual student in that class
            // (classroom names like "West" have no form prefix, so we can't guess from the name)
            var studentInClass = allStudents.FirstOrDefault(s =>
                string.Equals(s.Classroom, targetClass, StringComparison.OrdinalIgnoreCase));
            if (studentInClass?.Form != null)
                targetForm = studentInClass.Form.Value;
        }

        if (string.IsNullOrEmpty(targetClass))
        {
            var classesForLevel = GetClassesForLevel(assessment.Level);
            if (classesForLevel.Any())
            {
                var matchingFormClass = classesForLevel.FirstOrDefault(c => {
                    string cls = c.ToLowerInvariant();
                    if (targetForm == 5 && cls.Contains("u6")) return false;
                    if (targetForm == 6 && cls.Contains("l6")) return false;
                    if (targetForm >= 1 && targetForm <= 4) return cls.Contains($"form {targetForm}");
                    return true;
                });
                targetClass = matchingFormClass ?? classesForLevel.First();
            }
        }
        else if (targetForm == 0)
        {
            var cls = targetClass.ToLowerInvariant();
            if (cls.Contains("l6"))
            {
                targetForm = 5;
            }
            else if (cls.Contains("u6"))
            {
                targetForm = 6;
            }
            else
            {
                var match = System.Text.RegularExpressions.Regex.Match(targetClass, @"Form\s*([1-6])", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                if (match.Success)
                {
                    targetForm = int.Parse(match.Groups[1].Value);
                }
            }
        }

        string targetTerm = !string.IsNullOrEmpty(setup.Term) ? setup.Term : "Term 1";

        bool isValid = false;
        if (!string.IsNullOrEmpty(targetClass) && targetForm > 0)
        {
            var classesForLevel = GetClassesForLevel(assessment.Level);
            if (classesForLevel.Contains(targetClass))
            {
                isValid = true;
            }
        }

        if (isValid)
        {
            QuickEnterMarks(assessment, targetForm, targetClass, targetTerm);
        }
        else
        {
            dashboardSelectClass = targetClass;
            dashboardSelectForm = targetForm;
            dashboardSelectTerm = targetTerm;
            showDashboardClassSelectModal = true;
        }
    }

    private void OnDashboardClassChanged()
    {
        if (string.IsNullOrEmpty(dashboardSelectClass)) return;
        var cls = dashboardSelectClass.ToLowerInvariant();
        if (cls.Contains("l6"))
        {
            dashboardSelectForm = 5;
            return;
        }
        if (cls.Contains("u6"))
        {
            dashboardSelectForm = 6;
            return;
        }
        var match = System.Text.RegularExpressions.Regex.Match(dashboardSelectClass, @"Form\s*([1-6])", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (match.Success) {
            dashboardSelectForm = int.Parse(match.Groups[1].Value);
        }
    }

