    private async Task LoadSubjectsAsync()
    {
        AvailableSubjects = new();
        subjectLoadError = "";
        if (setup.FormNumber < 1 || setup.FormNumber > 6) return;

        isLoadingSubjects = true;
        try
        {
            switch (setup.Level)
            {
                case "form1to4":
                    // Forms 1-4 use the class subject configuration. Do not use the
                    // legacy Form 1/2 or O-Level catalogues here: they are not scoped
                    // to the selected class and can show subjects that are not offered.
                    if (string.IsNullOrWhiteSpace(setup.ClassName)) break;
                    var classSubjects = await SubjectService.GetForm1to4ClassSubjectsAsync(setup.FormNumber, setup.ClassName);
                    AvailableSubjects = classSubjects?.Subjects
                        .Where(s => !string.IsNullOrWhiteSpace(s))
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(s => s)
                        .ToList() ?? new();

                    // If the class-subject response is unavailable, use the effective
                    // student enrolments already loaded for this class as a temporary
                    // read-only fallback. This keeps teachers productive while the
                    // enrollment service is recovering, without reintroducing legacy
                    // subject data from another level.
                    if (AvailableSubjects.Count == 0)
                    {
                        AvailableSubjects = await LoadSubjectsFromEnrolledStudentsAsync(setup.FormNumber, setup.ClassName);
                        if (AvailableSubjects.Count == 0)
                        {
                            subjectLoadError = "No subjects could be loaded for this class. Check the class subject setup and try again.";
                        }
                    }
                    break;
                case "alevel":
                    // Form 5 and 6 use the preset A-Level subject catalogue.
                    var alevel = await SubjectService.GetALevelSubjectsAsync();
                    AvailableSubjects = alevel.Select(s => s.SubjectName ?? "").Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s).ToList();
                    break;
            }
        }
        catch
        {
            AvailableSubjects = new();
            if (setup.FormNumber is >= 1 and <= 4)
            {
                AvailableSubjects = await LoadSubjectsFromEnrolledStudentsAsync(setup.FormNumber, setup.ClassName);
                if (AvailableSubjects.Count == 0)
                    subjectLoadError = "The class subjects could not be loaded. Check the class subject setup and try again.";
            }
        }
        finally { isLoadingSubjects = false; }
    }

    private async Task<List<string>> LoadSubjectsFromEnrolledStudentsAsync(int form, string className)
    {
        if (form is < 1 or > 4 || string.IsNullOrWhiteSpace(className))
            return new();

        var students = allStudents
            .Where(s => s.Form == form && string.Equals(s.Classroom?.Trim(), className.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (students.Count == 0)
            return new();

        try
        {
            var subjectTasks = students.Select(s => SubjectService.GetForm1to4StudentSubjectsAsync(s.Id));
            var choices = await Task.WhenAll(subjectTasks);
            return choices
                .Where(c => c?.Subjects != null)
                .SelectMany(c => c!.Subjects)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s)
                .ToList();
        }
        catch
        {
            return new();
        }
    }

    private async Task LoadClassesAsync()
    {
        AvailableClasses = new();
        if (setup.FormNumber < 1 || setup.FormNumber > 6) return;

        isLoadingClasses = true;
        try
        {
            switch (setup.Level)
            {
                case "form1to4":
                    var olevelClasses = await OClassService.GetAllOlevelClassNamesAsync();
                    AvailableClasses = olevelClasses.Select(c => c.ClassName ?? "").Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c).ToList();
                    break;
                case "alevel":
                    var alevelClasses = await AClassService.GetAllAlevelClassNamesAsync();
                    AvailableClasses = alevelClasses.Select(c => c.ClassName ?? "").Where(c => !string.IsNullOrWhiteSpace(c)).OrderBy(c => c).ToList();
                    break;
            }
        }
        catch
        {
            AvailableClasses = new();
        }
        finally { isLoadingClasses = false; }
    }

