        selectedAssessmentId = 0;
        StateHasChanged();
        try
        {
            var level = setup.Level; // "form1to4" | "alevel"
            var subject = setup.SubjectName;
            var field = setup.Field;
            long idCounter = 1;

            if (setup.AssessmentType == "assignment")
            {
                var list = await AssessmentService.GetAssignmentsAsync(level, subject, field);
                MockAssessments = list?.Select(a => new AssignmentModel
                {
                    Id = a.Id ?? 0, RealId = a.Id ?? 0, SubjectId = a.SubjectId ?? 0,
                    Title = a.Title ?? "Assignment", MaxScore = a.MaxScore, Weight = a.Weight, TeacherId = a.TeacherId
                }).ToList() ?? new();
            }
            else if (setup.AssessmentType == "test")
            {
                var list = await AssessmentService.GetTestsAsync(level, subject, field);
                MockAssessments = list?.Select(t => new AssignmentModel
                {
                    Id = t.Id ?? 0, RealId = t.Id ?? 0, SubjectId = t.SubjectId ?? 0,
                    Title = t.Title ?? "Test", MaxScore = t.MaxScore, Weight = t.Weight, TeacherId = t.TeacherId
                }).ToList() ?? new();
            }
            else
            {
                var list = await AssessmentService.GetExamsAsync(level, subject, field);
                MockAssessments = list?.Select(ex => new AssignmentModel
                {
                    Id = ex.Id ?? 0, RealId = ex.Id ?? 0, SubjectId = ex.SubjectId ?? 0,
                    Title = ex.Title ?? "Exam", MaxScore = ex.MaxScore, Weight = ex.Weight, TeacherId = ex.TeacherId
                }).ToList() ?? new();
            }

            MockAssessments = currentTeacherId > 0
                ? MockAssessments.Where(a => a.TeacherId == currentTeacherId || a.Id == dashboardAssessmentIdToSelect).ToList()
                : MockAssessments;

            if (dashboardAssessmentIdToSelect > 0 && MockAssessments.Any(a => a.Id == dashboardAssessmentIdToSelect))
            {
                selectedAssessmentId = dashboardAssessmentIdToSelect;
                dashboardAssessmentIdToSelect = 0;
            }
        }
        catch { ShowToast("Could not load assessments", error: true); }
        finally { isLoadingAssessments = false; StateHasChanged(); }
    }

