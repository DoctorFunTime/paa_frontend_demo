@page "/staff"
@namespace paa_frontend.Client.Pages.Staff
@layout paa_frontend.Client.Layout.StaffPortalLayout
@using paa_frontend.Shared.Models
@using paa_frontend.Client.Services
@using paa_frontend.Client.Services.StaffPortal
@using static paa_frontend.Shared.Models.TeacherProfileModel
@inject IJSRuntime JS
@inject TeacherProfileServiceClient TeacherService
@inject AssessmentServiceClient AssessmentService
@inject NavigationManager Nav

<style>
@@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap');
:root{
    --blue:#4f46e5;--blue-dim:#eef2ff;--ink:#0f172a;--ink2:#475569;--ink3:#94a3b8;
    --bg:#f8fafc;--card:#ffffff;--green:#16a34a;--green-dim:#dcfce7;
    --amber:#d97706;--amber-dim:#fef3c7;--red:#e11d48;--red-dim:#fee2e2;
    --border:#e2e8f0;--shadow:0 4px 6px -1px rgba(0,0,0,0.05),0 2px 4px -1px rgba(0,0,0,0.03);
    --radius:20px;
}
.staff-home *,.staff-home *::before,.staff-home *::after{box-sizing:border-box;}
.staff-home{font-family:'Sora',sans-serif;color:var(--ink);}
.staff-home a{text-decoration:none;color:inherit;}
.staff-home button{font-family:'Sora',sans-serif;}

.page-wrap{padding:28px 32px;max-width:1400px;margin:0 auto;}

@@keyframes fadeUp{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
.a1{animation:fadeUp .3s ease both;}
.a2{animation:fadeUp .3s .06s ease both;}
.a3{animation:fadeUp .3s .12s ease both;}
@@keyframes spin{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}

/* hero / profile banner (same visual family as Enter Marks hero) */
.hero{background:linear-gradient(135deg,#1e1b4b 0%,#312e81 45%,#4338ca 100%);border-radius:24px;padding:26px 30px;color:#fff;margin-bottom:22px;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 80% 20%,rgba(255,255,255,0.10) 0%,transparent 60%);pointer-events:none;}
.hero-inner{position:relative;z-index:1;display:flex;align-items:center;gap:20px;flex-wrap:wrap;}
.hero-avatar{width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,0.14);border:1.5px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;font-size:19px;font-weight:800;color:#fff;flex-shrink:0;}
.hero-info{flex:1;min-width:200px;}
.hero-eyebrow{display:inline-block;padding:4px 12px;border-radius:999px;background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.2);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:9px;}
.hero-title{font-size:22px;font-weight:800;letter-spacing:-0.4px;margin-bottom:8px;}
.hero-meta{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:10px;}
.hero-meta-item{display:flex;align-items:center;gap:5px;font-size:12.5px;color:rgba(255,255,255,0.82);font-weight:500;min-width:0;}
.hero-meta-item span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.hero-badges{display:flex;gap:8px;flex-wrap:wrap;}
.hero-badge{padding:3px 10px;border-radius:6px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.05em;background:rgba(255,255,255,0.14);border:1px solid rgba(255,255,255,0.25);color:#fff;}
.hero-stats{display:flex;gap:28px;margin-left:auto;position:relative;z-index:1;}
.hero-stat{text-align:right;}
.hero-stat-label{font-size:10px;font-weight:700;color:rgba(255,255,255,0.65);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:2px;}
.hero-stat-val{font-size:26px;font-weight:800;font-family:'JetBrains Mono',monospace;line-height:1;}

/* quick actions */
.qa-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:22px;}
.qa-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:18px;display:flex;align-items:center;gap:14px;cursor:pointer;box-shadow:var(--shadow);transition:transform .15s,box-shadow .15s,border-color .15s;min-height:44px;text-align:left;width:100%;}
.qa-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,0.08);border-color:rgba(79,70,229,0.25);}
.qa-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.qa-title{font-size:14px;font-weight:700;color:var(--ink);margin-bottom:2px;}
.qa-sub{font-size:11.5px;color:var(--ink3);}
.qa-arrow{margin-left:auto;flex-shrink:0;color:var(--ink3);}

/* stat cards */
.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-bottom:22px;}
.stat-card{border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);position:relative;overflow:hidden;}
.stat-card.hi{background:linear-gradient(135deg,#4338ca,var(--blue));color:#fff;}
.stat-card.lo{background:var(--card);border:1px solid var(--border);}
.stat-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;}
.stat-card.hi .stat-label{opacity:0.85;}
.stat-card.lo .stat-label{color:var(--ink3);}
.stat-val{font-size:30px;font-weight:800;margin-top:8px;font-family:'JetBrains Mono',monospace;line-height:1;}
.stat-card.lo .stat-val{color:var(--ink);}
.stat-sub{font-size:12px;margin-top:5px;}
.stat-card.hi .stat-sub{opacity:0.75;}
.stat-card.lo .stat-sub{color:var(--ink3);}
.stat-decor{position:absolute;right:-10px;bottom:-10px;opacity:0.12;}
.stat-card.lo .stat-decor{opacity:0.05;color:var(--ink);}
.stat-progress{height:5px;background:rgba(0,0,0,0.06);border-radius:3px;margin-top:12px;overflow:hidden;}
.stat-card.hi .stat-progress{background:rgba(255,255,255,0.22);}
.stat-progress-fill{height:100%;border-radius:3px;transition:width .6s ease;}

.mini-bar{display:flex;align-items:flex-end;gap:5px;height:48px;margin-top:12px;}
.mb-col{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1;}
.mb-bar{width:100%;border-radius:4px 4px 0 0;transition:height .4s ease;min-height:2px;}
.mb-lbl{font-size:9px;color:var(--ink3);font-weight:700;}

/* panels */
.panel-card{background:var(--card);border-radius:var(--radius);border:1px solid var(--border);padding:22px;box-shadow:var(--shadow);}
.panel-title{font-size:12px;font-weight:800;color:var(--ink3);margin-bottom:16px;text-transform:uppercase;letter-spacing:0.08em;display:flex;align-items:center;gap:8px;}
.panel-link{font-size:11px;color:var(--blue);font-weight:700;background:none;border:none;cursor:pointer;padding:6px 0;min-height:32px;}

.dash-grid{display:grid;grid-template-columns:2fr 1fr;gap:20px;}

/* assessment list */
.assessment-list{display:flex;flex-direction:column;}
.assessment-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid rgba(0,0,0,0.05);}
.assessment-item:last-child{border-bottom:none;}
.ai-type{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;flex-shrink:0;}
.ai-info{flex:1;min-width:0;}
.ai-title{font-size:12.5px;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.ai-meta{font-size:11px;color:var(--ink3);margin-top:1px;}
.ai-weight{font-size:11px;color:var(--ink3);flex-shrink:0;font-family:'JetBrains Mono',monospace;white-space:nowrap;}

/* my details */
.pd-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.pd-item{display:flex;flex-direction:column;gap:3px;min-width:0;}
.pd-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:var(--ink3);}
.pd-val{font-size:13.5px;font-weight:600;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}

.empty-state{text-align:center;padding:40px 16px;color:var(--ink3);font-size:13px;}
.empty-state a{color:var(--blue);font-weight:600;}

.skeleton{background:linear-gradient(90deg,rgba(226,232,240,.75) 25%,rgba(241,245,249,.95) 37%,rgba(226,232,240,.75) 63%);background-size:400% 100%;animation:skeletonPulse 1.4s ease infinite;border-radius:10px;}
.skeleton-home{display:grid;gap:20px;}
.skeleton-hero{height:178px;border-radius:24px;}
.skeleton-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
.skeleton-card{height:112px;border-radius:18px;}
.skeleton-panel{height:300px;border-radius:20px;}
@@keyframes skeletonPulse{0%{background-position:100% 0;}100%{background-position:-100% 0;}}

/* ── mobile ── */
@@media(max-width:900px){
    .page-wrap{padding:14px 12px;}
    .hero{padding:20px;border-radius:20px;}
    .hero-title{font-size:19px;}
    .hero-stats{margin-left:0;width:100%;justify-content:flex-start;gap:24px;}
    .qa-grid{grid-template-columns:1fr;}
    .dash-grid{grid-template-columns:1fr;}
    .pd-grid{grid-template-columns:1fr;}
    .stats-row{gap:14px;}
    .skeleton-row{grid-template-columns:repeat(2,1fr);}
}
@@media(max-width:600px){
    .hero{padding:18px;}
    .hero-inner{gap:14px;}
    .hero-avatar{width:48px;height:48px;font-size:16px;}
    .hero-title{font-size:17px;}
    .hero-meta-item{font-size:11.5px;}
    .hero-stat-val{font-size:21px;}
    .stat-val{font-size:24px;}
    .panel-card{padding:16px;}
    .qa-card{padding:14px;}
    .skeleton-row{grid-template-columns:1fr;}
}
</style>

<div class="staff-home page-wrap">

@if (isLoading)
{
    <div class="skeleton-home" aria-label="Loading staff dashboard" role="status">
        <div class="skeleton skeleton-hero"></div>
        <div class="skeleton-row">
            <div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div>
            <div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div>
        </div>
        <div class="dash-grid">
            <div class="skeleton skeleton-panel"></div><div class="skeleton skeleton-panel"></div>
        </div>
    </div>
}
else
{
    <!-- Hero / profile banner -->
    <div class="hero a1">
        <div class="hero-inner">
            <div class="hero-avatar">@StaffInitials</div>
            <div class="hero-info">
                <span class="hero-eyebrow">Staff Portal</span>
                <div class="hero-title">@Me.FirstName @Me.LastName</div>
                <div class="hero-meta">
                    <span class="hero-meta-item">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                        <span>Teacher</span>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(Me.Email))
                    {
                        <span class="hero-meta-item">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            <span>@Me.Email</span>
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Me.Phone))
                    {
                        <span class="hero-meta-item">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.12 6.12l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/></svg>
                            <span>@Me.Phone</span>
                        </span>
                    }
                </div>
                <div class="hero-badges">
                    <span class="hero-badge">@(Me.Status ?? "Active")</span>
                    <span class="hero-badge">ID @Me.Id</span>
                </div>
            </div>
            <div class="hero-stats">
                <div class="hero-stat">
                    <div class="hero-stat-label">Assessments</div>
                    <div class="hero-stat-val">@totalAssessments</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-label">Graded</div>
                    <div class="hero-stat-val">@totalGraded</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick actions -->
    <div class="qa-grid a2">
        <button class="qa-card" @onclick='() => Nav.NavigateTo("/staff/attendance")'>
            <div class="qa-icon" style="background:rgba(15,23,42,0.06);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div>
                <div class="qa-title">Mark Attendance</div>
                <div class="qa-sub">Update today's register</div>
            </div>
            <svg class="qa-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <button class="qa-card" @onclick='() => Nav.NavigateTo("/staff/marks")'>
            <div class="qa-icon" style="background:var(--blue-dim);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <div>
                <div class="qa-title">Enter Marks</div>
                <div class="qa-sub">Assessments &amp; grades</div>
            </div>
            <svg class="qa-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
    </div>

    <!-- Stat cards -->
    <div class="stats-row a2">
        <div class="stat-card hi">
            <div class="stat-label">Total Assessments</div>
            <div class="stat-val">@totalAssessments</div>
            <div class="stat-sub">Assignments, tests &amp; exams you own</div>
            <div class="stat-decor"><svg width="90" height="90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/></svg></div>
        </div>
        <div class="stat-card lo">
            <div class="stat-label">Completion Rate</div>
            <div class="stat-val">@completionRate%</div>
            <div class="stat-sub">@totalGraded of @totalEligible grades entered</div>
            <div class="stat-progress"><div class="stat-progress-fill" style="width:@(completionRate)%;background:var(--green);"></div></div>
        </div>
        <div class="stat-card lo">
            <div class="stat-label">Avg Score</div>
            <div class="stat-val">@averageScore%</div>
            <div class="stat-sub">Across all graded assessments</div>
            <div class="mini-bar">
                @foreach (var bar in scoreDistribution)
                {
                    <div class="mb-col">
                        <div class="mb-bar" style="height:@(bar.HeightPct)%;background:@bar.Color;"></div>
                        <span class="mb-lbl">@bar.Label</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Assessments + My Details -->
    <div class="dash-grid a3">
        <div class="panel-card">
            <div class="panel-title" style="justify-content:space-between;">
                <span style="display:flex;align-items:center;gap:8px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    Recent Assessments
                </span>
                <button class="panel-link" @onclick='() => Nav.NavigateTo("/staff/marks")'>View all →</button>
            </div>
            @if (!recentAssignments.Any() && !recentTests.Any() && !recentExams.Any())
            {
                <div class="empty-state">No assessments found. <a href="/staff/marks">Create one →</a></div>
            }
            else
            {
                <div class="assessment-list">
                    @foreach (var a in recentAssignments.Take(4))
                    {
                        <div class="assessment-item">
                            <div class="ai-type" style="background:var(--blue-dim);color:var(--blue);">A</div>
                            <div class="ai-info">
                                <div class="ai-title">@(a.Title ?? "Untitled")</div>
                                <div class="ai-meta">Assignment</div>
                            </div>
                            <span class="ai-weight">@(a.MaxScore) pts</span>
                        </div>
                    }
                    @foreach (var t in recentTests.Take(3))
                    {
                        <div class="assessment-item">
                            <div class="ai-type" style="background:var(--amber-dim);color:#b45309;">T</div>
                            <div class="ai-info">
                                <div class="ai-title">@(t.Title ?? "Untitled")</div>
                                <div class="ai-meta">Test</div>
                            </div>
                            <span class="ai-weight">@(t.MaxScore) pts</span>
                        </div>
                    }
                    @foreach (var e in recentExams.Take(2))
                    {
                        <div class="assessment-item">
                            <div class="ai-type" style="background:rgba(124,58,237,0.12);color:#7c3aed;">EX</div>
                            <div class="ai-info">
                                <div class="ai-title">@(e.Title ?? "Untitled")</div>
                                <div class="ai-meta">Exam</div>
                            </div>
                            <span class="ai-weight">@(e.MaxScore) pts</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="panel-card">
            <div class="panel-title">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                My Details
            </div>
            <div class="pd-grid">
                <div class="pd-item">
                    <div class="pd-label">National ID</div>
                    <div class="pd-val">@(Me.NationalId ?? "—")</div>
                </div>
                <div class="pd-item">
                    <div class="pd-label">Phone</div>
                    <div class="pd-val">@(Me.Phone ?? "—")</div>
                </div>
                <div class="pd-item">
                    <div class="pd-label">Email</div>
                    <div class="pd-val">@(Me.Email ?? "—")</div>
                </div>
                <div class="pd-item">
                    <div class="pd-label">Status</div>
                    <div class="pd-val" style="color:var(--green);">@(Me.Status ?? "Active")</div>
                </div>
            </div>
            <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--border);">
                <button class="panel-link" style="padding:0;" @onclick='() => Nav.NavigateTo("/staff/profile")'>Edit Profile →</button>
            </div>
        </div>
    </div>
}
</div>

@code {
    private Teacher Me = new();
    private bool isLoading = true;

    // Stats
    private int totalAssessments;
    private int totalGraded;
    private int totalEligible;
    private string completionRate = "0";
    private string averageScore = "0";

    // Assessment lists using existing DTOs
    private List<AssignmentsDTO> recentAssignments = new();
    private List<TestsDTO> recentTests = new();
    private List<ExamsDTO> recentExams = new();

    private record ScoreBar(string Label, double HeightPct, string Color);
    private List<ScoreBar> scoreDistribution = new();

    private long currentTeacherId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var userIdStr = await JS.InvokeAsync<string>("sessionStorage.getItem", "primeappDemo.userId");
            if (long.TryParse(userIdStr, out currentTeacherId))
            {
                Me.Id = currentTeacherId;
                var teacher = await TeacherService.GetTeacherAsync(currentTeacherId);
                if (teacher != null) Me = teacher;
            }
        }
        catch (Exception)
        {
        }
        finally
        {
            isLoading = false;
        }

        if (currentTeacherId > 0)
        {
            _ = LoadDashboardStatsAndNotifyAsync();
        }
    }

    private async Task LoadDashboardStatsAndNotifyAsync()
    {
        await LoadDashboardStatsAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Loads this teacher's assessments and their mark-completion stats.
    /// Uses the exact same endpoints as before, but issues requests concurrently
    /// (instead of one-at-a-time) so the dashboard loads in roughly the time of
    /// the single slowest call rather than the sum of every call.
    /// </summary>
    private async Task LoadDashboardStatsAsync()
    {
        try
        {
            var levels = new[] { "form1to4", "alevel" };

            // Kick off assignments/tests/exams for every level at once.
            var assignmentTasks = levels.Select(l => AssessmentService.GetAssignmentsAsync(l, "", "")).ToList();
            var testTasks = levels.Select(l => AssessmentService.GetTestsAsync(l, "", "")).ToList();
            var examTasks = levels.Select(l => AssessmentService.GetExamsAsync(l, "", "")).ToList();

            await Task.WhenAll(assignmentTasks.Cast<Task>().Concat(testTasks.Cast<Task>()).Concat(examTasks.Cast<Task>()));

            recentAssignments = assignmentTasks
                .Where(t => t.Result != null)
                .SelectMany(t => t.Result!)
                .Where(a => a.TeacherId == currentTeacherId)
                .OrderByDescending(a => a.DueDate)
                .ToList();

            recentTests = testTasks
                .Where(t => t.Result != null)
                .SelectMany(t => t.Result!)
                .Where(t => t.TeacherId == currentTeacherId)
                .OrderByDescending(t => t.TestDate)
                .ToList();

            recentExams = examTasks
                .Where(t => t.Result != null)
                .SelectMany(t => t.Result!)
                .Where(e => e.TeacherId == currentTeacherId)
                .OrderByDescending(e => e.ExamDate)
                .ToList();

            totalAssessments = recentAssignments.Count + recentTests.Count + recentExams.Count;

            // Fetch marks for every assessment concurrently instead of sequentially.
            var assignmentMarkTasks = recentAssignments
                .Where(a => a.Id.HasValue)
                .Select(a => SafeGetMarksAsync(() => AssessmentService.GetMarksByAssignmentAsync(a.Id!.Value)))
                .ToList();
            var testMarkTasks = recentTests
                .Where(t => t.Id.HasValue)
                .Select(t => SafeGetMarksAsync(() => AssessmentService.GetMarksByTestAsync(t.Id!.Value)))
                .ToList();
            var examMarkTasks = recentExams
                .Where(e => e.Id.HasValue)
                .Select(e => SafeGetMarksAsync(() => AssessmentService.GetMarksByExamAsync(e.Id!.Value)))
                .ToList();

            await Task.WhenAll(
                assignmentMarkTasks.Cast<Task>()
                    .Concat(testMarkTasks.Cast<Task>())
                    .Concat(examMarkTasks.Cast<Task>()));

            var gradedSum = 0;
            var eligibleSum = 0;
            var allScores = new List<double>();

            foreach (var task in assignmentMarkTasks)
            {
                var marks = task.Result;
                if (marks == null) continue;
                gradedSum += marks.Count(m => m.Score.HasValue);
                eligibleSum += marks.Count;
                allScores.AddRange(marks.Where(m => m.Score.HasValue).Select(m => m.Score!.Value));
            }
            foreach (var task in testMarkTasks)
            {
                var marks = task.Result;
                if (marks == null) continue;
                gradedSum += marks.Count(m => m.Score.HasValue);
                eligibleSum += marks.Count;
                allScores.AddRange(marks.Where(m => m.Score.HasValue).Select(m => m.Score!.Value));
            }
            foreach (var task in examMarkTasks)
            {
                var marks = task.Result;
                if (marks == null) continue;
                gradedSum += marks.Count(m => m.Score.HasValue);
                eligibleSum += marks.Count;
                allScores.AddRange(marks.Where(m => m.Score.HasValue).Select(m => m.Score!.Value));
            }

            totalGraded = gradedSum;
            totalEligible = eligibleSum;
            double cr = totalEligible > 0 ? (double)totalGraded / totalEligible * 100 : 0;
            completionRate = cr.ToString("F0");

            double avg = allScores.Any() ? allScores.Average() : 0;
            averageScore = avg.ToString("F1");

            // Build score distribution buckets
            int[] counts = new int[5];
            foreach (var score in allScores)
            {
                if (score >= 80) counts[0]++;
                else if (score >= 70) counts[1]++;
                else if (score >= 60) counts[2]++;
                else if (score >= 50) counts[3]++;
                else counts[4]++;
            }
            int maxCount = counts.Max() == 0 ? 1 : counts.Max();
            string[] colors = { "#16a34a", "#4f46e5", "#60a5fa", "#d97706", "#e11d48" };
            string[] labels = { "A", "B", "C", "D", "U" };
            scoreDistribution = counts.Select((c, i) => new ScoreBar(labels[i], (double)c / maxCount * 100, colors[i])).ToList();
        }
        catch (Exception)
        {
        }
    }

    /// <summary>Awaits a marks-fetch call, swallowing per-assessment failures so one
    /// bad request can't block the rest of the dashboard from loading.</summary>
    private static async Task<List<T>?> SafeGetMarksAsync<T>(Func<Task<List<T>?>> fetcher)
    {
        try { return await fetcher(); }
        catch { return null; }
    }

    private string StaffInitials => $"{(Me.FirstName?.Length > 0 ? Me.FirstName[0] : '?')}{(Me.LastName?.Length > 0 ? Me.LastName[0] : '?')}";
}
