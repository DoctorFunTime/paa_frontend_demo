                    </div>
                }
                @if (indivSelectedStudent != null)
                {
                    <button type="button" class="btn-ghost" style="position:absolute;right:4px;top:4px;padding:3px 7px;" aria-label="Clear selected student" @onclick="ClearIndivStudent">×</button>
                }
            </div>
            <input class="form-control" type="date" @bind="indivStartDate" style="width:160px;" />
            <input class="form-control" type="date" @bind="indivEndDate" style="width:160px;" />
