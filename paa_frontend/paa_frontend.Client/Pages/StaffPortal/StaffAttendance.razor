                    <span class="sum-card-label" style="color:#10b981;">Present</span>
                    <span class="sum-card-val green">@presentCount</span>
                </div>
                <div class="sum-card">
                    <span class="sum-card-label" style="color:#f59e0b;">Late</span>
                    <span class="sum-card-val amber">@lateCount</span>
                </div>
                <div class="sum-card">
                    <span class="sum-card-label" style="color:#ef4444;">Absent</span>
                    <span class="sum-card-val red">@absentCount</span>
                </div>
            </div>

            <div class="cal-card">
                <div class="cal-nav">
                    <button class="cal-btn" @onclick="MyPrevMonth">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6" /></svg>
                    </button>
                    <div class="cal-month">@myViewMonth.ToString("MMMM yyyy")</div>
                    <button class="cal-btn" @onclick="MyNextMonth">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6" /></svg>
                    </button>
                </div>

                <div class="cal-grid">
                    @foreach (var dow in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                    {
                        <div class="cal-dow">@dow</div>
                    }

                    @{
                        var firstDay = new DateOnly(myViewMonth.Year, myViewMonth.Month, 1);
                        var daysInMonth = DateTime.DaysInMonth(myViewMonth.Year, myViewMonth.Month);
                        var startDow = ((int)firstDay.DayOfWeek + 6) % 7;
                    }

                    @for (var i = 0; i < startDow; i++)
                    {
                        <div class="cal-day empty"></div>
                    }

                    @for (var d = 1; d <= daysInMonth; d++)
                    {
                        var day = new DateOnly(myViewMonth.Year, myViewMonth.Month, d);
                        var dayRecord = myRecords.FirstOrDefault(r => r.SessionDate == day);
                        var isToday = day == DateOnly.FromDateTime(DateTime.Now);

                        var statusClass = dayRecord == null ? "" : $"status-{dayRecord.Status.ToLowerInvariant()}";
                        <div class="cal-day @(isToday ? "today" : "") @statusClass" @key="d">
