    private async Task UpdateIndivRecord(long recordId, string status)
    {
        var updated = await AttendanceService.UpdateRecordStatusAsync(recordId, status);
        if (updated != null && indivRecords != null)
        {
            var idx = indivRecords.FindIndex(r => r.Id == recordId);
            if (idx >= 0) indivRecords[idx] = updated;
            StateHasChanged();
        }
    }

    // ── My Attendance (Calendar - Read Only) ──
    private async Task LoadMyAttendanceData()
    {
        var userIdStr = await JS.InvokeAsync<string?>("sessionStorage.getItem", "primeappDemo.userId");
        if (!long.TryParse(userIdStr, out var staffId) || staffId <= 0) { myRecords = new(); return; }

        isLoadingMyAtt = true;
        StateHasChanged();
        try
        {
            var startDate = new DateOnly(myViewMonth.Year, myViewMonth.Month, 1);
            var endDate = startDate.AddMonths(1).AddDays(-1);

            // Use school attendance sessions as the denominator. If this staff
            // member has no record for a completed staff session, show that day
            // as absent rather than silently dropping it from the calendar/rate.
            var sessions = await AttendanceService.GetSessionsByDateRangeAsync(startDate, endDate);
            var apiRecords = await AttendanceService.GetRecordsByPersonAndDateRangeAsync(staffId, startDate, endDate);
            var staffSessions = sessions?
                .Where(s => string.Equals(s.Type, "Staff", StringComparison.OrdinalIgnoreCase))
                .GroupBy(s => s.Date)
                .OrderBy(g => g.Key)
                .ToList() ?? new();
            var staffRecords = apiRecords ?? new();

            myRecords = staffSessions.Select(daySessions =>
            {
                var sessionIds = daySessions.Select(s => s.Id).ToHashSet();
                var record = staffRecords.FirstOrDefault(r => sessionIds.Contains(r.SessionId));
                return new MyAttDayRecord
                {
                    SessionDate = daySessions.Key,
                    Status = record?.Status ?? "Absent",
                    Remarks = record?.Remarks
                };
            }).ToList();
        }
        catch { myRecords = new(); }
        finally { isLoadingMyAtt = false; StateHasChanged(); }
    }

    private async Task MyPrevMonth()
    {
        myViewMonth = myViewMonth.AddMonths(-1);
        await LoadMyAttendanceData();
    }

    private async Task MyNextMonth()
    {
        myViewMonth = myViewMonth.AddMonths(1);
        await LoadMyAttendanceData();
    }
