                }
            </select>
            @if (isLoadingIndivClasses)
            {
                <select class="form-control" style="width:160px;" disabled><option>Loading classes…</option></select>
            }
            else
            {
                <select class="form-control" style="width:160px;" @onchange="OnIndivClassChanged">
