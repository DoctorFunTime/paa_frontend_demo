    private async Task LoadClassForRegister()
    {
        registerLoadAttempted = true;
        registerStudents.Clear();
        existingSession = null;
        isLoadingRegister = true;
        StateHasChanged();

        try
        {
            var filtered = allStudents.Where(s => s.Form == regForm && ClassMatchesFormAndName(s.Classroom, regForm, regClassroom));
            foreach (var s in filtered)
            {
                registerStudents.Add(new RegStudent
                {
                    Id = s.Id,
                    Name = $"{s.FirstName} {s.LastName}".Trim(),
                    Status = "Present"
                });
            }

            var sessions = await AttendanceService.GetSessionsByDateAsync(regDate);
            var classStudentIds = registerStudents.Select(s => s.Id).ToHashSet();
            var candidates = sessions?.Where(s => s.Type == "Student" && s.ReferenceId == regForm).ToList() ?? new();
            AttendanceSessionDto? found = null;
            foreach (var candidate in candidates)
            {
                var candidateRecords = await AttendanceService.GetRecordsBySessionAsync(candidate.Id);
                if (candidateRecords?.Any(r => classStudentIds.Contains(r.PersonId)) == true)
                {
                    found = candidate;
                    break;
                }
            }
            if (found != null)
            {
                existingSession = found;
                var records = await AttendanceService.GetRecordsBySessionAsync(found.Id);
                if (records != null)
                {
                    foreach (var r in records)
                    {
                        var student = registerStudents.FirstOrDefault(s => s.Id == r.PersonId);
                        if (student != null) student.Status = r.Status;
                    }
                }
            }
        }
        catch (Exception)
        {
            Console.WriteLine($"[STAFF ATTENDANCE] Error loading class");
        }
        finally { isLoadingRegister = false; StateHasChanged(); }
    }

    private async Task LoadRegisterHistoryAsync()
    {
        if (regForm <= 0 || string.IsNullOrWhiteSpace(regClassroom) || registerHistoryStart > registerHistoryEnd) return;
        isLoadingRegisterHistory = true;
        registerHistory.Clear();
        StateHasChanged();
        try
        {
            var classStudentIds = allStudents
                .Where(s => s.Form == regForm && ClassMatchesFormAndName(s.Classroom, regForm, regClassroom))
                .Select(s => (long)s.Id)
                .ToHashSet();
            var sessions = await AttendanceService.GetSessionsByDateRangeAsync(registerHistoryStart, registerHistoryEnd);
            foreach (var session in (sessions ?? new List<AttendanceSessionDto>())
                .Where(s => s.Type == "Student" && s.ReferenceId == regForm)
                .OrderByDescending(s => s.Date))
            {
                var records = await AttendanceService.GetRecordsBySessionAsync(session.Id);
                var classRecords = (records ?? new List<AttendanceRecordDto>())
                    .Where(r => classStudentIds.Contains(r.PersonId))
                    .ToList();
                if (!classRecords.Any()) continue;
                registerHistory.Add(new RegisterHistoryDay
                {
                    Date = session.Date,
                    Session = session,
                    Present = classRecords.Count(r => r.Status == "Present"),
                    Late = classRecords.Count(r => r.Status == "Late"),
                    Absent = classRecords.Count(r => r.Status == "Absent")
                });
            }
        }
        finally
        {
            isLoadingRegisterHistory = false;
            StateHasChanged();
        }
    }

    private static bool ClassMatchesFormAndName(string? classroom, int form, string selectedClass)
    {
        if (string.IsNullOrWhiteSpace(classroom) || string.IsNullOrWhiteSpace(selectedClass))
            return false;

        static string Normalize(string value) =>
            new string(value.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();

        var actual = Normalize(classroom);
        var selected = Normalize(selectedClass);
        var formText = form.ToString();

        if (actual == selected || actual == formText + selected || actual == selected + formText)
            return true;

        if (actual.StartsWith("form" + formText)) actual = actual[("form" + formText).Length..];
        else if (actual.StartsWith(formText)) actual = actual[formText.Length..];
        if (selected.StartsWith("form" + formText)) selected = selected[("form" + formText).Length..];
        else if (selected.StartsWith(formText)) selected = selected[formText.Length..];

        return actual == selected;
    }

    private async Task SaveClassRegister()
    {
        isSavingRegister = true;
        StateHasChanged();
        try
        {
            var userIdStr = await JS.InvokeAsync<string?>("sessionStorage.getItem", "primeappDemo.userId");
            long.TryParse(userIdStr, out var teacherId);

            if (existingSession != null)
            {
                var existingRecords = await AttendanceService.GetRecordsBySessionAsync(existingSession.Id);
                if (existingRecords != null)
                {
                    foreach (var s in registerStudents)
                    {
                        var existing = existingRecords.FirstOrDefault(r => r.PersonId == s.Id);
                        if (existing != null)
                        {
                            await AttendanceService.UpdateRecordStatusAsync(existing.Id, s.Status);
                        }
                    }
                }
            }
            else
            {
                var dto = new CreateAttendanceSessionDto
                {
                    Date = regDate,
                    Type = "Student",
                    ReferenceId = regForm,
                    CreatedBy = teacherId,
                    Records = registerStudents.Select(s => new AttendanceRecordInputDto
                    {
                        PersonId = s.Id,
                        PersonType = "Student",
                        Status = s.Status,
                        Remarks = null
                    }).ToList()
                };
                var session = await AttendanceService.CreateSessionWithClassAsync(dto, regForm, regClassroom);
                if (session != null) existingSession = session;
            }
        }
        finally { isSavingRegister = false; StateHasChanged(); }
    }

