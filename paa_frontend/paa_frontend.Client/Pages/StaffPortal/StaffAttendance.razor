                                        <div class="toggle-group">
                                            <button class="toggle-btn present @(r.Status == "Present" ? "active" : "")" @onclick='() => UpdateIndivRecord(r.Id, "Present")'>P</button>
                                            <button class="toggle-btn late @(r.Status == "Late" ? "active" : "")" @onclick='() => UpdateIndivRecord(r.Id, "Late")'>L</button>
                                            <button class="toggle-btn absent @(r.Status == "Absent" ? "active" : "")" @onclick='() => UpdateIndivRecord(r.Id, "Absent")'>A</button>
                                            <button class="toggle-btn excused @(r.Status == "Excused" ? "active" : "")" @onclick='() => UpdateIndivRecord(r.Id, "Excused")'>E</button>
