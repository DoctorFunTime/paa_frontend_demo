                </div>

                <div class="legend-row">
                    <div class="legend-item"><div class="legend-dot" style="background:#10b981;"></div> Present</div>
                    <div class="legend-item"><div class="legend-dot" style="background:#f59e0b;"></div> Late</div>
                    <div class="legend-item"><div class="legend-dot" style="background:#ef4444;"></div> Absent</div>
                    <div class="legend-item"><div class="legend-dot" style="background:#6366f1;"></div> Excused</div>
                </div>
            </div>
        }
    }
