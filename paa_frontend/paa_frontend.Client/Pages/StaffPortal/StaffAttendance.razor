        }
        else if (indivRecords != null)
        {
            <div class="table-card"><div class="empty-state">No attendance records found for this student in the selected range</div></div>
        }
    }

    @* ── MY ATTENDANCE (Calendar View - Read Only) ── *@
    @if (activeTab == "myattendance")
    {
        if (isLoadingMyAtt)
        {
            <div class="cal-card">
                <div aria-label="Loading attendance" role="status">
                    <div class="attendance-skeleton-summary">
