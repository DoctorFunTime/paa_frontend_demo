</div>

@code {
    private string activeTab = "register";
    private bool isPrintingClassList;

    // Lookups
    private Dictionary<long, string> createdByNames = new();
    private List<Student> allStudents = new();
    private bool lookupsLoaded = false;

    // Class name loading
    private List<string> availableClasses = new();
    private bool isLoadingClasses = false;

    // Class Register
    private int regForm;
    private string regClassroom = "";
    private DateOnly regDate = DateOnly.FromDateTime(DateTime.Now);
    private bool registerLoadAttempted = false;
    private bool isLoadingRegister = false;
    private bool isSavingRegister = false;
    private AttendanceSessionDto? existingSession;
    private List<RegStudent> registerStudents = new();
    private DateOnly registerHistoryStart = DateOnly.FromDateTime(DateTime.Now.AddDays(-30));
    private DateOnly registerHistoryEnd = DateOnly.FromDateTime(DateTime.Now);
    private bool isLoadingRegisterHistory;
    private List<RegisterHistoryDay> registerHistory = new();

    public class RegStudent
    {
        public long Id { get; set; }
        public string Name { get; set; } = "";
        public string Status { get; set; } = "Present";
    }

    public class RegisterHistoryDay
    {
        public DateOnly Date { get; set; }
        public AttendanceSessionDto Session { get; set; } = new();
        public int Present { get; set; }
        public int Late { get; set; }
        public int Absent { get; set; }
    }

    // Individual
    private int indivForm;
    private string indivClassroom = "";
    private string indivSearchTerm = "";
    private long indivStudentId;
    private Student? indivSelectedStudent;
    private bool indivComboOpen;
    private DateOnly indivStartDate = DateOnly.FromDateTime(DateTime.Now.AddDays(-30));
    private DateOnly indivEndDate = DateOnly.FromDateTime(DateTime.Now);
    private List<AttendanceRecordDto>? indivRecords;
    private Dictionary<long, DateOnly> indivSessionDates = new();
    private List<string> indivAvailableClasses = new();
    private bool isLoadingIndivClasses = false;
    private bool isLoadingIndiv = false;

    // My Attendance (calendar)
    private DateOnly myViewMonth = new DateOnly(DateTime.Now.Year, DateTime.Now.Month, 1);
    private List<MyAttDayRecord>? myRecords;
    private bool isLoadingMyAtt = false;
    private int? classListForm;
    private string classListClassroom = "";
    private List<string> classListClassrooms = new();

    public class MyAttDayRecord
    {
        public DateOnly SessionDate { get; set; }
        public string Status { get; set; } = "Present";
        public string? Remarks { get; set; }
    }

    private IEnumerable<Student> filteredIndivStudents
    {
        get
        {
            var term = (indivSearchTerm ?? "").Trim().ToLowerInvariant();
            var pool = allStudents.AsEnumerable();
            if (indivForm > 0) pool = pool.Where(s => s.Form == indivForm);
            if (!string.IsNullOrEmpty(indivClassroom)) pool = pool.Where(s => ClassMatchesFormAndName(s.Classroom, indivForm, indivClassroom));
            if (!string.IsNullOrWhiteSpace(term))
                pool = pool.Where(s => (s.FirstName + " " + s.LastName).ToLowerInvariant().Contains(term));
            return pool.Take(20);
        }
    }

    private List<Student> classListStudents =>
        allStudents
            .Where(s => classListForm.HasValue
                && s.Form == classListForm.Value
                && ClassMatchesFormAndName(s.Classroom, classListForm.Value, classListClassroom))
            .OrderBy(s => s.LastName)
            .ThenBy(s => s.FirstName)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        // These two loads are independent of each other, so run them concurrently
        // instead of one after another to cut initial page load time roughly in half.
        await Task.WhenAll(LoadLookups(), LoadMyAttendanceData());
    }

    private async Task LoadLookups()
    {
        if (lookupsLoaded) return;
        lookupsLoaded = true;
        try
        {
            var teachersTask = TeacherService.GetTeachersAsync();
            var studentsTask = StudentService.GetStudentsAsync();
            await Task.WhenAll(teachersTask, studentsTask);

            var teachers = teachersTask.Result;
            if (teachers != null)
                foreach (var t in teachers)
                    createdByNames[t.Id] = $"{t.FirstName} {t.LastName}".Trim();

            allStudents = studentsTask.Result ?? new();
            RefreshClassListClassrooms();
        }
        catch (Exception)
        {
            Console.WriteLine($"Lookup error");
        }
    }

    private string ResolveCreatedBy(long createdBy)
    {
        if (createdByNames.TryGetValue(createdBy, out var name)) return name;
        return $"User #{createdBy}";
    }

    private string GetLevel(int form) => form switch
    {
        >= 1 and <= 4 => "form1to4",
        >= 5 and <= 6 => "alevel",
        _ => ""
    };

    private async Task LoadClassNamesAsync(int form, Action<List<string>> setter, Action<bool> loadingSetter)
    {
        setter(new());
        if (form < 1 || form > 6) return;

        loadingSetter(true);
        StateHasChanged();
        try
        {
            switch (GetLevel(form))
            {
                case "form1to4":
                    setter(allStudents
                        .Where(s => s.Form == form && !string.IsNullOrWhiteSpace(s.Classroom))
                        .Select(s => s.Classroom!)
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(c => c)
                        .ToList());
                    break;
                case "olevel":
                    setter(allStudents
                        .Where(s => s.Form == form && !string.IsNullOrWhiteSpace(s.Classroom))
                        .Select(s => s.Classroom!)
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(c => c)
                        .ToList());
                    break;
                case "alevel":
                    var alevel = await AClassService.GetAllAlevelClassNamesAsync();
                    setter(alevel.Select(c => c.ClassName ?? "").Where(c => !string.IsNullOrWhiteSpace(c)).OrderBy(c => c).ToList());
                    break;
            }
        }
        catch { setter(new()); }
        finally { loadingSetter(false); StateHasChanged(); }
    }

    private async Task OnRegFormChanged(ChangeEventArgs e)
    {
        regForm = int.TryParse(e.Value?.ToString(), out var f) ? f : 0;
        regClassroom = "";
        registerStudents.Clear();
        registerLoadAttempted = false;
        await LoadClassNamesAsync(regForm, list => availableClasses = list, loading => isLoadingClasses = loading);
    }

    private void OnRegClassChanged(ChangeEventArgs e)
    {
        regClassroom = e.Value?.ToString() ?? "";
        registerStudents.Clear();
        registerLoadAttempted = false;
    }

