                @if (indivComboOpen && filteredIndivStudents.Any())
                {
                    <div id="individual-student-options" class="search-dropdown" role="listbox">
                        @foreach (var s in filteredIndivStudents.Take(10))
                        {
                            <div class="search-item" role="option" @key="s.Id" @onclick='() => SelectIndivStudent(s)'>
                                <div class="search-item-name">@s.FirstName @s.LastName</div>
                                <div class="search-item-meta">Form @s.Form @s.Classroom</div>
                            </div>
