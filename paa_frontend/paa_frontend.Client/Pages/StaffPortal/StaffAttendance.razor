        if (isLoadingIndiv)
        {
            <div class="attendance-skeleton-summary" aria-label="Loading student attendance" role="status">
                <div class="skeleton"></div><div class="skeleton"></div>
                <div class="skeleton"></div><div class="skeleton"></div>
            </div>
            <div class="skeleton attendance-skeleton-list"></div>
