@page "/admin/teachers/edit/{TeacherId:long}"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using paa_frontend.Client.Services
@using static paa_frontend.Shared.Models.TeacherProfileModel
@inject TeacherProfileServiceClient TeacherService
@inject paa_frontend.Client.Services.NotificationService NotificationService
@inject NavigationManager Nav

@if (isLoading)
{
    <AdminLoadingSkeleton />
}

<style>
    .teacher-shell {
        max-width: 1120px;
        margin: 0 auto;
        width: 100%;
        padding-bottom: 48px;
    }

    .teacher-hero,
    .teacher-card {
        background: rgba(255,255,255,0.88);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(226,232,240,0.9);
        border-radius: 28px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
    }

    .teacher-hero {
        padding: 28px;
        margin-bottom: 18px;
    }

    .teacher-card {
        padding: 24px;
    }

    .teacher-name {
        color: #0f172a;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 1.05;
    }

    .teacher-sub {
        color: #475569;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.8rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #334155;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .section-title {
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        margin-bottom: 18px;
    }

    .field-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .label {
        color: #475569;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .control {
        width: 100%;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1.5px solid #cbd5e1;
        background: #ffffff;
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 600;
        outline: none;
    }

    .control:focus {
        border-color: #1a4fff;
        box-shadow: 0 0 0 4px rgba(26, 79, 255, 0.10);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 22px;
    }

    .btn {
        border: none;
        border-radius: 14px;
        padding: 12px 18px;
        font-size: 0.9rem;
        font-weight: 800;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }

    .btn:hover {
        transform: translateY(-1px);
    }

    .btn-primary {
        background: #1a4fff;
        color: white;
        box-shadow: 0 10px 24px rgba(26, 79, 255, 0.18);
    }

    .btn-secondary {
        background: white;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

    .status {
        margin-top: 14px;
        padding: 12px 14px;
        border-radius: 14px;
        font-size: 0.88rem;
        font-weight: 700;
    }

    .status-ok {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .status-error {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    @@media (max-width: 768px) {
        .teacher-shell {
            padding-bottom: 28px;
        }

        .teacher-hero,
        .teacher-card {
            border-radius: 22px;
        }

        .field-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="teacher-shell">
    @if (isLoading)
    {
        <div class="teacher-card">
            <div class="text-sm font-bold text-slate-500">Loading teacher details...</div>
        </div>
    }
    else if (teacher == null)
    {
        <div class="teacher-card text-center">
            <div class="text-xl font-extrabold text-slate-900 mb-2">Teacher not found</div>
            <div class="text-sm text-slate-600 mb-6">The selected teacher record could not be loaded.</div>
            <button type="button" class="btn btn-primary" @onclick='() => Nav.NavigateTo("/admin/teachers")'>Back to Teachers</button>
        </div>
    }
    else
    {
        <div class="teacher-hero">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5">
                <div class="flex items-center gap-4 min-w-0">
                    <div class="w-16 h-16 rounded-2xl bg-slate-100 border border-slate-200 flex items-center justify-center text-xl font-black text-slate-700 shrink-0">
                        @TeacherInitials
                    </div>
                    <div class="min-w-0">
                        <div class="teacher-name">@teacher.FirstName @teacher.LastName</div>
                        <div class="teacher-sub mt-2">Edit teacher contact and profile details.</div>
                        <div class="mt-3 flex flex-wrap gap-2">
                            <span class="chip">Teacher</span>
                            <span class="chip">ID @teacher.Id</span>
                            <span class="chip">@(teacher.Status ?? "Active")</span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <button type="button" class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/admin/teachers")'>Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save Changes")
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="status @(statusIsError ? "status-error" : "status-ok")">@statusMessage</div>
            }
        </div>

        <EditForm Model="@teacher" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="teacher-card">
                <div class="section-title">Teacher Details</div>
                <div class="field-grid">
                    <div class="field">
                        <label class="label">First Name</label>
                        <InputText class="control" @bind-Value="teacher.FirstName" />
                    </div>
                    <div class="field">
                        <label class="label">Last Name</label>
                        <InputText class="control" @bind-Value="teacher.LastName" />
                    </div>
                    <div class="field">
                        <label class="label">Email Address</label>
                        <InputText class="control" @bind-Value="teacher.Email" type="email" />
                    </div>
                    <div class="field">
                        <label class="label">Phone Number</label>
                        <InputText class="control" @bind-Value="teacher.Phone" type="tel" />
                    </div>
                    <div class="field">
                        <label class="label">Gender</label>
                        <InputSelect class="control" @bind-Value="teacher.Gender">
                            <option value="">Select gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                    </div>
                    <div class="field">
                        <label class="label">Status</label>
                        <InputSelect class="control" @bind-Value="teacher.Status">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Suspended">Suspended</option>
                        </InputSelect>
                    </div>
                    <div class="field">
                        <label class="label">National ID</label>
                        <InputText class="control" @bind-Value="teacher.NationalId" />
                    </div>
                    <div class="field">
                        <label class="label">Date of Birth</label>
                        <InputDate class="control" @bind-Value="teacher.DateOfBirth" />
                    </div>
                </div>

                <div class="actions">
                    <button type="button" class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/admin/teachers")'>Back</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">Save Changes</button>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public long TeacherId { get; set; }

    private Teacher? teacher;
    private bool isLoading = true;
    private bool isSaving;
    private bool statusIsError;
    private string? statusMessage;

    private string TeacherInitials =>
        $"{(string.IsNullOrWhiteSpace(teacher?.FirstName) ? "T" : teacher!.FirstName!.Trim()[0].ToString().ToUpperInvariant())}{(string.IsNullOrWhiteSpace(teacher?.LastName) ? "E" : teacher!.LastName!.Trim()[0].ToString().ToUpperInvariant())}";

    protected override async Task OnInitializedAsync()
    {
        await LoadTeacherAsync();
    }

    private async Task LoadTeacherAsync()
    {
        isLoading = true;
        statusMessage = null;
        statusIsError = false;

        try
        {
            teacher = await TeacherService.GetTeacherAsync(TeacherId);
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to load teacher: {ex.Message}";
            statusIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (teacher == null)
            return;

        isSaving = true;
        statusMessage = null;
        statusIsError = false;

        try
        {
            var response = await TeacherService.UpdateTeacherAsync(teacher.Id, teacher);
            if (response.IsSuccessStatusCode)
            {
                statusMessage = "Teacher details updated successfully.";
                statusIsError = false;
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                statusMessage = string.IsNullOrWhiteSpace(body)
                    ? $"Teacher update failed with status {(int)response.StatusCode}."
                    : body;
                statusIsError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Save failed: {ex.Message}";
            statusIsError = true;
        }
        finally
        {
            isSaving = false;
        }
    }
}
