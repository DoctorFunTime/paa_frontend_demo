@page "/admin/grades/reports"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using paa_frontend.Client.Services.Admin
@using paa_frontend.Client.Services.StaffPortal
@using paa_frontend.Shared.Models
@using static paa_frontend.Shared.Models.StudentProfileModel
@inject AdminGradesServiceClient AdminGradesService
@inject StudentProfileServiceClient StudentProfileService
@inject OlevelClassServiceClient OlevelClassService
@inject AssessmentServiceClient AssessmentService
@inject NavigationManager Nav


<style>
    .hub-nav-link {
        padding: 0.75rem 1.25rem;
        font-weight: 700;
        font-size: 0.875rem;
        color: #64748b;
        border-bottom: 2px solid transparent;
        transition: all 0.15s ease-in-out;
        text-decoration: none;
    }
    .hub-nav-link.active {
        color: #059669;
        border-bottom-color: #059669;
    }
    .hub-nav-link:hover {
        color: #047857;
    }
    .hub-nav {
        min-width: 0;
        overflow-x: auto;
        scrollbar-width: none;
    }
    .hub-nav::-webkit-scrollbar { display: none; }
    
    .rm-hero {
        background: linear-gradient(135deg, #064e3b 0%, #065f46 45%, #047857 100%);
        border-radius: 1.5rem;
        padding: 1.75rem 2rem;
        color: #fff;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }
    .rm-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 50%, rgba(255,255,255,0.06) 0%, transparent 60%);
        border-radius: inherit;
    }

    .metric-chip {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 1rem;
        padding: 0.75rem 1.25rem;
        backdrop-filter: blur(12px);
        min-width: 130px;
    }

    .card {
        background: #fff;
        border-radius: 1.25rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        overflow: hidden;
        min-width: 0;
        max-width: 100%;
    }

    .btn-approve {
        padding: 0.5rem 1rem;
        background: #047857;
        color: #fff;
        border: none;
        border-radius: 0.6rem;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
    }
    .btn-approve:hover:not(:disabled) {
        background: #065f46;
        transform: translateY(-1px);
    }
    .btn-approve:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-view {
        padding: 0.5rem 0.875rem;
        background: #fff;
        color: #475569;
        border: 1px solid #e2e8f0;
        border-radius: 0.6rem;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
    }
    .btn-view:hover:not(:disabled) {
        background: #f8fafc;
        color: #1e293b;
    }

    .btn-regenerate {
        padding: 0.5rem 1rem;
        background: #d97706;
        color: #fff;
        border: none;
        border-radius: 0.6rem;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        white-space: nowrap;
    }
    .btn-regenerate:hover:not(:disabled) {
        background: #b45309;
        transform: translateY(-1px);
    }
    .btn-regenerate:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-regenerate-outline {
        padding: 0.4rem 0.75rem;
        background: #fff;
        color: #b45309;
        border: 1px solid #fde68a;
        border-radius: 0.6rem;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        white-space: nowrap;
    }
    .btn-regenerate-outline:hover:not(:disabled) {
        background: #fffbeb;
        border-color: #f59e0b;
        color: #92400e;
    }
    .btn-regenerate-outline:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .search-input {
        padding: 0.6rem 1rem;
        border: 1.5px solid #e2e8f0;
        border-radius: 0.75rem;
        font-size: 0.875rem;
        outline: none;
        transition: border-color 0.15s;
        background: #fff;
    }
    .search-input:focus {
        border-color: #047857;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .badge-pending { background: #fef9c3; color: #854d0e; }
    .badge-approved { background: #dcfce7; color: #166534; }
    .badge-fail { background: #fee2e2; color: #b91c1c; }
    .badge-warn { background: #fffbeb; color: #d97706; }
    
    .status-tab-btn {
        padding: 1rem 1.25rem;
        font-weight: 800;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 2px solid transparent;
        transition: all 0.15s ease-in-out;
        white-space: nowrap;
        background: transparent;
        border-top: none;
        border-left: none;
        border-right: none;
        cursor: pointer;
    }

    .table-wrap {
        overflow-x: auto;
        min-width: 0;
        max-width: 100%;
    }
    table {
        width: 100%;
        border-collapse: collapse;
    }
    thead th {
        padding: 0.875rem 1.25rem;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
    }
    tbody td {
        padding: 1rem 1.25rem;
        font-size: 0.875rem;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    tbody tr:hover {
        background: rgba(16, 185, 129, 0.02);
    }

    /* Modal Styling */
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        z-index: 999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }
    .modal {
        background: #fff;
        border-radius: 1.5rem;
        width: 100%;
        max-width: 780px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        display: flex;
        flex-direction: column;
    }
    .modal-header {
        padding: 1.5rem 1.75rem;
        border-bottom: 1px solid #f1f5f9;
        position: sticky;
        top: 0;
        background: #fff;
        z-index: 10;
    }
    .modal-body {
        padding: 1.5rem 1.75rem;
        overflow-y: auto;
        flex: 1;
    }
    .modal-footer {
        padding: 1.25rem 1.75rem;
        border-top: 1px solid #f1f5f9;
        display: flex;
        gap: 0.75rem;
        justify-content: flex-end;
        position: sticky;
        bottom: 0;
        background: #fff;
        z-index: 10;
    }

    .subject-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        border-radius: 0.75rem;
        background: #f8fafc;
        margin-bottom: 0.5rem;
        border: 1px solid #f1f5f9;
    }
    .detail-tab-row {
        display: flex;
        border-bottom: 2px solid #e2e8f0;
        margin-bottom: 1.25rem;
    }
    .detail-tab {
        padding: 0.6rem 1.2rem;
        font-size: 0.8rem;
        font-weight: 700;
        color: #64748b;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: all 0.15s;
    }
    .detail-tab.active {
        color: #047857;
        border-bottom-color: #047857;
    }
    .detail-tab:hover {
        color: #1e293b;
    }
    .mark-chip {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.6rem;
        border-radius: 0.5rem;
        font-size: 0.8rem;
        font-weight: 700;
        font-family: monospace;
        margin: 0.15rem;
    }
    .weight-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.55rem;
        border-radius: 9999px;
        font-size: 0.65rem;
        font-weight: 800;
        background: #d1fae5;
        color: #065f46;
    }

    @@media (max-width: 640px) {
        .card, .rm-hero, .flex, .grid > * {
            min-width: 0;
            max-width: 100%;
        }
        .rm-hero .flex {
            flex-wrap: wrap;
        }
        .hub-nav-link {
            padding: 0.65rem 0.75rem;
            font-size: 0.72rem;
            white-space: nowrap;
        }
        .rm-hero {
            padding: 1.25rem 1rem;
            border-radius: 1rem;
            margin-bottom: 1rem;
        }
        .rm-hero h1 {
            font-size: 1.5rem;
            line-height: 1.2;
        }
        .metric-chip {
            flex: 1 1 calc(50% - 0.5rem);
            min-width: 0;
            padding: 0.65rem 0.5rem;
        }
        .card {
            border-radius: 0.85rem;
        }
        .search-input {
            width: 100% !important;
            min-width: 0 !important;
        }
        .table-wrap {
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
        }
        .table-wrap table {
            min-width: 940px;
        }
        .table-wrap thead th,
        .table-wrap tbody td {
            padding: 0.7rem 0.75rem;
        }
        .status-tab-btn {
            padding: 0.8rem 0.75rem;
            font-size: 0.68rem;
        }
        .modal-backdrop {
            padding: 0.5rem;
            align-items: flex-end;
        }
        .modal {
            max-height: calc(100vh - 1rem);
            border-radius: 1rem;
        }
        .modal-header,
        .modal-body,
        .modal-footer {
            padding: 1rem;
        }
        .modal-footer {
            flex-direction: column-reverse;
        }
        .modal-footer button {
            width: 100%;
        }
        .subject-row {
            align-items: flex-start;
            gap: 0.75rem;
        }
    }
</style>

<!-- Grades Hub Navigation Header -->
<div class="hub-nav flex border-b border-slate-200 mb-6 gap-2">
    <a href="/admin/grades/approval" class="hub-nav-link">
        1. Marks Review &amp; Generation
    </a>
    <a href="/admin/grades/reports" class="hub-nav-link active">
        2. Report Approval Queue
    </a>
</div>

<!-- Hero Section -->
<div class="rm-hero shadow-lg mb-6">
    <div class="relative z-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <span class="inline-block px-3 py-1 rounded-full bg-white/20 text-white text-[length:0.65rem] font-extrabold uppercase tracking-widest mb-3 border border-white/20">
                    Admin Portal
                </span>
                <h1 class="text-3xl font-black tracking-tight mb-2 text-white">Report Approval Queue</h1>
                <p class="text-white/80 text-sm font-medium max-w-lg">
                    Review generated report cards and release them to student accounts. Approved cards are instantly downloadable by students and parents.
                </p>
            </div>
            
            <div class="flex gap-3 flex-wrap">
                <div class="metric-chip text-center">
                    <div class="text-white/70 text-[length:0.6rem] font-bold uppercase tracking-wider mb-1">Ready for Approval</div>
                    <div class="text-2xl font-black">@allLoadedCards.Count(IsReadyForApproval)</div>
                    <div class="text-white/60 text-[length:0.55rem] mt-0.5">
                        @if (allLoadedCards.Any(IsReadyForApproval))
                        {
                            @($"avg {allLoadedCards.Where(IsReadyForApproval).Average(CardAverage):F0}% class mark")
                        }
                        else { @("none ready") }
                    </div>
                </div>
                <div class="metric-chip text-center">
                    <div class="text-white/70 text-[length:0.6rem] font-bold uppercase tracking-wider mb-1">Needs Attention</div>
                    <div class="text-2xl font-black">@allLoadedCards.Count(IsPendingReview)</div>
                    <div class="text-white/60 text-[length:0.55rem] mt-0.5">Incomplete or not submitted</div>
                </div>
                <div class="metric-chip text-center">
                    <div class="text-white/70 text-[length:0.6rem] font-bold uppercase tracking-wider mb-1">Approved This Session</div>
                    <div class="text-2xl font-black">@approvedToday</div>
                    <div class="text-white/60 text-[length:0.55rem] mt-0.5">Released to students</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMsg))
{
    <div class="mb-6 p-4 rounded-2xl text-sm font-bold border @(statusError ? "bg-rose-50 text-rose-700 border-rose-200" : "bg-emerald-50 text-emerald-700 border-emerald-200")">
        <div class="flex items-center gap-2">
            @if (statusError)
            {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            }
            else
            {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            }
            <span>@statusMsg</span>
        </div>
    </div>
}

<div class="card mb-6">
    <!-- Filter bar -->
    <div class="bg-slate-50 border-b border-slate-200 p-4 flex flex-col xl:flex-row justify-between items-stretch xl:items-center gap-4">
        
        <div class="flex flex-wrap items-center gap-3">
            <select class="search-input" style="min-width:160px;" @bind="filterLevel" @bind:after="OnFilterChangedAsync">
                <option value="">All Levels</option>
                <option value="form1to4">Forms 1–4</option>
                <option value="olevel">O-Level (Form 3 &amp; 4)</option>
                <option value="alevel">A-Level (Form 5 &amp; 6)</option>
            </select>

            <select class="search-input" style="min-width:170px;" @bind="filterClass" @bind:after="OnFilterChangedAsync">
                <option value="">All Classes</option>
                @foreach (var className in AvailableClasses)
                {
                    <option value="@className">@className</option>
                }
            </select>
            
            <select class="search-input" style="min-width:140px;" @bind="filterTerm" @bind:after="OnFilterChangedAsync">
                <option value="">All Terms</option>
                <option value="Term 1">Term 1</option>
                <option value="Term 2">Term 2</option>
                <option value="Term 3">Term 3</option>
            </select>
            
            <input class="search-input" style="width:100px;" type="number" @bind="filterYear" @bind:after="OnFilterChangedAsync" placeholder="Year" />

            <button class="btn-view" @onclick="LoadDataAsync" disabled="@isLoading">
                @if (isLoading)
                {
                    <svg class="inline w-3 h-3 animate-spin mr-1 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
                }
                Refresh Cards
            </button>

            <button class="btn-regenerate" @onclick="PromptRegenerateAll" disabled="@(isLoading || isRegenerating || !FilteredCards.Any())" title="Delete existing generated reports and regenerate fresh ones to await approval">
                @if (isRegenerating && regenTargetMode == RegenMode.All)
                {
                    <svg class="inline w-3.5 h-3.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
                    <span>Regenerating (@regenProgressCurrent/@regenProgressTotal)...</span>
                }
                else
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
                    <span>Regenerate All (@FilteredCards.Count) Reports</span>
                }
            </button>
        </div>

        <div class="flex items-center gap-2 max-w-sm">
            <svg class="text-slate-400 shrink-0 ml-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input class="form-control search-input" type="text" placeholder="Search by student name..."
                   @bind="searchTerm" @bind:event="oninput" />
        </div>
    </div>

    <!-- Mutually exclusive queues: ready, incomplete/pending, and approved -->
    <div class="flex border-b border-slate-200 overflow-x-auto flex-nowrap bg-white">
        <button class="status-tab-btn @(activeTab == "ready" ? "border-emerald-600 text-emerald-600" : "border-transparent text-slate-500 hover:text-slate-900")"
                @onclick='() => { activeTab = "ready"; selectedIds.Clear(); }'>
            Ready for Approval (@FilteredCards.Count(IsReadyForApproval))
        </button>
        <button class="status-tab-btn @(activeTab == "pending" ? "border-emerald-600 text-emerald-600" : "border-transparent text-slate-500 hover:text-slate-900")"
                @onclick='() => { activeTab = "pending"; selectedIds.Clear(); }'>
            Pending / Needs Attention (@FilteredCards.Count(IsPendingReview))
        </button>
        <button class="status-tab-btn @(activeTab == "approved" ? "border-emerald-600 text-emerald-600" : "border-transparent text-slate-500 hover:text-slate-900")"
                @onclick="ShowApprovedQueueAsync">
            Approved &amp; Released (@FilteredCards.Count(c => c.AdminApproved))
        </button>
    </div>

    @if (isLoading)
    {
        <div class="p-16 text-center">
            <svg class="mx-auto mb-4 animate-spin text-emerald-600" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
            <h4 class="text-base font-extrabold text-slate-900">Loading report cards...</h4>
            <p class="text-xs text-slate-500 mt-1">Retrieving draft and approved documents from the server.</p>
        </div>
    }
    else
    {
        var displayCards = FilteredCards.Where(c => activeTab switch
        {
            "ready" => IsReadyForApproval(c),
            "pending" => IsPendingReview(c),
            "approved" => c.AdminApproved,
            _ => false
        }).ToList();
        
        if (!displayCards.Any())
        {
            <div class="p-16 text-center text-slate-400">
                <svg class="mx-auto mb-4" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                <h4 class="text-base font-bold text-slate-700">No Report Cards Found</h4>
                <p class="text-xs text-slate-400 mt-1">
                    @(activeTab == "ready" ? "No complete, submitted reports are ready for approval." : activeTab == "pending" ? "No incomplete or unsubmitted reports need attention." : "No approved report cards found matching the criteria.")
                </p>
            </div>
        }
        else
        {
            <div class="p-4 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <input type="checkbox" id="selectAll" class="w-4 h-4 rounded text-emerald-600 border-slate-300 focus:ring-emerald-500"
                           checked="@(displayCards.Any() && displayCards.All(c => selectedIds.Contains(c.Id ?? 0)))"
                           @onchange="@(e => ToggleSelectAll((bool)e.Value!, displayCards))" />
                    <label for="selectAll" class="text-xs font-bold text-slate-700 uppercase tracking-wider cursor-pointer">
                        Select All @(activeTab == "ready" ? "Ready" : activeTab == "pending" ? "Pending" : "Approved") (@displayCards.Count)
                    </label>
                </div>
                
                @if (selectedIds.Any())
                {
                    <div class="flex items-center gap-2 flex-wrap">
                        @if (activeTab == "ready")
                        {
                            <button class="btn-approve !py-1.5 !px-4 !text-xs shadow-sm flex items-center gap-1.5"
                                    disabled="@(isBulkApproving || isRegenerating)"
                                    @onclick="ApproveSelectedAsync">
                                @if (isBulkApproving)
                                {
                                    <svg class="animate-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
                                    <span>Approving...</span>
                                }
                                else
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                    <span>Approve @selectedIds.Count Selected</span>
                                }
                            </button>
                        }

                        <button class="btn-regenerate !py-1.5 !px-4 !text-xs shadow-sm flex items-center gap-1.5"
                                disabled="@(isBulkApproving || isRegenerating)"
                                title="Delete selected reports and regenerate anew to await approval"
                                @onclick="PromptRegenerateSelected">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
                            <span>Regenerate @selectedIds.Count Selected</span>
                        </button>
                    </div>
                }
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 40px;"></th>
                            <th>Student</th>
                            <th>Term / Year</th>
                            <th>Subjects</th>
                            <th>Average</th>
                            <th>Failing</th>
                            <th>Remarks</th>
                            <th>Subject Comments</th>
                            <th>Status</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var card in displayCards)
                        {
                            var average = CardAverage(card);
                            var fails = FailedSubjectCount(card);
                            var isHighRisk = average < 50 || fails > 0;
                            var missingComments = string.IsNullOrWhiteSpace(card.OverallComments);
                            var missingSubjectComments = MissingSubjectCommentCount(card);

                            <tr>
                                <td>
                                    <input type="checkbox" class="w-4 h-4 rounded text-emerald-600 border-slate-300 focus:ring-emerald-500"
                                           checked="@(selectedIds.Contains(card.Id ?? 0))"
                                           @onchange="@(_ => ToggleCardSelect(card.Id ?? 0))" />
                                </td>
                                <td>
                                    <div class="font-bold text-slate-900 leading-tight">@GetStudentName(card.StudentId)</div>
                                    <div class="text-xs text-slate-400 mt-0.5">Form @card.StudentForm @card.StudentClass &bull; ID #@card.StudentId</div>
                                </td>
                                <td>
                                    <span class="font-semibold text-slate-700">@card.Term @card.TermYear</span>
                                </td>
                                <td>
                                    <span class="badge" style="background:#ede9fe;color:#5b21b6;">@(card.Subjects?.Count ?? 0) subjects</span>
                                </td>
                                <td>
                                    <span class="font-mono font-bold text-sm" style="color:@(average >= 50 ? "#16a34a" : "#dc2626")">
                                        @average.ToString("F1")%
                                    </span>
                                </td>
                                <td>
                                    @if (fails > 0)
                                    {
                                        <span class="badge badge-fail">@fails Fails</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-approved">0 Fails</span>
                                    }
                                </td>
                                <td>
                                    @if (missingComments)
                                    {
                                        <span class="badge badge-warn">No overall comment</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-approved" title="@card.OverallComments">Overall comment present</span>
                                    }
                                </td>
                                <td>
                                    @if (missingSubjectComments == 0 && card.Subjects?.Any() == true)
                                    {
                                        <span class="badge badge-approved">Subject comments present</span>
                                    }
                                    else if (card.Subjects?.Any() != true)
                                    {
                                        <span class="badge badge-warn">No subjects</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warn">@missingSubjectComments missing</span>
                                    }
                                </td>
                                <td>
                                    @if (card.AdminApproved)
                                    {
                                        <span class="badge badge-approved">✓ Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pending">⏳ Draft</span>
                                    }
                                </td>
                                <td style="text-align:right;">
                                    <div class="flex gap-2 justify-end items-center">
                                        <button class="btn-view" @onclick="() => OpenDetail(card)">View Details</button>
                                        <button class="btn-regenerate-outline"
                                                disabled="@(regeneratingId == card.Id || isRegenerating)"
                                                title="Delete this report and regenerate anew to await approval"
                                                @onclick="() => PromptRegenerateSingle(card)">
                                            @if (regeneratingId == card.Id)
                                            {
                                                <svg class="animate-spin" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
                                                <span>...</span>
                                            }
                                            else
                                            {
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
                                                <span>Regenerate</span>
                                            }
                                        </button>
                                        @if (!card.AdminApproved)
                                        {
                                            <button class="btn-approve"
                                                    disabled="@(approvingId == card.Id || !IsReadyForApproval(card) || isRegenerating)"
                                                    title="@(IsReadyForApproval(card) ? "Approve this report" : GetPendingReason(card))"
                                                    @onclick="() => ApproveAsync(card)">
                                                @(approvingId == card.Id ? "⏳" : IsReadyForApproval(card) ? "Approve" : "Pending")
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

<!-- Detail Modal -->
@if (selectedCard != null)
{
    <div class="modal-backdrop" @onclick="CloseDetail">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <div class="text-xl font-black text-slate-900">@GetStudentName(selectedCard.StudentId)</div>
                        @{ var modalCwPct = ((selectedCard.CourseworkWeight ?? 0.3) * 100).ToString("F0"); }
                        <div class="text-xs text-slate-500 mt-1 font-semibold">
                            Form @selectedCard.StudentForm @selectedCard.StudentClass &bull; @selectedCard.Term @selectedCard.TermYear &bull; Coursework Weight: @modalCwPct%
                        </div>
                    </div>
                    <button @onclick="CloseDetail" style="padding: 0.5rem; border-radius: 0.5rem; border: none; background: #f1f5f9; cursor: pointer; color: #64748b;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
                
                <!-- Overall Comments Callout -->
                <div class="mt-3.5 p-3 rounded-xl bg-slate-50 border border-slate-100">
                    <div class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-wider mb-1">Overall Comment</div>
                    @if (!string.IsNullOrEmpty(selectedCard.OverallComments))
                    {
                        <p class="text-sm text-slate-700 italic font-medium">"@selectedCard.OverallComments"</p>
                    }
                    else
                    {
                        <p class="text-xs text-rose-500 font-bold">⚠️ No overall comments have been written for this report card yet.</p>
                    }
                </div>

                <div class="mt-2 p-3 rounded-xl bg-slate-50 border border-slate-100">
                    <div class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-wider mb-1">Subject Comments</div>
                    <p class="text-xs font-bold @(MissingSubjectCommentCount(selectedCard) == 0 && selectedCard.Subjects?.Any() == true ? "text-emerald-700" : "text-rose-500")">
                        @SubjectCommentStatus(selectedCard)
                    </p>
                </div>

                <!-- Tabs -->
                <div class="detail-tab-row mt-4">
                    <button class="detail-tab @(detailTab=="summary"?"active":"")" @onclick='()=>detailTab="summary"'>Subject Breakdown</button>
                    <button class="detail-tab @(detailTab=="detailed"?"active":"")" @onclick="ShowDetailedMarks">Detailed Marks Source</button>
                </div>
            </div>
            
            <div class="modal-body">
                @if (detailTab == "summary")
                {
                    <div class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Academic Performance</div>
                    @if (selectedCard.Subjects?.Any() == true)
                    {
                        @foreach (var sub in selectedCard.Subjects)
                        {
                            var grade = GradeHelper.ToGrade(sub.FinalMark);
                            var isFailing = sub.FinalMark < 50;
                            <div class="subject-row">
                                <div>
                                    <div class="text-sm font-bold text-slate-900">@sub.SubjectName</div>
                                    <div class="text-xs text-slate-500 mt-0.5 font-semibold">
                                        CW mark: <span class="font-mono">@sub.CourseworkMark.ToString("F1")%</span> &bull; Exam mark: <span class="font-mono">@sub.ExamMark.ToString("F1")%</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(sub.Comments))
                                    {
                                        <div class="text-xs text-emerald-800 italic mt-1 font-medium bg-emerald-50/50 p-1.5 rounded-lg">"@sub.Comments"</div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-rose-500 italic mt-1 font-semibold">No subject comment recorded.</div>
                                    }
                                </div>
                                <div class="text-right">
                                    <div class="text-base font-black font-mono" style="color:@(isFailing ? "#dc2626" : "#10b981")">@sub.FinalMark.ToString("F1")%</div>
                                    <div class="text-xs font-extrabold" style="color:@(isFailing ? "#dc2626" : "#10b981")">Grade @grade</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-sm text-slate-400 text-center py-6">No subject grades recorded in this draft.</p>
                    }
                }
                else if (detailTab == "detailed")
                {
                    @if (isLoadingDetail)
                    {
                        <div style="padding:2rem;text-align:center;">
                            <svg class="mx-auto mb-3 animate-spin text-emerald-600" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
                            <div class="text-sm text-slate-500 font-medium">Fetching original student marks...</div>
                        </div>
                    }
                    else if (cwMarks == null && examMarks == null)
                    {
                        <div style="padding:2rem;text-align:center;">
                            <p class="text-sm text-slate-400">Could not retrieve detailed teacher entries.</p>
                            <button class="btn-approve mt-2" @onclick="LoadDetailedMarksAsync">Retry Fetch</button>
                        </div>
                    }
                    else
                    {
                        var cwW = (selectedCard.CourseworkWeight ?? 0.3) * 100;
                        var exW = (1 - (selectedCard.CourseworkWeight ?? 0.3)) * 100;

                        <div style="display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;border-radius:.75rem;background:#ecfdf5;border:1px solid #a7f3d0;margin-bottom:1.25rem;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                            <span class="text-xs font-bold text-emerald-700">Coursework Weight: @cwW.ToString("F0")% &bull; Exam Weight: @exW.ToString("F0")%</span>
                        </div>

                        @if (cwMarks?.CourseMarks?.Any() == true)
                        {
                            <div class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Coursework Submissions</div>
                            @foreach (var kv in cwMarks.CourseMarks)
                            {
                                <div class="mb-4 bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <div class="flex items-center justify-between gap-2 mb-2">
                                        <span class="text-sm font-extrabold text-slate-900">@kv.Key</span>
                                        <span class="weight-badge">@kv.Value.Count assignments/tests</span>
                                    </div>
                                    <div class="flex flex-wrap gap-1">
                                        @for (int i = 0; i < kv.Value.Count; i++)
                                        {
                                            var entry = kv.Value[i];
                                            double pct = entry.PercentageScore;
                                            <span class="mark-chip" style="background:@(pct >= 50 ? "rgba(16,185,129,0.1)" : "rgba(239,68,68,0.1)");color:@(pct >= 50 ? "#059669" : "#dc2626")">
                                                Score @(i + 1): @pct.ToString("F1")% (@entry.ActualMark / @entry.MaxScore pts)
                                            </span>
                                        }
                                    </div>
                                    <div class="text-xs font-bold text-slate-400 mt-2 font-mono">
                                        Coursework Average: @kv.Value.Average(e => e.PercentageScore).ToString("F1")%
                                    </div>
                                </div>
                            }
                        }

                        @if (examMarks?.MarksBySubject?.Any() == true)
                        {
                            <div class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3 mt-6">Exam Submissions</div>
                            @foreach (var kv in examMarks.MarksBySubject)
                            {
                                <div class="mb-4 bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <div class="text-sm font-extrabold text-slate-900 mb-2">@kv.Key</div>
                                    @foreach (var em in kv.Value)
                                    {
                                        double emPct = em.Score ?? (em.MaxScore > 0 ? em.ActualMark / em.MaxScore * 100.0 : 0);
                                        <div class="flex justify-between items-center bg-white p-2 rounded-lg border border-slate-100 mb-1">
                                            <div class="text-xs font-semibold text-slate-700">@(em.ExamTitle ?? "Final Exam")</div>
                                            <span class="mark-chip font-bold" style="background:@(emPct >= 50 ? "rgba(16,185,129,0.1)" : "rgba(239,68,68,0.1)");color:@(emPct >= 50 ? "#059669" : "#dc2626")">
                                                @emPct.ToString("F1")% (@em.ActualMark / @em.MaxScore)
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        }

                        @if (cwMarks?.CourseMarks?.Any() != true && examMarks?.MarksBySubject?.Any() != true)
                        {
                            <p class="text-sm text-slate-400 text-center py-6">No coursework or exam score details recorded for this term.</p>
                        }
                    }
                }
            </div>
            
            <div class="modal-footer">
                <button class="btn-view" @onclick="CloseDetail">Close Review</button>
                <button class="btn-regenerate-outline"
                        disabled="@(regeneratingId == selectedCard.Id || isRegenerating)"
                        title="Delete this report and regenerate anew to await approval"
                        @onclick="() => PromptRegenerateSingle(selectedCard)">
                    @if (regeneratingId == selectedCard.Id)
                    {
                        <svg class="animate-spin" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
                        <span>Regenerating...</span>
                    }
                    else
                    {
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
                        <span>Regenerate Report</span>
                    }
                </button>
                @if (!selectedCard.AdminApproved)
                {
                    <button class="btn-approve"
                            disabled="@(approvingId == selectedCard.Id || !IsReadyForApproval(selectedCard) || isRegenerating)"
                            title="@(IsReadyForApproval(selectedCard) ? "Approve this report" : GetPendingReason(selectedCard))"
                            @onclick="() => ApproveAsync(selectedCard)">
                        @(approvingId == selectedCard.Id ? "Approving…" : IsReadyForApproval(selectedCard) ? "Approve Report Card" : "Pending Review")
                    </button>
                }
                else
                {
                    <span class="badge badge-approved" style="padding:0.6rem 1rem;font-size:0.8rem;">Approved &amp; Released</span>
                }
            </div>
        </div>
    </div>
}

<!-- Regenerate Confirmation & Progress Modal -->
@if (showRegenModal)
{
    <div class="modal-backdrop" @onclick="() => { if (!isRegenerating) showRegenModal = false; }">
        <div class="modal" style="max-width: 520px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 rounded-xl bg-amber-100 text-amber-700">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
                    </div>
                    <div>
                        <h4 class="text-lg font-black text-slate-900">
                            @if (regenTargetMode == RegenMode.All)
                            {
                                <span>Regenerate All Reports</span>
                            }
                            else if (regenTargetMode == RegenMode.Selected)
                            {
                                <span>Regenerate Selected Reports</span>
                            }
                            else
                            {
                                <span>Regenerate Report Card</span>
                            }
                        </h4>
                        <p class="text-xs text-slate-500 font-medium">Re-pull marks and regenerate reports to await approval</p>
                    </div>
                </div>
            </div>

            <div class="modal-body">
                @if (isRegenerating)
                {
                    <div class="py-6 text-center">
                        <svg class="mx-auto mb-3 animate-spin text-amber-600" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
                        <h5 class="text-sm font-black text-slate-800">Regenerating Reports in Progress...</h5>
                        <p class="text-xs text-slate-500 mt-1">Processing @regenProgressCurrent of @regenProgressTotal report card(s)</p>
                        
                        <div class="w-full bg-slate-100 rounded-full h-2.5 mt-4 overflow-hidden border border-slate-200">
                            @{
                                var pct = regenProgressTotal > 0 ? (regenProgressCurrent * 100 / regenProgressTotal) : 0;
                            }
                            <div class="bg-amber-500 h-2.5 rounded-full transition-all duration-300" style="width: @pct%"></div>
                        </div>
                        <p class="text-[length:0.65rem] text-slate-400 font-semibold mt-2">Please do not close or navigate away.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-3">
                        @if (regenTargetMode == RegenMode.Single && singleRegenCard != null)
                        {
                            <p class="text-sm text-slate-700">
                                You are about to regenerate the report card for <strong class="text-slate-900">@GetStudentName(singleRegenCard.StudentId)</strong> for <strong class="text-slate-900">@singleRegenCard.Term @singleRegenCard.TermYear</strong>.
                            </p>
                        }
                        else if (regenTargetMode == RegenMode.Selected)
                        {
                            <p class="text-sm text-slate-700">
                                You are about to regenerate <strong class="text-slate-900">@selectedIds.Count</strong> selected report card(s).
                            </p>
                        }
                        else
                        {
                            <p class="text-sm text-slate-700">
                                You are about to regenerate all <strong class="text-slate-900">@FilteredCards.Count</strong> report card(s) matching the current view.
                            </p>
                        }

                        <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs leading-relaxed space-y-1.5">
                            <div class="font-extrabold flex items-center gap-1.5">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                                <span>How regeneration works:</span>
                            </div>
                            <ul class="list-disc pl-4 space-y-1 font-medium">
                                <li>The existing report card will be deleted from the system.</li>
                                <li>A fresh report card will be generated using the latest student marks and subject comments.</li>
                                <li>The regenerated report card will await admin approval in the queue.</li>
                            </ul>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button class="btn-view" @onclick="() => showRegenModal = false" disabled="@isRegenerating">Cancel</button>
                <button class="btn-regenerate shadow-sm"
                        disabled="@isRegenerating"
                        @onclick="ConfirmExecuteRegenAsync">
                    @if (isRegenerating)
                    {
                        <svg class="animate-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
                        <span>Regenerating...</span>
                    }
                    else
                    {
                        <span>Confirm &amp; Regenerate</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ReportCardModel> allLoadedCards = new();
    private List<Student> allStudents = new();
    private Dictionary<long, string> studentNames = new();
    private bool isLoading = true;
    private long approvingId = 0;
    private string statusMsg = "";
    private bool statusError;
    private string searchTerm = "";
    private string filterLevel = "";
    private string filterClass = "";
    private string filterTerm = "";
    private int? filterYear;
    private ReportCardModel? selectedCard;
    private int approvedToday = 0;
    private string activeTab = "ready";
    private List<string> AvailableClasses = new();

    // Detail modal state
    private string detailTab = "summary";
    private bool isLoadingDetail = false;
    private CourseworkMarksResponse? cwMarks;
    private ExamMarksResponse? examMarks;

    // Checkboxes selection
    private HashSet<long> selectedIds = new();

    // Regeneration state
    private enum RegenMode { All, Selected, Single }
    private bool showRegenModal = false;
    private RegenMode regenTargetMode = RegenMode.All;
    private ReportCardModel? singleRegenCard;
    private bool isRegenerating = false;
    private long regeneratingId = 0;
    private int regenProgressCurrent = 0;
    private int regenProgressTotal = 0;
    private Dictionary<long, string> olevelFieldCache = new();

    private List<ReportCardModel> FilteredCards => allLoadedCards
        .Where(c =>
            (string.IsNullOrEmpty(searchTerm) ||
                GetStudentName(c.StudentId).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(filterLevel) ||
                LevelMatchesForm(c, filterLevel)) &&
            (string.IsNullOrEmpty(filterClass) ||
                string.Equals(GetStudentClass(c), filterClass, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(filterTerm) ||
                string.Equals(c.Term, filterTerm, StringComparison.OrdinalIgnoreCase)) &&
            (!filterYear.HasValue ||
                c.TermYear == filterYear.Value))
        .OrderBy(c => c.AdminApproved)
        .ThenBy(c => string.IsNullOrWhiteSpace(c.OverallComments) ? 0 : 1)
        .ThenByDescending(c => FailedSubjectCount(c))
        .ThenBy(CardAverage)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        filterYear = DateTime.Now.Year;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        statusMsg = "";
        selectedIds.Clear();
        StateHasChanged();
        try
        {
            if (allStudents.Count == 0)
            {
                allStudents = await StudentProfileService.GetStudentsAsync() ?? new();
                studentNames = allStudents.ToDictionary(s => (long)s.Id, s => $"{s.FirstName} {s.LastName}".Trim());
                AvailableClasses = allStudents
                    .Select(s => s.Classroom)
                    .Where(c => !string.IsNullOrWhiteSpace(c))
                    .Select(c => c!.Trim())
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(c => c)
                    .ToList();
            }

            if (activeTab == "approved" || !string.IsNullOrEmpty(filterLevel) || !string.IsNullOrEmpty(filterClass))
            {
                var scopedStudents = allStudents.AsEnumerable();
                if (!string.IsNullOrEmpty(filterLevel))
                    scopedStudents = scopedStudents.Where(s => FilterStudentsForLevel(new[] { s }, filterLevel).Any());
                if (!string.IsNullOrEmpty(filterClass))
                    scopedStudents = scopedStudents.Where(s => string.Equals(s.Classroom, filterClass, StringComparison.OrdinalIgnoreCase));

                await LoadCardsForStudentsAsync(scopedStudents.ToList());
            }
            else
            {
                var pending = await AdminGradesService.GetPendingReportCardsAsync() ?? new();
                allLoadedCards = pending;
            }
        }
        catch
        {
            statusMsg = "Could not load report cards. Check API server connection.";
            statusError = true;
            allLoadedCards = new();
        }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task OnFilterChangedAsync()
    {
        selectedIds.Clear();
        await LoadDataAsync();
    }

    private async Task ShowApprovedQueueAsync()
    {
        activeTab = "approved";
        selectedIds.Clear();
        await LoadDataAsync();
    }

    private async Task LoadCardsForStudentsAsync(List<Student> students)
    {
        try
        {
            var pending = await AdminGradesService.GetPendingReportCardsAsync() ?? new();
            var loaded = new List<ReportCardModel>(pending);

            const int BatchSize = 10;
            for (int i = 0; i < students.Count; i += BatchSize)
            {
                var batch = students.Skip(i).Take(BatchSize).ToList();
                var tasks = batch.Select(async s =>
                {
                    try
                    {
                        return await AdminGradesService.GetStudentReportCardsAsync(s.Id);
                    }
                    catch { return null; }
                });
                var results = await Task.WhenAll(tasks);
                foreach (var result in results)
                {
                    if (result != null)
                    {
                        foreach (var card in result)
                        {
                            if (!loaded.Any(c => c.Id == card.Id))
                            {
                                loaded.Add(card);
                            }
                        }
                    }
                }
            }

            allLoadedCards = loaded;
        }
        catch
        {
            allLoadedCards = new();
        }
    }

    private async Task LoadDetailedMarksAsync()
    {
        if (selectedCard == null) return;
        isLoadingDetail = true;
        cwMarks = null;
        examMarks = null;
        StateHasChanged();

        try
        {
            int termNum = selectedCard.Term?.Replace("Term ", "") switch
            {
                "1" => 1, "2" => 2, "3" => 3, _ => 1
            };
            int termYear = selectedCard.TermYear;
            long studentId = selectedCard.StudentId;

            string field = "default";
            var form = selectedCard.StudentForm ?? 0;
            if (form is 3 or 4)
                field = await ResolveOlevelFieldAsync(studentId);

            var cwTask = AdminGradesService.GetCourseworkMarksAsync(studentId, termNum, termYear, field);
            var exTask = AdminGradesService.GetExamMarksAsync(studentId, termNum, termYear, field);
            await Task.WhenAll(cwTask, exTask);

            cwMarks = cwTask.Result;
            examMarks = exTask.Result;
        }
        catch { }
        finally { isLoadingDetail = false; StateHasChanged(); }
    }

    private async Task<string> ResolveOlevelFieldAsync(long studentId)
    {
        try
        {
            var field = await OlevelClassService.GetStudentOlevelFieldAsync(studentId);
            if (!string.IsNullOrWhiteSpace(field))
                return field.Trim('"');
        }
        catch { }
        return "Sciences";
    }

    private async Task ApproveAsync(ReportCardModel card)
    {
        approvingId = card.Id ?? 0;
        statusMsg = "";
        try
        {
            var cardId = card.Id ?? 0;
            bool ok = await AdminGradesService.ApproveReportCardAsync(cardId);
            if (ok)
            {
                card.AdminApproved = true;
                approvedToday++;
                statusMsg = $"Report card for {GetStudentName(card.StudentId)} ({card.Term} {card.TermYear}) approved — now visible to student.";
                statusError = false;
                if (selectedCard?.Id == card.Id)
                    selectedCard = card;
                
                selectedIds.Remove(cardId);
            }
            else
            {
                statusMsg = "Approval failed. The report card may not exist or is already approved.";
                statusError = true;
            }
        }
        catch { statusMsg = "Network error — could not approve report card."; statusError = true; }
        finally { approvingId = 0; StateHasChanged(); }
    }

    private void ToggleSelectAll(bool isChecked, IEnumerable<ReportCardModel> visibleCards)
    {
        if (isChecked)
        {
            foreach (var card in visibleCards)
            {
                if (card.Id.HasValue)
                {
                    selectedIds.Add(card.Id.Value);
                }
            }
        }
        else
        {
            selectedIds.Clear();
        }
    }

    private void ToggleCardSelect(long id)
    {
        if (selectedIds.Contains(id))
        {
            selectedIds.Remove(id);
        }
        else
        {
            selectedIds.Add(id);
        }
    }

    private bool isBulkApproving = false;

    private async Task ApproveSelectedAsync()
    {
        if (!selectedIds.Any()) return;
        isBulkApproving = true;
        statusMsg = $"Approving {selectedIds.Count} report cards...";
        statusError = false;
        StateHasChanged();

        int succeeded = 0;
        int failed = 0;

        try
        {
            var tasks = selectedIds.Select(async id =>
            {
                try
                {
                    bool ok = await AdminGradesService.ApproveReportCardAsync(id);
                    return (Id: id, Success: ok);
                }
                catch { return (Id: id, Success: false); }
            });

            var results = await Task.WhenAll(tasks);
            foreach (var res in results)
            {
                if (res.Success)
                {
                    succeeded++;
                    var card = allLoadedCards.FirstOrDefault(c => c.Id == res.Id);
                    if (card != null)
                    {
                        card.AdminApproved = true;
                        approvedToday++;
                    }
                }
                else
                {
                    failed++;
                }
            }

            statusMsg = failed > 0 
                ? $"Successfully approved {succeeded} report cards. {failed} failed."
                : $"Successfully approved {succeeded} report cards.";
            statusError = failed > 0;
        }
        catch (Exception ex)
        {
            statusMsg = $"Error: {ex.Message}";
            statusError = true;
        }
        finally
        {
            selectedIds.Clear();
            isBulkApproving = false;
            StateHasChanged();
        }
    }

