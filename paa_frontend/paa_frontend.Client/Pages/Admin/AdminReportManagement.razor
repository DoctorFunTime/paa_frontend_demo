        regenTargetMode = RegenMode.All;
        singleRegenCard = null;
        showRegenModal = true;
    }

    private void PromptRegenerateSelected()
    {
        if (!selectedIds.Any()) return;
        regenTargetMode = RegenMode.Selected;
        singleRegenCard = null;
        showRegenModal = true;
    }

    private void PromptRegenerateSingle(ReportCardModel card)
    {
        regenTargetMode = RegenMode.Single;
        singleRegenCard = card;
        showRegenModal = true;
    }

    private async Task ConfirmExecuteRegenAsync()
    {
        List<ReportCardModel> cardsToRegenerate = new();

        switch (regenTargetMode)
        {
            case RegenMode.All:
                cardsToRegenerate = FilteredCards.ToList();
                break;
            case RegenMode.Selected:
                cardsToRegenerate = allLoadedCards.Where(c => c.Id.HasValue && selectedIds.Contains(c.Id.Value)).ToList();
                break;
            case RegenMode.Single:
                if (singleRegenCard != null) cardsToRegenerate.Add(singleRegenCard);
                break;
        }

        if (!cardsToRegenerate.Any())
        {
            showRegenModal = false;
            return;
        }

        isRegenerating = true;
        regenProgressTotal = cardsToRegenerate.Count;
        regenProgressCurrent = 0;
        statusMsg = $"Regenerating {regenProgressTotal} report card(s)...";
        statusError = false;
        StateHasChanged();

        int succeeded = 0;
        int failed = 0;

        foreach (var card in cardsToRegenerate)
        {
            regeneratingId = card.Id ?? 0;
            StateHasChanged();

            var (ok, _) = await ExecuteRegenerateCardAsync(card);
            if (ok)
            {
                succeeded++;
                if (card.Id.HasValue) selectedIds.Remove(card.Id.Value);
            }
            else
            {
                failed++;
            }

            regenProgressCurrent++;
            StateHasChanged();
        }

        regeneratingId = 0;
        isRegenerating = false;
        showRegenModal = false;

        statusMsg = failed > 0
            ? $"Regeneration complete: {succeeded} report card(s) regenerated to await approval, {failed} failed."
            : $"Successfully regenerated {succeeded} report card(s). They are now awaiting approval.";
        statusError = failed > 0;

        if (activeTab == "approved")
        {
            activeTab = "ready";
        }

        await LoadDataAsync();
    }

    private async Task<(bool success, string? error)> ExecuteRegenerateCardAsync(ReportCardModel card)
    {
        try
        {
            // 1. Delete existing report card
            bool deleted = false;
            if (card.Id.HasValue && card.Id.Value > 0)
            {
                deleted = await AdminGradesService.DeleteReportCardAsync(card.Id.Value);
            }

            if (!deleted)
            {
                await AdminGradesService.DeleteReportCardByStudentTermAndYearAsync(card.StudentId, card.Term, card.TermYear);
            }

            // 2. Resolve student details and field
            var student = allStudents.FirstOrDefault(s => s.Id == card.StudentId);
            string field = await ResolveFieldForCardAsync(card);

            // 3. Regenerate subject comments (overwrites stale auto-comments, preserves teacher-written ones)
            await RegenerateSubjectCommentsForCardAsync(card, student, field);

            // 4. Prepare regeneration request
            var req = new ReportCardRequest
            {
                StudentId = card.StudentId,
                Term = card.Term,
                TermMonth = card.TermMonth,
                TermYear = card.TermYear,
                CourseworkWeight = card.CourseworkWeight ?? 0.30,
                OverallComments = card.OverallComments,
                StudentFirstName = card.StudentFirstName ?? student?.FirstName,
                StudentLastName = card.StudentLastName ?? student?.LastName,
                StudentForm = card.StudentForm ?? student?.Form,
                StudentClass = card.StudentClass ?? student?.Classroom
            };

            // 5. Generate fresh report card awaiting approval
            var newCard = await AdminGradesService.GenerateReportCardAsync(req, field);
            if (newCard != null)
            {
                if (card.AdminApproved && newCard.Id.HasValue)
                {
                    try
                    {
                        await AdminGradesService.ApproveReportCardAsync(newCard.Id.Value);
                        newCard.AdminApproved = true;
                        newCard.ReleasedToStudent = true;
                    }
                    catch { }
                }

                if (selectedCard?.Id == card.Id)
                {
                    selectedCard = newCard;
                }
                return (true, null);
            }
            return (false, "Empty report card response");
        }
        catch (Exception ex)
        {
            return (false, ex.Message);
        }
    }

    private async Task RegenerateSubjectCommentsForCardAsync(ReportCardModel card, Student? student, string field)
    {
        try
        {
            var studentClass = card.StudentClass ?? student?.Classroom ?? string.Empty;
            var cwWeight = card.CourseworkWeight ?? 0.30;
            var termNumber = card.Term switch
            {
                "Term 1" => 1,
                "Term 2" => 2,
                "Term 3" => 3,
                _ => 1
            };

            // Fetch marks from all field variants
            var fieldCandidates = new[] { "default", "", field }
                .Where(f => f != null)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var cwTasks = fieldCandidates.Select(async f =>
            {
                try { return await AdminGradesService.GetCourseworkMarksAsync(card.StudentId, termNumber, card.TermYear, f); }
                catch { return null; }
            });
            var examTasks = fieldCandidates.Select(async f =>
            {
                try { return await AdminGradesService.GetExamMarksAsync(card.StudentId, termNumber, card.TermYear, f); }
                catch { return null; }
            });

            var cwResults = await Task.WhenAll(cwTasks);
            var examResults = await Task.WhenAll(examTasks);

            // Merge all mark results
            var coursework = new Dictionary<string, List<MarkEntry>>(StringComparer.OrdinalIgnoreCase);
            foreach (var resp in cwResults)
            {
                if (resp?.CourseMarks == null) continue;
                foreach (var kvp in resp.CourseMarks)
                {
                    if (!coursework.ContainsKey(kvp.Key)) coursework[kvp.Key] = kvp.Value ?? new();
                    else if (kvp.Value != null) coursework[kvp.Key].AddRange(kvp.Value);
                }
            }

            var exams = new Dictionary<string, List<ExamMarkDTO>>(StringComparer.OrdinalIgnoreCase);
            foreach (var resp in examResults)
            {
                if (resp?.MarksBySubject == null) continue;
                foreach (var kvp in resp.MarksBySubject)
                {
                    if (!exams.ContainsKey(kvp.Key)) exams[kvp.Key] = kvp.Value ?? new();
                    else if (kvp.Value != null) exams[kvp.Key].AddRange(kvp.Value);
                }
            }

            // Build subject list from marks + card subjects
            var subjectsFromCard = card.Subjects?.Select(s => s.SubjectName).Where(s => !string.IsNullOrWhiteSpace(s)).ToList() ?? new();
            var subjectsToProcess = subjectsFromCard.ToList();
            foreach (var k in coursework.Keys.Concat(exams.Keys))
            {
                if (!subjectsToProcess.Any(s => string.Equals(s, k, StringComparison.OrdinalIgnoreCase)))
                    subjectsToProcess.Add(k);
            }

            if (subjectsToProcess.Count == 0) return;

            var commentsToSave = new List<SubjectCommentDTO>();

            foreach (var subject in subjectsToProcess.Where(s => !string.IsNullOrWhiteSpace(s)))
            {
                List<SubjectCommentDTO>? existing = null;
                try
                {
                    existing = await AssessmentService.GetSubjectCommentsAsync(subject, studentClass, card.Term, card.TermYear);
                }
                catch { }

                // Always preserve teacher-written comments (TeacherId != null)
                if (existing?.Any(c => c.StudentId == card.StudentId && !string.IsNullOrWhiteSpace(c.Comments) && c.TeacherId != null) == true)
                    continue;

                // Track existing auto-comment for upsert
                var existingAuto = existing?.FirstOrDefault(c => c.StudentId == card.StudentId && c.TeacherId == null);

                // Compute marks
                bool hasCw = coursework.Any(kv => string.Equals(kv.Key, subject, StringComparison.OrdinalIgnoreCase) && kv.Value?.Any(e => e != null) == true);
                bool hasEx = exams.Any(kv => string.Equals(kv.Key, subject, StringComparison.OrdinalIgnoreCase) && kv.Value?.Any(e => e != null) == true);

                var cwEntries = coursework.FirstOrDefault(kv => string.Equals(kv.Key, subject, StringComparison.OrdinalIgnoreCase)).Value;
                var examEntries = exams.FirstOrDefault(kv => string.Equals(kv.Key, subject, StringComparison.OrdinalIgnoreCase)).Value;

                var courseworkMark = hasCw ? cwEntries!.Where(e => e != null).Select(e => e.PercentageScore).DefaultIfEmpty(0).Average() : 0;
                var examMark = hasEx ? examEntries!.Where(e => e != null).Select(e => e.Score ?? 0).DefaultIfEmpty(0).Average() : 0;

                double finalMark;
                if (hasCw && hasEx && courseworkMark > 0 && examMark > 0)
                    finalMark = (courseworkMark * cwWeight) + (examMark * (1 - cwWeight));
                else if (hasEx && examMark > 0)
                    finalMark = examMark;
                else if (hasCw && courseworkMark > 0)
                    finalMark = courseworkMark;
                else
                    finalMark = Math.Max(courseworkMark, examMark);

                var teacherFeedback = cwEntries?.Select(e => e.Feedback).FirstOrDefault(f => !string.IsNullOrWhiteSpace(f));
                int regenNonce = Random.Shared.Next(1, 1000000);

                commentsToSave.Add(new SubjectCommentDTO
                {
                    Id = existingAuto?.Id,
                    StudentId = card.StudentId,
                    SubjectName = subject,
                    ClassName = studentClass,
                    Term = card.Term,
                    TermYear = card.TermYear,
                    Comments = BuildRegenComment(subject, finalMark, courseworkMark, examMark, card.StudentId, teacherFeedback, regenNonce),
                    TeacherId = null
                });
            }

            if (commentsToSave.Any())
                await AssessmentService.SaveSubjectCommentsAsync(commentsToSave);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[REGEN] Comment regeneration failed for student {card.StudentId}: {ex.Message}");
        }
    }

