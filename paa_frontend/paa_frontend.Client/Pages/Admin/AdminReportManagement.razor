                $"The student should actively address difficult topics in {subject} with the teacher to turn current challenges into progress.",
                $"A patient, methodical review of foundational syllabus topics will assist the student in raising achievement in {subject}."
            }
        };

        var seed = regenNonce != 0
            ? HashCode.Combine(studentId, subject.GetHashCode(), (int)Math.Round(finalMark * 10), regenNonce)
            : HashCode.Combine(studentId, subject.GetHashCode(), (int)Math.Round(finalMark * 10), courseworkMark > 0, examMark > 0);
        var variation = (int)((uint)seed % (uint)profile.Length);
        var first = profile[variation];

        bool hasCw = courseworkMark > 0;
        bool hasEx = examMark > 0;
        var balanceSeed = (uint)(seed ^ (subject.Length * 37 + (int)Math.Round(finalMark) + regenNonce));
        string balance = string.Empty;

        if (hasCw && hasEx)
        {
            if (finalMark >= 80)
            {
                var opts = new[] { "Maintains commendable standards across both continuous assessment and examination components.", "Both coursework assignments and examination results reflect excellent preparation and sustained dedication.", "Work across all evaluated areas demonstrates high academic capability and dependable self-discipline.", "Performance is remarkably well rounded across both daily coursework and examination assessments.", "Exhibits exceptional academic consistency, performing with equal distinction in coursework tasks and examinations." };
                balance = opts[(int)(balanceSeed % (uint)opts.Length)];
            }
            else if (courseworkMark >= examMark)
            {
                var opts = new[] { "Coursework is currently the stronger indicator; carrying that same preparation into examinations should be the next focus.", "The coursework result is encouraging; more timed examination practice will help strengthen the overall result.", "Strong coursework habits are evident; applying them more consistently under examination conditions should lead to further gains.", "Continued coursework effort, together with focused examination revision, will be especially beneficial.", "The high standard of day-to-day work is pleasing; developing timed exam pacing will help match this in examinations." };
                balance = opts[(int)(balanceSeed % (uint)opts.Length)];
            }
            else
            {
                var opts = new[] { "Examination performance shows good potential; applying that understanding more consistently in coursework tasks will yield stronger results.", "The examination result is promising; regular coursework completion will help make overall achievement even more secure.", "Building on this examination result with greater attention to day-to-day coursework and assignments is recommended.", "The examination outcome highlights strong capability; bringing daily coursework to the same level will maximize progress.", "Strong exam insight is evident; ensuring all continuous assessment assignments are submitted punctually will lift results." };
                balance = opts[(int)(balanceSeed % (uint)opts.Length)];
            }
        }
        else if (hasEx && !hasCw)
        {
            if (finalMark >= 80)
            {
                var opts = new[] { "Demonstrates commendable examination technique and thorough preparation under assessment conditions.", "Examination responses reflect deep understanding and clear, articulate reasoning throughout.", "The examination outcome confirms sustained effort and a mature grasp of the syllabus.", "Superb examination temperament, showing sharp accuracy and excellent analytical problem solving.", "Flawless composure and academic precision were demonstrated across the examination papers." };
                balance = opts[(int)(balanceSeed % (uint)opts.Length)];
            }
            else if (finalMark >= 60)
            {
                var opts = new[] { "Examination performance indicates a dependable foundation with positive scope for further advancement.", "Shows good engagement in assessments; targeted revision of complex topics will help raise marks further.", "A respectable examination result; consistent past paper practice will help consolidate knowledge.", "Demonstrates solid potential under exam conditions with steady progress across key topics.", "Sound test performance; refining answering techniques for higher-tariff questions will yield higher grades." };
                balance = opts[(int)(balanceSeed % (uint)opts.Length)];
            }
            else
            {
                var opts = new[] { "Structured examination revision and regular past-paper practice are recommended to improve future assessment outcomes.", "Additional practice with examination-style questions will help develop confidence and exam technique.", "Targeted review of core topics and practicing under timed conditions will support examination readiness.", "Working through model examination answers and past papers will help clarify expectations and improve scores.", "Focusing on exam command words and foundational principles will assist in raising assessment marks." };
                balance = opts[(int)(balanceSeed % (uint)opts.Length)];
            }
        }
        else if (hasCw && !hasEx)
        {
            if (finalMark >= 80)
            {
                var opts = new[] { "Coursework assignments have been completed to an exemplary standard, showing great initiative.", "Demonstrates sustained dedication and thoroughness across all continuous assessment tasks.", "Coursework submissions reflect high quality, analytical depth, and consistent academic effort.", "Produces consistently superior coursework, demonstrating thorough research and thoughtful execution.", "Daily engagement and continuous assessment work reflect commendable scholarship and pride in presentation." };
                balance = opts[(int)(balanceSeed % (uint)opts.Length)];
            }
            else if (finalMark >= 60)
            {
                var opts = new[] { "Coursework tasks show positive engagement and a steady grasp of core subject material.", "Maintains consistent coursework participation; attention to detail in assignments will bring further gains.", "Steady coursework contributions throughout the term; deepening written explanations will enhance quality.", "Reliable completion of coursework projects; refining analytical detail will lead to even stronger scores.", "A dependable approach to continuous assessments; maintaining this focus will ensure good progress." };
                balance = opts[(int)(balanceSeed % (uint)opts.Length)];
            }
            else
            {
                var opts = new[] { "More consistent coursework submission and active participation in class activities are advised.", "Regular completion of assignments and seeking timely help will support subject progress.", "Punctual submission of all coursework tasks and careful attention to guidelines will help lift grades.", "The student is urged to seek feedback on draft assignments to improve coursework quality.", "Dedication to completing every assigned project and task will build a stronger academic foundation." };
                balance = opts[(int)(balanceSeed % (uint)opts.Length)];
            }
        }

        var feedbackSentence = string.IsNullOrWhiteSpace(teacherFeedback)
            ? string.Empty
            : $"The recorded Staff Marks feedback is also noted: {teacherFeedback.Trim().TrimEnd('.')}.";
        return string.Join(" ", new[] { first, balance, feedbackSentence }.Where(s => !string.IsNullOrWhiteSpace(s)));
    }

    private async Task<string> ResolveFieldForCardAsync(ReportCardModel card)
    {
        var form = card.StudentForm;
        if (!form.HasValue || form == 0)
        {
            var student = allStudents.FirstOrDefault(s => s.Id == card.StudentId);
            form = student?.Form;
        }

        if (form is 3 or 4)
        {
            if (olevelFieldCache.TryGetValue(card.StudentId, out var cached))
                return cached;

            var resolved = await ResolveOlevelFieldAsync(card.StudentId);
            olevelFieldCache[card.StudentId] = resolved;
            return resolved;
        }

        return "default";
    }

    private string GetStudentName(long id)
        => studentNames.TryGetValue(id, out var n) ? n : $"Student #{id}";

    private string GetStudentClass(ReportCardModel card)
    {
        if (!string.IsNullOrWhiteSpace(card.StudentClass))
            return card.StudentClass;

        var student = allStudents.FirstOrDefault(s => s.Id == card.StudentId);
        return student?.Classroom ?? string.Empty;
    }

    private static bool IsReadyForApproval(ReportCardModel card)
        => !card.AdminApproved &&
           card.TeacherSubmitted &&
           card.Subjects?.Any() == true &&
           card.Subjects.All(s => !string.IsNullOrWhiteSpace(s.SubjectName) && !string.IsNullOrWhiteSpace(s.Comments));

    private static bool IsPendingReview(ReportCardModel card)
        => !card.AdminApproved && !IsReadyForApproval(card);

    private static string GetPendingReason(ReportCardModel card)
    {
        if (!card.TeacherSubmitted) return "Waiting for teacher submission";
        if (card.Subjects?.Any() != true) return "No subject marks are recorded";
        var missingComments = card.Subjects.Count(s => string.IsNullOrWhiteSpace(s.Comments));
        return missingComments > 0 ? $"{missingComments} subject comment(s) missing" : "Report is not complete";
    }

    private void OpenDetail(ReportCardModel card)
    {
        selectedCard = card;
        detailTab = "summary";
        cwMarks = null;
        examMarks = null;
    }

    private async Task ShowDetailedMarks()
    {
        detailTab = "detailed";
        if (cwMarks == null && examMarks == null && !isLoadingDetail)
            await LoadDetailedMarksAsync();
    }

    private void CloseDetail()
    {
        selectedCard = null;
        cwMarks = null;
        examMarks = null;
    }

    private static bool LevelMatchesForm(ReportCardModel card, string level)
    {
        var form = card.StudentForm ?? 0;
        return level switch
        {
            "form1to4" => form is >= 1 and <= 4,
            "olevel" => form is 3 or 4,
            "alevel" => form is 5 or 6,
            _ => true
        };
    }

    private static double CardAverage(ReportCardModel card)
        => card.Subjects?.Any() == true ? card.Subjects.Average(s => s.FinalMark) : 0;

    private static List<Student> FilterStudentsForLevel(IEnumerable<Student> students, string level) => level switch
    {
        "form1to4" => students.Where(s => s.Form is >= 1 and <= 4).ToList(),
        "olevel" => students.Where(s => s.Form is 3 or 4).ToList(),
        "alevel" => students.Where(s => s.Form is 5 or 6).ToList(),
        _ => new()
    };

    private static int FailedSubjectCount(ReportCardModel card)
        => card.Subjects?.Count(s => s.FinalMark < 50) ?? 0;

    private static int MissingSubjectCommentCount(ReportCardModel card)
        => card.Subjects?.Count(s => string.IsNullOrWhiteSpace(s.Comments)) ?? 0;

    private static string SubjectCommentStatus(ReportCardModel card)
    {
        var subjectCount = card.Subjects?.Count ?? 0;
        if (subjectCount == 0) return "No subjects available to assess.";

        var missing = MissingSubjectCommentCount(card);
        return missing == 0
            ? $"All {subjectCount} subject comments are present."
            : $"{missing} of {subjectCount} subject comments are missing.";
    }
}
