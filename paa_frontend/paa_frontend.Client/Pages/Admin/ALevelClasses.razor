@using paa_frontend.Client.Services.Admin
@using static paa_frontend.Shared.Models.Admin.AlevelClassesModel
@inject AlevelClassServiceClient ClassService

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
        <h2 class="text-xl font-extrabold text-slate-900 tracking-tight mb-1">A-Level Class Presets</h2>
        <p class="text-sm font-medium text-slate-500">Manage Form 5 &amp; 6 class names used when assigning students.</p>
    </div>
    <button class="shrink-0 px-5 py-2.5 bg-violet-600 hover:bg-violet-700 text-white rounded-full text-sm font-bold shadow-md transition-all flex items-center gap-2"
            @onclick="OpenAddModal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Class
    </button>
</div>


@if (!string.IsNullOrEmpty(pageStatus))
{
    <div class="mb-5 p-4 rounded-2xl flex items-center gap-3 text-sm font-bold @(pageError ? "bg-rose-50 text-rose-700 border border-rose-200" : "bg-violet-50 text-violet-700 border border-violet-200")">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        @pageStatus
    </div>
}

<!-- Search + list -->
<div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-6 md:p-8 shadow-sm mb-8">
    <div class="flex flex-col sm:flex-row items-center gap-3 mb-6">
        <div class="relative flex-1 w-full max-w-sm">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </span>
            <input class="w-full py-2.5 pl-10 pr-4 bg-white border border-slate-200 rounded-full text-sm font-medium focus:outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-100 transition-all placeholder:text-slate-400"
                   type="text" placeholder="Search class presets..." value="@searchTerm" @oninput="OnSearch" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
            @for (int i = 0; i < 6; i++)
            {
                <div class="bg-white/60 border border-slate-200/60 rounded-2xl p-5 animate-pulse">
                    <div class="w-10 h-10 rounded-xl bg-slate-200 mb-3"></div>
                    <div class="w-2/3 h-4 bg-slate-200 rounded mb-2"></div>
                    <div class="w-1/3 h-3 bg-slate-100 rounded"></div>
                </div>
            }
        </div>
    }
    else if (!filteredClassNames.Any())
    {
        <div class="text-center py-16">
            <div class="w-16 h-16 bg-violet-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-violet-400">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10"/><path d="M7 12h6"/></svg>
            </div>
            <h3 class="text-lg font-extrabold text-slate-900 mb-2">No class presets found</h3>
            <p class="text-sm text-slate-500 mb-6">@(classNames?.Any() == true ? "Try a different search." : "Add A-Level class names to get started.")</p>
            <button class="px-6 py-2.5 bg-violet-600 hover:bg-violet-700 text-white rounded-full text-sm font-bold transition-all shadow-md" @onclick="OpenAddModal">Add First Class</button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
            @{ int ci = 0; }
            @foreach (var className in filteredClassNames)
            {
                var (bg, fg) = ClassColor(ci);
                <div class="bg-white/80 border border-slate-200 rounded-2xl p-5 hover:shadow-md transition-all group flex flex-col">
                    <div class="flex items-start justify-between mb-3">
                        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-sm font-extrabold shrink-0" style="background:@bg;color:@fg;">
                            @(string.IsNullOrWhiteSpace(className.ClassName) ? "CL" : new string(className.ClassName.Trim().Take(2).ToArray()).ToUpper())
                        </div>
                        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                            <button class="w-7 h-7 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-violet-600 hover:border-violet-200 hover:bg-violet-50 flex items-center justify-center transition-all shadow-sm" title="Edit" @onclick="() => OpenEditModal(className)">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button class="w-7 h-7 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 flex items-center justify-center transition-all shadow-sm" title="Delete" @onclick="() => ConfirmDelete(className)">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                            </button>
                        </div>
                    </div>
                    <div class="text-base font-extrabold text-slate-900">@className.ClassName</div>
                    <div class="text-[length:0.65rem] font-mono font-bold text-slate-400 mt-1">ID: @className.Id</div>
                </div>
                ci++;
            }
        </div>
    }
</div>

<!-- Add/Edit Modal -->
@if (showEditModal)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[100] flex items-end sm:items-center justify-center p-0 sm:p-4" @onclick="CloseEditModal">
        <div class="bg-white rounded-t-3xl sm:rounded-3xl w-full sm:max-w-md shadow-2xl" @onclick:stopPropagation="true">
            <div class="p-6 border-b border-slate-100">
                <h3 class="text-lg font-extrabold text-slate-900">@(isEditing ? "Edit Class Preset" : "Add Class Preset")</h3>
                <p class="text-xs text-slate-500 font-medium mt-0.5">@(isEditing ? "Update the class name below." : "Enter a new A-Level class name, e.g. L6A, U6B.")</p>
            </div>
            <div class="p-6">
                <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2">Class Name</label>
                <input class="w-full py-3 px-4 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:border-violet-500 focus:ring-2 focus:ring-violet-100 outline-none transition-all placeholder:text-slate-400"
                       placeholder="e.g. L6A, U6B" @bind="editClassName" @bind:event="oninput" @onkeydown="HandleKeyDown" />
                @if (!string.IsNullOrEmpty(editStatus))
                {
                    <p class="mt-2 text-xs font-bold @(editError ? "text-rose-600" : "text-violet-600")">@editStatus</p>
                }
            </div>
            <div class="px-6 pb-6 flex gap-3">
                <button class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors" @onclick="CloseEditModal">Cancel</button>
                <button class="flex-1 px-4 py-2.5 rounded-xl bg-violet-600 hover:bg-violet-700 disabled:opacity-50 text-white text-sm font-bold transition-colors shadow-sm flex items-center justify-center gap-2"
                        disabled="@(isSaving || string.IsNullOrWhiteSpace(editClassName))" @onclick="HandleSave">
                    @if (isSaving) { <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> }
                    @(isEditing ? "Save Changes" : "Add Class")
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirm -->
@if (deleteTarget != null)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[100] flex items-center justify-center p-4" @onclick="() => deleteTarget = null">
        <div class="bg-white rounded-3xl p-8 max-w-md w-full shadow-2xl" @onclick:stopPropagation="true">
            <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mb-5">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <h3 class="text-xl font-extrabold text-slate-900 mb-2">Delete class preset?</h3>
            <p class="text-sm font-medium text-slate-500 mb-8 leading-relaxed">
                This will permanently remove <strong>@deleteTarget.ClassName</strong>. Students still linked to this class may block deletion.
            </p>
            <div class="flex items-center justify-end gap-3">
                <button class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors" @onclick="() => deleteTarget = null">Cancel</button>
                <button class="px-5 py-2.5 rounded-xl bg-rose-600 text-white text-sm font-bold hover:bg-rose-700 transition-colors shadow-sm" @onclick="ExecuteDelete">Delete Class</button>
            </div>
        </div>
    </div>
}

@code {
    private List<AlevelClassName>? classNames;
    private List<AlevelClassName> filteredClassNames = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private string pageStatus = "";
    private bool pageError;

    private bool showEditModal;
    private bool isEditing;
    private long editClassId;
    private string editClassName = "";
    private string editStatus = "";
    private bool editError;
    private bool isSaving;
    private AlevelClassName? deleteTarget;

    private static readonly (string Bg, string Fg)[] Palette = {
        ("rgb(245,243,255)", "#7c3aed"), ("rgb(239,246,255)", "#2563eb"),
        ("rgb(236,253,245)", "#059669"), ("rgb(255,251,235)", "#d97706"),
        ("rgb(255,241,242)", "#e11d48"), ("rgb(240,249,255)", "#0284c7"),
    };
    private (string Bg, string Fg) ClassColor(int i) => Palette[i % Palette.Length];

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            classNames = (await ClassService.GetAllAlevelClassNamesAsync()).OrderBy(c => c.ClassName).ToList();
            ApplySearch();
        }
        catch { pageStatus = "A-Level class presets could not be loaded right now. Please refresh and try again."; pageError = true; classNames = new(); }
        finally { isLoading = false; }
    }

    private void OnSearch(ChangeEventArgs e) { searchTerm = e.Value?.ToString() ?? ""; ApplySearch(); }
    private void ApplySearch() => filteredClassNames = string.IsNullOrWhiteSpace(searchTerm)
        ? classNames?.ToList() ?? new()
        : classNames?.Where(c => (c.ClassName ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList() ?? new();

    private void OpenAddModal()  { isEditing = false; editClassId = 0; editClassName = ""; editStatus = ""; editError = false; showEditModal = true; }
    private void OpenEditModal(AlevelClassName c) { isEditing = true; editClassId = c.Id; editClassName = c.ClassName ?? ""; editStatus = ""; editError = false; showEditModal = true; }
    private void CloseEditModal() { showEditModal = false; editStatus = ""; editError = false; }

    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(editClassName)) await HandleSave(); }

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(editClassName)) return;
        isSaving = true; editStatus = ""; editError = false;
        try
        {
            var trimmed = editClassName.Trim();
            bool result = isEditing
                ? await ClassService.UpdateAlevelClassNameAsync(editClassId, trimmed)
                : await ClassService.PostAlevelClassNameAsync(new PostAlevelClassName { ClassName = trimmed });

            if (result) { pageStatus = isEditing ? $"'{trimmed}' updated." : $"'{trimmed}' added."; pageError = false; await LoadData(); CloseEditModal(); }
            else { editStatus = "Operation failed. Please try again."; editError = true; }
        }
        catch { editStatus = "We could not save that class right now. Check that the class is valid and try again."; editError = true; }
        finally { isSaving = false; }
    }

    private void ConfirmDelete(AlevelClassName c) => deleteTarget = c;

    private async Task ExecuteDelete()
    {
        if (deleteTarget == null) return;
        try
        {
            var result = await ClassService.DeleteAlevelClassNameAsync(deleteTarget.Id);
            if (result) { pageStatus = $"'{deleteTarget.ClassName}' deleted."; pageError = false; classNames?.Remove(deleteTarget); ApplySearch(); }
            else { pageStatus = "Delete failed. The class may still be in use."; pageError = true; }
        }
        catch { pageStatus = "We could not delete that class right now. It may still be in use or unavailable."; pageError = true; }
        finally { deleteTarget = null; }
    }
}
