@code {
    [Parameter]
    public int StudentId { get; set; }

    private Student? student;
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isSaving = false;
    private string activeTab = "profile"; // profile, contact
    private List<string> currentSubjects = new();
    private string? studentField;
    private bool subjectsLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadStudent();
        // If navigating directly to edit route, open edit mode natively
        if (Nav.Uri.Contains("/edit/")) { isEditing = true; }
    }

    private async Task LoadStudent()
    {
        isLoading = true;
        try
        {
            student = await StudentService.GetStudentAsync(StudentId);
            if (student != null && student.EmergencyContactDetails == null)
            {
                student.EmergencyContactDetails = new EmergencyContactDetails();
            }
            if (student != null)
            {
                subjectsLoading = true;
                try
                {
                    var subjectsTask = SubjectService.GetForm1to4StudentSubjectsAsync(student.Id);
                    var classSubjectsTask = student.Form is >= 1 and <= 4
                        ? SubjectService.GetForm1to4ClassSubjectsAsync(student.Form.Value, student.Classroom ?? string.Empty)
                        : Task.FromResult<paa_frontend.Shared.Models.Admin.SubjectsModel.Form1to4ClassSubjects?>(null);
                    var fieldTask = student.Form == 4 ? OLevelClassService.GetStudentOlevelFieldAsync(student.Id) : Task.FromResult<string?>(null);
                    await Task.WhenAll(subjectsTask, classSubjectsTask, fieldTask);
                    currentSubjects = (subjectsTask.Result?.Subjects?.Any() == true
                        ? subjectsTask.Result.Subjects
                        : classSubjectsTask.Result?.Subjects ?? new())
                        .Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
                    studentField = fieldTask.Result;
                }
                finally
                {
                    subjectsLoading = false;
                }
            }
        }
        catch (Exception)
        {
            NotificationService.ShowError("Error loading student");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleEdit()
    {
        isEditing = !isEditing;
    }

    private async Task HandleValidSubmit()
    {
        if (student == null) return;
        
        isSaving = true;
        
        try
        {
            var response = await StudentService.UpdateStudentAsync(student.Id, student);
            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowSuccess("Student details updated successfully.");
                isEditing = false;
            }
            else
            {
                NotificationService.ShowError($"Failed to update student. Server returned {(int)response.StatusCode}.");
            }
        }
        catch (Exception)
        {
            NotificationService.ShowError("Failed to update student.");
        }
        finally
        {
            isSaving = false;
        }
    }
}
