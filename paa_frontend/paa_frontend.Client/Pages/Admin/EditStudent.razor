@page "/students/edit/{StudentId:int}"
@page "/students/{StudentId:int}"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using paa_frontend.Client.Services
@using static paa_frontend.Shared.Models.StudentProfileModel
@inject StudentProfileServiceClient StudentService
@inject paa_frontend.Client.Services.Admin.StudentSubjectServiceClient SubjectService
@inject paa_frontend.Client.Services.Admin.OlevelClassServiceClient OLevelClassService
@inject paa_frontend.Client.Services.NotificationService NotificationService
@inject NavigationManager Nav

@if (isLoading)
{
    <div class="max-w-4xl mx-auto w-full animate-pulse">
        <div class="h-48 bg-slate-200 rounded-3xl mb-8"></div>
        <div class="flex gap-4 mb-8">
            @for (int i = 0; i < 4; i++) { <div class="h-10 w-24 bg-slate-200 rounded-full"></div> }
        </div>
        <div class="h-96 bg-white/60 rounded-3xl border border-slate-200/50"></div>
    </div>
}
else if (student == null)
{
    <div class="flex flex-col items-center justify-center py-20 text-center">
        <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center text-slate-400 mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h2 class="text-xl font-bold text-slate-900 mb-2">Student not found</h2>
        <p class="text-slate-500 mb-6">The student record you are looking for does not exist or has been removed.</p>
        <button class="px-5 py-2 bg-slate-900 text-white rounded-full font-bold shadow hover:bg-slate-800" @onclick='() => Nav.NavigateTo("/students")'>Return to Directory</button>
    </div>
}
else
{
    <div class="max-w-5xl mx-auto w-full pb-16">
        
        <!-- Header Ribbon / Banner -->
        <div class="relative w-full h-40 md:h-48 bg-gradient-to-r from-blue-700 to-indigo-800 rounded-[2rem] overflow-hidden mb-6 flex flex-col justify-between shadow-sm">
            <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iMTAwIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciP...</')] opacity-10"></div>
            
            <div class="p-6 md:p-8 flex items-center justify-between relative z-10 w-full">
                <button class="flex items-center justify-center w-10 h-10 rounded-full bg-white/20 hover:bg-white/30 backdrop-blur text-white transition-colors" @onclick='() => Nav.NavigateTo("/students")'>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                </button>
                <div class="flex items-center gap-2">
                    <button class="px-4 py-2 bg-white/10 hover:bg-white/20 backdrop-blur rounded-full text-white text-xs font-bold transition-colors">Print ID</button>
                    @if (!isEditing)
                    {
                        <button class="px-4 py-2 bg-white text-blue-700 rounded-full text-xs font-bold transition-all shadow-md flex items-center gap-2" @onclick="ToggleEdit">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            Edit Profile
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Profile Metadata -->
        <div class="flex flex-col md:flex-row items-center md:items-start gap-6 -mt-16 relative z-20 px-6 md:px-12 mb-10">
            <div class="w-28 h-28 md:w-32 md:h-32 rounded-2xl bg-white p-1.5 shadow-xl shrink-0">
                <div class="w-full h-full rounded-xl bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center text-4xl font-black text-slate-400">
                    @(student.FirstName?.FirstOrDefault().ToString() ?? "")@(student.LastName?.FirstOrDefault().ToString() ?? "")
                </div>
            </div>
            <div class="flex-1 mt-4 md:mt-20 text-center md:text-left flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-black text-slate-900 tracking-tight leading-tight">@student.FirstName @student.LastName</h1>
                    <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 mt-2 text-sm font-bold text-slate-500">
                        <span class="flex items-center gap-1.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> @(string.IsNullOrEmpty(student.Email) ? "No Email" : student.Email)</span>
                        <span class="flex items-center gap-1.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l1.79-1.79a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg> @(string.IsNullOrEmpty(student.Phone) ? "No Phone" : student.Phone)</span>
                    </div>
                </div>
                <div class="flex flex-wrap items-center justify-center gap-2">
                    <span class="px-3 py-1 rounded-full border border-slate-200 bg-white shadow-sm text-xs font-black text-slate-700">Form @student.Form</span>
                    @if (student.Status == "Active") { <span class="px-3 py-1 rounded-full border border-emerald-200 bg-emerald-50 text-emerald-700 text-xs font-black flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-emerald-600 rounded-full"></span>Active</span> }
                    else { <span class="px-3 py-1 rounded-full border border-slate-200 bg-slate-100 text-slate-600 text-xs font-black flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-slate-400 rounded-full"></span>@student.Status</span> }
                </div>
            </div>
        </div>

        <!-- ── Navigation Tabs ──────────────────────────────────── -->
        <div class="grid grid-cols-2 gap-2 mb-8 bg-white/50 backdrop-blur-sm p-1.5 rounded-2xl mx-2 md:mx-0 shadow-sm border border-slate-200/50 w-full md:w-max md:flex">
            <button class="min-w-0 px-3 md:px-6 py-2.5 rounded-xl text-[length:0.7rem] md:text-sm font-bold transition-colors text-center leading-tight md:whitespace-nowrap @(activeTab == "profile" ? "bg-white text-blue-700 shadow border border-slate-100" : "text-slate-500 hover:text-slate-900")" @onclick='() => activeTab = "profile"'>Profile Overview</button>
            <button class="min-w-0 px-3 md:px-6 py-2.5 rounded-xl text-[length:0.7rem] md:text-sm font-bold transition-colors text-center leading-tight md:whitespace-nowrap @(activeTab == "contact" ? "bg-white text-blue-700 shadow border border-slate-100" : "text-slate-500 hover:text-slate-900")" @onclick='() => activeTab = "contact"'>Contact Info</button>
        </div>


        <!-- ── Edit Form State ──────────────────────────────────── -->
        @if (isEditing)
        {
            <EditForm Model="@student" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="bg-white/80 backdrop-blur border border-slate-200/60 rounded-3xl p-6 md:p-10 mb-8 shadow-sm">
                    <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-100">
                        <h2 class="text-xl font-extrabold text-slate-800 tracking-tight">Edit Student Details</h2>
                        <div class="flex items-center gap-3">
                            <button type="button" class="px-5 py-2 rounded-xl border border-slate-200 bg-white text-sm font-bold text-slate-600 hover:bg-slate-50 shadow-sm" @onclick="ToggleEdit">Cancel</button>
                            <button type="submit" class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold shadow-md transition-colors flex items-center gap-2" disabled="@isSaving">
                                @if(isSaving){ <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> <span>Saving...</span> }
                                else { <span>Save Changes</span> }
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                        
                        <div class="col-span-1 md:col-span-2">
                            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Basic Identity</h3>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">First Name</label>
                            <InputText @bind-Value="student.FirstName" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" />
                            <ValidationMessage For="@(() => student.FirstName)" class="text-[length:0.65rem] text-rose-500 font-bold" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Last Name</label>
                            <InputText @bind-Value="student.LastName" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Date of Birth</label>
                            <InputDate @bind-Value="student.DateOfBirth" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Gender</label>
                            <InputSelect @bind-Value="student.Gender" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none appearance-none">
                                <option value="">Select gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </InputSelect>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">National ID</label>
                            <InputText @bind-Value="student.NationalId" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none font-mono" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Religion</label>
                            <InputText @bind-Value="student.Religion" maxlength="100" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Temporary ID</label>
                            <InputText @bind-Value="student.TempId" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none font-mono" placeholder="TEMP-001" />
                        </div>

                        <div class="col-span-1 md:col-span-2 mt-4">
                            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4 border-b border-slate-100 pb-2">Academics</h3>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Form / Year</label>
                            <InputNumber @bind-Value="student.Form" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" min="1" max="6" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Classroom</label>
                            <InputText @bind-Value="student.Classroom" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" placeholder="e.g. 4B" />
                        </div>
                        <div class="col-span-1 md:col-span-2 mt-4">
                            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4 border-b border-slate-100 pb-2">Contact</h3>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Email Address</label>
                            <InputText @bind-Value="student.Email" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" type="email" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Phone</label>
                            <InputText @bind-Value="student.Phone" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" type="tel" />
                        </div>
                        <div class="col-span-1 md:col-span-2 flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Address</label>
                            <InputTextArea @bind-Value="student.Address" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none resize-none" rows="3" />
                        </div>

                        <div class="col-span-1 md:col-span-2 mt-4">
                            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4 border-b border-slate-100 pb-2">Emergency Contact</h3>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Guardian Name</label>
                            <InputText @bind-Value="student.EmergencyContactDetails!.Name" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" />
                            <ValidationMessage For="@(() => student.EmergencyContactDetails!.Name)" class="text-[length:0.65rem] text-rose-500 font-bold" />
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Guardian Phone</label>
                            <InputText @bind-Value="student.EmergencyContactDetails!.Phone" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" type="tel" />
                            <ValidationMessage For="@(() => student.EmergencyContactDetails!.Phone)" class="text-[length:0.65rem] text-rose-500 font-bold" />
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Guardian Email</label>
                            <InputText @bind-Value="student.EmergencyContactDetails!.Email" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" type="email" />
                            <ValidationMessage For="@(() => student.EmergencyContactDetails!.Email)" class="text-[length:0.65rem] text-rose-500 font-bold" />
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-600">Relationship</label>
                            <InputText @bind-Value="student.EmergencyContactDetails!.Relationship" class="w-full bg-slate-50/50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" />
                            <ValidationMessage For="@(() => student.EmergencyContactDetails!.Relationship)" class="text-[length:0.65rem] text-rose-500 font-bold" />
                        </div>
                    </div>
                </div>
            </EditForm>
        }
        else
        {
            <!-- ── View Mode State ──────────────────────────────────── -->
            @if (activeTab == "profile")
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 animate-fade-in">
                    <div class="flex flex-col gap-8">
                        <div>
                            <h3 class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-4 pl-1">Personal Details</h3>
                            <dl class="space-y-4">
                                <div class="flex flex-col pb-3 border-b border-slate-100">
                                    <dt class="text-xs font-bold text-slate-500 mb-1">Date of Birth</dt>
                                    <dd class="text-sm font-semibold text-slate-900">@(student.DateOfBirth?.ToString("MMM dd, yyyy") ?? "—")</dd>
                                </div>
                                <div class="flex flex-col pb-3 border-b border-slate-100">
                                    <dt class="text-xs font-bold text-slate-500 mb-1">Gender</dt>
                                    <dd class="text-sm font-semibold text-slate-900">@(student.Gender ?? "—")</dd>
                                </div>
                                <div class="flex flex-col pb-3 border-b border-slate-100">
                                    <dt class="text-xs font-bold text-slate-500 mb-1">National ID</dt>
                                    <dd class="text-sm font-mono font-bold text-slate-900">@(student.NationalId ?? "—")</dd>
                                </div>
                                <div class="flex flex-col pb-3 border-b border-slate-100">
                                    <dt class="text-xs font-bold text-slate-500 mb-1">Temporary ID</dt>
                                    <dd class="text-sm font-mono font-bold text-slate-900">@(student.TempId ?? "—")</dd>
                                </div>
                            </dl>
                        </div>
                        <div>
                            <h3 class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-4 pl-1">Academic Details</h3>
                            <div class="rounded-3xl border border-slate-200/50 bg-white/40 p-6">
                                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                                    <span class="text-xs font-bold text-slate-500">Class</span>
                                    <span class="text-sm font-black text-slate-900">@(string.IsNullOrWhiteSpace(student.Classroom) ? "Not assigned" : student.Classroom)</span>
                                </div>
                                @if (student.Form == 4)
                                {
                                    <div class="flex items-center justify-between border-b border-slate-100 py-3">
                                        <span class="text-xs font-bold text-slate-500">Field</span>
                                        <span class="text-sm font-black text-slate-900">@(string.IsNullOrWhiteSpace(studentField) ? "Not assigned" : studentField)</span>
                                    </div>
                                }
                                <div class="pt-4">
                                    <div class="text-xs font-bold text-slate-500 mb-2">Current subjects</div>
                                    @if (subjectsLoading)
                                    {
                                        <div class="text-sm font-medium text-slate-400">Loading subjects…</div>
                                    }
                                    else if (currentSubjects.Any())
                                    {
                                        <div class="flex flex-wrap gap-2">
                                            @foreach (var subject in currentSubjects)
                                            {
                                                <span class="rounded-xl border border-violet-200 bg-violet-50 px-3 py-1.5 text-xs font-bold text-violet-700">@subject</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-sm font-medium text-slate-400">No subjects assigned</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-8">
                        <div>
                            <h3 class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-4 pl-1">Quick Actions & Meta</h3>
                            <div class="bg-white/40 border border-slate-200/50 backdrop-blur rounded-3xl p-6">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-slate-500 font-bold">Profile ID</span>
                                    <span class="text-xs font-mono font-bold text-slate-400">@student.Id</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (activeTab == "contact")
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 animate-fade-in">
                    <div class="bg-white/60 border border-slate-200/50 backdrop-blur rounded-3xl p-6 hover:-translate-y-1 transition-transform shadow-sm">
                        <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center mb-4">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        </div>
                        <div class="text-[length:0.65rem] uppercase font-bold text-slate-400 mb-1 tracking-widest">Email Address</div>
                        <div class="text-sm font-bold text-slate-900 break-all">@(string.IsNullOrEmpty(student.Email) ? "—" : student.Email)</div>
                    </div>

                    <div class="bg-white/60 border border-slate-200/50 backdrop-blur rounded-3xl p-6 hover:-translate-y-1 transition-transform shadow-sm">
                        <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center mb-4">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l1.79-1.79a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </div>
                        <div class="text-[length:0.65rem] uppercase font-bold text-slate-400 mb-1 tracking-widest">Phone Number</div>
