@using paa_frontend.Client.Services.Admin
@using static paa_frontend.Shared.Models.Admin.OlevelClassesModel
@using static paa_frontend.Shared.Models.StudentProfileModel
@inject OlevelClassServiceClient ClassService
@inject StudentSubjectServiceClient SubjectService
@inject StudentProfileServiceClient StudentProfileService
@inject paa_frontend.Client.Services.NotificationService NotificationService
@inject NavigationManager Navigation

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
    <div>
        <h2 class="text-xl font-extrabold text-slate-900 tracking-tight mb-1">O-Level Class Presets</h2>
        <p class="text-sm font-medium text-slate-500">Review every Forms 1–4 class, see the subjects it offers, and open the subject setup when you need to make changes.</p>
    </div>
    <div class="flex items-center gap-3 shrink-0">
        <a href="/admin/academics/olevel?tab=setup" class="px-4 py-2 bg-white/60 hover:bg-white border border-slate-200/60 rounded-full text-xs font-semibold text-slate-600 transition-colors shadow-sm flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            Subjects
        </a>
        <button class="shrink-0 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-full text-sm font-bold shadow-md transition-all" @onclick="OpenAddModal">
            New Class
        </button>
    </div>
</div>

<!-- Stats ribbon -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-slate-200/50 backdrop-blur border border-slate-200/50 rounded-2xl overflow-hidden mb-8">
    <div class="bg-white/80 p-5">
        <div class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Forms 1–4 Classes</div>
        <div class="text-3xl font-extrabold text-blue-600 tracking-tighter mb-2">@classRows.Count</div>
        <span class="px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 text-xs font-bold">Available</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(pageStatus))
{
    <div class="mb-5 p-4 rounded-2xl flex items-center gap-3 text-sm font-bold @(pageError ? "bg-rose-50 text-rose-700 border border-rose-200" : "bg-blue-50 text-blue-700 border border-blue-200")">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        @pageStatus
    </div>
}

<!-- Class list -->
<div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-6 md:p-8 shadow-sm mb-8">
    <div class="flex flex-col lg:flex-row lg:items-center gap-4 mb-6">
        <div class="flex-1">
        <h2 class="text-xl font-extrabold text-slate-900 mb-1">Classes and subject offerings</h2>
        <p class="text-sm font-medium text-slate-500">Each class inherits the subjects shown here. Students can later opt out of individual subjects.</p>
        </div>
        <div class="flex flex-col sm:flex-row items-center gap-3">
            <div class="relative w-full sm:w-72">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </span>
                <input class="w-full py-2.5 pl-10 pr-4 bg-white border border-slate-200 rounded-full text-sm font-medium focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-slate-400"
                       type="text" placeholder="Search class presets..." value="@searchTerm" @oninput="OnSearch" />
            </div>
            <select class="w-full sm:w-auto py-2.5 px-4 bg-white border border-slate-200 rounded-full text-sm font-bold text-slate-600" value="@formFilter" @onchange="OnFormFilterChanged">
                <option value="">All Forms</option>
                @for (var form = 1; form <= 4; form++)
                {
                    <option value="@form">Form @form</option>
                }
            </select>
            <button class="w-full sm:w-auto px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-full text-sm font-bold transition-all shadow-md" @onclick="OpenAddModal">
                New Class
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
            @for (int i = 0; i < 6; i++)
            {
                <div class="bg-white/60 border border-slate-200/60 rounded-2xl p-5 animate-pulse">
                    <div class="w-10 h-10 rounded-xl bg-slate-200 mb-3"></div>
                    <div class="w-2/3 h-4 bg-slate-200 rounded mb-2"></div>
                    <div class="w-1/3 h-3 bg-slate-100 rounded"></div>
                </div>
            }
        </div>
    }
    else if (!filteredClassNames.Any())
    {
        <div class="text-center py-16">
            <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-blue-400">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10"/><path d="M7 12h6"/></svg>
            </div>
            <h3 class="text-lg font-extrabold text-slate-900 mb-2">No class presets found</h3>
            <p class="text-sm text-slate-500 mb-6">@(classNames?.Any() == true ? "Try a different search term." : "Add the O-Level class names students can belong to.")</p>
            <button class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-full text-sm font-bold transition-all shadow-md" @onclick="OpenAddModal">Add First Class</button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
            @{ int ci = 0; }
            @foreach (var classRow in filteredClassRows)
            {
                var (bg, fg) = ClassColor(ci);
                <div class="bg-white/80 border border-slate-200 rounded-2xl p-5 hover:shadow-md transition-all group flex flex-col">
                    <div class="flex items-start justify-between mb-3">
                        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-sm font-extrabold shrink-0" style="background:@bg;color:@fg;">
                            @(string.IsNullOrWhiteSpace(classRow.ClassName) ? "CL" : new string(classRow.ClassName.Trim().Take(2).ToArray()).ToUpper())
                        </div>
                        @if (classRow.LegacyClass != null)
                        {
                        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                            <button class="w-7 h-7 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-blue-600 hover:border-blue-200 hover:bg-blue-50 flex items-center justify-center transition-all shadow-sm" title="Edit class name" @onclick="() => OpenEditModal(classRow.LegacyClass!)">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button class="w-7 h-7 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 flex items-center justify-center transition-all shadow-sm" title="Delete class name" @onclick="() => ConfirmDelete(classRow.LegacyClass!)">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                            </button>
                        </div>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="text-base font-extrabold text-slate-900">@classRow.ClassName</div>
                        <span class="px-2 py-1 rounded-full bg-slate-100 text-slate-500 text-[length:0.65rem] font-black">Form @classRow.Form</span>
                    </div>
                    @if (classRow.LegacyClass != null)
                    {
                        <div class="text-[length:0.65rem] font-mono font-bold text-slate-400 mt-2">ID: @classRow.LegacyClass.Id</div>
                    }
                    <div class="mt-4 pt-4 border-t border-slate-100">
                        <div class="flex items-center justify-between gap-3 mb-2">
                            <span class="text-[length:0.65rem] uppercase tracking-widest font-black text-slate-400">Subjects offered</span>
                            @if (classRow.IsLoadingSubjects)
                            {
                                <span class="text-xs font-bold text-blue-600">Loading…</span>
                            }
                            else
                            {
                                <span class="text-xs font-black text-slate-700">@classRow.Subjects.Count</span>
                            }
                        </div>
                        @if (classRow.IsLoadingSubjects)
                        {
                            <div class="flex flex-wrap gap-2">
                                <span class="h-7 w-20 rounded-full bg-slate-100 animate-pulse"></span>
                                <span class="h-7 w-24 rounded-full bg-slate-100 animate-pulse"></span>
                            </div>
                        }
                        else if (classRow.Subjects.Any())
                        {
                            <div class="flex flex-wrap gap-2">
                                @foreach (var subject in classRow.Subjects)
                                {
                                    <span class="subject-pill">@subject</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-xs font-medium text-amber-700 bg-amber-50 border border-amber-100 rounded-xl px-3 py-2">No subjects configured for this class yet.</p>
                        }
                    </div>
                    <a class="mt-4 inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-xs font-black transition-colors"
                       href="@BuildSubjectSetupUrl(classRow)">
                        Edit class subjects
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
                ci++;
            }
        </div>
    }
</div>

<!-- Add/Edit Modal -->
@if (showEditModal)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[100] flex items-end sm:items-center justify-center p-0 sm:p-4" @onclick="CloseEditModal">
        <div class="bg-white rounded-t-3xl sm:rounded-3xl w-full sm:max-w-md shadow-2xl" @onclick:stopPropagation="true">
            <div class="p-6 border-b border-slate-100">
                <h3 class="text-lg font-extrabold text-slate-900">@(isEditing ? "Edit Class Preset" : "Add Class Preset")</h3>
                <p class="text-xs text-slate-500 font-medium mt-0.5">@(isEditing ? "Update the O-Level class name." : "Create a preset class name such as 3A or 4B.")</p>
            </div>
            <div class="p-6">
                <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2">Class Name</label>
                <input class="w-full py-3 px-4 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all placeholder:text-slate-400"
                       placeholder="e.g. 3A, Form 4B" @bind="editClassName" @bind:event="oninput" @onkeydown="HandleKeyDown" />
                @if (!string.IsNullOrEmpty(editStatus))
                {
                    <p class="mt-2 text-xs font-bold @(editError ? "text-rose-600" : "text-blue-600")">@editStatus</p>
                }
            </div>
            <div class="px-6 pb-6 flex gap-3">
                <button class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors" @onclick="CloseEditModal">Cancel</button>
                <button class="flex-1 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 disabled:opacity-50 text-white text-sm font-bold transition-colors shadow-sm flex items-center justify-center gap-2"
                        disabled="@(isSaving || string.IsNullOrWhiteSpace(editClassName))" @onclick="HandleSaveClassName">
                    @if (isSaving) { <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> }
                    @(isEditing ? "Save Changes" : "Add Class")
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirm Modal -->
@if (deleteTarget != null)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[100] flex items-center justify-center p-4" @onclick="() => deleteTarget = null">
        <div class="bg-white rounded-3xl p-8 max-w-md w-full shadow-2xl" @onclick:stopPropagation="true">
            <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mb-5">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <h3 class="text-xl font-extrabold text-slate-900 mb-2">Delete class preset?</h3>
            <p class="text-sm font-medium text-slate-500 mb-8 leading-relaxed">
                This will permanently remove <strong>@deleteTarget.ClassName</strong>. Students still linked to this class may block deletion.
            </p>
            <div class="flex items-center justify-end gap-3">
                <button class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors" @onclick="() => deleteTarget = null">Cancel</button>
                <button class="px-5 py-2.5 rounded-xl bg-rose-600 text-white text-sm font-bold hover:bg-rose-700 transition-colors shadow-sm" @onclick="ExecuteDelete">Delete Class</button>
            </div>
        </div>
    </div>
}

@code {
    private List<OlevelClassName>? classNames;
    private List<OlevelClassName> filteredClassNames = new();
    private List<ClassSubjectRow> classRows = new();
    private List<ClassSubjectRow> filteredClassRows = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private int? formFilter;
    private string pageStatus = "";
    private bool pageError;

    private bool showEditModal;
    private bool isEditing;
    private long editClassId;
    private string editClassName = "";
    private string editStatus = "";
    private bool editError;
    private bool isSaving;
    private OlevelClassName? deleteTarget;

    private sealed class ClassSubjectRow
    {
        public int Form { get; init; }
        public string ClassName { get; init; } = string.Empty;
        public OlevelClassName? LegacyClass { get; init; }
        public List<string> Subjects { get; set; } = new();
        public bool IsLoadingSubjects { get; set; }
    }

    private static readonly (string Bg, string Fg)[] Palette = {
        ("rgb(239,246,255)", "#2563eb"), ("rgb(240,249,255)", "#0284c7"),
        ("rgb(236,253,245)", "#059669"), ("rgb(255,251,235)", "#d97706"),
        ("rgb(245,243,255)", "#7c3aed"), ("rgb(255,241,242)", "#e11d48"),
    };
    private (string Bg, string Fg) ClassColor(int i) => Palette[i % Palette.Length];

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var legacyClassesTask = ClassService.GetAllOlevelClassNamesAsync();
            var studentsTask = StudentProfileService.GetStudentsAsync();
            var classSubjectsTask = SubjectService.GetAllForm1to4ClassSubjectsAsync();
            await Task.WhenAll(legacyClassesTask, studentsTask, classSubjectsTask);

            classNames = legacyClassesTask.Result.OrderBy(c => c.ClassName).ToList();
            var students = studentsTask.Result ?? new();
            classRows = new();

            foreach (var className in classNames)
            {
                // O-Level class presets are shared by every Form 1–4.
                for (var form = 1; form <= 4; form++)
                    AddClassRow(form, className.ClassName, className, students);
            }

            classRows = classRows
                .Where(row => row.Form is >= 1 and <= 4 && !string.IsNullOrWhiteSpace(row.ClassName))
                .GroupBy(row => $"{row.Form}:{row.ClassName.Trim()}", StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderBy(row => row.Form)
                .ThenBy(row => row.ClassName)
                .ToList();

            foreach (var row in classRows)
            {
                var setup = classSubjectsTask.Result.FirstOrDefault(item => item.Form == row.Form
                    && (string.Equals(item.ClassName?.Trim(), row.ClassName.Trim(), StringComparison.OrdinalIgnoreCase)
                        || string.Equals(item.ClassCode?.Trim(), $"{row.Form}{row.ClassName.Trim()}", StringComparison.OrdinalIgnoreCase)));
                row.Subjects = setup?.Subjects?
                    .Where(subject => !string.IsNullOrWhiteSpace(subject))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(subject => subject)
                    .ToList() ?? new();
                row.IsLoadingSubjects = false;
            }

            ApplySearch();
        }
        catch { pageStatus = "Classes or their subject offerings could not be loaded right now. Please refresh and try again."; pageError = true; classNames = new(); classRows = new(); filteredClassRows = new(); }
        finally { isLoading = false; }
    }

    private void OnSearch(ChangeEventArgs e) { searchTerm = e.Value?.ToString() ?? ""; ApplySearch(); }
    private void OnFormFilterChanged(ChangeEventArgs e)
    {
        formFilter = int.TryParse(e.Value?.ToString(), out var form) ? form : null;
        ApplySearch();
    }
    private void ApplySearch()
    {
        filteredClassRows = classRows.Where(row => (!formFilter.HasValue || row.Form == formFilter.Value)
                && (string.IsNullOrWhiteSpace(searchTerm)
                || row.ClassName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                || row.Subjects.Any(subject => subject.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
            ).ToList();
        filteredClassNames = classNames?.Where(c => (c.ClassName ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList() ?? new();
    }

    private void AddClassRow(int form, string? className, OlevelClassName? legacyClass, List<Student> students)
    {
        var resolvedForm = form > 0 ? form : ResolveForm(className, students, 0);
        if (resolvedForm is >= 1 and <= 4 && !string.IsNullOrWhiteSpace(className))
        {
            classRows.Add(new ClassSubjectRow { Form = resolvedForm, ClassName = className.Trim(), LegacyClass = legacyClass });
        }
    }

    private static int ResolveForm(string? className, List<Student> students, int fallback)
    {
        var clean = className?.Trim() ?? string.Empty;
        if (clean.Length > 0 && clean[0] is >= '1' and <= '4')
            return clean[0] - '0';

        var student = students.FirstOrDefault(item => string.Equals(item.Classroom?.Trim(), clean, StringComparison.OrdinalIgnoreCase));
        return student?.Form is >= 1 and <= 4 ? student.Form.Value : fallback;
    }

    private static string BuildSubjectSetupUrl(ClassSubjectRow row)
        => $"/admin/academics/olevel/setup?form={row.Form}&className={Uri.EscapeDataString(row.ClassName)}";

    private void OpenAddModal()  { isEditing = false; editClassId = 0; editClassName = ""; editStatus = ""; editError = false; showEditModal = true; }
    private void OpenEditModal(OlevelClassName c) { isEditing = true; editClassId = c.Id; editClassName = c.ClassName ?? ""; editStatus = ""; editError = false; showEditModal = true; }
    private void CloseEditModal() { showEditModal = false; editStatus = ""; editError = false; }

    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(editClassName)) await HandleSaveClassName(); }

    private async Task HandleSaveClassName()
    {
        if (string.IsNullOrWhiteSpace(editClassName)) return;
        isSaving = true; editStatus = ""; editError = false;
        try
        {
            bool result;
            var trimmed = editClassName.Trim();
            if (isEditing)
                result = await ClassService.UpdateOlevelClassNameAsync(editClassId, trimmed);
            else
                result = await ClassService.PostOlevelClassNameAsync(new PostOlevelClassName { ClassName = trimmed });

            if (result) { pageStatus = isEditing ? $"'{trimmed}' updated." : $"'{trimmed}' added."; pageError = false; NotificationService.ShowSuccess(pageStatus); await LoadData(); CloseEditModal(); }
            else { editStatus = "Operation failed. Please try again."; editError = true; }
        }
        catch { editStatus = "We could not save that class right now. Check that the class is valid and try again."; editError = true; }
        finally { isSaving = false; }
    }

    private void ConfirmDelete(OlevelClassName c) => deleteTarget = c;

    private async Task ExecuteDelete()
    {
        if (deleteTarget == null) return;
        try
        {
            var result = await ClassService.DeleteOlevelClassNameAsync(deleteTarget.Id);
            if (result) { pageStatus = $"'{deleteTarget.ClassName}' deleted."; pageError = false; NotificationService.ShowSuccess(pageStatus); classNames?.Remove(deleteTarget); ApplySearch(); }
            else { pageStatus = "Delete failed. The class may still be in use."; pageError = true; }
        }
        catch { pageStatus = "We could not delete that class right now. It may still be in use or unavailable."; pageError = true; }
        finally { deleteTarget = null; }
    }
}
