<div class="admin-loading-skeleton" role="status" aria-label="Loading page content" aria-busy="true">
    <div class="admin-skeleton-hero admin-skeleton-block"></div>
    <div class="admin-skeleton-metrics">
        @for (var i = 0; i < 4; i++) { <div class="admin-skeleton-card admin-skeleton-block"></div> }
    </div>
    <div class="admin-skeleton-content"><div class="admin-skeleton-panel admin-skeleton-block"></div><div class="admin-skeleton-panel admin-skeleton-block"></div></div>
</div>
<style>
    .admin-loading-skeleton{display:grid;gap:1rem;width:100%;margin-bottom:1.5rem}.admin-skeleton-block{position:relative;overflow:hidden;background:linear-gradient(90deg,#eef2f7 25%,#f8fafc 50%,#eef2f7 75%);background-size:200% 100%;animation:adminSkeletonShimmer 1.35s ease-in-out infinite;border:1px solid rgba(226,232,240,.8)}.admin-skeleton-hero{height:7.5rem;border-radius:1.5rem}.admin-skeleton-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem}.admin-skeleton-card{height:5.75rem;border-radius:1rem}.admin-skeleton-content{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem}.admin-skeleton-panel{height:17rem;border-radius:1.25rem}@@keyframes adminSkeletonShimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}@@media(max-width:768px){.admin-skeleton-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-skeleton-content{grid-template-columns:1fr}.admin-skeleton-hero{height:6.5rem}.admin-skeleton-panel{height:13rem}}
</style>
