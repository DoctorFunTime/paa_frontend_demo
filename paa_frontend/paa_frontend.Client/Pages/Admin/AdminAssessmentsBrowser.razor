@* AdminAssessmentsBrowser.razor
   Reusable component embedded in JuniorHub, OLevelHub, ALevelHub.
   Lets admins browse assessments (assignments / tests / exams) per subject for the given level.
   Read-only - creation is done via StaffMarks in the Staff Portal.
*@
@namespace paa_frontend.Client.Pages.Admin
@using paa_frontend.Client.Services.StaffPortal
@using paa_frontend.Client.Services.Admin
@using paa_frontend.Shared.Models
@inject AssessmentServiceClient AssessmentService
@inject StudentSubjectServiceClient SubjectService

<style>
.abrow{display:flex;gap:.75rem;flex-wrap:wrap;align-items:center;margin-bottom:1.25rem}
.ab-select{padding:.55rem 1rem;border:1.5px solid #e2e8f0;border-radius:.75rem;font-size:.875rem;outline:none;transition:border-color .15s;background:#fff;min-width:160px}
.ab-select:focus{border-color:@AccentColor}
.acard{border:1px solid #e2e8f0;border-radius:1rem;background:#fff;padding:1rem 1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;transition:box-shadow .15s}
.acard:hover{box-shadow:0 4px 16px rgba(0,0,0,.07)}
.atype-badge{display:inline-flex;align-items:center;padding:.25rem .65rem;border-radius:9999px;font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em}
.empty-ab{padding:3rem;text-align:center;color:#94a3b8}
</style>

<div>
    <div class="flex items-center justify-between mb-5">
        <div>
            <h2 class="text-xl font-extrabold text-slate-900">Assessments Browser</h2>
            <p class="text-xs text-slate-500 font-medium mt-1">
                Read-only view of all assessments created by teachers for this level. Marks entry is done in the Staff Portal.
            </p>
        </div>
        @if (!string.IsNullOrEmpty(statusMsg))
        {
            <span class="text-xs font-bold px-3 py-1.5 rounded-full @(statusErr ? "bg-rose-50 text-rose-700" : "bg-emerald-50 text-emerald-700")">
                @statusMsg
            </span>
        }
    </div>

    <div class="abrow">
        <select class="ab-select" @bind="selectedSubject" @bind:after="LoadAssessmentsAsync">
            <option value="">Select Subject</option>
            @foreach (var s in subjects)
            {
                <option value="@s">@s</option>
            }
        </select>
        <select class="ab-select" style="min-width:130px;" @bind="selectedType" @bind:after="LoadAssessmentsAsync">
            <option value="assignment">Assignments</option>
            <option value="test">Tests</option>
            <option value="exam">Exams</option>
        </select>
        <button class="px-4 py-2 rounded-xl text-sm font-bold transition-all text-white"
                style="background:@AccentColor"
                @onclick="LoadAssessmentsAsync"
                disabled="@(isLoading || string.IsNullOrEmpty(selectedSubject))">
            @(isLoading ? "Loading..." : "Load")
        </button>
    </div>

    @if (isLoading)
    {
        <div class="space-y-3">
            @for (int i = 0; i < 4; i++)
            {
                <div class="h-16 rounded-2xl bg-slate-100 animate-pulse"></div>
            }
        </div>
    }
    else if (!hasLoaded)
    {
        <div class="empty-ab">
            <svg class="mx-auto mb-3" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
            <p class="text-sm font-semibold text-slate-500">Select a subject and click Load to see assessments.</p>
        </div>
    }
    else if (!assessments.Any())
    {
        <div class="empty-ab">
            <svg class="mx-auto mb-3" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/>
            </svg>
            <p class="text-sm font-semibold text-slate-500">No @selectedType@("s") found for @selectedSubject.</p>
            <p class="text-xs text-slate-400 mt-1">Teachers create assessments in the Staff Portal under "Enter Marks".</p>
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var item in assessments)
            {
                var (typeBg, typeFg, typeLabel) = selectedType switch
                {
                    "test" => ("rgba(245,158,11,.12)", "#b45309", "TEST"),
                    "exam" => ("rgba(124,58,237,.12)", "#6d28d9", "EXAM"),
                    _ => ("rgba(26,79,255,.10)", "#1d4ed8", "ASGN"),
                };
                <div class="acard">
                    <div class="flex items-center gap-3">
                        <span class="atype-badge" style="background:@typeBg;color:@typeFg;">@typeLabel</span>
                        <div>
                            <div class="text-sm font-bold text-slate-900">@item.Title</div>
                            <div class="text-xs text-slate-400 mt-0.5">Subject ID #@item.SubjectId</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="text-right flex-shrink-0">
                            <div class="text-sm font-black text-slate-900 font-mono">@item.MaxScore pts</div>
                            <div class="text-xs text-slate-400">@((item.Weight * 100).ToString("F0"))% weight</div>
                        </div>
                        <button class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors"
                                title="Delete Assessment (Admin)"
                                @onclick="() => assessmentToDelete = item">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                    </div>
                </div>
            }
        </div>
        <div class="mt-4 text-xs text-slate-400 font-medium">@assessments.Count @(selectedType + "s") shown for @selectedSubject.</div>
    }

    @if (assessmentToDelete != null)
    {
        <div style="position:fixed;inset:0;background:rgba(15,23,42,0.5);backdrop-filter:blur(3px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:16px;">
            <div style="background:#fff;border-radius:1rem;max-width:440px;width:100%;padding:24px;box-shadow:0 20px 25px -5px rgba(0,0,0,0.1),0 10px 10px -5px rgba(0,0,0,0.04);">
                <div style="font-size:16px;font-weight:700;color:#0f172a;margin-bottom:8px;">Delete Assessment</div>
                <p style="font-size:13px;color:#64748b;margin-bottom:20px;line-height:1.5;">
                    Are you sure you want to delete <strong>@assessmentToDelete.Title</strong>? This will permanently remove the assessment and any linked marks.
                </p>
                <div style="display:flex;justify-content:flex-end;gap:10px;">
                    <button class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition"
                            @onclick="() => assessmentToDelete = null" disabled="@isDeleting">
                        Cancel
                    </button>
                    <button class="px-4 py-2 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl transition"
                            @onclick="ExecuteDeleteAsync" disabled="@isDeleting">
                        @(isDeleting ? "Deleting..." : "Delete")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Level { get; set; } = "form1to4";
    [Parameter] public string AccentColor { get; set; } = "#059669";
    [Parameter] public bool ShowFieldSelector { get; set; } = false;

    private List<string> subjects = new();
    private List<AssessmentItem> assessments = new();
    private string selectedSubject = "";
    private string selectedType = "assignment";
    private bool isLoading = false;
    private bool hasLoaded = false;
    private string statusMsg = "";
    private bool statusErr = false;
    private AssessmentItem? assessmentToDelete = null;
    private bool isDeleting = false;

    private record AssessmentItem(long Id, long SubjectId, string Title, double MaxScore, double Weight);

    protected override async Task OnParametersSetAsync()
    {
        await LoadSubjectsAsync();
    }

    private async Task LoadSubjectsAsync()
    {
        subjects.Clear();
        selectedSubject = "";

        try
        {
            if (Level == "form1to4")
            {
                var classSubjects = await SubjectService.GetAllForm1to4ClassSubjectsAsync();
                subjects = classSubjects
                    .SelectMany(x => x.Subjects ?? new List<string>())
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Select(x => x.Trim())
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(x => x)
                    .ToList();
            }
            else if (Level == "alevel")
            {
                var s = await SubjectService.GetALevelSubjectsAsync();
                subjects = s.Select(x => x.SubjectName ?? "").Where(x => !string.IsNullOrEmpty(x)).ToList();
            }
        }
        catch
        {
            statusMsg = "Could not load subjects.";
            statusErr = true;
        }
    }

    private async Task LoadAssessmentsAsync()
    {
        if (string.IsNullOrEmpty(selectedSubject)) return;
        isLoading = true;
        assessments.Clear();
        StatusClear();
        StateHasChanged();

        try
        {
                var field = "";
            if (selectedType == "assignment")
            {
                var list = await AssessmentService.GetAssignmentsAsync(Level, selectedSubject, field);
                assessments = list?.Select(a => new AssessmentItem(a.Id ?? 0, a.SubjectId ?? 0, a.Title ?? "Assignment", a.MaxScore, a.Weight)).ToList() ?? new();
            }
            else if (selectedType == "test")
            {
                var list = await AssessmentService.GetTestsAsync(Level, selectedSubject, field);
                assessments = list?.Select(t => new AssessmentItem(t.Id ?? 0, t.SubjectId ?? 0, t.Title ?? "Test", t.MaxScore, t.Weight)).ToList() ?? new();
            }
            else
            {
                var list = await AssessmentService.GetExamsAsync(Level, selectedSubject, field);
                assessments = list?.Select(e => new AssessmentItem(e.Id ?? 0, e.SubjectId ?? 0, e.Title ?? "Exam", e.MaxScore, e.Weight)).ToList() ?? new();
            }
            hasLoaded = true;
        }
        catch
        {
            statusMsg = "Could not load assessments.";
            statusErr = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteDeleteAsync()
    {
        if (assessmentToDelete == null) return;
        isDeleting = true;
        try
        {
            bool ok = await AssessmentService.DeleteAssessmentAsync(selectedType, assessmentToDelete.Id);
            if (ok)
            {
                assessments.RemoveAll(a => a.Id == assessmentToDelete.Id);
                statusMsg = "Assessment deleted successfully.";
                statusErr = false;
                assessmentToDelete = null;
            }
            else
            {
                statusMsg = "Failed to delete assessment.";
                statusErr = true;
            }
        }
        catch (Exception ex)
        {
            statusMsg = $"Error: {ex.Message}";
            statusErr = true;
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private void StatusClear()
    {
        statusMsg = "";
        statusErr = false;
    }
}
