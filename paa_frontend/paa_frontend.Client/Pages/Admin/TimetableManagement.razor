    private void ToggleDay(int day,ChangeEventArgs e){if(e.Value is bool selected&&selected)selectedDays.Add(day);else selectedDays.Remove(day);}
    private async Task AddSlots()
    {
        if(selectedDays.Count==0||!TimeOnly.TryParse(slotStartText,out var start)||!TimeOnly.TryParse(slotEndText,out var end)||end<=start)
        {
            SetMessage("Choose at least one weekday and an end time later than the start time.",true);
            return;
        }

        var requestedDays=selectedDays.OrderBy(day=>day).ToList();
        var existingForPeriod=slots.Where(slot=>slot.PeriodNumber==slotPeriod&&requestedDays.Contains(slot.DayOfWeek)).ToList();
        if(existingForPeriod.Count>0)
        {
            var existing=existingForPeriod[0];
            SetMessage($"P{slotPeriod} already exists on {DayName(existing.DayOfWeek)} as {SlotTime(existing)} ({existing.Type}). Period numbers can only be used once per day. Choose a different period number or remove the existing period first; no periods were added.",true);
            return;
        }

        var overlaps=slots.FirstOrDefault(slot=>requestedDays.Contains(slot.DayOfWeek)&&slot.PeriodNumber!=slotPeriod&&slot.StartTime.HasValue&&slot.EndTime.HasValue&&start<slot.EndTime.Value&&end>slot.StartTime.Value);
        if(overlaps is not null)
        {
            SetMessage($"This time overlaps {DayName(overlaps.DayOfWeek)} P{overlaps.PeriodNumber} ({SlotTime(overlaps)}). Adjust the time or remove the conflicting slot.",true);
            return;
        }

        busy=true;
        activeAction="slots";
        var failedDays=new List<string>();
        try
        {
            foreach(var day in requestedDays)
            {
                try
                {
                    var saved=await Timetable.SaveSlotAsync(new TimetableSlotRequest{DayOfWeek=day,PeriodNumber=slotPeriod,StartTime=start,EndTime=end,Type=slotType});
                    if(saved is null)throw new InvalidOperationException("The service returned no saved period.");
                }
                catch(Exception ex)
                {
                    failedDays.Add($"{DayName(day)}: {ex.Message}");
                }
            }

            if(failedDays.Count>0)
            {
                slots=await Timetable.GetSlotsAsync();
                SetMessage($"P{slotPeriod} was saved for some weekdays but failed for: {string.Join("; ",failedDays)}. Correct the listed issue and add the remaining days individually; no matching existing periods were overwritten.",true);
                return;
            }

            var duration=end.ToTimeSpan()-start.ToTimeSpan();
            slotStartText=end.ToString("HH:mm");
            slotEndText=end.Add(duration).ToString("HH:mm");
            slotPeriod++;
            slots=await Timetable.GetSlotsAsync();
            SetMessage($"P{slotPeriod-1} saved for the selected weekdays. The next period is set to {slotStartText}–{slotEndText}.",false);
        }
        catch(Exception ex)
        {
            SetMessage($"Periods could not be refreshed after saving: {ex.Message}",true);
        }
        finally
        {
            busy=false;
            activeAction="";
        }
    }
