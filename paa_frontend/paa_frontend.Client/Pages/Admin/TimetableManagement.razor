    {
        public bool Equals((string ClassId, string SubjectId) left, (string ClassId, string SubjectId) right) =>
            StringComparer.OrdinalIgnoreCase.Equals(left.ClassId, right.ClassId) && StringComparer.OrdinalIgnoreCase.Equals(left.SubjectId, right.SubjectId);
        public int GetHashCode((string ClassId, string SubjectId) key) =>
            HashCode.Combine(StringComparer.OrdinalIgnoreCase.GetHashCode(key.ClassId), StringComparer.OrdinalIgnoreCase.GetHashCode(key.SubjectId));
    }
    private sealed record StaffAttendanceEntry(long TeacherId, DateOnly Date, string Status);
    private readonly HashSet<int> selectedDays = new(){1,2,3,4,5}; private int selectedSlotDay=1, termYear=DateTime.Today.Year, termNumber=CurrentTermNumber; private List<ClassOption> classes = new(); private readonly List<string> subjects = new(); private readonly List<string> qualificationSubjects = new(); private readonly Dictionary<string,List<string>> subjectsByClass = new(StringComparer.OrdinalIgnoreCase);
    private List<TimetableSlot> slots = new(); private List<TimetableAllocation> allocations = new(); private List<TeacherProfileModel.Teacher> teachers = new(); private List<TimetableTeacherSubject> teacherSubjects = new(); private List<TimetableTeacherUnavailable> teacherUnavailable = new(); private List<TimetableRoom> rooms = new(); private List<TimetableGenerationIssue> validation = new(); private List<TimetableAssignment> previewAssignments=new(); private Dictionary<Guid,TimetableSlot> previewSlots=new(); private List<TimetableVersionInfo> savedVersions=new();
    private string term = $"{DateTime.Today.Year}-T{CurrentTermNumber}", slotStartText = "08:00", slotEndText = "08:40", slotType = "LESSON", allocationClass = "", allocationSubject = "", teacherId = "", allocationRoomType = "", generationClass = "", generationVersion = "", generationName="", qualificationTeacherId = "", qualificationClass = "", qualificationSubject = "", unavailableTeacherId = "", unavailableSlotId = "", roomCode = "", roomType = "", message = "", previewClassId="", previewTeacherId="", previewMode="class", activeTab="setup", savedViewVersion="";
    private string moveAssignmentId="", moveTargetSlotId="";
    private string analyticsVersionId=""; private DateTime analyticsStartDate=DateTime.Today.AddDays(-29), analyticsEndDate=DateTime.Today;
    private bool analyticsLoading, analyticsLoaded; private int analyticsTotalPeriods, analyticsTotalMinutes, analyticsClassCount, analyticsAttendanceMatchCount;
    private List<AnalyticsWorkload> analyticsTeacherStats=new(); private List<AnalyticsGroup> analyticsClassStats=new(); private List<SubjectAnalytics> analyticsSubjectStats=new(); private List<ClassSubjectAnalytics> analyticsClassSubjectStats=new();
    private int slotPeriod = 1, plannedPeriods = 4, doubleLessons = 0, roomCapacity, timeLimitSeconds=30; private bool busy, loadingData=true, loadFailed, isError, heavySubject, previewLoading, accessDenied; private string activeAction=""; private TimetableJob? job;
