    private bool TryBuildRequest(out TimetableGenerateRequest request){request=new();if(timeLimitSeconds<1||timeLimitSeconds>300){SetMessage("Solver time limit must be between 1 and 300 seconds.",true);return false;}if(!string.IsNullOrWhiteSpace(generationVersion)&&!Guid.TryParse(generationVersion,out _)){SetMessage("Select a saved draft or enter a valid timetable ID.",true);return false;}if(string.IsNullOrWhiteSpace(generationVersion)&&string.IsNullOrWhiteSpace(generationName)){SetMessage("Enter a name for this timetable before generating.",true);return false;}request=new(){Term=term,Name=generationName.Trim(),TimeLimitSeconds=timeLimitSeconds,ClassId=string.IsNullOrWhiteSpace(generationClass)?null:generationClass,VersionId=Guid.TryParse(generationVersion,out var v)?v:null};return true;}
    private async Task Validate(){if(!TryBuildRequest(out var request))return;busy=true;activeAction="validate";try{validation=await Timetable.ValidateAsync(request);SetMessage(validation.Count==0?"Setup checks passed. You can generate a draft.":$"Readiness check found {validation.Count} issue(s).",validation.Count>0);}catch(Exception ex){SetMessage(ex.Message,true);}finally{busy=false;activeAction="";}}
    private async Task Generate(){if(!TryBuildRequest(out var request))return;busy=true;activeAction="generate";job=null;previewVersionId=null;try{job=await Timetable.GenerateAsync(request);if(job is null)throw new InvalidOperationException("Generation request was rejected.");for(var i=0;i<310&&(job.Status=="QUEUED"||job.Status=="RUNNING");i++){await Task.Delay(1000);job=await Timetable.GetJobAsync(job.Id)??job;}if(job.Status=="COMPLETED"){generationVersion=job.VersionId?.ToString()??generationVersion;savedVersions=await Timetable.GetVersionsAsync(term);savedViewVersion=job.VersionId?.ToString()??"";activeTab="view";previewClassId=string.IsNullOrWhiteSpace(generationClass)?allocations.Select(a=>a.ClassId).FirstOrDefault()??"":generationClass;SetMessage("Timetable generation completed.",false);if(!string.IsNullOrWhiteSpace(previewClassId))await LoadPreview();}else{validation=job.Issues;SetMessage(job.Message??"Timetable generation did not complete.",true);}}catch(Exception ex){SetMessage(ex.Message,true);}finally{busy=false;activeAction="";}}
    private async Task PublishVersion(Guid version){busy=true;activeAction="publish";try{await Timetable.PublishAsync(version);savedVersions=await Timetable.GetVersionsAsync(term);SetMessage("Timetable published. It is now the active version for student and staff portals.",false);}catch(Exception ex){SetMessage(ex.Message,true);}finally{busy=false;activeAction="";}}
    private static string DayName(int day)=>Days.GetValueOrDefault(day,"?"); private void SetMessage(string text,bool error){message=text;isError=error;}
}
