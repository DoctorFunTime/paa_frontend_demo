    private async Task LoadAnalytics()
    {
        var startDate=DateOnly.FromDateTime(analyticsStartDate);
        var endDate=DateOnly.FromDateTime(analyticsEndDate);
        if(!Guid.TryParse(analyticsVersionId,out var versionId)||endDate<startDate)
        {
            SetMessage("Choose a published timetable and a valid attendance date range.",true);
            return;
        }
        if(endDate.DayNumber-startDate.DayNumber>366){SetMessage("Choose an attendance range of one year or less.",true);return;}

        analyticsLoading=true;analyticsLoaded=false;activeAction="analytics";
        try
        {
            var version=savedVersions.FirstOrDefault(v=>v.Id==versionId)??throw new InvalidOperationException("The selected timetable is no longer available. Reload the page and try again.");
            var termAllocations=await Timetable.GetAllocationsAsync(version.Term);
            var classIds=termAllocations.Select(a=>a.ClassId).Where(id=>!string.IsNullOrWhiteSpace(id)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            var classAssignments=await Task.WhenAll(classIds.Select(id=>Timetable.GetByClassAsync(versionId,id)));
            var assignments=classAssignments.SelectMany(group=>group).DistinctBy(assignment=>assignment.Id).ToList();
            var slotsById=slots.ToDictionary(slot=>slot.Id);
            bool IsLesson(TimetableAssignment assignment)=>slotsById.TryGetValue(assignment.SlotId,out var slot)&&slot.Type=="LESSON"&&!slot.Blocked;
            int Minutes(TimetableAssignment assignment){if(!slotsById.TryGetValue(assignment.SlotId,out var slot)||!slot.StartTime.HasValue||!slot.EndTime.HasValue)return 0;return Math.Max(0,(int)(slot.EndTime.Value.ToTimeSpan()-slot.StartTime.Value.ToTimeSpan()).TotalMinutes);}
            var lessonAssignments=assignments.Where(IsLesson).ToList();
            analyticsTotalPeriods=lessonAssignments.Count;
            analyticsTotalMinutes=lessonAssignments.Sum(Minutes);
            analyticsClassCount=lessonAssignments.Select(a=>a.ClassId).Where(id=>!string.IsNullOrWhiteSpace(id)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
            analyticsClassStats=lessonAssignments.Where(a=>!string.IsNullOrWhiteSpace(a.ClassId)).GroupBy(a=>a.ClassId!,StringComparer.OrdinalIgnoreCase).Select(g=>new AnalyticsGroup(g.Key,g.Count(),g.Sum(Minutes))).ToList();
            analyticsSubjectStats=lessonAssignments.Where(a=>!string.IsNullOrWhiteSpace(a.SubjectId)).GroupBy(a=>a.SubjectId!,StringComparer.OrdinalIgnoreCase).Select(g=>new SubjectAnalytics(g.Key,g.Count(),g.Sum(Minutes))).ToList();
            analyticsClassSubjectStats=lessonAssignments.Where(a=>!string.IsNullOrWhiteSpace(a.ClassId)&&!string.IsNullOrWhiteSpace(a.SubjectId)).GroupBy(a=>(ClassId:a.ClassId!,SubjectId:a.SubjectId!),new ClassSubjectKeyComparer()).Select(g=>new ClassSubjectAnalytics(g.Key.ClassId,g.Key.SubjectId,g.Count(),g.Sum(Minutes))).ToList();

            var teacherById=teachers.ToDictionary(t=>t.Id.ToString(),StringComparer.OrdinalIgnoreCase);
            var workloads=new Dictionary<string,AnalyticsWorkload>(StringComparer.OrdinalIgnoreCase);
            var scheduleByTeacherAndDay=new Dictionary<string,Dictionary<int,(int Periods,int Minutes)>>(StringComparer.OrdinalIgnoreCase);
            foreach(var assignment in lessonAssignments.Where(a=>!string.IsNullOrWhiteSpace(a.TeacherId)&&!a.TeacherId!.StartsWith("UNASSIGNED:",StringComparison.OrdinalIgnoreCase)))
            {
                var id=assignment.TeacherId!.Trim();
                if(!workloads.TryGetValue(id,out var workload)){var name=teacherById.TryGetValue(id,out var teacher)?TeacherName(teacher):TeacherName(id);workload=new AnalyticsWorkload{TeacherId=id,Name=string.IsNullOrWhiteSpace(name)?$"Teacher {id}":name};workloads[id]=workload;}
                workload.WeeklyPeriods++;workload.WeeklyMinutes+=Minutes(assignment);
                if(!slotsById.TryGetValue(assignment.SlotId,out var slot))continue;
                if(!scheduleByTeacherAndDay.TryGetValue(id,out var byDay)){byDay=new();scheduleByTeacherAndDay[id]=byDay;}
                var current=byDay.GetValueOrDefault(slot.DayOfWeek);byDay[slot.DayOfWeek]=(current.Periods+1,current.Minutes+Minutes(assignment));
            }

            var sessions=(await AttendanceService.GetSessionsByDateRangeAsync(startDate,endDate)??new()).Where(session=>string.Equals(session.Type,"Staff",StringComparison.OrdinalIgnoreCase)).ToList();
            var recordGroups=await Task.WhenAll(sessions.Select(async session=>(session,records:await AttendanceService.GetRecordsBySessionAsync(session.Id)??new List<AttendanceRecordDto>())));
            var attendance=recordGroups.SelectMany(group=>group.records.Select(record=>new StaffAttendanceEntry(record.PersonId,group.session.Date,record.Status??""))).ToList();
            analyticsAttendanceMatchCount=attendance.Count(entry=>workloads.ContainsKey(entry.TeacherId.ToString()));
            foreach(var entry in attendance)
            {
                if(!workloads.TryGetValue(entry.TeacherId.ToString(),out var workload))continue;
                var status=entry.Status.Trim();
                var day=(int)entry.Date.DayOfWeek;if(day==0)day=7;
                var scheduled=scheduleByTeacherAndDay.GetValueOrDefault(workload.TeacherId)?.GetValueOrDefault(day)??(0,0);
                if(status.Equals("Present",StringComparison.OrdinalIgnoreCase)){workload.PresentDays++;workload.PeriodsOnPresentDays+=scheduled.Periods;workload.MinutesOnPresentDays+=scheduled.Minutes;}
                else if(status.Equals("Late",StringComparison.OrdinalIgnoreCase)){workload.LateDays++;workload.PeriodsOnPresentDays+=scheduled.Periods;workload.MinutesOnPresentDays+=scheduled.Minutes;}
                else if(status.Equals("Absent",StringComparison.OrdinalIgnoreCase)){workload.AbsentDays++;workload.PeriodsOnAbsentDays+=scheduled.Periods;workload.MinutesOnAbsentDays+=scheduled.Minutes;}
            }
            analyticsTeacherStats=workloads.Values.OrderByDescending(row=>row.WeeklyMinutes).ToList();
            analyticsLoaded=true;
            SetMessage($"Analytics loaded for {version.Name} ({version.Term}).",false);
        }
        catch(Exception ex){SetMessage($"Analytics could not be loaded: {ex.Message}",true);}
        finally{analyticsLoading=false;activeAction="";}
    }
