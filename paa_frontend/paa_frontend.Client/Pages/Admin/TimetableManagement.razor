@page "/admin/academics/timetable"
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using paa_frontend.Shared.Models
@using paa_frontend.Client.Services
@using paa_frontend.Client.Services.Admin
@using System.Security.Claims
@using static paa_frontend.Shared.Models.Admin.OlevelClassesModel
@using static paa_frontend.Shared.Models.Admin.AlevelClassesModel
@inject TimetableServiceClient Timetable
@inject StudentSubjectServiceClient SubjectService
@inject TeacherProfileServiceClient TeacherProfileService
@inject AttendanceServiceClient AttendanceService
@inject Microsoft.JSInterop.IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<div class="mx-auto max-w-7xl space-y-7">
    <header><p class="text-xs font-bold uppercase tracking-widest text-emerald-700">Academics</p><h1 class="mt-2 text-3xl font-extrabold text-slate-900">Timetable setup and management</h1><p class="mt-2 max-w-3xl text-sm text-slate-600">Set the weekly bell schedule and each class's subject load before generating a draft. A double lesson uses two adjacent periods and counts as two of that subject's weekly periods.</p></header>
    @if (accessDenied) { <div class="rounded-lg border border-amber-300 bg-amber-50 px-4 py-4 text-sm text-amber-950" role="alert"><p class="font-bold">Administrator sign-in required</p><p class="mt-1">This page needs an ADMIN or SUPER account. Your current session role@(currentRoles.Length == 1 ? " is " : "s are ")@string.Join(", ", currentRoles).</p><p class="mt-1">The “Admin” label is part of this page layout; it does not grant access. Sign out, log in with your administrator account, then reopen Timetable Management.</p></div> }
    else if (loadingData) { <div class="flex items-center gap-3 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm font-semibold text-sky-900" role="status" aria-live="polite"><span class="h-4 w-4 animate-spin rounded-full border-2 border-sky-700 border-t-transparent"></span>Loading classes, subjects, teachers, and timetable setup…</div> }
    @if (loadFailed && !loadingData) { <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-900" role="alert"><span>Some setup data did not load. Retry before making changes.</span><button class="rounded-md border border-rose-300 bg-white px-3 py-1.5 font-bold" @onclick="LoadSetupData" disabled="@busy">@(activeAction == "load" ? "Retrying…" : "Retry loading")</button></div> }
    @if (!string.IsNullOrWhiteSpace(message)){<div class="rounded-lg border @(isError ? "border-rose-200 bg-rose-50 text-rose-800" : "border-emerald-200 bg-emerald-50 text-emerald-900") px-4 py-3 text-sm font-semibold" role="status">@message</div>}

    <nav class="flex gap-2 border-b border-slate-200" role="tablist" aria-label="Timetable administration">
        <button role="tab" aria-selected="@(activeTab=="setup")" class="border-b-2 px-4 py-3 text-sm font-bold @(activeTab=="setup"?"border-emerald-700 text-emerald-800":"border-transparent text-slate-500")" @onclick="ShowSetup">Setup &amp; Generate</button>
        <button role="tab" aria-selected="@(activeTab=="view")" class="border-b-2 px-4 py-3 text-sm font-bold @(activeTab=="view"?"border-emerald-700 text-emerald-800":"border-transparent text-slate-500")" @onclick="ShowTimetables">View Timetables</button>
        <button role="tab" aria-selected="@(activeTab=="analytics")" class="border-b-2 px-4 py-3 text-sm font-bold @(activeTab=="analytics"?"border-emerald-700 text-emerald-800":"border-transparent text-slate-500")" @onclick="ShowAnalytics">Analytics</button>
    </nav>
    <div hidden="@(activeTab!="setup")">

    <section class="mt-8 border-t-2 border-slate-300 pt-8">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-xl font-bold text-slate-900">1. Weekly periods</h2><p class="mt-1 text-sm text-slate-500">Add each period time and choose which weekdays use it. Add breaks as BREAK slots.</p></div><span class="text-sm font-semibold text-slate-600">@(loadingData ? "Loading periods…" : $"{slots.Count(s => !s.Blocked && s.Type == "LESSON")} lesson slots")</span></div>
        <div class="grid gap-3 rounded-lg bg-slate-50 p-4 md:grid-cols-6">
            <label class="text-sm font-semibold text-slate-700">Period number<input type="number" min="1" @bind="slotPeriod" disabled="@(loadingData || busy)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100" /></label>
            <label class="text-sm font-semibold text-slate-700">Starts<input type="time" value="@slotStartText" @onchange="SlotStartChanged" disabled="@(loadingData || busy)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100" /></label>
            <label class="text-sm font-semibold text-slate-700">Ends<input type="time" value="@slotEndText" @onchange="SlotEndChanged" disabled="@(loadingData || busy)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100" /></label>
            <label class="text-sm font-semibold text-slate-700">Slot type<select @bind="slotType" disabled="@(loadingData || busy)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100"><option value="LESSON">Lesson</option><option value="BREAK">Break</option><option value="LUNCH">Lunch</option><option value="SPORT">Sports</option><option value="BLOCKED">Blocked</option></select></label>
            <fieldset class="md:col-span-2" disabled="@(loadingData || busy)"><legend class="text-sm font-semibold text-slate-700">Weekdays</legend><div class="mt-2 flex flex-wrap gap-x-3 gap-y-2">@foreach (var day in Days) { <label class="flex items-center gap-1.5 text-sm"><input type="checkbox" checked="@selectedDays.Contains(day.Key)" @onchange="e => ToggleDay(day.Key, e)" />@day.Value</label> }</div></fieldset>
            <button class="rounded-md bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-slate-700 disabled:cursor-wait disabled:opacity-60 md:col-span-6 md:justify-self-start" @onclick="AddSlots" disabled="@(loadingData || busy)">@(activeAction == "slots" ? "Adding periods…" : "Add period to selected days")</button>
        </div>
        <div class="mt-4 rounded-lg border border-slate-200 bg-white">
            <div class="flex gap-1 overflow-x-auto border-b border-slate-200 p-2" role="tablist" aria-label="Periods by weekday">
                @foreach (var day in Days) { <button role="tab" aria-selected="@(selectedSlotDay == day.Key)" class="shrink-0 rounded-md px-4 py-2 text-sm font-bold @(selectedSlotDay == day.Key ? "bg-slate-900 text-white" : "text-slate-600 hover:bg-slate-100")" @onclick="() => selectedSlotDay = day.Key">@day.Value <span class="ml-1 opacity-70">@slots.Count(s => s.DayOfWeek == day.Key)</span></button> }
            </div>
            <div class="max-h-80 overflow-auto"><table class="w-full min-w-[620px] text-left text-sm"><thead class="sticky top-0 bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Period</th><th class="px-4 py-3">Time</th><th class="px-4 py-3">Type</th><th></th></tr></thead><tbody class="divide-y divide-slate-100">@foreach (var slot in slots.Where(s => s.DayOfWeek == selectedSlotDay).OrderBy(s => s.PeriodNumber)) { <tr><td class="px-4 py-3">@slot.PeriodNumber</td><td class="px-4 py-3">@(slot.StartTime?.ToString("HH:mm")) - @(slot.EndTime?.ToString("HH:mm"))</td><td class="px-4 py-3">@slot.Type</td><td class="px-4 py-3 text-right"><button class="font-semibold text-rose-700 hover:underline disabled:opacity-50" title="Remove slot" @onclick="() => RemoveSlot(slot.Id)" disabled="@(loadingData || busy)">@(activeAction == $"slot-{slot.Id}" ? "Removing…" : "Remove")</button></td></tr> } @if (!loadingData && !slots.Any(s => s.DayOfWeek == selectedSlotDay)) { <tr><td colspan="4" class="px-4 py-6 text-slate-500">No periods configured for @DayName(selectedSlotDay).</td></tr> } @if (loadingData) { <tr><td colspan="4" class="px-4 py-6 text-slate-500">Loading periods…</td></tr> }</tbody></table></div>
        </div>
    </section>

    <section class="mt-8 border-t-2 border-slate-300 pt-8">
        <div class="mb-4"><h2 class="text-xl font-bold text-slate-900">2. Teacher qualifications and availability</h2><p class="mt-1 text-sm text-slate-500">Choose a form and class combination first; subjects are limited to that class's enrollment offerings. Qualifications identify what a teacher can teach. Add each subject and its weekly periods under Class subject allocations to include it in the timetable.</p></div>
        <div class="grid gap-3 rounded-lg bg-slate-50 p-4 md:grid-cols-4">
            <label class="text-sm font-semibold text-slate-700">Teacher<select @bind="qualificationTeacherId" disabled="@(loadingData || busy || teachers.Count == 0)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:cursor-wait disabled:bg-slate-100"><option value="">@(loadingData ? "Loading staff…" : teachers.Count == 0 ? "No staff available" : "Select staff member")</option>@foreach(var t in teachers){<option value="@t.Id">@TeacherName(t)</option>}</select></label>
            <label class="text-sm font-semibold text-slate-700">Form / class<select @bind="qualificationClass" @bind:after="QualificationClassSelected" disabled="@(loadingData || busy || classes.Count == 0)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:cursor-wait disabled:bg-slate-100"><option value="">@(loadingData ? "Loading classes…" : classes.Count == 0 ? "No classes available" : "Select class")</option>@foreach(var c in classes){<option value="@c.Key">@c.Label</option>}</select></label>
            <label class="text-sm font-semibold text-slate-700">Qualified subject<select @bind="qualificationSubject" disabled="@(loadingData || busy || string.IsNullOrWhiteSpace(qualificationClass) || qualificationSubjects.Count == 0)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:cursor-wait disabled:bg-slate-100"><option value="">@(loadingData ? "Loading subjects…" : string.IsNullOrWhiteSpace(qualificationClass) ? "Select a class first" : qualificationSubjects.Count == 0 ? "No offered subjects" : "Select offered subject")</option>@foreach(var s in qualificationSubjects){<option value="@s">@s</option>}</select></label>
            <button class="self-end rounded-md bg-slate-900 px-4 py-2 text-sm font-bold text-white disabled:cursor-wait disabled:opacity-60" @onclick="AddQualification" disabled="@(loadingData || busy)">@(activeAction == "qualification" ? "Saving qualification…" : "Add subject qualification")</button>
            <label class="text-sm font-semibold text-slate-700">Teacher unavailable<select @bind="unavailableTeacherId" disabled="@(loadingData || busy || teachers.Count == 0)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:cursor-wait disabled:bg-slate-100"><option value="">@(loadingData ? "Loading staff…" : teachers.Count == 0 ? "No staff available" : "Select staff")</option>@foreach(var t in teachers){<option value="@t.Id">@TeacherName(t)</option>}</select></label>
            <label class="text-sm font-semibold text-slate-700">Weekly slot (day + period)<select @bind="unavailableSlotId" disabled="@(loadingData || busy || slots.Count == 0)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:cursor-wait disabled:bg-slate-100"><option value="">@(loadingData ? "Loading periods…" : "Select period")</option>@foreach(var s in slots.Where(s=>s.Type=="LESSON"&&!s.Blocked).OrderBy(s=>s.DayOfWeek).ThenBy(s=>s.PeriodNumber)){<option value="@s.Id">@DayName(s.DayOfWeek) P@s.PeriodNumber · @(s.StartTime?.ToString("HH:mm"))</option>}</select></label>
            <button class="self-end rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 disabled:cursor-wait disabled:opacity-60" @onclick="AddUnavailability" disabled="@(loadingData || busy)">@(activeAction == "unavailability" ? "Saving availability…" : "Mark unavailable")</button>
        </div>
        <div class="mt-3 grid gap-4 lg:grid-cols-2"><div><h3 class="mb-2 text-sm font-bold text-slate-700">Qualified subjects</h3><div class="max-h-64 overflow-auto rounded-lg border border-slate-200 bg-white"><table class="w-full text-left text-sm"><tbody class="divide-y divide-slate-100">@foreach(var q in teacherSubjects){<tr><td class="px-3 py-2">@q.TeacherName (@q.TeacherId)</td><td class="px-3 py-2 font-semibold">@q.SubjectId</td><td class="px-3 py-2 text-right"><button class="text-rose-700 disabled:opacity-50" @onclick="()=>RemoveQualification(q.Id)" disabled="@(loadingData || busy)">@(activeAction == $"qualification-{q.Id}" ? "Removing…" : "Remove")</button></td></tr>}@if(teacherSubjects.Count==0){<tr><td class="px-3 py-3 text-slate-500">@(loadingData ? "Loading qualifications…" : "No teacher-subject qualifications yet.")</td></tr>}</tbody></table></div></div><div><h3 class="mb-2 text-sm font-bold text-slate-700">Unavailable periods</h3><div class="max-h-64 overflow-auto rounded-lg border border-slate-200 bg-white"><table class="w-full text-left text-sm"><tbody class="divide-y divide-slate-100">@foreach(var u in teacherUnavailable){var slot=slots.FirstOrDefault(s=>s.Id==u.SlotId);<tr><td class="px-3 py-2">@TeacherName(u.TeacherId)</td><td class="px-3 py-2">@(slot is null?"Missing slot":$"{DayName(slot.DayOfWeek)} P{slot.PeriodNumber}")</td><td class="px-3 py-2 text-right"><button class="text-rose-700 disabled:opacity-50" @onclick="()=>RemoveUnavailability(u)" disabled="@(loadingData || busy)">@(activeAction == $"unavailable-{u.Id}" ? "Removing…" : "Remove")</button></td></tr>}@if(teacherUnavailable.Count==0){<tr><td class="px-3 py-3 text-slate-500">@(loadingData ? "Loading availability…" : "No recurring unavailability recorded.")</td></tr>}</tbody></table></div></div></div>
    </section>

    <section class="mt-8 border-t-2 border-slate-300 pt-8">
        <div class="mb-4"><h2 class="text-xl font-bold text-slate-900">3. Rooms and specialist spaces</h2><p class="mt-1 text-sm text-slate-500">Add active rooms using the same labels you will enter as an allocation's optional room requirement, such as LAB or COMPUTER_LAB.</p></div>
        <div class="grid gap-3 rounded-lg bg-slate-50 p-4 md:grid-cols-4"><label class="text-sm font-semibold text-slate-700">Room code<input @bind="roomCode" disabled="@(loadingData || busy)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100" /></label><label class="text-sm font-semibold text-slate-700">Room type<input @bind="roomType" disabled="@(loadingData || busy)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100" /></label><label class="text-sm font-semibold text-slate-700">Capacity<input type="number" min="0" @bind="roomCapacity" disabled="@(loadingData || busy)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100" /></label><button class="self-end rounded-md bg-slate-900 px-4 py-2 text-sm font-bold text-white disabled:cursor-wait disabled:opacity-60" @onclick="SaveRoom" disabled="@(loadingData || busy)">@(activeAction == "room" ? "Saving room…" : "Add or update room")</button></div>
        <div class="mt-3 max-h-40 overflow-auto">@if(loadingData){<p class="text-sm text-slate-500" role="status">Loading rooms…</p>}else if(rooms.Count==0){<p class="text-sm text-slate-500">No rooms configured yet.</p>}else{<div class="flex flex-wrap gap-2">@foreach(var room in rooms){<span class="inline-flex items-center gap-2 border border-slate-200 bg-white px-3 py-1.5 text-sm">@room.RoomCode · @room.RoomType · @room.Capacity<button class="font-bold text-rose-700 disabled:opacity-50" title="Deactivate room" @onclick="()=>DeactivateRoom(room.Id)" disabled="@(loadingData || busy)">@(activeAction == $"room-{room.Id}" ? "…" : "×")</button></span>}</div>}</div>
    </section>

    <section class="mt-8 border-t-2 border-slate-300 pt-8">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-xl font-bold text-slate-900">4. Class subject allocations</h2><p class="mt-1 text-sm text-slate-500">Set each class's weekly subject load; the generator chooses the periods for you. You do not assign each subject to a slot manually.</p>@if(activeAction=="term"){<p class="mt-1 text-sm font-semibold text-sky-700" role="status">Loading allocations for @term…</p>}</div><div class="flex items-end gap-2"><label class="text-sm font-semibold text-slate-700">Year<select @bind="termYear" @bind:after="TermSelectionChanged" disabled="@(loadingData || busy)" class="ml-2 rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100">@for(var year=DateTime.Today.Year-1;year<=DateTime.Today.Year+5;year++){<option value="@year">@year</option>}</select></label><label class="text-sm font-semibold text-slate-700">Term<select @bind="termNumber" @bind:after="TermSelectionChanged" disabled="@(loadingData || busy)" class="ml-2 rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100"><option value="1">Term 1</option><option value="2">Term 2</option><option value="3">Term 3</option></select></label></div></div>
        <div class="grid gap-3 rounded-lg bg-slate-50 p-4 md:grid-cols-8">
            <label class="text-sm font-semibold text-slate-700">Form / class<select @bind="allocationClass" @bind:after="ClassSelected" disabled="@(loadingData || busy || classes.Count == 0)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:cursor-wait disabled:bg-slate-100"><option value="">@(loadingData ? "Loading classes…" : classes.Count == 0 ? "No classes available" : "Select class")</option>@foreach(var c in classes){<option value="@c.Key">@c.Label</option>}</select></label>
            <label class="text-sm font-semibold text-slate-700">Subject<select @bind="allocationSubject" @bind:after="SubjectSelected" disabled="@(loadingData || busy || string.IsNullOrWhiteSpace(allocationClass) || EligibleAllocationSubjects.Count == 0)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:cursor-wait disabled:bg-slate-100"><option value="">@(loadingData ? "Loading subjects…" : string.IsNullOrWhiteSpace(allocationClass) ? "Select a class first" : EligibleAllocationSubjects.Count == 0 ? "No offered subjects with a qualified teacher" : "Select subject")</option>@foreach(var s in EligibleAllocationSubjects){<option value="@s">@s</option>}</select></label>
            <label class="text-sm font-semibold text-slate-700">Periods / week<input type="number" min="1" @bind="plannedPeriods" disabled="@(loadingData || busy)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100" /></label>
            <label class="text-sm font-semibold text-slate-700">Double lessons / week<input type="number" min="0" @bind="doubleLessons" disabled="@(loadingData || busy)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100" /></label>
            <label class="text-sm font-semibold text-slate-700">Assigned teacher<select @bind="teacherId" disabled="@(loadingData || busy || string.IsNullOrWhiteSpace(allocationSubject) || !QualifiedTeachers.Any())" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:cursor-wait disabled:bg-slate-100"><option value="">@(loadingData ? "Loading qualified teachers…" : string.IsNullOrWhiteSpace(allocationSubject) ? "Select a subject first" : !QualifiedTeachers.Any() ? "No qualified teachers for subject" : "Select qualified teacher")</option>@foreach(var q in QualifiedTeachers){<option value="@q.TeacherId">@q.TeacherName (@q.TeacherId)</option>}</select></label>
            <label class="text-sm font-semibold text-slate-700">Required room type<input @bind="allocationRoomType" disabled="@(loadingData || busy)" placeholder="Optional, e.g. LAB" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100" /></label>
            <label class="flex items-center gap-2 self-end pb-2 text-sm font-semibold text-slate-700"><input type="checkbox" @bind="heavySubject" disabled="@(loadingData || busy)" />Heavy subject</label>
            <button class="self-end rounded-md bg-emerald-700 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-800 disabled:cursor-wait disabled:opacity-60" @onclick="SaveAllocation" disabled="@(loadingData || busy)">@(activeAction == "allocation" ? "Saving allocation…" : "Save allocation")</button>
        </div>
        <p class="mt-2 text-xs text-slate-500">A weekly slot is one recurring weekday and period number, such as Monday P1. A double lesson uses two adjacent slots and counts as 2 periods in the weekly total; e.g. 6 periods/week with 3 doubles. Heavy subjects receive a soft preference for earlier periods; this does not block later placement.</p>
        <div class="mt-4 max-h-80 overflow-auto rounded-lg border border-slate-200 bg-white"><table class="w-full min-w-[620px] text-left text-sm"><thead class="sticky top-0 bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Form / class</th><th class="px-4 py-3">Subject</th><th class="px-4 py-3">Periods / week</th><th class="px-4 py-3">Double lessons</th><th class="px-4 py-3">Teacher</th><th></th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var allocation in allocations){<tr><td class="px-4 py-3">@ClassLabel(allocation.ClassId)</td><td class="px-4 py-3 font-semibold">@allocation.SubjectId</td><td class="px-4 py-3">@allocation.PlannedPeriods</td><td class="px-4 py-3">@allocation.DoublePeriodsPerWeek</td><td class="px-4 py-3">@(string.IsNullOrWhiteSpace(allocation.TeacherId)?"Not set":TeacherName(allocation.TeacherId))</td><td class="px-4 py-3 text-right"><button class="font-semibold text-rose-700 hover:underline disabled:opacity-50" @onclick="() => RemoveAllocation(allocation.Id)" disabled="@(loadingData || busy)">@(activeAction == $"allocation-{allocation.Id}" ? "Removing…" : "Remove")</button></td></tr>}@if(allocations.Count==0){<tr><td colspan="6" class="px-4 py-6 text-slate-500">@(loadingData ? "Loading allocations…" : $"No subject allocations saved for {term}.")</td></tr>}</tbody></table></div>
    </section>

    <section class="mt-8 border-t-2 border-slate-300 pt-8"><h2 class="text-xl font-bold text-slate-900">5. Validate and generate</h2><p class="mt-1 text-sm text-slate-500">Validation checks setup first. The solver then searches for a schedule obeying every hard constraint; failed runs leave any existing draft unchanged. Give each new timetable a clear name. Saved drafts can be selected later for regeneration.</p><div class="mt-4 grid gap-3 rounded-lg bg-slate-50 p-4 md:grid-cols-4"><label class="text-sm font-semibold text-slate-700">Generate for<select @bind="generationClass" disabled="@(loadingData || busy)" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100"><option value="">All configured classes</option>@foreach(var c in allocations.Select(a=>a.ClassId).Distinct().OrderBy(x=>x)){<option value="@c">@ClassLabel(c)</option>}</select></label><label class="text-sm font-semibold text-slate-700">Timetable name<input @bind="generationName" disabled="@(loadingData || busy || Guid.TryParse(generationVersion,out _))" required maxlength="160" placeholder="e.g. Form 2 Term 3 2026" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100" /></label><label class="text-sm font-semibold text-slate-700">Reuse saved draft<select @bind="generationVersion" disabled="@(loadingData || busy)" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100"><option value="">Create a new timetable</option>@foreach(var saved in savedVersions.Where(v=>v.Lifecycle=="DRAFT")){<option value="@saved.Id">@saved.Name</option>}</select></label><label class="text-sm font-semibold text-slate-700">Solver time limit (seconds)<input type="number" min="1" max="300" @bind="timeLimitSeconds" disabled="@(loadingData || busy)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 disabled:bg-slate-100" /></label><div class="flex flex-wrap items-end gap-2"><button class="rounded-md border border-slate-300 bg-white px-4 py-2.5 font-bold text-slate-800 disabled:cursor-wait disabled:opacity-60" @onclick="Validate" disabled="@(loadingData || busy)">@(activeAction == "validate" ? "Checking readiness…" : "Check readiness")</button><button class="rounded-md bg-emerald-700 px-5 py-2.5 font-bold text-white hover:bg-emerald-800 disabled:cursor-wait disabled:opacity-60" @onclick="Generate" disabled="@(loadingData || busy)">@(activeAction == "generate" ? "Generating timetable…" : "Generate")</button></div></div>@if(validation.Count>0){<div class="mt-4 space-y-2" role="status">@foreach(var issue in validation){<div class="border @(issue.Severity=="ERROR"?"border-rose-200 bg-rose-50":"border-amber-200 bg-amber-50") p-3 text-sm"><div class="font-bold">@issue.Message</div><div class="mt-1">Suggested fix: @issue.Suggestion</div></div>}</div>}@if(job is not null){<div class="mt-4 border border-slate-200 bg-white p-4 text-sm"><div class="font-bold text-slate-900">@job.Status · @job.Score</div><p class="mt-1 text-slate-600">@job.Message</p>@if(job.VersionId.HasValue){<p class="mt-2 break-all font-mono text-xs text-slate-600">Draft: @(savedVersions.FirstOrDefault(v=>v.Id==job.VersionId)?.Name ?? "Saved timetable") <span class="break-all font-mono text-xs text-slate-500">(@job.VersionId)</span></p><p class="mt-1 text-slate-700">Scheduled @job.Scheduled periods; unscheduled @job.Unscheduled.</p>@if(savedVersions.Any(v=>v.Id==job.VersionId&&v.Lifecycle=="DRAFT")){<button class="mt-3 rounded-md bg-slate-900 px-4 py-2 font-bold text-white disabled:opacity-60" @onclick="()=>PublishVersion(job.VersionId.Value)" disabled="@busy">@(activeAction=="publish"?"Publishing…":"Publish timetable")</button>}}@foreach(var issue in job.Issues){<div class="mt-2 border-l-2 border-rose-500 pl-3"><div class="font-semibold">@issue.Message</div><div class="text-slate-600">Suggested fix: @issue.Suggestion</div></div>}</div>}@if(savedVersions.Count>0){<div class="mt-4 overflow-auto rounded-lg border border-slate-200 bg-white"><table class="w-full min-w-[640px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Name</th><th class="px-4 py-3">Term</th><th class="px-4 py-3">Status</th><th class="px-4 py-3"></th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var saved in savedVersions){<tr><td class="px-4 py-3 font-semibold">@saved.Name</td><td class="px-4 py-3">@saved.Term</td><td class="px-4 py-3">@saved.Lifecycle</td><td class="px-4 py-3 text-right"><button class="mr-3 font-semibold text-blue-700 hover:underline" @onclick="()=>LoadSavedVersion(saved.Id)" disabled="@busy">View</button>@if(saved.Lifecycle=="DRAFT"){<button class="font-semibold text-emerald-700 hover:underline" @onclick="()=>PublishVersion(saved.Id)" disabled="@busy">@(activeAction=="publish"?"Publishing…":"Publish")</button>}</td></tr>}</tbody></table></div>}</section>
    </div>
    <div hidden="@(activeTab!="view")" class="space-y-6">
        <section class="border-t border-slate-200 pt-6">
            <h2 class="text-xl font-bold text-slate-900">View a saved timetable</h2>
            <p class="mt-1 text-sm text-slate-600">Choose the year and term, then open a named draft, published timetable, or archived version.</p>
            <div class="mt-4 flex flex-wrap items-end gap-3 rounded-lg bg-slate-50 p-4">
                <label class="text-sm font-semibold text-slate-700">Year<select @bind="termYear" @bind:after="TermSelectionChanged" disabled="@(loadingData||busy)" class="mt-1 block rounded-md border border-slate-300 bg-white px-3 py-2">@for(var year=DateTime.Today.Year-1;year<=DateTime.Today.Year+5;year++){<option value="@year">@year</option>}</select></label>
                <label class="text-sm font-semibold text-slate-700">Term<select @bind="termNumber" @bind:after="TermSelectionChanged" disabled="@(loadingData||busy)" class="mt-1 block rounded-md border border-slate-300 bg-white px-3 py-2"><option value="1">Term 1</option><option value="2">Term 2</option><option value="3">Term 3</option></select></label>
                <label class="min-w-64 flex-1 text-sm font-semibold text-slate-700">Saved timetable<select @bind="savedViewVersion" disabled="@(loadingData||busy||savedVersions.Count==0)" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2"><option value="">@(loadingData?"Loading timetables…":savedVersions.Count==0?$"No timetables saved for {term}":"Select a timetable")</option>@foreach(var saved in savedVersions){<option value="@saved.Id">@saved.Name · @saved.Lifecycle</option>}</select></label>
                <button class="rounded-md bg-slate-900 px-4 py-2 font-bold text-white disabled:opacity-50" @onclick="LoadSelectedSavedVersion" disabled="@(busy||!Guid.TryParse(savedViewVersion,out _))">@(activeAction=="view"?"Opening…":"Open timetable")</button>
            </div>
        </section>
    @if(PreviewVersionId.HasValue){
        <section id="timetable-preview" class="scroll-mt-24 border-t border-slate-200 pt-6"><h2 class="text-xl font-bold text-slate-900">6. Generated timetable</h2><p class="mt-1 text-sm text-slate-500">Review a generated or saved timetable by class or teacher. Select a named version above, then choose the view you want.</p><p class="mt-2 text-sm font-semibold text-slate-700">@PreviewVersionName</p><div class="mt-4 flex flex-wrap items-end gap-3"><label class="text-sm font-semibold text-slate-700">View by<select @bind="previewMode" @bind:after="PreviewModeChanged" disabled="@(busy || previewLoading)" class="mt-1 block min-w-40 rounded-md border border-slate-300 bg-white px-3 py-2"><option value="class">Class</option><option value="teacher">Teacher</option></select></label>@if(previewMode=="class"){<label class="text-sm font-semibold text-slate-700">Class<select @bind="previewClassId" disabled="@(busy || allocations.Count==0)" class="mt-1 block min-w-56 rounded-md border border-slate-300 bg-white px-3 py-2"><option value="">Select a class</option>@foreach(var c in allocations.Select(a=>a.ClassId).Distinct().OrderBy(x=>x)){<option value="@c">@ClassLabel(c)</option>}</select></label>}else{<label class="text-sm font-semibold text-slate-700">Teacher<select @bind="previewTeacherId" disabled="@(busy || previewLoading || teachers.Count==0)" class="mt-1 block min-w-56 rounded-md border border-slate-300 bg-white px-3 py-2"><option value="">Select a teacher</option>@foreach(var t in teachers.OrderBy(t=>t.LastName).ThenBy(t=>t.FirstName)){<option value="@t.Id">@TeacherName(t)</option>}</select></label>}<button class="rounded-md border border-slate-300 px-4 py-2 font-bold disabled:opacity-60" @onclick="LoadPreview" disabled="@(busy || previewLoading || (previewMode=="class"?string.IsNullOrWhiteSpace(previewClassId):string.IsNullOrWhiteSpace(previewTeacherId)))">@(previewLoading ? "Loading timetable…" : "Load timetable")</button></div><div class="mt-4 overflow-auto">
            @if(previewLoading){<p role="status">Loading timetable…</p>}
            else {<TimetablePrintView Heading="@(previewMode=="teacher" ? "Teacher's Timetable" : "Class Timetable")" Term="@term" VersionName="@PreviewVersionName" IdentityLine="@(previewMode=="teacher"?TeacherName(previewTeacherId):ClassLabel(previewClassId))" Slots="slots" Assignments="previewAssignments" ShowClass="@(previewMode=="teacher")" />}
        </div></section>
        <div class="my-4 flex flex-wrap gap-3">
            <button class="rounded-md bg-slate-900 px-4 py-2 font-bold text-white disabled:opacity-50" @onclick="EditCurrentTimetable" disabled="@busy">@(IsDraftPreview ? "Edit / regenerate draft" : "Edit as draft")</button>
            @if(IsDraftPreview){<button class="rounded-md bg-emerald-700 px-4 py-2 font-bold text-white" @onclick="()=>PublishVersion(PreviewVersionId!.Value)" disabled="@busy">Publish timetable</button>}
            <button class="rounded-md border border-rose-300 px-4 py-2 font-bold text-rose-700 disabled:opacity-50" @onclick="DeleteCurrentTimetable" disabled="@busy">Delete timetable</button>
        </div>
        @if(IsDraftPreview){<section class="mt-5 rounded-lg border border-emerald-200 bg-emerald-50 p-4"><h3 class="font-bold text-slate-900">Adjust this draft</h3><p class="mt-1 text-sm text-slate-600">Move a lesson to an available slot. Class, teacher, and room conflicts are checked. Double lessons move together.</p><div class="mt-3 grid gap-3 md:grid-cols-[2fr_2fr_auto]"><label class="text-sm font-semibold text-slate-700">Lesson<select @bind="moveAssignmentId" disabled="@(busy||previewLoading||previewAssignments.Count==0)" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2"><option value="">Select a lesson</option>@foreach(var item in previewAssignments.OrderBy(a=>previewSlots.TryGetValue(a.SlotId,out var s)?s.DayOfWeek:8).ThenBy(a=>previewSlots.TryGetValue(a.SlotId,out var s)?s.PeriodNumber:99)){<option value="@item.Id">@AssignmentLabel(item)</option>}</select></label><label class="text-sm font-semibold text-slate-700">New slot<select @bind="moveTargetSlotId" disabled="@(busy||previewLoading||SelectedMoveAssignment is null)" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2"><option value="">Select an available lesson slot</option>@if(SelectedMoveAssignment is { } selectedMove){@foreach(var target in AvailableMoveSlots(selectedMove)){<option value="@target.Id">@DayName(target.DayOfWeek) P@target.PeriodNumber · @SlotTime(target)</option>}}</select></label><button class="self-end rounded-md bg-emerald-700 px-4 py-2 font-bold text-white disabled:opacity-50" @onclick="MoveSelectedPeriod" disabled="@(busy||previewLoading||SelectedMoveAssignment is null||!Guid.TryParse(moveTargetSlotId,out _))">@(activeAction=="move"?"Moving…":"Move lesson")</button></div></section>}
    }else{<div class="rounded-lg border border-slate-200 bg-white p-6 text-sm text-slate-600">Choose a saved timetable above to view its class or teacher timetable.</div>}
    </div>
    <div hidden="@(activeTab!="analytics")" class="space-y-6">
        <section class="border-t border-slate-200 pt-6">
            <h2 class="text-xl font-bold text-slate-900">Timetable analytics</h2>
            <p class="mt-1 text-sm text-slate-600">Compare weekly scheduled teaching load by teacher, class, and subject. Staff attendance is matched by teacher ID and the weekday of each attendance register.</p>
            <div class="mt-4 flex flex-wrap items-end gap-3 rounded-lg bg-slate-50 p-4">
                <label class="min-w-64 flex-1 text-sm font-semibold text-slate-700">Published timetable<select @bind="analyticsVersionId" @bind:after="AnalyticsSelectionChanged" disabled="@(loadingData||analyticsLoading||!savedVersions.Any(v=>v.Lifecycle=="PUBLISHED"))" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2"><option value="">Select a published timetable</option>@foreach(var version in savedVersions.Where(v=>v.Lifecycle=="PUBLISHED")){<option value="@version.Id">@version.Name · @version.Term</option>}</select></label>
                <label class="text-sm font-semibold text-slate-700">Attendance from<input type="date" @bind="analyticsStartDate" @bind:after="AnalyticsSelectionChanged" disabled="@analyticsLoading" class="mt-1 block rounded-md border border-slate-300 bg-white px-3 py-2" /></label>
                <label class="text-sm font-semibold text-slate-700">Through<input type="date" @bind="analyticsEndDate" @bind:after="AnalyticsSelectionChanged" disabled="@analyticsLoading" class="mt-1 block rounded-md border border-slate-300 bg-white px-3 py-2" /></label>
                <button class="rounded-md bg-emerald-700 px-4 py-2 font-bold text-white disabled:opacity-60" @onclick="LoadAnalytics" disabled="@(loadingData||analyticsLoading||!Guid.TryParse(analyticsVersionId,out _))">@(analyticsLoading?"Calculating…":"Load analytics")</button>
            </div>
            @if(analyticsLoading){<div class="mt-4 rounded-lg border border-sky-200 bg-sky-50 p-4 text-sm text-sky-900" role="status">Loading timetable assignments and staff attendance…</div>}
            @if(!analyticsLoaded&&!analyticsLoading){<div class="mt-4 rounded-lg border border-slate-200 bg-white p-4 text-sm text-slate-600">Select a published timetable and date range, then load the analytics.</div>}
            @if(analyticsLoaded&&!analyticsLoading){
                <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                    <div class="rounded-lg border border-slate-200 bg-white p-4"><div class="text-xs font-bold uppercase text-slate-500">Scheduled periods / week</div><div class="mt-1 text-2xl font-extrabold">@analyticsTotalPeriods</div></div>
                    <div class="rounded-lg border border-slate-200 bg-white p-4"><div class="text-xs font-bold uppercase text-slate-500">Scheduled teaching time / week</div><div class="mt-1 text-2xl font-extrabold">@FormatHours(analyticsTotalMinutes)</div></div>
                    <div class="rounded-lg border border-slate-200 bg-white p-4"><div class="text-xs font-bold uppercase text-slate-500">Classes · teachers · subjects</div><div class="mt-1 text-2xl font-extrabold">@analyticsClassCount · @analyticsTeacherStats.Count · @analyticsSubjectStats.Count</div></div>
                    <div class="rounded-lg border border-slate-200 bg-white p-4"><div class="text-xs font-bold uppercase text-slate-500">Staff attendance matches</div><div class="mt-1 text-2xl font-extrabold">@analyticsAttendanceMatchCount</div><div class="text-xs text-slate-500">records in selected date range</div></div>
                </div>
                <p class="mt-3 text-xs text-slate-500">Scheduled hours are calculated from lesson slot times. Attendance shows scheduled periods on days marked Present/Late or Absent; it does not certify that individual lessons were delivered.</p>
                <section class="mt-8 border-t border-slate-200 pt-6"><h3 class="mb-2 text-lg font-bold">Teacher workload and attendance</h3><div class="overflow-auto rounded-lg border border-slate-200 bg-white"><table class="w-full min-w-[920px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-3 py-3">Teacher</th><th class="px-3 py-3">Periods / week</th><th class="px-3 py-3">Hours / week</th><th class="px-3 py-3">Present</th><th class="px-3 py-3">Late</th><th class="px-3 py-3">Absent</th><th class="px-3 py-3">Scheduled periods on present/late days</th><th class="px-3 py-3">Scheduled periods on absent days</th><th class="px-3 py-3">Attendance rate</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var row in analyticsTeacherStats.OrderByDescending(x=>x.WeeklyMinutes)){<tr><td class="px-3 py-3 font-semibold">@row.Name</td><td class="px-3 py-3">@row.WeeklyPeriods</td><td class="px-3 py-3">@FormatHours(row.WeeklyMinutes)</td><td class="px-3 py-3">@row.PresentDays</td><td class="px-3 py-3">@row.LateDays</td><td class="px-3 py-3">@row.AbsentDays</td><td class="px-3 py-3">@row.PeriodsOnPresentDays · @FormatHours(row.MinutesOnPresentDays)</td><td class="px-3 py-3">@row.PeriodsOnAbsentDays · @FormatHours(row.MinutesOnAbsentDays)</td><td class="px-3 py-3">@(row.AttendanceDays==0?"—":$"{row.AttendanceRate:F0}%")</td></tr>}@if(analyticsTeacherStats.Count==0){<tr><td colspan="9" class="px-3 py-5 text-slate-500">No teacher assignments found for this timetable.</td></tr>}</tbody></table></div></section>
                <div class="mt-6 grid gap-6 xl:grid-cols-2">
                    <section class="border-t border-slate-200 pt-6"><h3 class="mb-2 text-lg font-bold">Class periods and teaching time per week</h3><div class="overflow-auto rounded-lg border border-slate-200 bg-white"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-3 py-3">Class</th><th class="px-3 py-3">Periods</th><th class="px-3 py-3">Hours</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var row in analyticsClassStats.OrderBy(x=>x.ClassId)){<tr><td class="px-3 py-3 font-semibold">@ClassLabel(row.ClassId)</td><td class="px-3 py-3">@row.Periods</td><td class="px-3 py-3">@FormatHours(row.Minutes)</td></tr>}</tbody></table></div></section>
                    <section class="border-t border-slate-200 pt-6"><h3 class="mb-2 text-lg font-bold">Subject periods and teaching time per week</h3><div class="overflow-auto rounded-lg border border-slate-200 bg-white"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-3 py-3">Subject</th><th class="px-3 py-3">Periods</th><th class="px-3 py-3">Hours</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var row in analyticsSubjectStats.OrderByDescending(x=>x.Minutes)){<tr><td class="px-3 py-3 font-semibold">@row.SubjectId</td><td class="px-3 py-3">@row.Periods</td><td class="px-3 py-3">@FormatHours(row.Minutes)</td></tr>}</tbody></table></div></section>
                </div>
                <section class="mt-8 border-t border-slate-200 pt-6"><h3 class="mb-2 text-lg font-bold">Subject periods by class per week</h3><p class="mb-3 text-sm text-slate-500">Shows how many periods each class receives for each subject, with total scheduled teaching time.</p><div class="overflow-auto rounded-lg border border-slate-200 bg-white"><table class="w-full min-w-[620px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-3 py-3">Class</th><th class="px-3 py-3">Subject</th><th class="px-3 py-3">Periods / week</th><th class="px-3 py-3">Hours / week</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach(var row in analyticsClassSubjectStats.OrderBy(x=>x.ClassId).ThenBy(x=>x.SubjectId)){<tr><td class="px-3 py-3 font-semibold">@ClassLabel(row.ClassId)</td><td class="px-3 py-3">@row.SubjectId</td><td class="px-3 py-3">@row.Periods</td><td class="px-3 py-3">@FormatHours(row.Minutes)</td></tr>}@if(analyticsClassSubjectStats.Count==0){<tr><td colspan="4" class="px-3 py-5 text-slate-500">No class-subject periods found for this timetable.</td></tr>}</tbody></table></div></section>
            }
        </section>
    </div>
</div>

@code {
