@page "/admin/bursers/edit/{BurserId:long}"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using paa_frontend.Client.Services
@using static paa_frontend.Shared.Models.BurserProfileModel
@inject BurserProfileServiceClient BurserService
@inject NavigationManager Nav

@if (isLoading)
{
    <div class="max-w-4xl mx-auto w-full animate-pulse">
        <div class="h-48 bg-slate-200 rounded-3xl mb-8"></div>
        <div class="flex gap-4 mb-8">
            @for (int i = 0; i < 2; i++) { <div class="h-10 w-24 bg-slate-200 rounded-full"></div> }
        </div>
        <div class="h-64 bg-white/60 rounded-3xl border border-slate-200/50"></div>
    </div>
}
else if (burser == null)
{
    <div class="flex flex-col items-center justify-center py-20 text-center">
        <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center text-slate-400 mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <h2 class="text-xl font-bold text-slate-900 mb-2">Burser not found</h2>
        <p class="text-slate-500 mb-6">The record you are looking for does not exist or has been removed.</p>
        <button class="px-5 py-2 bg-slate-900 text-white rounded-full font-bold shadow hover:bg-slate-800" @onclick='() => Nav.NavigateTo("/admin/bursers")'>Return to Directory</button>
    </div>
}
else
{
    <div class="max-w-4xl mx-auto w-full pb-16">

        <!-- Header Banner -->
        <div class="relative w-full h-40 md:h-48 bg-gradient-to-r from-amber-600 to-orange-700 rounded-[2rem] overflow-hidden mb-6 flex flex-col justify-between shadow-lg">
            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 50%, white 1px, transparent 1px), radial-gradient(circle at 80% 20%, white 1px, transparent 1px); background-size: 40px 40px;"></div>
            <div class="p-6 md:p-8 flex items-center justify-between relative z-10 w-full">
                <button class="flex items-center justify-center w-10 h-10 rounded-full bg-white/20 hover:bg-white/30 backdrop-blur text-white transition-colors" @onclick='() => Nav.NavigateTo("/admin/bursers")'>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                </button>
                <div class="flex items-center gap-2">
                    <span class="px-3 py-1.5 bg-white/10 rounded-full text-white text-xs font-bold uppercase tracking-wider">Read-Only · Admin View</span>
                </div>
            </div>
        </div>

        <!-- Profile Metadata -->
        <div class="flex flex-col md:flex-row items-center md:items-start gap-6 -mt-16 relative z-20 px-6 md:px-12 mb-10">
            <div class="w-28 h-28 md:w-32 md:h-32 rounded-2xl bg-white p-1.5 shadow-xl shrink-0">
                <div class="w-full h-full rounded-xl bg-gradient-to-br from-amber-100 to-orange-200 flex items-center justify-center text-4xl font-black text-amber-600">
                    @(burser.FirstName?.FirstOrDefault().ToString() ?? "")@(burser.LastName?.FirstOrDefault().ToString() ?? "")
                </div>
            </div>
            <div class="flex-1 mt-4 md:mt-20 text-center md:text-left flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-black text-slate-900 tracking-tight leading-tight">@burser.FirstName @burser.LastName</h1>
                    <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 mt-2 text-sm font-bold text-slate-500">
                        <span class="flex items-center gap-1.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> @(string.IsNullOrEmpty(burser.Email) ? "No Email" : burser.Email)</span>
                        <span class="flex items-center gap-1.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l1.79-1.79a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg> @(string.IsNullOrEmpty(burser.Phone) ? "No Phone" : burser.Phone)</span>
                    </div>
                </div>
                <div class="flex flex-wrap items-center justify-center gap-2">
                    <span class="px-3 py-1 rounded-full border border-slate-200 bg-white shadow-sm text-xs font-black text-slate-700">Financial Admin</span>
                    @if (burser.Status == "Active") { <span class="px-3 py-1 rounded-full border border-emerald-200 bg-emerald-50 text-emerald-700 text-xs font-black flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-emerald-600 rounded-full"></span>Active</span> }
                    else { <span class="px-3 py-1 rounded-full border border-slate-200 bg-slate-100 text-slate-600 text-xs font-black flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-slate-400 rounded-full"></span>@burser.Status</span> }
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="flex overflow-x-auto hide-scrollbar gap-2 mb-8 bg-white/50 backdrop-blur-sm p-1.5 rounded-2xl mx-2 md:mx-0 shadow-sm border border-slate-200/50 w-max">
            <button class="px-6 py-2.5 rounded-xl text-sm font-bold transition-colors whitespace-nowrap @(activeTab == "profile" ? "bg-white text-amber-700 shadow border border-slate-100" : "text-slate-500 hover:text-slate-900")" @onclick='() => activeTab = "profile"'>Profile Overview</button>
            <button class="px-6 py-2.5 rounded-xl text-sm font-bold transition-colors whitespace-nowrap @(activeTab == "contact" ? "bg-white text-amber-700 shadow border border-slate-100" : "text-slate-500 hover:text-slate-900")" @onclick='() => activeTab = "contact"'>Contact Info</button>
        </div>

        <!-- Read-only notice -->
        <div class="mb-6 p-3.5 rounded-2xl bg-amber-50 border border-amber-200 flex items-center gap-3 text-sm font-semibold text-amber-800">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            This profile is read-only within the Admin portal. To make changes, use the staff management system.
        </div>

        <!-- Profile Tab -->
        @if (activeTab == "profile")
        {
            <div class="animate-fade-in grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-10">

                <!-- Left: PII -->
                <div class="bg-white/70 backdrop-blur-sm border border-slate-200/60 rounded-3xl p-6 shadow-sm">
                    <h3 class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-5">Personal Details</h3>
                    <dl class="space-y-4">
                        <div class="flex flex-col pb-3 border-b border-slate-100">
                            <dt class="text-xs font-bold text-slate-500 mb-1">Full Name</dt>
                            <dd class="text-sm font-semibold text-slate-900">@burser.FirstName @burser.LastName</dd>
                        </div>
                        <div class="flex flex-col pb-3 border-b border-slate-100">
                            <dt class="text-xs font-bold text-slate-500 mb-1">Gender</dt>
                            <dd class="text-sm font-semibold text-slate-900">@(burser.Gender ?? "—")</dd>
                        </div>
                        <div class="flex flex-col pb-3 border-b border-slate-100">
                            <dt class="text-xs font-bold text-slate-500 mb-1">Date of Birth</dt>
                            <dd class="text-sm font-semibold text-slate-900">@(burser.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "—")</dd>
                        </div>
                        <div class="flex flex-col">
                            <dt class="text-xs font-bold text-slate-500 mb-1">National ID</dt>
                            <dd class="text-sm font-mono font-bold text-slate-900">@(burser.NationalId ?? "—")</dd>
                        </div>
                    </dl>
                </div>

                <!-- Right: System meta -->
                <div class="flex flex-col gap-5">
                    <div class="bg-white/70 backdrop-blur-sm border border-slate-200/60 rounded-3xl p-6 shadow-sm">
                        <h3 class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-5">System Information</h3>
                        <dl class="space-y-4">
                            <div class="flex items-center justify-between">
                                <dt class="text-xs font-bold text-slate-500">System ID</dt>
                                <dd class="text-xs font-mono font-bold text-slate-400">@burser.Id</dd>
                            </div>
                            <div class="flex items-center justify-between">
                                <dt class="text-xs font-bold text-slate-500">Employment Status</dt>
                                <dd>
                                    @if (burser.Status == "Active") { <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-[length:0.65rem] font-extrabold">Active</span> }
                                    else { <span class="px-2 py-0.5 rounded-full bg-slate-200 text-slate-600 text-[length:0.65rem] font-extrabold">@burser.Status</span> }
                                </dd>
                            </div>
                            <div class="flex items-center justify-between">
                                <dt class="text-xs font-bold text-slate-500">Role</dt>
                                <dd class="text-xs font-bold text-slate-700">Financial Administrator</dd>
                            </div>
                        </dl>
                    </div>

                    <div class="bg-amber-50/60 border border-amber-100 rounded-3xl p-6">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            </div>
                            <span class="text-sm font-bold text-amber-900">Admin Note</span>
                        </div>
                        <p class="text-xs text-amber-800 leading-relaxed font-medium">Bursers manage student fee collection, financial records, and billing operations. Their records are maintained through the Finance module.</p>
                    </div>
                </div>
            </div>
        }

        <!-- Contact Tab -->
        @if (activeTab == "contact")
        {
            <div class="animate-fade-in grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <div class="bg-white/70 backdrop-blur-sm border border-slate-200/60 rounded-3xl p-6 hover:-translate-y-1 transition-transform shadow-sm">
                    <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center mb-4">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    </div>
                    <div class="text-[length:0.65rem] uppercase font-bold text-slate-400 mb-1 tracking-widest">Email Address</div>
                    <div class="text-sm font-bold text-slate-900 break-all">@(string.IsNullOrEmpty(burser.Email) ? "—" : burser.Email)</div>
                </div>
                <div class="bg-white/70 backdrop-blur-sm border border-slate-200/60 rounded-3xl p-6 hover:-translate-y-1 transition-transform shadow-sm">
                    <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center mb-4">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l1.79-1.79a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </div>
                    <div class="text-[length:0.65rem] uppercase font-bold text-slate-400 mb-1 tracking-widest">Phone Number</div>
                    <div class="text-sm font-bold text-slate-900">@(string.IsNullOrEmpty(burser.Phone) ? "—" : burser.Phone)</div>
                </div>
                <div class="bg-white/70 backdrop-blur-sm border border-slate-200/60 rounded-3xl p-6 hover:-translate-y-1 transition-transform shadow-sm">
                    <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center mb-4">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    </div>
                    <div class="text-[length:0.65rem] uppercase font-bold text-slate-400 mb-1 tracking-widest">National ID</div>
                    <div class="text-sm font-mono font-bold text-slate-900">@(string.IsNullOrEmpty(burser.NationalId) ? "—" : burser.NationalId)</div>
                </div>
            </div>
        }

    </div>
}

@code {
    [Parameter]
    public long BurserId { get; set; }

    private Burser? burser;
    private bool isLoading = true;
    private string activeTab = "profile";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            burser = await BurserService.GetBurserAsync(BurserId);
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }
}
