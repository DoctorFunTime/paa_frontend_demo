@page "/students"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using paa_frontend.Client.Services
@using static paa_frontend.Shared.Models.StudentProfileModel
@using Microsoft.JSInterop
@inject StudentProfileServiceClient StudentService
@inject paa_frontend.Client.Services.Admin.StudentSubjectServiceClient SubjectService
@inject NotificationService NotificationService
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<div class="page-wrap @(isPrintingClassList ? "print-class-list" : "")">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2 text-sm text-slate-500 font-medium mb-1">
            <a href="/admin" class="hover:text-blue-600 transition-colors">Dashboard</a>
            <span class="text-slate-300">&rsaquo;</span>
            <span class="text-slate-800 font-bold">Students Management</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mb-1">Students</h1>
        <p class="text-sm font-medium text-slate-500">Manage the student directory and class information.</p>
    </div>
    <div class="flex w-full md:w-auto flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <button class="px-4 py-2 bg-white/60 hover:bg-white backdrop-blur-sm border border-slate-200/60 rounded-full text-xs font-semibold text-slate-600 transition-colors shadow-sm flex items-center justify-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
            Export
        </button>
        <a href="/students/bulk-import" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full text-xs font-bold transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 10l5 5 5-5" /><path d="M12 15V3" /><path d="M5 21h14" /></svg>
            Bulk Import
        </a>
        <a href="/students/add?returnPortal=admin" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-full text-xs font-bold transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            New Student
        </a>
    </div>
</div>

<!-- Premium Tab Navigation -->
<div class="flex items-center gap-2 overflow-x-auto hide-scrollbar bg-slate-200/50 backdrop-blur border border-slate-200/50 p-1.5 rounded-2xl mb-8 shadow-sm">
    @foreach (var tab in tabs)
    {
        <button class="px-5 py-2.5 rounded-xl text-sm font-bold whitespace-nowrap transition-all duration-300 relative @(activeTab == tab ? "text-blue-700 bg-white shadow-sm" : "text-slate-500 hover:text-slate-800 hover:bg-white/50")" @onclick="() => SetActiveTab(tab)">
            @tab
        </button>
    }
</div>

@if (activeTab == "Directory")
{
    <div class="animate-fade-in">
        <!-- ── Stats Ribbon (Glass style) ─────────────────────────────────── -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-slate-200/50 backdrop-blur border border-slate-200/50 rounded-2xl overflow-hidden mb-8">
            <div class="bg-white/80 p-4 sm:p-5">
                <div class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Active students</div>
                <div class="text-3xl font-extrabold text-blue-600 tracking-tighter mb-2">@ActiveStudentCount</div>
                <span class="px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 text-xs font-bold">Currently enrolled</span>
            </div>
            <div class="bg-white/80 p-4 sm:p-5">
                <div class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Joined (30 days)</div>
                <div class="text-3xl font-extrabold text-emerald-500 tracking-tighter mb-2">@JoinedLast30DaysCount</div>
                <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 text-xs font-bold">New students</span>
            </div>
            <div class="bg-white/80 p-4 sm:p-5">
                <div class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Transferred in (30 days)</div>
                <div class="text-3xl font-extrabold text-slate-700 tracking-tighter mb-2">@TransferredLast30DaysCount</div>
                <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-xs font-bold shadow-sm">Recent transfers</span>
            </div>
            <div class="bg-white/80 p-4 sm:p-5">
                <div class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Showing</div>
                <div class="text-3xl font-extrabold text-slate-900 tracking-tighter mb-2">@filteredStudents.Count</div>
                <span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-600 text-xs font-bold">Filtered</span>
            </div>
        </div>

        <!-- ── Top Toolbar ─────────────────────────────────────────────── -->
        <div class="flex flex-col xl:flex-row xl:items-center gap-4 mb-4">
            <div class="relative w-full xl:flex-1 xl:max-w-sm">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg></span>
                <input class="w-full py-2.5 pl-10 pr-4 bg-white/70 border border-slate-200 rounded-full text-sm font-medium focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-slate-400" type="text" placeholder="Search by name, email, temp ID or ID..." value="@searchTerm" @oninput="OnSearch" />
            </div>

            <!-- Toggles -->
            <div class="flex items-center gap-2 overflow-x-auto pb-2 xl:pb-0 hide-scrollbar">
                <!-- Status Filter -->
                <div class="flex bg-white/60 p-1 border border-slate-200 rounded-full shadow-sm shrink-0">
                    <button class="px-4 py-1.5 rounded-full text-xs font-bold transition-colors @(string.IsNullOrEmpty(statusFilter) ? "bg-slate-900 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")" @onclick="() => OnStatusChange(string.Empty)">All</button>
                    <button class="px-4 py-1.5 rounded-full text-xs font-bold transition-colors @(statusFilter == "Active" ? "bg-emerald-500 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")" @onclick='() => OnStatusChange("Active")'>Active</button>
                    <button class="px-4 py-1.5 rounded-full text-xs font-bold transition-colors @(statusFilter == "Inactive" ? "bg-slate-400 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")" @onclick='() => OnStatusChange("Inactive")'>Inactive</button>
                </div>

                <!-- Form Dropdown -->
                <div class="relative shrink-0">
                    <select class="appearance-none pl-4 pr-9 py-2 bg-white/60 border border-slate-200 rounded-full text-xs font-bold text-slate-600 focus:outline-none focus:border-blue-500" value="@filterForm" @onchange='e => { filterForm = e.Value?.ToString() ?? ""; ApplyFilters(); }'>
                        <option value="">All Forms</option>
                        @for (int f = 1; f <= 6; f++)
                        {
                            <option value="@f">Form @f</option>
                        }
                    </select>
                    <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg></div>
                </div>

                <!-- Class Dropdown -->
                <div class="relative shrink-0">
                    <select class="appearance-none pl-4 pr-9 py-2 bg-white/60 border border-slate-200 rounded-full text-xs font-bold text-slate-600 focus:outline-none focus:border-blue-500" value="@filterClass" @onchange='e => { filterClass = e.Value?.ToString() ?? ""; ApplyFilters(); }'>
                        <option value="">All Classes</option>
                        @foreach (var classroom in StudentClassOptions)
                        {
                            <option value="@classroom">@classroom</option>
                        }
                    </select>
                    <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg></div>
                </div>

                <!-- Gender Dropdown -->
                <div class="relative shrink-0">
                    <select class="appearance-none pl-4 pr-9 py-2 bg-white/60 border border-slate-200 rounded-full text-xs font-bold text-slate-600 focus:outline-none focus:border-blue-500" value="@filterGender" @onchange='e => { filterGender = e.Value?.ToString() ?? ""; ApplyFilters(); }'>
                        <option value="">All Genders</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                    <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg></div>
                </div>
            </div>

            <!-- Right side controls -->
            <div class="w-full xl:w-auto xl:ml-auto flex items-center justify-between xl:justify-end gap-3 sm:gap-4 shrink-0">
                <span class="text-xs font-bold text-slate-400 shrink-0">@filteredStudents.Count matches</span>
                <div class="flex bg-white/60 border border-slate-200 rounded-full p-1 shadow-sm">
                    <button class="w-8 h-8 rounded-full flex items-center justify-center transition-colors @(viewMode == "table" ? "bg-white shadow text-blue-600" : "text-slate-400 hover:text-slate-700")" @onclick="SetTableView">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="3" y1="15" x2="21" y2="15" /><line x1="9" y1="9" x2="9" y2="21" /></svg>
                    </button>
                    <button class="w-8 h-8 rounded-full flex items-center justify-center transition-colors @(viewMode == "grid" ? "bg-white shadow text-blue-600" : "text-slate-400 hover:text-slate-700")" @onclick="SetGridView">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- ── Main View Area ─────────────────────────────────────────── -->
        @if (viewMode == "table")
        {
            <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-8">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[800px]">
                        <thead class="bg-slate-50/50 border-b border-slate-200 text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest">
                            <tr>
                                <th class="py-3 px-4 w-12 text-center pointer-events-auto">
                                    <input type="checkbox" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer" @onclick="ToggleSelectAll" />
                                </th>
                                <th class="py-3 px-4 cursor-pointer hover:text-blue-600 transition-colors @(sortField == "Name" ? "text-blue-600" : "")" @onclick='() => SortBy("Name")'>
                                    Student @SortIcon("Name")
                                </th>
                                <th class="py-3 px-4">Contact</th>
                                <th class="py-3 px-4 cursor-pointer hover:text-blue-600 transition-colors @(sortField == "Form" ? "text-blue-600" : "")" @onclick='() => SortBy("Form")'>
                                    Year / Class @SortIcon("Form")
                                </th>
                                <th class="py-3 px-4">Gender</th>
                                <th class="py-3 px-4">DOB</th>
                                <th class="py-3 px-4">Status</th>
                                <th class="py-3 px-4 w-24"></th>
                            </tr>
                        </thead>
                        <tbody class="text-sm font-medium text-slate-700 divide-y divide-slate-100">
                            @if (students == null)
                            {
                                @for (int i = 0; i < 8; i++)
                                {
                                    <tr class="animate-pulse">
                                        <td class="py-4 px-4 text-center"><div class="w-4 h-4 bg-slate-200 rounded mx-auto"></div></td>
                                        <td class="py-4 px-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-xl bg-slate-200 shrink-0"></div>
                                                <div class="flex flex-col gap-1.5"><div class="w-24 h-3 bg-slate-200 rounded"></div><div class="w-16 h-2 bg-slate-100 rounded"></div></div>
                                            </div>
                                        </td>
                                        <td class="py-4 px-4"><div class="w-32 h-3 bg-slate-200 rounded"></div></td>
                                        <td class="py-4 px-4"><div class="w-16 h-5 bg-slate-200 rounded-md"></div></td>
                                        <td class="py-4 px-4"><div class="w-10 h-3 bg-slate-200 rounded"></div></td>
                                        <td class="py-4 px-4"><div class="w-20 h-3 bg-slate-200 rounded"></div></td>
                                        <td class="py-4 px-4"><div class="w-16 h-5 bg-slate-200 rounded-full"></div></td>
                                        <td></td>
                                    </tr>
                                }
                            }
                            else if (!pagedStudents.Any())
                            {
                                <tr>
                                    <td colspan="8" class="py-16 text-center">
                                        <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-400">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
                                        </div>
                                        <div class="text-sm font-bold text-slate-800 mb-1">No students found</div>
                                        <p class="text-xs text-slate-500 font-medium">Try adjusting your filters or search term.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int ri = 0;
                                @foreach (var s in pagedStudents)
                                {
                                    var (bg, fg) = AvatarColor(ri);
                                    bool sel = selectedIds.Contains(s.Id);
                                    string ini = (s.FirstName?.FirstOrDefault().ToString() ?? "") + (s.LastName?.FirstOrDefault().ToString() ?? "");
                                    int sid = s.Id;
                                    bool isALevel = IsALevelStudent(s);
                                    var subjectChoices = GetALevelSubjectChoicesForStudent(s.Id);

                                    <tr class="hover:bg-blue-50/50 transition-colors group cursor-pointer" @onclick="() => NavigateToStudent(sid)">
                                        <td class="py-3 px-4 text-center" @onclick:stopPropagation="true">
                                            <input type="checkbox" checked="@sel" @onchange="e => ToggleSelect(s.Id, (bool)e.Value!)" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer" />
                                        </td>
                                        <td class="py-3 px-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-xl flex items-center justify-center text-sm font-extrabold shrink-0" style="background:@bg;color:@fg;">@ini</div>
                                                <div>
                                                    <div class="text-sm font-bold text-slate-900 group-hover:text-blue-700 transition-colors">@s.FirstName @s.LastName</div>
                                                    <div class="text-[length:0.65rem] font-mono font-bold text-slate-400 mt-0.5">@(string.IsNullOrEmpty(s.NationalId) ? "No national ID" : s.NationalId)</div>
                                                    <div class="text-[length:0.65rem] font-mono font-bold text-slate-400 mt-0.5">@(string.IsNullOrEmpty(s.TempId) ? "No temp ID" : s.TempId)</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3 px-4 max-w-[200px] truncate">
                                            @if (!string.IsNullOrEmpty(s.Email))
                                            {
                                                <div class="flex items-center gap-1.5 text-xs text-slate-600 truncate"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="shrink-0" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>@s.Email</div>
                                            }
                                            @if (!string.IsNullOrEmpty(s.Phone))
                                            {
                                                <div class="flex items-center gap-1.5 text-xs text-slate-600 truncate mt-1"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="shrink-0" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l1.79-1.79a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>@s.Phone</div>
                                            }
                                            @if (string.IsNullOrEmpty(s.Email) && string.IsNullOrEmpty(s.Phone))
                                            {
                                                <span class="text-xs text-slate-400">&mdash;</span>
                                            }
                                        </td>
                                        <td class="py-3 px-4">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 text-xs font-extrabold text-slate-700 shadow-sm">Form @s.Form</span>
                                                @if (!string.IsNullOrEmpty(s.Classroom))
                                                {
                                                    <span class="text-[length:0.65rem] font-bold text-slate-400">@s.Classroom</span>
                                                }
                                            </div>
                                            @if (isALevel)
                                            {
                                                <div class="mt-2 flex flex-wrap gap-1">
                                                    @if (subjectChoices != null && subjectChoices.Subjects.Any())
                                                    {
                                                        @foreach (var subject in subjectChoices.Subjects.Take(3))
                                                        {
                                                            <span class="px-2 py-0.5 rounded-full bg-violet-100 text-violet-700 text-[length:0.6rem] font-bold">@subject</span>
                                                        }
                                                        @if (subjectChoices.Subjects.Count > 3)
                                                        {
                                                            <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-[length:0.6rem] font-bold">+@(subjectChoices.Subjects.Count - 3)</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-[length:0.65rem] font-medium text-slate-400 italic">No subjects assigned</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td class="py-3 px-4 text-xs font-bold text-slate-500">@(s.Gender ?? "—")</td>
                                        <td class="py-3 px-4 font-mono text-[length:0.7rem] font-bold text-slate-500">@(s.DateOfBirth.HasValue ? s.DateOfBirth.Value.ToString("dd MMM yyyy") : "—")</td>
                                        <td class="py-3 px-4">
                                            @if (s.Status == "Active")
                                            {
                                                <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-[length:0.65rem] font-extrabold flex inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Active</span>
                                            }
                                            else
                                            {

                                                <span class="px-2 py-0.5 rounded-full bg-slate-200 text-slate-600 text-[length:0.65rem] font-extrabold flex inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>@s.Status</span>
                                            }
                                        </td>
                                        <td class="py-3 px-4 text-right" @onclick:stopPropagation="true">
                                            <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                                <button class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-blue-600 hover:border-blue-200 hover:bg-blue-50 flex items-center justify-center transition-all shadow-sm" title="View" @onclick="() => NavigateToStudent(sid)">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                                </button>
                                                <button class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 flex items-center justify-center transition-all shadow-sm" title="Edit" @onclick="() => NavigateToEdit(sid)">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                                </button>
                                                @if (isALevel)
                                                {
                                                    <button class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-violet-600 hover:border-violet-200 hover:bg-violet-50 flex items-center justify-center transition-all shadow-sm" title="Assign A-Level Subjects" @onclick="() => OpenAssignSubjectsModal(s)">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="w-8 h-8 rounded-lg bg-slate-100 border border-slate-200 text-slate-300 flex items-center justify-center shadow-sm cursor-not-allowed" title="A-Level subject assignment is only available for Form 5 and Form 6 students" disabled>
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    ri++;
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <div class="bg-slate-50/80 border-t border-slate-200 px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <span class="text-xs font-bold text-slate-400">
                            Showing @(((currentPage - 1) * pageSize) + 1)–@(Math.Min(currentPage * pageSize, filteredStudents.Count)) of @filteredStudents.Count
                        </span>
                        <div class="pagination-nav flex items-center gap-1">
                            <button class="w-8 h-8 rounded-lg flex items-center justify-center border border-slate-200 bg-white text-slate-500 hover:bg-slate-50 disabled:opacity-50 transition-colors shadow-sm" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">
