                            bool isSel = selectedSubjectsForAssign.Contains(subjectName);
                            <button type="button"
                                    class="min-h-24 flex flex-col items-start justify-between gap-3 p-4 rounded-2xl border text-left text-sm font-semibold transition-all shadow-sm @(isSel ? "border-violet-400 bg-violet-50 text-violet-800 shadow-violet-100" : "border-slate-200 bg-white text-slate-700 hover:border-violet-200 hover:bg-violet-50/50")"
                                    @onclick='() => ToggleSubjectForAssign(subjectName)'>
                                <span class="w-6 h-6 rounded-lg flex items-center justify-center shrink-0 @(isSel ? "bg-violet-600" : "border border-slate-300 bg-white")">
                                    @if (isSel)
                                    {
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
                                    }
                                </span>
                                <span class="text-sm font-bold leading-snug">@subjectName</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(assignSubjectsStatus))
        {
            <div class="mx-6 mb-2 p-3 rounded-xl text-xs font-bold @(assignSubjectsError ? "bg-rose-50 text-rose-700" : "bg-emerald-50 text-emerald-700")">
                @assignSubjectsStatus
            </div>
        }

        <div class="p-6 border-t border-slate-100 flex gap-3 shrink-0">
            <button class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors" @onclick="CloseAssignSubjectsModal">Cancel</button>
            <button class="flex-1 px-4 py-2.5 rounded-xl bg-violet-600 hover:bg-violet-700 disabled:opacity-50 text-white text-sm font-bold transition-colors shadow-sm flex items-center justify-center gap-2"
                    disabled="@(isSavingAssignSubjects || assignSubjectsStudent == null || !selectedSubjectsForAssign.Any())" @onclick="HandleAssignSubjectsForStudent">
                @if (isSavingAssignSubjects)
                {
                    <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Assign Subjects</span>
                }
            </button>
        </div>
    </div>
</div>
}

 </div>

<style>
