                                else
                                {

                                    <span class="px-2 py-0.5 rounded-full bg-slate-200 text-slate-600 text-[length:0.6rem] font-extrabold flex inline-flex items-center gap-1"><span class="w-1 h-1 rounded-full bg-slate-400"></span>@s.Status</span>
