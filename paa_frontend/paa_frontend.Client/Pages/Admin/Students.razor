                                    <span class="text-[length:0.6rem] uppercase tracking-widest opacity-70">Joined</span>
                                    <span class="text-slate-800">@(s.CreatedAt?.ToString("dd MMM yyyy") ?? "—")</span>
                                </div>
                                <div class="flex flex-col gap-1">
                                    <span class="text-[length:0.6rem] uppercase tracking-widest opacity-70">Gender</span>
