                                            }
                                            @if (subjectChoices.Subjects.Count > 4)
                                            {
                                                <span class="px-2.5 py-1 rounded-xl bg-slate-100 text-slate-500 text-[length:0.65rem] font-bold border border-slate-200">+@(subjectChoices.Subjects.Count - 4)</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-[length:0.7rem] font-medium text-slate-400 italic">No subjects assigned</div>
