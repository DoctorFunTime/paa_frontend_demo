@code {
    private string activeTab = "Directory";
    private string[] tabs = { "Directory", "Class Lists" };
    private async Task SetActiveTab(string tab)
    {
        activeTab = tab;
        if ((tab == "Class Lists" || tab == "Student Accounts") && !allStudentsLoaded)
            await LoadAllStudentsAsync();
    }


    private List<Student>? students;
    private List<Student> summaryStudents = new();
    private List<Student> filteredStudents = new();
    private List<Student> pagedStudents = new();
    private int totalStudentCount;
    private bool allStudentsLoaded;
    private bool isPageLoading;
    private int TotalStudentCount => allStudentsLoaded ? (students?.Count ?? 0) : totalStudentCount;
    private IEnumerable<Student> StudentSummary => allStudentsLoaded ? (students ?? new()) : summaryStudents;
    private int ActiveStudentCount => StudentSummary.Count(s => string.Equals(s.Status, "Active", StringComparison.OrdinalIgnoreCase));
    private int JoinedLast30DaysCount => StudentSummary.Count(s => s.CreatedAt.HasValue && s.CreatedAt.Value >= DateTime.Now.AddDays(-30));
    private int TransferredLast30DaysCount => StudentSummary.Count(s => s.CreatedAt.HasValue && s.CreatedAt.Value >= DateTime.Now.AddDays(-30) && (s.Status?.Contains("transfer", StringComparison.OrdinalIgnoreCase) ?? false));
    private int InactiveStudentCount => allStudentsLoaded ? (students?.Count(s => s.Status != "Active") ?? 0) : students?.Count(s => s.Status != "Active") ?? 0;
    private List<paa_frontend.Shared.Models.Admin.SubjectsModel.GetStudentALevelSubjectChoices> aLevelSubjectChoices = new();

    private string searchTerm = "";
    private string statusFilter = "";
    private string filterForm = "";
    private string filterClass = "";
    private string filterGender = "";
    private int? classListForm;
    private string classListClassroom = "";
    private List<string> classListClassrooms = new();
    private bool isPrintingClassList;
    private string sortField = "Name";
    private bool sortAsc = true;
    private string viewMode = "grid";
    private string statementSearchTerm = "";

    private IEnumerable<Student> StatementStudents =>
        (students ?? new())
            .Where(s => !string.IsNullOrWhiteSpace(statementSearchTerm) &&
                ((s.FirstName + " " + s.LastName).Contains(statementSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                 s.Id.ToString().Contains(statementSearchTerm) ||
                 (s.TempId?.Contains(statementSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false)))
            .OrderBy(s => s.LastName)
            .Take(8);

    private List<Student> classListStudents =>
        (students ?? new())
            .Where(s => classListForm.HasValue
                && s.Form == classListForm.Value
                && string.Equals(s.Classroom, classListClassroom, StringComparison.OrdinalIgnoreCase))
            .OrderBy(s => s.LastName)
            .ThenBy(s => s.FirstName)
            .ToList();

    private int currentPage = 1;
    private const int pageSize = 15;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)(allStudentsLoaded ? filteredStudents.Count : totalStudentCount) / pageSize));

    private IEnumerable<string> StudentClassOptions => (students ?? new())
        .Where(s => !string.IsNullOrWhiteSpace(s.Classroom))
        .Select(s => s.Classroom!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(c => c);

    private HashSet<int> selectedIds = new();
    private Student? assignSubjectsStudent;
    private List<paa_frontend.Shared.Models.Admin.SubjectsModel.ALevelSubjects>? availableALevelSubjects;
    private HashSet<string> selectedSubjectsForAssign = new();
    private bool showAssignSubjectsModal;
    private bool isLoadingAssignSubjects;
    private bool isSavingAssignSubjects;
    private string assignSubjectsStatus = "";
    private bool assignSubjectsError;

    private static readonly (string Bg, string Fg)[] Palette = {
        ("rgb(239,246,255)",  "#2563eb"), // blue
        ("rgb(236,253,245)",  "#059669"), // emerald
        ("rgb(255,251,235)", "#d97706"),  // amber
        ("rgb(245,243,255)", "#7c3aed"),  // violet
        ("rgb(255,241,242)",  "#e11d48"), // rose
        ("rgb(240,249,255)", "#0284c7"),  // sky
    };
    private (string Bg, string Fg) AvatarColor(int i) => Palette[i % Palette.Length];
    private static bool IsALevelStudent(Student s) => s.Form.GetValueOrDefault(0) == 5 || s.Form.GetValueOrDefault(0) == 6;

    private void NavigateToStudent(int id) => Nav.NavigateTo("/students/" + id);
    private void NavigateToEdit(int id) => Nav.NavigateTo("/students/edit/" + id);
    private void SetTableView() => viewMode = "table";
    private void SetGridView() => viewMode = "grid";

    private MarkupString SortIcon(string f) => new MarkupString(
        sortField == f
            ? "<span class='text-[length:0.6rem] ml-1'>" + (sortAsc ? "↑" : "↓") + "</span>"
            : "<span class='text-[length:0.6rem] ml-1 opacity-30'>↕</span>");

    private bool dataLoadAttempted;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || dataLoadAttempted) return;
        dataLoadAttempted = true;

        try
        {
            var pageTask = StudentService.GetStudentsPageAsync(0, pageSize);
            var summaryTask = StudentService.GetStudentsAsync();
            await Task.WhenAll(pageTask, summaryTask);
            var page = await pageTask;
            students = page.Content ?? new();
            summaryStudents = await summaryTask ?? new();
            totalStudentCount = page.TotalElements;
            filteredStudents = students.ToList();
            pagedStudents = students.ToList();
            StateHasChanged();
        }
        catch (Exception)
        {
            students = new();
        }
    }

    private async Task LoadAllStudentsAsync()
    {
        if (allStudentsLoaded) return;
        var allTask = StudentService.GetStudentsAsync();
        var choicesTask = SubjectService.GetStudentALevelSubjectChoicesAsync();
        await Task.WhenAll(allTask, choicesTask);
        students = allTask.Result ?? new();
        aLevelSubjectChoices = choicesTask.Result ?? new();
        totalStudentCount = students.Count;
        allStudentsLoaded = true;
        RefreshClassListClassrooms();
        ApplyFilters();
        StateHasChanged();
    }

    private void OnSearch(ChangeEventArgs e) { searchTerm = e.Value?.ToString() ?? ""; ApplyFilters(); }
    private void OnStatusChange(string s) { statusFilter = s; ApplyFilters(); }

    private void OnClassListFormChanged(ChangeEventArgs e)
    {
        classListForm = int.TryParse(e.Value?.ToString(), out var form) ? form : null;
        classListClassroom = string.Empty;
        RefreshClassListClassrooms();
        StateHasChanged();
    }

    private void OnClassListClassroomChanged(ChangeEventArgs e)
    {
        classListClassroom = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private void RefreshClassListClassrooms()
    {
        classListClassrooms = !classListForm.HasValue
            ? new List<string>()
            : (students ?? new())
                .Where(s => s.Form == classListForm.Value && !string.IsNullOrWhiteSpace(s.Classroom))
                .Select(s => s.Classroom!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(value => value)
                .ToList();
    }

    private async Task PrintClassListAsync()
    {
        if (!classListForm.HasValue || string.IsNullOrWhiteSpace(classListClassroom) || !classListStudents.Any())
        {
            return;
        }

        isPrintingClassList = true;
        StateHasChanged();
        await Task.Delay(50);
        await JSRuntime.InvokeVoidAsync("window.print");
        isPrintingClassList = false;
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        if (students == null) return;
        var q = students.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchTerm))
            q = q.Where(s => (s.FirstName + " " + s.LastName + " " + s.Email + " " + s.Classroom + " " + s.NationalId + " " + s.TempId + " " + s.Phone).Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(statusFilter)) q = q.Where(s => s.Status == statusFilter);
        // Use GetValueOrDefault to safely compare nullable int Form
        if (!string.IsNullOrEmpty(filterForm) && int.TryParse(filterForm, out int fv)) q = q.Where(s => s.Form.GetValueOrDefault(0) == fv);
        if (!string.IsNullOrWhiteSpace(filterClass)) q = q.Where(s => string.Equals(s.Classroom?.Trim(), filterClass.Trim(), StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(filterGender)) q = q.Where(s => s.Gender == filterGender);

        q = sortField switch
        {
            "Name" => sortAsc ? q.OrderBy(s => s.LastName).ThenBy(s => s.FirstName) : q.OrderByDescending(s => s.LastName).ThenByDescending(s => s.FirstName),
            "Form" => sortAsc ? q.OrderBy(s => s.Form) : q.OrderByDescending(s => s.Form),
            _ => q
        };
        filteredStudents = q.ToList(); currentPage = 1; UpdatePage();
    }

    private void UpdatePage() => pagedStudents = filteredStudents.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    private async Task GoToPage(int p)
    {
        currentPage = Math.Clamp(p, 1, Math.Max(1, totalPages));
        if (allStudentsLoaded) { UpdatePage(); return; }
        isPageLoading = true;
        var page = await StudentService.GetStudentsPageAsync(currentPage - 1, pageSize);
        students = page.Content ?? new();
        filteredStudents = students.ToList();
        pagedStudents = students.ToList();
        totalStudentCount = page.TotalElements;
        isPageLoading = false;
        StateHasChanged();
    }

    private IEnumerable<int> VisiblePages()
    {
        if (totalPages <= 7) return Enumerable.Range(1, totalPages);
        var pages = new List<int> { 1 };
        var start = Math.Max(2, currentPage - 1);
        var end = Math.Min(totalPages - 1, currentPage + 1);
        if (start > 2) pages.Add(0);
        pages.AddRange(Enumerable.Range(start, end - start + 1));
        if (end < totalPages - 1) pages.Add(0);
        pages.Add(totalPages);
        return pages;
    }

    private void SortBy(string field) { if (sortField == field) sortAsc = !sortAsc; else { sortField = field; sortAsc = true; } ApplyFilters(); }
    private void ToggleSelect(int id, bool val) { if (val) selectedIds.Add(id); else selectedIds.Remove(id); }
    private void ToggleSelectAll() { if (selectedIds.Count == pagedStudents.Count) selectedIds.Clear(); else foreach (var s in pagedStudents) selectedIds.Add(s.Id); }
    private paa_frontend.Shared.Models.Admin.SubjectsModel.GetStudentALevelSubjectChoices? GetALevelSubjectChoicesForStudent(long studentId)
        => aLevelSubjectChoices.FirstOrDefault(c => c.StudentId == studentId);

    private async Task OpenAssignSubjectsModal(Student student)
    {
        if (!IsALevelStudent(student))
        {
            NotificationService.ShowError("A-Level subject assignment is only available for Form 5 and Form 6 students.");
            return;
        }

        assignSubjectsStudent = student;
        showAssignSubjectsModal = true;
        isLoadingAssignSubjects = true;
        assignSubjectsStatus = "";
        assignSubjectsError = false;
        selectedSubjectsForAssign.Clear();

        try
        {
            var subjectsTask = SubjectService.GetALevelSubjectsAsync();
            var choicesTask = SubjectService.GetStudentALevelSubjectChoicesAsync();
            await Task.WhenAll(subjectsTask, choicesTask);

            availableALevelSubjects = subjectsTask.Result;
            var existingChoices = choicesTask.Result.FirstOrDefault(c => c.StudentId == student.Id);
            if (existingChoices != null)
            {
                foreach (var subjectName in existingChoices.Subjects)
                {
                    selectedSubjectsForAssign.Add(subjectName);
                }
            }
        }
        catch (Exception ex)
        {
            assignSubjectsStatus = "Failed to load subjects: " + ex.Message;
            assignSubjectsError = true;
        }
        finally
        {
            isLoadingAssignSubjects = false;
        }
    }

    private void CloseAssignSubjectsModal()
    {
        showAssignSubjectsModal = false;
        assignSubjectsStudent = null;
        assignSubjectsStatus = "";
        assignSubjectsError = false;
        isLoadingAssignSubjects = false;
        isSavingAssignSubjects = false;
        selectedSubjectsForAssign.Clear();
    }

    private void ToggleSubjectForAssign(string subjectName)
    {
        if (selectedSubjectsForAssign.Contains(subjectName)) selectedSubjectsForAssign.Remove(subjectName);
        else selectedSubjectsForAssign.Add(subjectName);
    }

    private async Task HandleAssignSubjectsForStudent()
    {
        if (assignSubjectsStudent == null || !selectedSubjectsForAssign.Any()) return;

        isSavingAssignSubjects = true;
        assignSubjectsStatus = "";
        assignSubjectsError = false;

        try
        {
            var result = await SubjectService.PostALevelSubjectsToStudentAsync(assignSubjectsStudent.Id, selectedSubjectsForAssign.ToList());
            if (result)
            {
                var refreshedChoices = await SubjectService.GetStudentALevelSubjectChoicesAsync();
                var refreshedChoice = refreshedChoices.FirstOrDefault(c => c.StudentId == assignSubjectsStudent.Id);

                // Keep the cards correct even if the enrollment service is still
                // propagating the write when the immediate refresh is performed.
                if (refreshedChoice == null)
                {
                    refreshedChoice = new paa_frontend.Shared.Models.Admin.SubjectsModel.GetStudentALevelSubjectChoices
                    {
                        StudentId = assignSubjectsStudent.Id,
                        Form = assignSubjectsStudent.Form ?? 0,
                        ClassName = assignSubjectsStudent.Classroom,
                        Subjects = selectedSubjectsForAssign.ToList()
                    };
                    refreshedChoices.Add(refreshedChoice);
                }
                else
                {
                    refreshedChoice.Subjects = selectedSubjectsForAssign.ToList();
                }

                aLevelSubjectChoices = refreshedChoices;
                NotificationService.ShowSuccess("Subjects assigned successfully.");
                CloseAssignSubjectsModal();
            }
            else
            {
                assignSubjectsStatus = "Subjects could not be assigned because this student's class is missing or is not configured. Check the student class and make sure it exists in the class presets, then try again.";
                assignSubjectsError = true;
                NotificationService.ShowError(assignSubjectsStatus);
            }
        }
        catch
        {
            assignSubjectsStatus = "Subjects could not be assigned because this student's class is missing or is not configured. Check the student class and make sure it exists in the class presets, then try again.";
            assignSubjectsError = true;
            NotificationService.ShowError(assignSubjectsStatus);
        }
        finally
        {
            isSavingAssignSubjects = false;
        }
    }

}
