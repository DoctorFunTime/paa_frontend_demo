@code {
    private Task PrintApplication() => JS.InvokeVoidAsync("window.print").AsTask();

    private RenderFragment ApplicationPrintField(string Label, string? Value, bool Wide = false) => @<div class="application-field @(Wide ? "wide" : "")">
        <div class="application-field-label">@Label</div>
        <div class="application-field-value">@(string.IsNullOrWhiteSpace(Value) ? " " : Value.Trim())</div>
    </div>;

    private Student newStudent = new();
    private EditContext editContext = default!;
    private List<AlevelClassName> aLevelPresets = new();
    private List<string> oLevelPresets = new();
    private bool classesLoading = true;
    private bool isSubmitting = false;
    private AuthCreationResult? createdStudent;
    private string? formFeedbackMessage;
    private string? submissionErrorMessage;
    private ValidationMessageStore validationMessageStore = default!;
    private ElementReference feedbackSectionRef;
    private ElementReference responseSectionRef;
    [CascadingParameter(Name = "ReturnPortal")]
    private string? ReturnPortal { get; set; }

    private string DashboardHref => ReturnPortal == "burser" ? "/burser" : "/admin";

    protected override void OnInitialized()
    {
        ResetFormModel();
    }

    protected override async Task OnInitializedAsync()
    {
        classesLoading = true;
        try
        {
            var aTask = ClassService.GetAllAlevelClassNamesAsync();
            var oTask = OClassService.GetAllOlevelClassNamesAsync();
            await Task.WhenAll(aTask, oTask);

            aLevelPresets = (aTask.Result ?? new())
                .Where(c => !string.IsNullOrWhiteSpace(c.ClassName))
                .OrderBy(c => c.ClassName)
                .ToList();

            oLevelPresets = (oTask.Result ?? new())
                .Where(c => !string.IsNullOrWhiteSpace(c.ClassName))
                .Select(c => c.ClassName!)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
        }
        catch
        {
            aLevelPresets = new();
            oLevelPresets = new();
        }
        finally
        {
            classesLoading = false;
        }
    }

    private async Task HandleInvalidSubmit(EditContext _)
    {
        createdStudent = null;
        submissionErrorMessage = null;
        formFeedbackMessage = "Please correct the highlighted fields and try again.";
        NotificationService.ShowError(formFeedbackMessage);
        await InvokeAsync(StateHasChanged);
        await FocusElementAsync(feedbackSectionRef);
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        try
        {
            ClearCustomValidation();
            formFeedbackMessage = null;
            submissionErrorMessage = null;
            createdStudent = null;

            var response = await StudentService.CreateStudentAsync(newStudent);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthCreationResult>();
                if (result != null)
                {
                    createdStudent = result;
                    NotificationService.ShowSuccess("Student created successfully!");
                    await InvokeAsync(StateHasChanged);
                    await FocusElementAsync(responseSectionRef);
                }
                else
                {
                    submissionErrorMessage = "Student was created, but the response details could not be displayed.";
                    NotificationService.ShowError(submissionErrorMessage);
                    await InvokeAsync(StateHasChanged);
                    await FocusElementAsync(feedbackSectionRef);
                }
            }
            else
            {
                submissionErrorMessage = await ExtractErrorMessageAsync(response, "Failed to create student. Please review the form and try again.");
                NotificationService.ShowError(submissionErrorMessage);
                await InvokeAsync(StateHasChanged);
                await FocusElementAsync(feedbackSectionRef);
            }
        }
        catch (Exception)
        {
            submissionErrorMessage = "Error: ";
            NotificationService.ShowError(submissionErrorMessage);
            await InvokeAsync(StateHasChanged);
            await FocusElementAsync(feedbackSectionRef);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        createdStudent = null;
        formFeedbackMessage = null;
        submissionErrorMessage = null;
        ResetFormModel();
    }

    private void ResetFormModel()
    {
        newStudent = new Student
        {
            Gender = string.Empty,
            Status = "Active",
            EmergencyContactDetails = new EmergencyContactDetails()
        };
        editContext = new EditContext(newStudent);
        validationMessageStore = new ValidationMessageStore(editContext);
        editContext.OnFieldChanged += (_, __) => ClearCustomValidation();
    }

    private void ClearCustomValidation()
    {
        validationMessageStore.Clear();
        editContext.NotifyValidationStateChanged();
    }

    private void AddFieldError<TField>(Expression<Func<TField>> accessor, string message)
    {
        validationMessageStore.Clear();
        validationMessageStore.Add(FieldIdentifier.Create(accessor), message);
        editContext.NotifyValidationStateChanged();
    }

    private static async Task FocusElementAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync();
        }
        catch
        {
        }
    }

    private static async Task<string> ExtractErrorMessageAsync(HttpResponseMessage response, string fallbackMessage)
    {
        var raw = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(raw))
        {
            return fallbackMessage;
        }

        try
        {
            using var document = JsonDocument.Parse(raw);
            var root = document.RootElement;

            foreach (var propertyName in new[] { "message", "error", "title", "detail" })
            {
                if (root.TryGetProperty(propertyName, out var property) && property.ValueKind == JsonValueKind.String)
                {
                    var value = property.GetString();
                    if (!string.IsNullOrWhiteSpace(value))
                    {
                        return value!;
                    }
                }
            }
        }
        catch (JsonException)
        {
        }

        return raw.Trim();
    }
}
