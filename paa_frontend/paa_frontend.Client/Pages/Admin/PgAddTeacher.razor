@page "/admin/teachers/add"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using static paa_frontend.Shared.Models.TeacherProfileModel
@using paa_frontend.Shared.Models
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@using System.Text.Json
@inject paa_frontend.Client.Services.TeacherProfileServiceClient TeacherService
@inject paa_frontend.Client.Services.NotificationService NotificationService
@inject NavigationManager Nav

<div class="max-w-4xl mx-auto w-full pb-16">
    <div class="flex items-center gap-2 text-sm text-slate-500 font-medium mb-1">
        <a href="/admin" class="hover:text-blue-600 transition-colors">Dashboard</a>
        <span class="text-slate-300">&rsaquo;</span>
        <span class="text-slate-800 font-bold">New Teacher</span>
    </div>
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mb-2">Register New Teacher</h1>
            <p class="text-sm font-medium text-slate-500">Add a new teaching staff member to the school system.</p>
        </div>
    </div>

    <EditForm EditContext="@editContext" id="teacher-registration-form" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit" class="bg-white/60 backdrop-blur-sm border border-slate-200/50 rounded-3xl p-6 md:p-10 shadow-sm animate-fade-in relative overflow-hidden">
        <DataAnnotationsValidator />
        
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-teal-600 to-indigo-600"></div>

        @if (!string.IsNullOrWhiteSpace(formFeedbackMessage) || !string.IsNullOrWhiteSpace(submissionErrorMessage))
        {
            <div id="teacher-submit-feedback" @ref="feedbackSectionRef" tabindex="-1" class="mb-6 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm text-rose-700 shadow-sm" aria-live="assertive">
                @if (!string.IsNullOrWhiteSpace(formFeedbackMessage))
                {
                    <p class="font-bold">@formFeedbackMessage</p>
                }
                @if (!string.IsNullOrWhiteSpace(submissionErrorMessage))
                {
                    <p class="font-bold">@submissionErrorMessage</p>
                }
                <ValidationSummary class="validation-errors mt-3 space-y-1 text-xs font-semibold text-rose-600" />
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">

            <div class="col-span-1 md:col-span-2">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Basic Identity</h3>
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[length:0.8rem] font-bold text-slate-700">First Name <span class="text-rose-500">*</span></label>
                <InputText @bind-Value="newTeacher.FirstName" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" />
                <ValidationMessage For="@(() => newTeacher.FirstName)" class="text-[length:0.65rem] text-rose-500 font-bold" />
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[length:0.8rem] font-bold text-slate-700">Last Name <span class="text-rose-500">*</span></label>
                <InputText @bind-Value="newTeacher.LastName" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" />
                <ValidationMessage For="@(() => newTeacher.LastName)" class="text-[length:0.65rem] text-rose-500 font-bold" />
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[length:0.8rem] font-bold text-slate-700">Date of Birth</label>
                <InputDate @bind-Value="newTeacher.DateOfBirth" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" />
                <ValidationMessage For="@(() => newTeacher.DateOfBirth)" class="text-[length:0.65rem] text-rose-500 font-bold" />
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[length:0.8rem] font-bold text-slate-700">Gender</label>
                <div class="relative">
                    <InputSelect @bind-Value="newTeacher.Gender" class="w-full bg-white border border-slate-200 rounded-xl pl-4 pr-10 py-2.5 text-sm font-medium focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none appearance-none">
                        <option value="">Select gender...</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </InputSelect>
                    <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                    </div>
                </div>
                <ValidationMessage For="@(() => newTeacher.Gender)" class="text-[length:0.65rem] text-rose-500 font-bold" />
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[length:0.8rem] font-bold text-slate-700">National ID</label>
                <InputText @bind-Value="newTeacher.NationalId" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none font-mono" placeholder="00-0000000X00" />
                <ValidationMessage For="@(() => newTeacher.NationalId)" class="text-[length:0.65rem] text-rose-500 font-bold" />
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[length:0.8rem] font-bold text-slate-700">Employment Status</label>
                <div class="relative">
                    <InputSelect @bind-Value="newTeacher.Status" class="w-full bg-white border border-slate-200 rounded-xl pl-4 pr-10 py-2.5 text-sm font-medium focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none appearance-none">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Suspended">Suspended</option>
                    </InputSelect>
                    <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                    </div>
                </div>
                <ValidationMessage For="@(() => newTeacher.Status)" class="text-[length:0.65rem] text-rose-500 font-bold" />
            </div>

            <div class="col-span-1 md:col-span-2 mt-4">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest border-t border-slate-200/60 pt-6 mb-4">Contact Information</h3>
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[length:0.8rem] font-bold text-slate-700">Email Address</label>
                <InputText @bind-Value="newTeacher.Email" type="text" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" placeholder="teacher@example.com (optional)" />
                <ValidationMessage For="@(() => newTeacher.Email)" class="text-[length:0.65rem] text-rose-500 font-bold" />
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[length:0.8rem] font-bold text-slate-700">Phone</label>
                <InputText @bind-Value="newTeacher.Phone" type="tel" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all outline-none" placeholder="+263 7..." />
                <ValidationMessage For="@(() => newTeacher.Phone)" class="text-[length:0.65rem] text-rose-500 font-bold" />
            </div>

        </div>

        <div class="mt-10 pt-6 border-t border-slate-100 flex flex-col-reverse sm:flex-row items-stretch sm:items-center sm:justify-end gap-3">
            <button type="button" class="w-full sm:w-auto px-6 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors shadow-sm" @onclick='() => Nav.NavigateTo("/admin")'>Cancel</button>
            <button type="submit" class="w-full sm:w-auto px-8 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold transition-all shadow-md flex items-center justify-center gap-2" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> <span>Saving...</span>
                }
                else
                {
                    <span>Create Staff Record</span>
                }
            </button>
        </div>

    </EditForm>

    @if (createdTeacher != null)
    {
        <div id="teacher-created-response" @ref="responseSectionRef" tabindex="-1" class="mt-8 bg-white/60 backdrop-blur-sm border border-emerald-200/50 rounded-3xl p-6 md:p-10 shadow-sm animate-fade-in relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-500 to-teal-500"></div>
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                </div>
                <div>
                    <h2 class="text-xl font-extrabold text-slate-900">Teacher Account Created</h2>
                    <p class="text-sm text-slate-500">The record has been saved to the system.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <div class="bg-slate-50 rounded-xl p-4">
                    <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Account ID</div>
                    <div class="text-lg font-black text-slate-900 font-mono">#@createdTeacher.StudentId</div>
                </div>
                <div class="bg-slate-50 rounded-xl p-4">
                    <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Full Name</div>
                    <div class="text-lg font-bold text-slate-900">@createdTeacher.FirstName @createdTeacher.LastName</div>
                </div>

                <!-- Credentials block — full width, highlighted -->
                <div class="col-span-1 md:col-span-2 bg-teal-50 border border-teal-200 rounded-xl p-5">
                    <div class="flex items-center gap-2 mb-3">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-teal-500"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        <div class="text-xs font-bold text-teal-600 uppercase tracking-widest">Login Credentials — Share with staff member</div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Username</div>
                            <div class="text-sm font-mono font-bold text-slate-900 bg-white border border-teal-100 rounded-lg px-3 py-2">@(createdTeacher.Username ?? "—")</div>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Temporary Password</div>
                            <div class="text-sm font-mono font-bold text-slate-900 bg-white border border-teal-100 rounded-lg px-3 py-2">@(createdTeacher.Password ?? "—")</div>
                        </div>
                    </div>
                </div>

                <div class="bg-slate-50 rounded-xl p-4">
                    <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Status</div>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold @(createdTeacher.Status == "ACTIVE" ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700")">@createdTeacher.Status</span>
                </div>
                <div class="bg-slate-50 rounded-xl p-4">
                    <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Account Created</div>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold @(createdTeacher.IsCreated ? "bg-emerald-100 text-emerald-700" : "bg-rose-100 text-rose-700")">
                        @(createdTeacher.IsCreated ? "Yes" : "No")
                    </span>
                </div>

            </div>

            <div class="mt-6 pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-stretch sm:items-center sm:justify-end gap-3">
                <button class="w-full sm:w-auto px-6 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors shadow-sm" @onclick='() => Nav.NavigateTo("/admin/teachers")'>View All Teachers</button>
                <button class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold transition-all shadow-md" @onclick="ResetForm">Add Another</button>
            </div>
        </div>
    }
</div>

@code {
    private Teacher newTeacher = new();
    private EditContext editContext = default!;
    private bool isSubmitting = false;
    private AuthCreationResult? createdTeacher;
    private string? formFeedbackMessage;
    private string? submissionErrorMessage;
    private ElementReference feedbackSectionRef;
    private ElementReference responseSectionRef;

    protected override void OnInitialized()
    {
        ResetFormModel();
    }

    private async Task HandleInvalidSubmit(EditContext _)
    {
        createdTeacher = null;
        submissionErrorMessage = null;
        formFeedbackMessage = "Please correct the highlighted fields and try again.";
        NotificationService.ShowError(formFeedbackMessage);
        await InvokeAsync(StateHasChanged);
        await FocusElementAsync(feedbackSectionRef);
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        try
        {
            formFeedbackMessage = null;
            submissionErrorMessage = null;
            createdTeacher = null;

            var response = await TeacherService.CreateTeacherAsync(newTeacher);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthCreationResult>();
                if (result != null)
                {
                    createdTeacher = result;
                    NotificationService.ShowSuccess("Teacher created successfully!");
                    await InvokeAsync(StateHasChanged);
                    await FocusElementAsync(responseSectionRef);
                }
                else
                {
                    submissionErrorMessage = "Teacher was created, but the response details could not be displayed.";
                    NotificationService.ShowError(submissionErrorMessage);
                    await InvokeAsync(StateHasChanged);
                    await FocusElementAsync(feedbackSectionRef);
                }
            }
            else
            {
                submissionErrorMessage = await ExtractErrorMessageAsync(response, "Failed to create teacher. Please review the form and try again.");
                NotificationService.ShowError(submissionErrorMessage);
                await InvokeAsync(StateHasChanged);
                await FocusElementAsync(feedbackSectionRef);
            }
        }
        catch (Exception)
        {
            submissionErrorMessage = "Error: ";
            NotificationService.ShowError(submissionErrorMessage);
            await InvokeAsync(StateHasChanged);
            await FocusElementAsync(feedbackSectionRef);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        createdTeacher = null;
        formFeedbackMessage = null;
        submissionErrorMessage = null;
        ResetFormModel();
    }

    private void ResetFormModel()
    {
        newTeacher = new Teacher { Status = "Active" };
        editContext = new EditContext(newTeacher);
    }

    private static async Task FocusElementAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync();
        }
        catch
        {
        }
    }

    private static async Task<string> ExtractErrorMessageAsync(HttpResponseMessage response, string fallbackMessage)
    {
        var raw = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(raw))
        {
            return fallbackMessage;
        }

        try
        {
            using var document = JsonDocument.Parse(raw);
            var root = document.RootElement;

            foreach (var propertyName in new[] { "message", "error", "title", "detail" })
            {
                if (root.TryGetProperty(propertyName, out var property) && property.ValueKind == JsonValueKind.String)
                {
                    var value = property.GetString();
                    if (!string.IsNullOrWhiteSpace(value))
                    {
                        return value!;
                    }
                }
            }
        }
        catch (JsonException)
        {
        }

        return raw.Trim();
    }
}
