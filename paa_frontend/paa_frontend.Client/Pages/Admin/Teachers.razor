@page "/admin/teachers"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using paa_frontend.Client.Services
@using static paa_frontend.Shared.Models.TeacherProfileModel
@inject TeacherProfileServiceClient TeacherService
@inject NavigationManager Nav

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2 text-sm text-slate-500 font-medium mb-1">
            <a href="/admin" class="hover:text-blue-600 transition-colors">Dashboard</a>
            <span class="text-slate-300">&rsaquo;</span>
            <span class="text-slate-800 font-bold">Staff Directory</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mb-1">Teachers</h1>
        <p class="text-sm font-medium text-slate-500">Manage, filter, and view all academic staff.</p>
    </div>
    <div class="flex w-full md:w-auto flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <button class="px-4 py-2 bg-white/60 hover:bg-white backdrop-blur-sm border border-slate-200/60 rounded-full text-xs font-semibold text-slate-600 transition-colors shadow-sm flex items-center justify-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
        </button>
        <a href="/admin/teachers/add" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-full text-xs font-bold transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Teacher
        </a>
        <a href="/admin/teachers/bulk-import" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-full text-xs font-bold transition-all shadow-md flex items-center justify-center gap-2">Bulk Import</a>
    </div>
</div>

<!-- ── Stats Ribbon ───────────────────────────────────────────── -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-slate-200/50 backdrop-blur border border-slate-200/50 rounded-2xl overflow-hidden mb-8">
    <div class="bg-white/80 p-4 sm:p-5">
        <div class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Total</div>
        <div class="text-3xl font-extrabold text-blue-600 tracking-tighter mb-2">@(teachers?.Count ?? 0)</div>
        <span class="px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 text-xs font-bold">All staff</span>
    </div>
    <div class="bg-white/80 p-4 sm:p-5">
        <div class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Active</div>
        <div class="text-3xl font-extrabold text-emerald-500 tracking-tighter mb-2">@(teachers?.Count(s => s.Status == "Active") ?? 0)</div>
        <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 text-xs font-bold">Teaching</span>
    </div>
    <div class="bg-white/80 p-4 sm:p-5">
        <div class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Inactive</div>
        <div class="text-3xl font-extrabold text-slate-700 tracking-tighter mb-2">@(teachers?.Count(s => s.Status != "Active") ?? 0)</div>
        <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-xs font-bold">On leave/inactive</span>
    </div>
    <div class="bg-white/80 p-4 sm:p-5">
        <div class="text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Showing</div>
        <div class="text-3xl font-extrabold text-slate-900 tracking-tighter mb-2">@filteredTeachers.Count</div>
        <span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-600 text-xs font-bold">Filtered</span>
    </div>
</div>

<!-- ── Top Toolbar ─────────────────────────────────────────────── -->
<div class="flex flex-col xl:flex-row xl:items-center gap-4 mb-4">
    <div class="relative w-full xl:flex-1 xl:max-w-sm">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></span>
        <input class="w-full py-2.5 pl-10 pr-4 bg-white/70 border border-slate-200 rounded-full text-sm font-medium focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all placeholder:text-slate-400" type="text" placeholder="Search by name, email or ID..." value="@searchTerm" @oninput="OnSearch" />
    </div>

    <!-- Toggles -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 xl:pb-0 hide-scrollbar">
        <div class="flex bg-white/60 p-1 border border-slate-200 rounded-full shadow-sm shrink-0">
            <button class="px-4 py-1.5 rounded-full text-xs font-bold transition-colors @(string.IsNullOrEmpty(statusFilter) ? "bg-slate-900 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")" @onclick="() => OnStatusChange(string.Empty)">All</button>
            <button class="px-4 py-1.5 rounded-full text-xs font-bold transition-colors @(statusFilter == "Active" ? "bg-emerald-500 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")" @onclick='() => OnStatusChange("Active")'>Active</button>
            <button class="px-4 py-1.5 rounded-full text-xs font-bold transition-colors @(statusFilter == "Inactive" ? "bg-slate-400 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")" @onclick='() => OnStatusChange("Inactive")'>Inactive</button>
        </div>

        <div class="relative shrink-0">
            <select class="appearance-none pl-4 pr-9 py-2 bg-white/60 border border-slate-200 rounded-full text-xs font-bold text-slate-600 focus:outline-none focus:border-blue-500" value="@filterGender" @onchange='e => { filterGender = e.Value?.ToString() ?? ""; ApplyFilters(); }'>
                <option value="">All Genders</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
            </select>
            <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></div>
        </div>
    </div>

    <div class="w-full xl:w-auto xl:ml-auto flex items-center justify-between xl:justify-end gap-3 sm:gap-4 shrink-0">
        <span class="text-xs font-bold text-slate-400 shrink-0">@filteredTeachers.Count matches</span>
        <div class="flex bg-white/60 border border-slate-200 rounded-full p-1 shadow-sm">
            <button class="w-8 h-8 rounded-full flex items-center justify-center transition-colors @(viewMode == "table" ? "bg-white shadow text-blue-600" : "text-slate-400 hover:text-slate-700")" @onclick="SetTableView">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
            </button>
            <button class="w-8 h-8 rounded-full flex items-center justify-center transition-colors @(viewMode == "grid" ? "bg-white shadow text-blue-600" : "text-slate-400 hover:text-slate-700")" @onclick="SetGridView">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            </button>
        </div>
    </div>
</div>

<!-- ── Main View ─────────────────────────────────────────── -->
@if (viewMode == "table")
{
    <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-8">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[800px]">
                <thead class="bg-slate-50/50 border-b border-slate-200 text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest">
                    <tr>
                        <th class="py-3 px-4 w-12 text-center pointer-events-auto">
                            <input type="checkbox" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer" @onclick="ToggleSelectAll" />
                        </th>
                        <th class="py-3 px-4 cursor-pointer hover:text-blue-600 transition-colors @(sortField == "Name" ? "text-blue-600" : "")" @onclick='() => SortBy("Name")'>
                            Teacher @SortIcon("Name")
                        </th>
                        <th class="py-3 px-4">Contact</th>
                        <th class="py-3 px-4">Gender</th>
                        <th class="py-3 px-4">DOB</th>
                        <th class="py-3 px-4">Status</th>
                        <th class="py-3 px-4 w-24"></th>
                    </tr>
                </thead>
                <tbody class="text-sm font-medium text-slate-700 divide-y divide-slate-100">
                    @if (teachers == null)
                    {
                        @for (int i = 0; i < 8; i++)
                        {
                            <tr class="animate-pulse">
                                <td class="py-4 px-4 text-center"><div class="w-4 h-4 bg-slate-200 rounded mx-auto"></div></td>
                                <td class="py-4 px-4"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl bg-slate-200 shrink-0"></div><div class="flex flex-col gap-1.5"><div class="w-24 h-3 bg-slate-200 rounded"></div><div class="w-16 h-2 bg-slate-100 rounded"></div></div></div></td>
                                <td class="py-4 px-4"><div class="w-32 h-3 bg-slate-200 rounded"></div></td>
                                <td class="py-4 px-4"><div class="w-10 h-3 bg-slate-200 rounded"></div></td>
                                <td class="py-4 px-4"><div class="w-20 h-3 bg-slate-200 rounded"></div></td>
                                <td class="py-4 px-4"><div class="w-16 h-5 bg-slate-200 rounded-full"></div></td>
                                <td></td>
                            </tr>
                        }
                    }
                    else if (!pagedTeachers.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-16 text-center">
                                <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-400">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                                </div>
                                <div class="text-sm font-bold text-slate-800 mb-1">No teachers found</div>
                                <p class="text-xs text-slate-500 font-medium">Try adjusting your filters.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int ri = 0;
                        @foreach (var t in pagedTeachers)
                        {
                            var (bg, fg) = AvatarColor(ri);
                            bool sel = selectedIds.Contains(t.Id);
                            string ini = (t.FirstName?.FirstOrDefault().ToString() ?? "") + (t.LastName?.FirstOrDefault().ToString() ?? "");
                            long tid = t.Id;

                            <tr class="hover:bg-blue-50/50 transition-colors group cursor-pointer" @onclick="() => NavigateToTeacher(tid)">
                                <td class="py-3 px-4 text-center" @onclick:stopPropagation="true">
                                    <input type="checkbox" checked="@sel" @onchange="e => ToggleSelect(t.Id, (bool)e.Value!)" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer" />
                                </td>
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-sm font-extrabold shrink-0" style="background:@bg;color:@fg;">@ini</div>
                                        <div>
                                            <div class="text-sm font-bold text-slate-900 group-hover:text-blue-700 transition-colors">@t.FirstName @t.LastName</div>
                                            <div class="text-[length:0.65rem] font-mono font-bold text-slate-400 mt-0.5">@(string.IsNullOrEmpty(t.NationalId) ? "No ID" : t.NationalId)</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-4 max-w-[200px] truncate">
                                    @if (!string.IsNullOrEmpty(t.Email)) { <div class="flex items-center gap-1.5 text-xs text-slate-600 truncate"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="shrink-0" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>@t.Email</div> }
                                    @if (!string.IsNullOrEmpty(t.Phone)) { <div class="flex items-center gap-1.5 text-xs text-slate-600 truncate mt-1"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="shrink-0" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l1.79-1.79a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>@t.Phone</div> }
                                    @if (string.IsNullOrEmpty(t.Email) && string.IsNullOrEmpty(t.Phone)) { <span class="text-xs text-slate-400">&mdash;</span> }
                                </td>
                                <td class="py-3 px-4 text-xs font-bold text-slate-500">@(t.Gender ?? "—")</td>
                                <td class="py-3 px-4 font-mono text-[length:0.7rem] font-bold text-slate-500">@(t.DateOfBirth.HasValue ? t.DateOfBirth.Value.ToString("dd MMM yyyy") : "—")</td>
                                <td class="py-3 px-4">
                                    @if (t.Status == "Active") { <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-[length:0.65rem] font-extrabold flex inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Active</span> }
                                    else { <span class="px-2 py-0.5 rounded-full bg-slate-200 text-slate-600 text-[length:0.65rem] font-extrabold flex inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>@t.Status</span> }
                                </td>
                                <td class="py-3 px-4 text-right" @onclick:stopPropagation="true">
                                    <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <button class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 flex items-center justify-center transition-all shadow-sm" title="View Profile" @onclick="() => NavigateToTeacher(tid)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </button>
                                        <button class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 flex items-center justify-center transition-all shadow-sm" title="Delete" @onclick="() => ConfirmDelete(t)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            ri++;
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (filteredTeachers.Count > pageSize)
        {
            <div class="bg-slate-50/80 border-t border-slate-200 px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
                <span class="text-xs font-bold text-slate-400">Showing @(((currentPage - 1) * pageSize) + 1)–@(Math.Min(currentPage * pageSize, filteredTeachers.Count)) of @filteredTeachers.Count</span>
                <div class="flex items-center gap-1">
                    <button class="w-8 h-8 rounded-lg flex items-center justify-center border border-slate-200 bg-white text-slate-500 hover:bg-slate-50 disabled:opacity-50" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="15 18 9 12 15 6"/></svg></button>
                    @for (int p = 1; p <= totalPages; p++) { int pg = p; <button class="w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold transition-all @(currentPage == pg ? "bg-blue-600 text-white shadow-md" : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50")" @onclick="() => GoToPage(pg)">@pg</button> }
                    <button class="w-8 h-8 rounded-lg flex items-center justify-center border border-slate-200 bg-white text-slate-500 hover:bg-slate-50 disabled:opacity-50" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 18 15 12 9 6"/></svg></button>
                </div>
            </div>
        }
    </div>
}
else if (viewMode == "grid")
{
    @if (teachers == null)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-8">
            @for (int i = 0; i < 8; i++) {
                <div class="bg-white/60 backdrop-blur-sm border border-slate-200/60 rounded-2xl p-5 shadow-sm animate-pulse">
                    <div class="w-12 h-12 rounded-xl bg-slate-200 mb-4"></div>
                    <div class="w-2/3 h-3 bg-slate-200 rounded mb-2"></div>
                    <div class="w-1/2 h-2 bg-slate-100 rounded"></div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-8">
            @{ int ci = 0; }
            @foreach (var t in pagedTeachers)
            {
                var (bg, fg) = AvatarColor(ci);
                string ini = (t.FirstName?.FirstOrDefault().ToString() ?? "") + (t.LastName?.FirstOrDefault().ToString() ?? "");
                long tid = t.Id;

                <div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-5 hover:-translate-y-1 hover:shadow-lg transition-all cursor-pointer group flex flex-col" @onclick="() => NavigateToTeacher(tid)">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-sm font-extrabold shadow-sm" style="background:@bg;color:@fg;">@ini</div>
                        @if (t.Status == "Active") { <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-[length:0.6rem] font-extrabold flex inline-flex items-center gap-1"><span class="w-1 h-1 rounded-full bg-emerald-500"></span>Active</span> }
                        else { <span class="px-2 py-0.5 rounded-full bg-slate-200 text-slate-600 text-[length:0.6rem] font-extrabold flex inline-flex items-center gap-1"><span class="w-1 h-1 rounded-full bg-slate-400"></span>@t.Status</span> }
                    </div>
                    
                    <div class="text-base font-extrabold text-slate-900 group-hover:text-blue-700 transition-colors">@t.FirstName @t.LastName</div>
                    <div class="text-xs font-mono font-bold text-slate-400 mt-1">@(string.IsNullOrEmpty(t.NationalId) ? "No ID" : t.NationalId)</div>
                    @if (!string.IsNullOrEmpty(t.Email)) { <div class="text-[length:0.7rem] font-medium text-slate-500 mt-3 truncate">@t.Email</div> }
                    
                    <div class="mt-auto pt-4 flex gap-4 text-xs font-bold text-slate-400 border-t border-slate-100/50">
                        <div class="flex flex-col gap-1">
                            <span class="text-[length:0.6rem] uppercase tracking-widest opacity-70">Gender</span>
                            <span class="text-slate-800">@(t.Gender ?? "—")</span>
                        </div>
                    </div>
                </div>
                ci++;
            }
        </div>
    }
}

<!-- Delete Modal -->
@if (deleteTarget != null)
{
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[100] flex items-center justify-center p-4 animate-fade-in" @onclick="() => deleteTarget = null">
        <div class="bg-white rounded-3xl p-8 max-w-md w-full shadow-2xl relative" @onclick:stopPropagation="true">
            <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mb-5">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <h3 class="text-xl font-extrabold text-slate-900 mb-2">Remove teacher?</h3>
            <p class="text-sm font-medium text-slate-500 mb-8 leading-relaxed">
                This will permanently remove <strong>@deleteTarget.FirstName @deleteTarget.LastName</strong> from the system. This action cannot be undone.
            </p>
            <div class="flex items-center justify-end gap-3">
                <button class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors" @onclick="() => deleteTarget = null">Cancel</button>
                <button class="px-5 py-2.5 rounded-xl bg-rose-600 text-white text-sm font-bold hover:bg-rose-700 transition-colors shadow-sm" @onclick="ExecuteDelete">Remove Teacher</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Teacher>? teachers;
    private List<Teacher> filteredTeachers = new();
    private List<Teacher> pagedTeachers = new();

    private string searchTerm = "";
    private string statusFilter = "";
    private string filterGender = "";
    private string sortField = "Name";
    private bool sortAsc = true;
    private string viewMode = "table";

    private int currentPage = 1;
    private const int pageSize = 15;
    private int totalPages => (int)Math.Ceiling((double)filteredTeachers.Count / pageSize);

    private HashSet<long> selectedIds = new();
    private Teacher? deleteTarget = null;

    private static readonly (string Bg, string Fg)[] Palette = {
        ("rgb(239,246,255)",  "#2563eb"),
        ("rgb(236,253,245)",  "#059669"),
        ("rgb(255,251,235)", "#d97706"),
        ("rgb(245,243,255)", "#7c3aed"),
        ("rgb(255,241,242)",  "#e11d48"),
        ("rgb(240,249,255)", "#0284c7"),
    };
    private (string Bg, string Fg) AvatarColor(int i) => Palette[i % Palette.Length];

    private void NavigateToTeacher(long id) => Nav.NavigateTo("/admin/teachers/edit/" + id);
    private void SetTableView() => viewMode = "table";
    private void SetGridView() => viewMode = "grid";

    private MarkupString SortIcon(string f) => new MarkupString(
        sortField == f
            ? "<span class='text-[length:0.6rem] ml-1'>" + (sortAsc ? "↑" : "↓") + "</span>"
            : "<span class='text-[length:0.6rem] ml-1 opacity-30'>↕</span>");

    private bool dataLoadAttempted;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || dataLoadAttempted) return;
        dataLoadAttempted = true;

        try
        {
            teachers = await TeacherService.GetTeachersAsync();
            ApplyFilters();
            StateHasChanged();
        }
        catch (Exception)
        {
            teachers = new();
        }
    }

    private void OnSearch(ChangeEventArgs e) { searchTerm = e.Value?.ToString() ?? ""; ApplyFilters(); }
    private void OnStatusChange(string s) { statusFilter = s; ApplyFilters(); }

    private void ApplyFilters()
    {
        if (teachers == null) return;
        var q = teachers.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchTerm))
            q = q.Where(s => (s.FirstName + " " + s.LastName + " " + s.Email + " " + s.NationalId + " " + s.Phone).Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(statusFilter)) q = q.Where(s => s.Status == statusFilter);
        if (!string.IsNullOrEmpty(filterGender)) q = q.Where(s => s.Gender == filterGender);
        
        q = sortField switch {
            "Name" => sortAsc ? q.OrderBy(s => s.LastName).ThenBy(s => s.FirstName) : q.OrderByDescending(s => s.LastName).ThenByDescending(s => s.FirstName),
            _ => q
        };
        filteredTeachers = q.ToList(); currentPage = 1; UpdatePage();
    }

    private void UpdatePage() => pagedTeachers = filteredTeachers.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    private void GoToPage(int p) { currentPage = Math.Clamp(p, 1, Math.Max(1, totalPages)); UpdatePage(); }

    private void SortBy(string field) { if (sortField == field) sortAsc = !sortAsc; else { sortField = field; sortAsc = true; } ApplyFilters(); }
    private void ToggleSelect(long id, bool val) { if (val) selectedIds.Add(id); else selectedIds.Remove(id); }
    private void ToggleSelectAll() { if (selectedIds.Count == pagedTeachers.Count) selectedIds.Clear(); else foreach (var t in pagedTeachers) selectedIds.Add(t.Id); }
    private void ConfirmDelete(Teacher t) => deleteTarget = t;

    private async Task ExecuteDelete()
    {
        if (deleteTarget != null) { await TeacherService.DeleteTeacherAsync(deleteTarget.Id); teachers?.Remove(deleteTarget); selectedIds.Remove(deleteTarget.Id); ApplyFilters(); }
        deleteTarget = null;
    }
}
