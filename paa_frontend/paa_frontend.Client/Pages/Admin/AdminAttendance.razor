    // ── Staff ──
    private async Task LoadStaffForRegister()
    {
        staffMembers.Clear();
        staffSession = null;
        staffLoadError = null;
        isLoadingStaff = true;
        StateHasChanged();

        try
        {
            var teachers = await TeacherService.GetTeachersAsync();
            if (teachers != null)
            {
                foreach (var t in teachers)
                {
                    staffMembers.Add(new StaffMember
                    {
                        Id = t.Id,
                        Name = $"{t.FirstName} {t.LastName}".Trim(),
                        Role = "Teacher",
                        Status = "Present"
                    });
                }
            }

            var bursers = await BurserService.GetBursersAsync();
            if (bursers != null)
            {
                foreach (var b in bursers)
                {
                    staffMembers.Add(new StaffMember
                    {
                        Id = b.Id,
                        Name = $"{b.FirstName} {b.LastName}".Trim(),
                        Role = "Burser",
                        Status = "Present"
                    });
                }
            }
        }
        catch (Exception)
        {
            Console.WriteLine($"[ADMIN ATTENDANCE] Error loading staff");
            staffLoadError = "Failed to load staff members. Please try again.";
        }

        // Check if session already exists
        try
        {
            var existing = await AttendanceService.GetSessionsByDateAsync(staffDate);
            var found = existing?.FirstOrDefault(s => s.Type == "Staff");
            if (found != null)
            {
                staffSession = found;
                var existingRecords = await AttendanceService.GetRecordsBySessionAsync(found.Id);
                if (existingRecords != null)
                {
                    foreach (var r in existingRecords)
                    {
                        var member = staffMembers.FirstOrDefault(s => s.Id == r.PersonId);
                        if (member != null) member.Status = r.Status;
                    }
                }
            }
        }
        catch (Exception)
        {
            Console.WriteLine($"[ADMIN ATTENDANCE] Error loading existing staff session");
        }

        isLoadingStaff = false;
        StateHasChanged();
    }

    private async Task SaveStaffRegister()
    {
        isSavingStaff = true;
        StateHasChanged();

        try
        {
            var userIdStr = await JS.InvokeAsync<string?>("sessionStorage.getItem", "primeappDemo.userId");
            long.TryParse(userIdStr, out var adminId);

            if (staffSession != null)
            {
                // Session exists - update individual records
                var existingRecords = await AttendanceService.GetRecordsBySessionAsync(staffSession.Id);
                foreach (var sm in staffMembers)
                {
                    var existing = existingRecords?.FirstOrDefault(r => r.PersonId == sm.Id);
                    if (existing != null)
                    {
                        await AttendanceService.UpdateRecordStatusAsync(existing.Id, sm.Status);
                    }
                }
            }
            else
            {
                var dto = new CreateAttendanceSessionDto
                {
                    Date = staffDate,
                    Type = "Staff",
                    ReferenceId = 0,
                    CreatedBy = adminId,
                    Records = staffMembers.Select(s => new AttendanceRecordInputDto
                    {
                        PersonId = s.Id,
                        PersonType = s.Role, // add this
                        Status = s.Status,
                        Remarks = null
                    }).ToList()
                };
                var session = await AttendanceService.CreateSessionAsync(dto);
                if (session != null)
                {
                    staffSession = session;
                }
            }
        }
        finally { isSavingStaff = false; StateHasChanged(); }
    }
