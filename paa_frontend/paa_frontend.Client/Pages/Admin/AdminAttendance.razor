    private async Task LoadClassAttendance()
    {
        classSession = null;
        classRecords = null;
        isLoadingClass = true;
        StateHasChanged();

        try
        {
            var sessions = await AttendanceService.GetSessionsByDateAsync(classDate);
            var classStudentIds = allStudents
                .Where(s => s.Form == classForm && string.Equals(s.Classroom, classroom, StringComparison.OrdinalIgnoreCase))
                .Select(s => (long)s.Id)
                .ToHashSet();

            AttendanceSessionDto? match = null;
            if (sessions != null && classStudentIds.Count > 0)
            {
                foreach (var candidate in sessions.Where(s => s.Type == "Student"))
                {
                    var records = await AttendanceService.GetRecordsBySessionAsync(candidate.Id) ?? new();
                    if (records.Any(r => classStudentIds.Contains(r.PersonId)))
                    {
                        candidate.Records = records;
                        match = candidate;
                        break;
                    }
                }
            }

            if (match != null)
            {
                classSession = match;
                classRecords = (match.Records ?? new()).Where(r => classStudentIds.Contains(r.PersonId)).ToList();
            }
            else
            {
                classRecords = new();
            }
        }
        finally { isLoadingClass = false; StateHasChanged(); }
    }

