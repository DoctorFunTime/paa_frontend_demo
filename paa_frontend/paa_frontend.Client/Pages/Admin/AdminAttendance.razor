                                        <button class="toggle-btn present @(sm.Status == "Present" ? "active" : "")" @onclick='() => { sm.Status = "Present"; StateHasChanged(); }'>Present</button>
                                        <button class="toggle-btn late @(sm.Status == "Late" ? "active" : "")" @onclick='() => { sm.Status = "Late"; StateHasChanged(); }'>Late</button>
                                        <button class="toggle-btn absent @(sm.Status == "Absent" ? "active" : "")" @onclick='() => { sm.Status = "Absent"; StateHasChanged(); }'>Absent</button>
                                        <button class="toggle-btn excused @(sm.Status == "Excused" ? "active" : "")" @onclick='() => { sm.Status = "Excused"; StateHasChanged(); }'>Excused</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private string activeTab = "overview";

    // Overview tab
    private DateOnly overviewDate = DateOnly.FromDateTime(DateTime.Now);
    private OverviewData? overviewData;
    private bool isLoadingOverview = false;

    public class OverviewData
    {
        public int SessionCount { get; set; }
        public int StudentSessionCount { get; set; }
        public int StaffSessionCount { get; set; }
        public int StudentTotal { get; set; }
        public int StudentRecorded { get; set; }
        public int StudentCompletedRegisters { get; set; }
        public int StudentPendingRegisters { get; set; }
        public int StudentPresent { get; set; }
        public int StudentLate { get; set; }
        public int StudentAbsent { get; set; }
        public int StudentExcused { get; set; }
        public int StaffTotal { get; set; }
        public int StaffPresent { get; set; }
        public int StaffLate { get; set; }
        public int StaffAbsent { get; set; }
        public int StaffExcused { get; set; }
        public List<ClassAttendanceSummary> ClassSummaries { get; set; } = new();
    }

    public class ClassAttendanceSummary
    {
        public int Form { get; set; }
        public string ClassName { get; set; } = "";
        public string ClassLabel { get; set; } = "Unassigned class";
        public int TotalStudents { get; set; }
        public int Present { get; set; }
        public int Late { get; set; }
        public int Absent { get; set; }
        public int Excused { get; set; }
        public int Unmarked => Math.Max(0, TotalStudents - Present - Late - Absent - Excused);
        public bool IsComplete => TotalStudents > 0 && Unmarked == 0;
    }

    // Lookups for name resolution
    private Dictionary<long, string> createdByNames = new();
    private Dictionary<long, string> studentNames = new();
    private List<Student> allStudents = new();
    private bool lookupsLoaded = false;

    // School tab
    private DateOnly schoolDate = DateOnly.FromDateTime(DateTime.Now);
    private List<AttendanceSessionDto>? schoolSessions;
    private bool isLoadingSchool = false;

    // Class tab
    private int classForm;
    private string classroom = "";
    private DateOnly classDate = DateOnly.FromDateTime(DateTime.Now);
    private List<AttendanceRecordDto>? classRecords;
    private AttendanceSessionDto? classSession;
    private List<string> classAvailableClasses = new();
    private bool isLoadingClassNames = false;
    private bool isLoadingClass = false;

    // Student tab
    private int studentForm;
    private string studentClassroom = "";
    private string studentSearchTerm = "";
    private long studentLookupId;
    private Student? selectedStudent;
    private DateOnly studentStartDate = DateOnly.FromDateTime(DateTime.Now.AddDays(-30));
    private DateOnly studentEndDate = DateOnly.FromDateTime(DateTime.Now);
    private List<AttendanceRecordDto>? studentRecords;
    private List<string> studentAvailableClasses = new();
    private bool isLoadingStudentClassNames = false;
    private bool isLoadingStudent = false;

    // Staff tab
    private DateOnly staffDate = DateOnly.FromDateTime(DateTime.Now);
    private AttendanceSessionDto? staffSession;
    private List<StaffMember> staffMembers = new();
    private bool isLoadingStaff = false;
    private bool isSavingStaff = false;
    private string? staffLoadError;

    public class StaffMember
    {
        public long Id { get; set; }
        public string Name { get; set; } = "";
        public string Role { get; set; } = "Teacher";
        public string Status { get; set; } = "Present";
    }

    private IEnumerable<Student> filteredStudents
    {
        get
        {
            var term = (studentSearchTerm ?? "").Trim().ToLowerInvariant();
            var pool = allStudents.AsEnumerable();
            if (studentForm > 0) pool = pool.Where(s => s.Form == studentForm);
            if (!string.IsNullOrEmpty(studentClassroom)) pool = pool.Where(s => s.Classroom == studentClassroom);
            if (!string.IsNullOrWhiteSpace(term))
                pool = pool.Where(s => (s.FirstName + " " + s.LastName).ToLowerInvariant().Contains(term));
            return pool.Take(20);
        }
    }

    private bool dataLoadAttempted;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || dataLoadAttempted) return;
        dataLoadAttempted = true;

        await LoadLookups();
        await LoadOverviewData();
        StateHasChanged();
    }

    private async Task LoadLookups()
    {
        if (lookupsLoaded) return;
        lookupsLoaded = true;

        try
        {
            var teachers = await TeacherService.GetTeachersAsync();
            if (teachers != null)
                foreach (var t in teachers)
                    createdByNames[t.Id] = $"{t.FirstName} {t.LastName}".Trim();

            var bursers = await BurserService.GetBursersAsync();
            if (bursers != null)
                foreach (var b in bursers)
                    createdByNames[b.Id] = $"{b.FirstName} {b.LastName}".Trim();

            allStudents = await StudentService.GetStudentsAsync() ?? new();
            if (allStudents != null)
                foreach (var s in allStudents)
                    studentNames[s.Id] = $"{s.FirstName} {s.LastName}".Trim();
        }
        catch (Exception)
        {
            Console.WriteLine($"[ADMIN ATTENDANCE] Lookup error");
        }
    }

    private string ResolveCreatedBy(long createdBy)
    {
        if (createdByNames.TryGetValue(createdBy, out var name)) return name;
        return $"User #{createdBy}";
    }

    private string ResolveStudentName(long personId)
    {
        if (studentNames.TryGetValue(personId, out var name)) return name;
        return $"Student #{personId}";
    }

    private string ResolveInitials(long personId)
    {
        var name = ResolveStudentName(personId);
        if (name.StartsWith("Student #")) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return string.Concat(parts.Select(p => char.ToUpper(p[0]))).Substring(0, Math.Min(2, parts.Length));
    }

    private string GetLevel(int form) => form switch
    {
        >= 1 and <= 4 => "form1to4",
        >= 5 and <= 6 => "alevel",
        _ => ""
    };

    private static string GetStudentClassKey(Student student)
        => $"{student.Form.GetValueOrDefault()}|{(student.Classroom ?? "").Trim()}";

    private static string FormatClassLabel(string key)
    {
        var parts = key.Split('|', 2);
        return $"Form {parts[0]}{(parts.Length < 2 || string.IsNullOrWhiteSpace(parts[1]) ? " · No class" : $" · {parts[1]}")}";
    }

    private async Task LoadClassNamesAsync(int form, Action<List<string>> setter, Action<bool> loadingSetter)
    {
        setter(new());
        if (form < 1 || form > 6) return;

        loadingSetter(true);
        StateHasChanged();
        try
        {
            switch (GetLevel(form))
            {
                case "form1to4":
                    var olevel = await OClassService.GetAllOlevelClassNamesAsync();
                    setter(olevel.Select(c => c.ClassName ?? "").Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c).ToList());
                    break;
                case "alevel":
                    var alevel = await AClassService.GetAllAlevelClassNamesAsync();
                    setter(alevel.Select(c => c.ClassName ?? "").Where(c => !string.IsNullOrWhiteSpace(c)).OrderBy(c => c).ToList());
                    break;
            }
        }
        catch { setter(new()); }
        finally { loadingSetter(false); StateHasChanged(); }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }

    // ── Overview ──
    private async Task LoadOverviewData()
    {
        isLoadingOverview = true;
        overviewData = null;
        StateHasChanged();
        try
        {
            var sessions = await AttendanceService.GetSessionsByDateAsync(overviewDate);
            var data = new OverviewData
            {
                StudentTotal = allStudents.Count,
            };

            var classGroups = allStudents
                .Where(s => s.Form.GetValueOrDefault() > 0)
                .GroupBy(GetStudentClassKey, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g => g.Key,
                     g => new ClassAttendanceSummary
                     {
                         Form = g.First().Form.GetValueOrDefault(),
                         ClassName = (g.First().Classroom ?? "").Trim(),
                         ClassLabel = FormatClassLabel(g.Key),
                        TotalStudents = g.Count()
                    },
                    StringComparer.OrdinalIgnoreCase);

            if (sessions != null)
            {
                data.SessionCount = sessions.Count;
                data.StudentSessionCount = sessions.Count(s => s.Type == "Student");
                data.StaffSessionCount = sessions.Count(s => s.Type == "Staff");

                foreach (var session in sessions)
                {
                    // Session list doesn't include records — fetch per session
                    var recs = await AttendanceService.GetRecordsBySessionAsync(session.Id);
                    if (recs == null) recs = new();

                    if (session.Type == "Student")
                    {
                        data.StudentRecorded += recs.Count;
                        data.StudentPresent += recs.Count(r => r.Status == "Present");
                        data.StudentLate += recs.Count(r => r.Status == "Late");
                        data.StudentAbsent += recs.Count(r => r.Status == "Absent");
                        data.StudentExcused += recs.Count(r => r.Status == "Excused");

                        foreach (var groupEntry in classGroups)
                        {
                            var group = groupEntry.Value;
                            var studentsInClass = allStudents
                                .Where(s => string.Equals(GetStudentClassKey(s), groupEntry.Key, StringComparison.OrdinalIgnoreCase))
                                .Select(s => (long)s.Id)
                                .ToHashSet();
                            var classRecords = recs.Where(r => studentsInClass.Contains(r.PersonId)).ToList();
                            if (!classRecords.Any()) continue;
                            group.Present = Math.Max(group.Present, classRecords.Count(r => r.Status == "Present"));
                            group.Late = Math.Max(group.Late, classRecords.Count(r => r.Status == "Late"));
                            group.Absent = Math.Max(group.Absent, classRecords.Count(r => r.Status == "Absent"));
                            group.Excused = Math.Max(group.Excused, classRecords.Count(r => r.Status == "Excused"));
                        }
                    }
                    else if (session.Type == "Staff")
                    {
                        data.StaffTotal += recs.Count;
                        data.StaffPresent += recs.Count(r => r.Status == "Present");
                        data.StaffLate += recs.Count(r => r.Status == "Late");
                        data.StaffAbsent += recs.Count(r => r.Status == "Absent");
                        data.StaffExcused += recs.Count(r => r.Status == "Excused");
                    }
                }
            }

            data.ClassSummaries = classGroups.Values.OrderBy(s => s.ClassLabel).ToList();
            data.StudentCompletedRegisters = data.ClassSummaries.Count(s => s.IsComplete);
            data.StudentPendingRegisters = data.ClassSummaries.Count(s => !s.IsComplete);

            overviewData = data;
        }
        catch (Exception)
        {
            Console.WriteLine($"[ADMIN ATTENDANCE] Overview error");
        }
        finally { isLoadingOverview = false; StateHasChanged(); }
    }

