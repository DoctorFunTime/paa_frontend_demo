                <div class="sum-card"><div class="sum-card-label" style="color:#f59e0b;">Late</div><div class="sum-card-val amber">@lateCount</div></div>
                <div class="sum-card"><div class="sum-card-label" style="color:#ef4444;">Absent</div><div class="sum-card-val red">@absentCount</div></div>
