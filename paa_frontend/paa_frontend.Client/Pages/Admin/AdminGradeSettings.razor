@page "/admin/grades/settings"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using paa_frontend.Client.Services.Admin
@using paa_frontend.Shared.Models
@inject AdminGradesServiceClient GradesService
@inject IJSRuntime JS

<style>
@@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');
:root {
    --blue:#1A4FFF;--blue-dim:#ebefff;--ink:#0d1117;--ink2:#4a5168;--ink3:#9097a8;
    --bg:#f2f3f7;--card:#ffffff;--green:#00b67a;--green-dim:#e2f8f0;
    --amber:#f59e0b;--amber-dim:#fef3c7;--red:#ef4444;--red-dim:#fef2f2;
    --violet:#7c3aed;--violet-dim:rgba(124,58,237,0.08);
    --border:rgba(0,0,0,0.07);--shadow:0 1px 3px rgba(0,0,0,0.06),0 4px 16px rgba(0,0,0,0.04);
    --radius:14px; font-family:'Sora',sans-serif;
}
*, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
body { background:var(--bg); }

.page-wrap { padding:28px 32px; max-width:1100px; margin:0 auto; }
.breadcrumb { display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--ink3); margin-bottom:20px; }
.breadcrumb a { color:var(--ink3); text-decoration:none; } .breadcrumb a:hover { color:var(--blue); }

.page-header { margin-bottom:28px; }
.page-title { font-size:22px; font-weight:700; color:var(--ink); letter-spacing:-0.5px; margin-bottom:4px; }
.page-sub { font-size:13px; color:var(--ink3); }

.section-card { background:var(--card); border-radius:var(--radius); border:1px solid var(--border); padding:24px; box-shadow:var(--shadow); margin-bottom:24px; }
.section-title { font-size:15px; font-weight:600; color:var(--ink); margin-bottom:4px; }
.section-sub { font-size:12px; color:var(--ink3); margin-bottom:20px; }

.tab-row { display:flex; gap:8px; margin-bottom:20px; }
.tab-btn { padding:8px 18px; border-radius:20px; border:1.5px solid var(--border); background:transparent; font-size:13px; font-weight:500; color:var(--ink3); cursor:pointer; font-family:'Sora',sans-serif; transition:all 0.15s; }
.tab-btn.active { background:var(--blue); color:white; border-color:var(--blue); }

.scale-row { display:grid; grid-template-columns:90px 140px 1fr 100px 40px; gap:10px; align-items:center; margin-bottom:8px; }
.scale-row.header { font-size:11px; font-weight:600; color:var(--ink3); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:10px; }
.form-control { width:100%; padding:9px 12px; border:1.5px solid var(--border); border-radius:10px; font-size:13px; color:var(--ink); background:var(--bg); outline:none; transition:border-color 0.15s; font-family:'Sora',sans-serif; }
.form-control:focus { border-color:var(--blue); background:var(--card); }
.form-control.mono { font-family:'JetBrains Mono',monospace; }

.btn-primary { display:inline-flex; align-items:center; gap:6px; padding:9px 18px; background:var(--blue); color:white; border:none; border-radius:10px; font-size:13px; font-weight:500; cursor:pointer; font-family:'Sora',sans-serif; transition:all 0.15s; }
.btn-primary:hover { filter:brightness(1.1); transform:translateY(-1px); }
.btn-primary:disabled { opacity:0.5; cursor:not-allowed; transform:none; }
.btn-ghost { display:inline-flex; align-items:center; gap:6px; padding:9px 16px; background:transparent; color:var(--ink2); border:1px solid var(--border); border-radius:10px; font-size:13px; cursor:pointer; font-family:'Sora',sans-serif; transition:all 0.15s; }
.btn-ghost:hover { background:var(--card); }
.btn-icon { width:32px; height:32px; border-radius:8px; border:1px solid var(--border); background:transparent; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--red); transition:all 0.12s; }
.btn-icon:hover { background:var(--red-dim); border-color:var(--red); }
.btn-add { display:inline-flex; align-items:center; gap:6px; padding:7px 14px; border-radius:9px; border:1.5px dashed var(--border); background:transparent; color:var(--ink3); font-size:12.5px; cursor:pointer; font-family:'Sora',sans-serif; transition:all 0.12s; }
.btn-add:hover { border-color:var(--blue); color:var(--blue); }

.info-box { background:var(--blue-dim); border-radius:10px; padding:12px 14px; font-size:12px; color:var(--ink2); margin-bottom:18px; }

.toast { position:fixed; bottom:24px; right:24px; padding:13px 18px; border-radius:12px; font-size:13px; font-weight:500; display:flex; align-items:center; gap:8px; box-shadow:0 8px 32px rgba(0,0,0,0.15); z-index:999; animation:slideIn 0.2s ease; }
.toast-success { background:var(--green); color:white; }
.toast-error { background:var(--red); color:white; }
@@keyframes slideIn { from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);} }

.cw-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.cw-card { background:var(--bg); border-radius:12px; padding:16px; border:1.5px solid var(--border); }
.cw-label { font-size:11px; font-weight:600; color:var(--ink3); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px; display:block; }
.cw-big { font-size:28px; font-weight:700; color:var(--ink); font-family:'JetBrains Mono',monospace; }

@@media (max-width: 768px) {
    .page-wrap { padding: 16px; }
    .cw-grid { grid-template-columns: 1fr; }
    .scale-row {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px;
        background: var(--bg);
        margin-bottom: 16px;
    }
    .scale-row.header { display: none; }
    .scale-row > *:nth-child(1) { grid-column: 1 / 2; } /* Symbol */
    .scale-row > *:nth-child(2) { grid-column: 2 / 3; } /* Min Mark */
    .scale-row > *:nth-child(3) { grid-column: 1 / -1; } /* Comments */
    .scale-row > *:nth-child(4) { grid-column: 1 / 2; } /* Points */
    .scale-row > *:nth-child(5) { grid-column: 2 / 3; justify-self: end; width: 100%; display: flex; justify-content: flex-end; } /* Delete button */
    .scale-row > span:nth-child(4) { display: none; }
}
</style>

<div class="page-wrap">

    <div class="breadcrumb">
        <a href="/admin/academics">Academics</a>
        <span>›</span>
        <span style="color:var(--ink2);">Grade Settings</span>
    </div>

    <div class="page-header">
        <div class="page-title">Grade Settings</div>
        <div class="page-sub">Configure grading scales for O-Level (Forms 1–4) and A-Level (Forms 5–6), and set the coursework weight used when generating report cards.</div>
    </div>

    <!-- ── SECTION 1: COURSEWORK WEIGHT ── -->
    <div class="section-card">
        <div class="section-title">Coursework vs. Exam Weight</div>
        <div class="section-sub">Sets the split used when calculating the final mark on all report cards. Exam weight is auto-calculated as 100% minus coursework weight.</div>

        <div class="cw-grid" style="margin-bottom:20px;">
            <div class="cw-card">
                <span class="cw-label">Coursework Weight</span>
                <div style="display:flex;align-items:center;gap:12px;">
                    <input class="form-control mono" type="number" min="0" max="100" step="5"
                           style="max-width:100px;" @bind="cwWeightPercent" />
                    <span style="font-size:20px;font-weight:700;color:var(--blue);">%</span>
                </div>
                <div style="font-size:11px;color:var(--ink3);margin-top:6px;">e.g. 30 means 30% coursework</div>
            </div>
            <div class="cw-card">
                <span class="cw-label">Exam Weight (auto)</span>
                <div class="cw-big" style="color:var(--ink2);">@(100 - cwWeightPercent)%</div>
                <div style="font-size:11px;color:var(--ink3);margin-top:6px;">Remaining percentage allocated to exams</div>
            </div>
        </div>
        <div style="font-size:12px;color:var(--ink3);background:var(--amber-dim);border-radius:8px;padding:10px 14px;margin-bottom:16px;">
            ⚠️ This value is passed to the report card generation API. Each report card can still override it per-generation if needed.
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-size:13px;color:var(--ink2);">Default coursework weight:</span>
            <strong style="font-family:'JetBrains Mono',monospace;color:var(--blue);">@(cwWeightPercent / 100.0):@((100 - cwWeightPercent) / 100.0)</strong>
            <button class="btn-primary" style="margin-left:auto;" @onclick="SaveCourseworkWeight">Save Weight</button>
        </div>
    </div>

    <!-- ── SECTION 2: GRADING SCALE ── -->
    <div class="section-card">
        <div class="section-title">Grading Scale</div>
        <div class="section-sub">Define the grade symbols and minimum mark required for each grade. Changes apply to all future report card generations.</div>

        <div class="info-box">
            Scales are saved per level. Select the level tab, adjust the ranges, then click <strong>Save Scale</strong>. The system falls back to built-in defaults if no custom scale is saved.
        </div>

        <div class="tab-row">
            <button class="tab-btn @(activeLevel == "O-Level" ? "active" : "")" @onclick='() => SwitchLevel("O-Level")'>O-Level (Forms 1–4)</button>
            <button class="tab-btn @(activeLevel == "A-Level" ? "active" : "")" @onclick='() => SwitchLevel("A-Level")'>A-Level (Forms 5–6)</button>
        </div>

        @if (isLoading)
        {
            <AdminLoadingSkeleton />
        }
        else
        {
            <!-- Column headers -->
            <div class="scale-row header">
                <span>Symbol</span>
                <span>Min Mark (%)</span>
                <span>Comments / Descriptor</span>
                <span>Points (A-Level)</span>
                <span></span>
            </div>

            @foreach (var row in scaleRows)
            {
                var r = row;
                <div class="scale-row">
                    <input class="form-control mono" type="text" maxlength="5" placeholder="A*" @bind="r.GradeLabel" />
                    <input class="form-control mono" type="number" min="0" max="100" step="1" placeholder="80" @bind="r.MinMark" />
                    <input class="form-control" type="text" placeholder="e.g. Distinction" @bind="r.Comments" />
                    @if (activeLevel == "A-Level")
                    {
                        <input class="form-control mono" type="number" min="0" max="10" step="1" placeholder="e.g. 5" @bind="r.Points" />
                    }
                    else
                    {
                        <span></span>
                    }
                    <button class="btn-icon" @onclick="() => scaleRows.Remove(r)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
            }

            <div style="margin-top:10px;margin-bottom:20px;">
                <button class="btn-add" @onclick="AddRow">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Add Grade Band
                </button>
            </div>

            <div style="display:flex;gap:8px;">
                <button class="btn-ghost" @onclick="LoadScaleForLevel">↺ Reload from Server</button>
                <button class="btn-primary" @onclick="SaveScale" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                    }
                    @(isSaving ? "Saving…" : "Save " + activeLevel + " Scale")
                </button>
            </div>
        }
    </div>

</div>

@if (!string.IsNullOrEmpty(toastMsg))
{
    <div class="toast @(toastIsError ? "toast-error" : "toast-success")">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        @toastMsg
    </div>
}

@code {
    private string activeLevel = "O-Level";
    private bool isLoading = false;
    private bool isSaving = false;
    private int cwWeightPercent = 30;   // default 30% coursework
    private string toastMsg = "";
    private bool toastIsError = false;
    private System.Threading.CancellationTokenSource? _cts;

    private class ScaleRow
    {
        public string GradeLabel { get; set; } = "";
        public double MinMark    { get; set; }
        public string Comments   { get; set; } = "";
        public int? Points       { get; set; }
    }
    private List<ScaleRow> scaleRows = new();

    private const string CourseworkWeightStorageKey = "paa.admin.courseworkWeightPercent";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", CourseworkWeightStorageKey);
            if (int.TryParse(stored, out var savedWeight))
                cwWeightPercent = Math.Clamp(savedWeight, 0, 100);
        }
        catch { }

        await LoadScaleForLevel();
    }

    private async Task SaveCourseworkWeight()
    {
        cwWeightPercent = Math.Clamp(cwWeightPercent, 0, 100);
        await JS.InvokeVoidAsync("localStorage.setItem", CourseworkWeightStorageKey, cwWeightPercent.ToString());
        Toast($"✓ Coursework/exam split saved: {cwWeightPercent}% / {100 - cwWeightPercent}%");
    }

    private async Task SwitchLevel(string level)
    {
        activeLevel = level;
        await LoadScaleForLevel();
    }

    private async Task LoadScaleForLevel()
    {
        isLoading = true;
        scaleRows.Clear();
        try
        {
            var data = await GradesService.GetGradingScaleByLevelAsync(activeLevel);
            if (data != null && data.Any())
            {
                scaleRows = data.OrderByDescending(d => d.MinMark)
                    .Select(d => new ScaleRow
                    {
                        GradeLabel = d.GradeLabel ?? "",
                        MinMark    = d.MinMark,
                        Comments   = d.Comments ?? "",
                        Points     = d.Points
                    }).ToList();
            }
            else
            {
                // seed with defaults
                scaleRows = activeLevel == "O-Level"
                    ? new() {
                        new() { GradeLabel = "A*", MinMark = 90, Comments = "Distinction" },
                        new() { GradeLabel = "A",  MinMark = 80, Comments = "Excellent" },
                        new() { GradeLabel = "B",  MinMark = 70, Comments = "Very Good" },
                        new() { GradeLabel = "C",  MinMark = 60, Comments = "Credit" },
                        new() { GradeLabel = "D",  MinMark = 50, Comments = "Pass" },
                        new() { GradeLabel = "E",  MinMark = 40, Comments = "Weak Pass" },
                        new() { GradeLabel = "U",  MinMark =  0, Comments = "Fail" },
                      }
                    : new() {
                        new() { GradeLabel = "A",  MinMark = 80, Comments = "Distinction", Points = 5 },
                        new() { GradeLabel = "B",  MinMark = 70, Comments = "Merit", Points = 4 },
                        new() { GradeLabel = "C",  MinMark = 60, Comments = "Credit", Points = 3 },
                        new() { GradeLabel = "D",  MinMark = 50, Comments = "Pass", Points = 2 },
                        new() { GradeLabel = "E",  MinMark = 40, Comments = "Subsidiary", Points = 1 },
                        new() { GradeLabel = "U",  MinMark =  0, Comments = "Fail", Points = 0 },
                      };
            }
        }
        catch { Toast("Could not load grading scale", true); }
        finally { isLoading = false; }
    }

    private void AddRow() =>
        scaleRows.Add(new ScaleRow { GradeLabel = "", MinMark = 0, Comments = "" });

    private async Task SaveScale()
    {
        isSaving = true;
        try
        {
            var dtos = scaleRows
                .Where(r => !string.IsNullOrWhiteSpace(r.GradeLabel))
                .Select(r => new GradingScaleDTO
                {
                    LevelType  = activeLevel,
                    GradeLabel = r.GradeLabel,
                    MinMark    = r.MinMark,
                    Comments   = r.Comments,
                    Points     = r.Points
                }).ToList();

            var result = await GradesService.SaveGradingScaleAsync(activeLevel, dtos);
            if (result != null)
                Toast($"✓ {activeLevel} scale saved ({result.Count} bands)");
            else
                Toast("Save failed — check backend", true);
        }
        catch { Toast("Network error", true); }
        finally { isSaving = false; }
    }

    private async void Toast(string msg, bool error = false)
    {
        _cts?.Cancel();
        toastMsg = msg;
        toastIsError = error;
        StateHasChanged();
        _cts = new();
        try { await Task.Delay(3500, _cts.Token); toastMsg = ""; StateHasChanged(); }
        catch (TaskCanceledException) { }
    }
}
