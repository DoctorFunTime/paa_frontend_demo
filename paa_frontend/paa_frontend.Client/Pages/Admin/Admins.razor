@page "/admin/admins"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using paa_frontend.Client.Services
@using paa_frontend.Client.Services.Admin
@using Microsoft.JSInterop
@using AdminProfileRecord = paa_frontend.Shared.Models.AdminProfileModel.Admin
@inject AdminProfileServiceClient AdminService
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2 text-sm text-slate-500 font-medium mb-1">
            <a href="/admin" class="hover:text-indigo-600 transition-colors">Dashboard</a>
            <span class="text-slate-300">&rsaquo;</span>
            <span class="text-slate-800 font-bold">Administrators</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mb-1">Administrator Accounts</h1>
        <p class="text-sm font-medium text-slate-500">Create and manage admin logins from one place.</p>
    </div>
    <div class="flex w-full md:w-auto flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <button class="px-4 py-2 bg-white/70 hover:bg-white backdrop-blur-sm border border-slate-200/70 rounded-full text-xs font-semibold text-slate-600 transition-colors shadow-sm flex items-center justify-center gap-2" @onclick="ReloadAdmins">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
            Refresh
        </button>
        <a href="/admin/admins/add" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full text-xs font-bold transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Admin
        </a>
    </div>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
    <div class="rounded-2xl p-4 sm:p-5 border border-indigo-100 bg-gradient-to-br from-indigo-50 to-white">
        <div class="text-[0.65rem] font-bold text-indigo-400 uppercase tracking-widest mb-2">Total</div>
        <div class="text-3xl font-black text-indigo-700 tracking-tight">@admins.Count</div>
        <div class="text-xs text-slate-500 mt-1.5">visible accounts</div>
    </div>
    <div class="rounded-2xl p-4 sm:p-5 border border-emerald-100 bg-gradient-to-br from-emerald-50 to-white">
        <div class="text-[0.65rem] font-bold text-emerald-500 uppercase tracking-widest mb-2">Active</div>
        <div class="text-3xl font-black text-emerald-600 tracking-tight">@admins.Count(a => a.Status == "Active")</div>
        <div class="text-xs text-slate-500 mt-1.5">enabled accounts</div>
    </div>
    <div class="rounded-2xl p-4 sm:p-5 border border-slate-200 bg-gradient-to-br from-slate-50 to-white">
        <div class="text-[0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-2">Inactive</div>
        <div class="text-3xl font-black text-slate-600 tracking-tight">@admins.Count(a => a.Status != "Active")</div>
        <div class="text-xs text-slate-500 mt-1.5">disabled / suspended</div>
    </div>
    <div class="rounded-2xl p-4 sm:p-5 border border-amber-100 bg-gradient-to-br from-amber-50 to-white">
        <div class="text-[0.65rem] font-bold text-amber-500 uppercase tracking-widest mb-2">Matches</div>
        <div class="text-3xl font-black text-amber-600 tracking-tight">@VisibleAdmins.Count</div>
        <div class="text-xs text-slate-500 mt-1.5">current search/filter</div>
    </div>
</div>

<div class="flex flex-col xl:flex-row xl:items-center gap-4 mb-4">
    <div class="relative w-full xl:flex-1 xl:max-w-md">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
        </span>
        <input class="w-full py-2.5 pl-10 pr-4 bg-white/70 border border-slate-200 rounded-full text-sm font-medium focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400" type="text" placeholder="Search by name, email, or national ID..." @bind="searchTerm" @bind:event="oninput" />
    </div>

    <div class="flex items-center gap-2 overflow-x-auto pb-2 xl:pb-0 hide-scrollbar">
        <div class="flex bg-white/60 p-1 border border-slate-200 rounded-full shadow-sm shrink-0">
            <button class="px-4 py-1.5 rounded-full text-xs font-bold transition-colors @(string.IsNullOrEmpty(statusFilter) ? "bg-slate-900 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")" @onclick="() => SetStatusFilter(string.Empty)">All</button>
            <button class="px-4 py-1.5 rounded-full text-xs font-bold transition-colors @(statusFilter == "Active" ? "bg-emerald-500 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")" @onclick='() => SetStatusFilter("Active")'>Active</button>
            <button class="px-4 py-1.5 rounded-full text-xs font-bold transition-colors @(statusFilter == "Inactive" ? "bg-slate-500 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")" @onclick='() => SetStatusFilter("Inactive")'>Inactive</button>
            <button class="px-4 py-1.5 rounded-full text-xs font-bold transition-colors @(statusFilter == "Suspended" ? "bg-rose-500 text-white shadow-sm" : "text-slate-500 hover:text-slate-800")" @onclick='() => SetStatusFilter("Suspended")'>Suspended</button>
        </div>
    </div>
</div>

<div class="bg-white/70 backdrop-blur-sm border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-8">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[920px]">
            <thead class="bg-slate-50/80 border-b border-slate-200 text-[length:0.65rem] font-bold text-slate-400 uppercase tracking-widest">
                <tr>
                    <th class="py-3 px-4">Name</th>
                    <th class="py-3 px-4">Contact</th>
                    <th class="py-3 px-4">National ID</th>
                    <th class="py-3 px-4">Gender</th>
                    <th class="py-3 px-4">Status</th>
                    <th class="py-3 px-4 w-36 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="text-sm font-medium text-slate-700 divide-y divide-slate-100">
                @if (isLoading)
                {
                    @for (var i = 0; i < 6; i++)
                    {
                        <tr class="animate-pulse">
                            <td class="py-4 px-4"><div class="w-36 h-4 bg-slate-200 rounded"></div></td>
                            <td class="py-4 px-4"><div class="w-48 h-4 bg-slate-200 rounded"></div></td>
                            <td class="py-4 px-4"><div class="w-28 h-4 bg-slate-200 rounded"></div></td>
                            <td class="py-4 px-4"><div class="w-16 h-4 bg-slate-200 rounded"></div></td>
                            <td class="py-4 px-4"><div class="w-20 h-6 bg-slate-200 rounded-full"></div></td>
                            <td class="py-4 px-4 text-right"><div class="w-24 h-8 bg-slate-200 rounded-lg ml-auto"></div></td>
                        </tr>
                    }
                }
                else if (!VisibleAdmins.Any())
                {
                    <tr>
                        <td colspan="6" class="py-16 text-center">
                            <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-400">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
                            </div>
                            <div class="text-sm font-bold text-slate-800 mb-1">No administrators found</div>
                            <p class="text-xs text-slate-500 font-medium">Try a different search or add a new account.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var admin in VisibleAdmins)
                    {
                        bool isCurrentAdmin = CurrentAdminId.HasValue && admin.Id == CurrentAdminId.Value;
                        <tr class="hover:bg-indigo-50/50 transition-colors">
                            <td class="py-4 px-4 align-top">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 to-slate-800 flex items-center justify-center text-white text-sm font-black shrink-0">@GetInitials(admin.FirstName, admin.LastName)</div>
                                    <div>
                                        <div class="font-bold text-slate-900">@admin.FirstName @admin.LastName</div>
                                        <div class="text-[0.7rem] font-mono text-slate-400">#@admin.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-4 px-4 align-top">
                                <div class="text-xs text-slate-600">@(!string.IsNullOrWhiteSpace(admin.Email) ? admin.Email : "No email")</div>
                                <div class="text-xs text-slate-400 mt-1">@(!string.IsNullOrWhiteSpace(admin.Phone) ? admin.Phone : "No phone")</div>
                            </td>
                            <td class="py-4 px-4 align-top font-mono text-xs font-bold text-slate-600">@(!string.IsNullOrWhiteSpace(admin.NationalId) ? admin.NationalId : "—")</td>
                            <td class="py-4 px-4 align-top text-xs font-bold text-slate-600">@(!string.IsNullOrWhiteSpace(admin.Gender) ? admin.Gender : "—")</td>
                            <td class="py-4 px-4 align-top">
                                @if (admin.Status == "Active")
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[0.65rem] font-extrabold bg-emerald-100 text-emerald-700">Active</span>
                                }
                                else if (admin.Status == "Suspended")
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[0.65rem] font-extrabold bg-rose-100 text-rose-700">Suspended</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[0.65rem] font-extrabold bg-slate-100 text-slate-600">@(!string.IsNullOrWhiteSpace(admin.Status) ? admin.Status : "Inactive")</span>
                                }
                            </td>
                            <td class="py-4 px-4 align-top">
                                <div class="flex items-center justify-end gap-2">
                                    <button class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50 transition-colors" @onclick="() => GoToEditAdmin(admin.Id)">Edit</button>
                                    <button class="px-3 py-1.5 rounded-lg border border-rose-200 bg-white text-xs font-bold text-rose-600 hover:bg-rose-50 transition-colors disabled:opacity-40" disabled="@isCurrentAdmin" @onclick="() => DeleteAdminAsync(admin)">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<AdminProfileRecord> admins = new();
    private string searchTerm = string.Empty;
    private string statusFilter = string.Empty;
    private bool isLoading = true;
    private long? CurrentAdminId;
    private bool currentAdminLoaded;

    private List<AdminProfileRecord> VisibleAdmins => admins
        .Where(admin =>
        {
            if (!string.IsNullOrWhiteSpace(statusFilter) && !string.Equals(admin.Status, statusFilter, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            if (string.IsNullOrWhiteSpace(searchTerm))
            {
                return true;
            }

            var needle = searchTerm.Trim().ToLowerInvariant();
            return
                (admin.FirstName ?? string.Empty).ToLowerInvariant().Contains(needle) ||
                (admin.LastName ?? string.Empty).ToLowerInvariant().Contains(needle) ||
                (admin.Email ?? string.Empty).ToLowerInvariant().Contains(needle) ||
                (admin.Phone ?? string.Empty).ToLowerInvariant().Contains(needle) ||
                (admin.NationalId ?? string.Empty).ToLowerInvariant().Contains(needle);
        })
        .OrderBy(a => a.FirstName)
        .ThenBy(a => a.LastName)
        .ToList();

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || currentAdminLoaded)
        {
            return;
        }

        currentAdminLoaded = true;
        await Task.WhenAll(LoadCurrentAdminAsync(), LoadAdminsAsync());
        StateHasChanged();
    }

    private async Task LoadAdminsAsync()
    {
        isLoading = true;
        try
        {
            admins = await AdminService.GetAdminsAsync();
        }
        catch
        {
            admins = new();
            NotificationService.ShowError("Failed to load administrator accounts.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCurrentAdminAsync()
    {
        try
        {
            var userIdValue = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", "primeappDemo.userId");
            if (long.TryParse(userIdValue, out var userId) && userId > 0)
            {
                CurrentAdminId = userId;
            }
        }
        catch
        {
        }
    }

    private async Task ReloadAdmins()
    {
        await LoadAdminsAsync();
        StateHasChanged();
    }

    private void GoToEditAdmin(long id) => Nav.NavigateTo($"/admin/admins/edit/{id}");

    private void SetStatusFilter(string value)
    {
        statusFilter = value;
    }

    private async Task DeleteAdminAsync(AdminProfileRecord admin)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete administrator '{admin.FirstName} {admin.LastName}'?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            var response = await AdminService.DeleteAdminAsync(admin.Id);
            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowSuccess("Administrator deleted successfully.");
                admins.RemoveAll(a => a.Id == admin.Id);
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.ShowError(string.IsNullOrWhiteSpace(error) ? "Failed to delete administrator." : error);
            }
        }
        catch (Exception)
        {
            NotificationService.ShowError($"Failed to delete administrator");
        }
    }

    private static string GetInitials(string? firstName, string? lastName)
    {
        var firstInitial = string.IsNullOrWhiteSpace(firstName) ? string.Empty : firstName.Trim()[0].ToString().ToUpperInvariant();
        var lastInitial = string.IsNullOrWhiteSpace(lastName) ? string.Empty : lastName.Trim()[0].ToString().ToUpperInvariant();
        var initials = $"{firstInitial}{lastInitial}";
        return string.IsNullOrWhiteSpace(initials) ? "AD" : initials;
    }
}
