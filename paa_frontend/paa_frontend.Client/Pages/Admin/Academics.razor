@page "/admin/academics"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout

<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
        <div class="flex items-center gap-2 text-sm text-slate-500 font-medium mb-1">
            <a href="/admin" class="hover:text-blue-600 transition-colors">Dashboard</a>
            <span class="text-slate-300">&rsaquo;</span>
            <span class="text-slate-800 font-bold">Academics</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mb-1">Academics</h1>
        <p class="text-sm font-medium text-slate-500">Select an academic level to manage classes, subjects, fields, and grades.</p>
    </div>
</div>

<a href="/admin/academics/timetable" class="group mb-10 flex items-center gap-5 rounded-3xl border border-emerald-200 bg-emerald-50/70 p-6 transition-all hover:-translate-y-1 hover:bg-emerald-100 hover:shadow-xl"><div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-emerald-600 text-white">▦</div><div class="min-w-0 flex-1"><h2 class="text-xl font-extrabold text-emerald-950">Timetable management</h2><p class="mt-1 text-sm font-medium text-emerald-800">Generate drafts, review schedules, and make controlled manual adjustments.</p></div><span class="hidden text-sm font-bold text-emerald-700 sm:block">Open management &rarr;</span></a>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- A-Level -->
    <a href="/admin/academics/alevel" class="group bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-7 hover:-translate-y-1 hover:shadow-xl transition-all flex flex-col">
        <div class="w-14 h-14 rounded-2xl bg-violet-100 text-violet-600 flex items-center justify-center mb-5 group-hover:bg-violet-600 group-hover:text-white transition-colors">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        </div>
        <div class="mb-1">
            <span class="px-2.5 py-1 rounded-full bg-violet-50 text-violet-600 text-xs font-bold">Form 5 &amp; 6</span>
        </div>
        <h3 class="text-xl font-extrabold text-slate-900 group-hover:text-violet-700 transition-colors mt-3 mb-2">A-Level</h3>
        <p class="text-sm font-medium text-slate-500 flex-1 mb-6">Manage Upper 6 &amp; Lower 6 classes, subjects catalogue, and student subject assignments.</p>
        <div class="flex items-center text-sm font-bold text-violet-600 gap-1">
            Open <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition-transform"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
    </a>

    <!-- O-Level -->
    <a href="/admin/academics/olevel" class="group bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-7 hover:-translate-y-1 hover:shadow-xl transition-all flex flex-col">
        <div class="w-14 h-14 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center mb-5 group-hover:bg-blue-600 group-hover:text-white transition-colors">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
        <div class="mb-1">
            <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-600 text-xs font-bold">Form 1–4</span>
        </div>
        <h3 class="text-xl font-extrabold text-slate-900 group-hover:text-blue-700 transition-colors mt-3 mb-2">O-Level</h3>
        <p class="text-sm font-medium text-slate-500 flex-1 mb-6">Manage O-Level classes and choose the subjects offered to each class. You can then customise subjects for individual students.</p>
        <div class="flex items-center text-sm font-bold text-blue-600 gap-1">
            Open <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition-transform"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
    </a>

</div>

<!-- Grades Management Section -->
<div class="mt-10">
    <div class="flex items-center gap-3 mb-5">
        <div class="w-8 h-8 rounded-lg bg-slate-900 text-white flex items-center justify-center">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <h2 class="text-lg font-extrabold text-slate-900">Grades Management</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Marks Approval -->
        <a href="/admin/grades/approval" class="group bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-6 hover:-translate-y-1 hover:shadow-xl transition-all flex flex-col">
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-4 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-indigo-700 transition-colors mb-2">Marks Approval</h3>
            <p class="text-xs font-medium text-slate-500 flex-1 mb-4">Review pending report cards submitted by teachers. Approve or reject marks before release to students.</p>
            <div class="flex items-center text-xs font-bold text-indigo-600 gap-1">
                Open <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition-transform"><polyline points="9 18 15 12 9 6"/></svg>
            </div>
        </a>

        <!-- Teacher Analytics -->
        <a href="/admin/grades/teacher-analytics" class="group bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-6 hover:-translate-y-1 hover:shadow-xl transition-all flex flex-col">
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mb-4 group-hover:bg-amber-600 group-hover:text-white transition-colors">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-amber-700 transition-colors mb-2">Teacher Analytics</h3>
            <p class="text-xs font-medium text-slate-500 flex-1 mb-4">Track assessment submissions by teacher and view breakdowns of mark distributions per staff member.</p>
            <div class="flex items-center text-xs font-bold text-amber-600 gap-1">
                Open <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition-transform"><polyline points="9 18 15 12 9 6"/></svg>
            </div>
        </a>

        <!-- Grade Settings -->
        <a href="/admin/grades/settings" class="group bg-white/70 backdrop-blur-sm border border-slate-200 rounded-3xl p-6 hover:-translate-y-1 hover:shadow-xl transition-all flex flex-col">
            <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-700 flex items-center justify-center mb-4 group-hover:bg-slate-800 group-hover:text-white transition-colors">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M4.93 4.93l1.41 1.41M19.07 19.07l-1.41-1.41M4.93 19.07l1.41-1.41M21 12h-2M5 12H3M12 21v-2M12 5V3"/></svg>
            </div>
            <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-slate-700 transition-colors mb-2">Grade Settings</h3>
            <p class="text-xs font-medium text-slate-500 flex-1 mb-4">Configure O-Level/A-Level grading scales and define coursework vs. exam weight splits for the system.</p>
            <div class="flex items-center text-xs font-bold text-slate-700 gap-1">
                Open <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition-transform"><polyline points="9 18 15 12 9 6"/></svg>
            </div>
        </a>
    </div>
</div>
