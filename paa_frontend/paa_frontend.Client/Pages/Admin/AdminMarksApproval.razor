    private async Task GenerateAsync(bool forceRegenerate = false)
    {
        if (string.IsNullOrWhiteSpace(genLevel))
            return;

        isGenerating = true;
        statusMsg = "";
        statusError = false;
        StateHasChanged();

        try
        {
            var cwWeight = genCwWeight / 100.0;

            if (genStudentId > 0)
            {
                var student = eligibleStudents.FirstOrDefault(s => s.Id == genStudentId);
                var field = student != null ? await ResolveFieldForStudentAsync(student) : "default";
                if (string.IsNullOrWhiteSpace(field)) field = "default";

                if (student != null)
                    await EnsureAutomaticSubjectCommentsAsync(student, field, forceRegenerate);

                if (forceRegenerate)
                {
                    try
                    {
                        var existingCard = generationRoster.FirstOrDefault(r => r.Student.Id == genStudentId)?.ExistingCard;
                        if (existingCard?.Id.HasValue == true && existingCard.Id.Value > 0)
                        {
                            var deleted = await AdminGradesService.DeleteReportCardAsync(existingCard.Id.Value);
                            if (!deleted)
                                deleted = await AdminGradesService.DeleteReportCardByStudentTermAndYearAsync(genStudentId, genTerm, genYear);
                            if (!deleted)
                                throw new InvalidOperationException("The existing report card could not be removed.");
                        }
                        else if (!await AdminGradesService.DeleteReportCardByStudentTermAndYearAsync(genStudentId, genTerm, genYear))
                            throw new InvalidOperationException("The existing report card could not be removed.");
                    }
                    catch (Exception delEx)
                    {
                        Console.WriteLine($"[REGEN] Pre-delete existing card before regen: {delEx.Message}");
                    }
                }

                var req = new ReportCardRequest
                {
                    StudentId = genStudentId,
                    Term = genTerm,
                    TermYear = genYear,
                    CourseworkWeight = cwWeight
                };
                var result = await AdminGradesService.GenerateReportCardAsync(req, field);
                if (result != null)
                {
                    statusMsg = $"Report card successfully generated for {GetStudentName(genStudentId)}.";
                }
                else
                {
                    statusMsg = "Report card generation failed.";
                    statusError = true;
                }
            }
            else
            {
                var readyRows = generationRoster
                    .Where(r => r.Status == GenerationStatus.Ready)
                    .ToList();

                if (!readyRows.Any())
                {
                    statusMsg = "No ready students in the queue to generate.";
                    statusError = true;
                }
                else
                {
                    var commentTasks = readyRows.Select(async row =>
                    {
                        var field = await ResolveFieldForStudentAsync(row.Student);
                        await EnsureAutomaticSubjectCommentsAsync(row.Student, field);
                    });
                    await Task.WhenAll(commentTasks);

                    (int saved, int errors) = await AdminGradesService.BulkGenerateReportCardsAsync(
                        readyRows.Select(r => (long)r.Student.Id).ToList(),
                        genTerm,
                        genYear,
                        cwWeight,
                        genLevel == "olevel" && !string.IsNullOrWhiteSpace(genField) ? genField : "default"
                    );

                    if (errors > 0)
                    {
                        statusMsg = $"Bulk generation complete: {saved} generated, {errors} failed.";
                        statusError = true;
                    }
                    else
                    {
                        statusMsg = $"Bulk generation complete: {saved} report cards generated successfully.";
                    }
                }
            }

            await BuildGenerationRosterAsync();
        }
        catch (Exception ex)
        {
            statusMsg = $"Error: {ex.Message}";
            statusError = true;
        }
        finally
        {
            isGenerating = false;
            genStudentId = 0;
            StateHasChanged();
        }
    }

    private async Task EnsureAutomaticSubjectCommentsAsync(Student student, string field, bool forceRegenerate = false)
    {
        var expectedSubjects = await GetExpectedSubjectsAsync(student, field);
        var termNumber = ParseTermNumber(genTerm);

        // Fields are optional — union results across every plausible field
        // variant rather than gating on one value (mirrors GetMarkCoverageAsync).
        var fieldCandidates = new List<string> { "default", "" };
        if (!string.IsNullOrWhiteSpace(field))
            fieldCandidates.Add(field);
        fieldCandidates = fieldCandidates.Distinct(StringComparer.OrdinalIgnoreCase).ToList();

        // Per-candidate try/catch, same reasoning as GetMarkCoverageAsync: a
        // failing field-specific call must not take the "default"/"" results
        // down with it (previously this had no per-task isolation at all, so a
        // single faulted task would throw out of Task.WhenAll and abort report
        // generation for the whole student).
        var cwTasks = fieldCandidates.Select(async f =>
        {
            try { return await AdminGradesService.GetCourseworkMarksAsync(student.Id, termNumber, genYear, f); }
            catch { return null; }
        });
        var examTasks = fieldCandidates.Select(async f =>
        {
            try { return await AdminGradesService.GetExamMarksAsync(student.Id, termNumber, genYear, f); }
            catch { return null; }
        });

        var cwResults = await Task.WhenAll(cwTasks);
        var examResults = await Task.WhenAll(examTasks);

        var coursework = new Dictionary<string, List<MarkEntry>>(StringComparer.OrdinalIgnoreCase);
        void MergeCw(CourseworkMarksResponse? resp)
        {
            if (resp?.CourseMarks == null) return;
            foreach (var kvp in resp.CourseMarks)
            {
                if (!coursework.ContainsKey(kvp.Key))
                    coursework[kvp.Key] = kvp.Value ?? new();
                else if (kvp.Value != null)
                    coursework[kvp.Key].AddRange(kvp.Value);
            }
        }
        foreach (var r in cwResults) MergeCw(r);

        var exams = new Dictionary<string, List<ExamMarkDTO>>(StringComparer.OrdinalIgnoreCase);
        void MergeExam(ExamMarksResponse? resp)
        {
            if (resp?.MarksBySubject == null) return;
            foreach (var kvp in resp.MarksBySubject)
            {
                if (!exams.ContainsKey(kvp.Key))
                    exams[kvp.Key] = kvp.Value ?? new();
                else if (kvp.Value != null)
                    exams[kvp.Key].AddRange(kvp.Value);
            }
        }
        foreach (var r in examResults) MergeExam(r);

        var subjectsToComment = new List<string>(expectedSubjects);
        foreach (var k in coursework.Keys)
        {
            if (!subjectsToComment.Any(s => SubjectMatches(s, k)))
                subjectsToComment.Add(k);
        }
        foreach (var k in exams.Keys)
        {
            if (!subjectsToComment.Any(s => SubjectMatches(s, k)))
                subjectsToComment.Add(k);
        }

        // nonce shifts the comment pool index on each forced regen so the same
        // student/subject/mark combination always produces a *different* comment.
        // On normal generation the nonce stays 0 (deterministic first pick).
        int regenNonce = forceRegenerate
            ? Random.Shared.Next(1, 1000000)
            : 0;

        if (subjectsToComment.Count == 0) return;

        var commentsToSave = new List<SubjectCommentDTO>();

        foreach (var subject in subjectsToComment.Where(s => !string.IsNullOrWhiteSpace(s)))
        {
            var existing = await AssessmentService.GetSubjectCommentsAsync(
                subject, student.Classroom ?? string.Empty, genTerm, genYear);

            // When NOT regenerating: skip subjects that already have any comment.
            // When regenerating: skip only subjects that have a TEACHER-written comment
            //   (TeacherId != null), so real feedback is preserved.
            //   Auto-generated comments (TeacherId == null) will be overwritten.
            SubjectCommentDTO? existingAutoComment = null;
            if (existing?.Any() == true)
            {
                var teacherWritten = existing.FirstOrDefault(c =>
                    c.StudentId == student.Id &&
                    !string.IsNullOrWhiteSpace(c.Comments) &&
                    c.TeacherId != null);

                if (teacherWritten != null)
                    continue; // Always preserve real teacher feedback

                if (!forceRegenerate)
                {
                    // Normal generation: skip if any comment exists
                    if (existing.Any(c => c.StudentId == student.Id && !string.IsNullOrWhiteSpace(c.Comments)))
                        continue;
                }
                else
                {
                    // Regeneration: track existing auto-comment so we can carry its Id for upsert
                    existingAutoComment = existing.FirstOrDefault(c =>
                        c.StudentId == student.Id && c.TeacherId == null);
                }
            }

            var cwPair = coursework.FirstOrDefault(kv => SubjectMatches(kv.Key, subject));
            var cwEntries = cwPair.Value;

            var examPair = exams.FirstOrDefault(kv => SubjectMatches(kv.Key, subject));
            var examEntries = examPair.Value;

            var hasCw = cwEntries != null && cwEntries.Any(e => e != null);
            var hasExam = examEntries != null && examEntries.Any(e => e != null);

            var courseworkMark = hasCw ? cwEntries!.Where(e => e != null).Select(e => e.PercentageScore).DefaultIfEmpty(0).Average() : 0;
            var examMark = hasExam ? examEntries!.Where(e => e != null).Select(e => e.Score ?? 0).DefaultIfEmpty(0).Average() : 0;
            var courseworkWeight = genCwWeight / 100.0;

            double finalMark;
            if (hasCw && hasExam && courseworkMark > 0 && examMark > 0)
            {
                finalMark = (courseworkMark * courseworkWeight) + (examMark * (1 - courseworkWeight));
            }
            else if (hasExam && examMark > 0)
            {
                finalMark = examMark;
            }
            else if (hasCw && courseworkMark > 0)
            {
                finalMark = courseworkMark;
            }
            else
            {
                finalMark = Math.Max(courseworkMark, examMark);
            }

            var teacherFeedback = cwEntries?.Select(e => e.Feedback)
                .FirstOrDefault(f => !string.IsNullOrWhiteSpace(f));

            commentsToSave.Add(new SubjectCommentDTO
            {
                Id = existingAutoComment?.Id,   // carry Id on regen → upsert, not duplicate insert
                StudentId = student.Id,
                SubjectName = subject,
                ClassName = student.Classroom ?? string.Empty,
                Term = genTerm,
                TermYear = genYear,
                Comments = BuildAutomaticSubjectComment(subject, finalMark, courseworkMark, examMark, student.Id, teacherFeedback, regenNonce),
                TeacherId = null
            });
        }

        if (commentsToSave.Any())
            await AssessmentService.SaveSubjectCommentsAsync(commentsToSave);
    }

