@page "/admin/grades/approval"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using paa_frontend.Client.Services
@using paa_frontend.Client.Services.Admin
@using paa_frontend.Client.Services.StaffPortal
@using paa_frontend.Shared.Models
@using static paa_frontend.Shared.Models.StudentProfileModel
@inject AdminGradesServiceClient AdminGradesService
@inject StudentProfileServiceClient StudentProfileService
@inject StudentSubjectServiceClient SubjectService
@inject OlevelClassServiceClient OlevelClassService
@inject TeacherProfileServiceClient TeacherService
@inject AssessmentServiceClient AssessmentService
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (isLoadingCards || isLoadingSubmissions)
{
    <AdminLoadingSkeleton />
}

<style>
    .hub-nav-link {
        padding: 0.75rem 1.25rem;
        font-weight: 700;
        font-size: 0.875rem;
        color: #64748b;
        border-bottom: 2px solid transparent;
        transition: all 0.15s ease-in-out;
        text-decoration: none;
    }

        .hub-nav-link.active {
            color: #4f46e5;
            border-bottom-color: #4f46e5;
        }

        .hub-nav-link:hover {
            color: #3730a3;
        }

    .hub-nav {
        min-width: 0;
        overflow-x: auto;
        scrollbar-width: none;
    }

        .hub-nav::-webkit-scrollbar {
            display: none;
        }

    .approval-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 45%, #4338ca 100%);
        border-radius: 1.5rem;
        padding: 1.75rem 2rem;
        color: #fff;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }

        .approval-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 80% 50%, rgba(255,255,255,0.06) 0%, transparent 60%);
            border-radius: inherit;
        }

    .metric-chip {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 1rem;
        padding: 0.75rem 1.25rem;
        backdrop-filter: blur(12px);
        min-width: 130px;
    }

    .card {
        background: #fff;
        border-radius: 1.25rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        overflow: hidden;
        min-width: 0;
        max-width: 100%;
    }

    .marks-class-group {
        border: 1px solid #e2e8f0;
        border-radius: 0.9rem;
        background: #fff;
        overflow: hidden;
    }

        .marks-class-group > summary {
            list-style: none;
        }

            .marks-class-group > summary::-webkit-details-marker {
                display: none;
            }

        .marks-class-group[open] .class-chevron {
            transform: rotate(180deg);
        }

    .class-chevron {
        transition: transform 0.15s ease;
        font-size: 1.1rem;
        line-height: 1;
    }

    .summary-chip {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 0.35rem 0.65rem;
        background: #eef2ff;
        color: #4338ca;
        white-space: nowrap;
    }

    .summary-chip-muted {
        background: #f1f5f9;
        color: #64748b;
    }

    .summary-chip-danger {
        background: #fff1f2;
        color: #be123c;
    }

    .summary-chip-warning {
        background: #fff7ed;
        color: #c2410c;
    }

    .form-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #475569;
        margin-bottom: 0.5rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1.5px solid #cbd5e1;
        border-radius: 0.75rem;
        font-size: 0.875rem;
        color: #1e293b;
        outline: none;
        transition: all 0.15s ease-in-out;
        background: #fff;
    }

        .form-control:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .form-control:disabled {
            background: #f1f5f9;
            color: #94a3b8;
            cursor: not-allowed;
            border-color: #e2e8f0;
        }

    .btn-indigo {
        padding: 0.75rem 1.5rem;
        background: #4f46e5;
        color: #fff;
        border: none;
        border-radius: 0.75rem;
        font-size: 0.875rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-indigo:hover:not(:disabled) {
            background: #4338ca;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
        }

        .btn-indigo:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .btn-outline {
        padding: 0.75rem 1.25rem;
        background: #fff;
        color: #475569;
        border: 1.5px solid #e2e8f0;
        border-radius: 0.75rem;
        font-size: 0.875rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-outline:hover:not(:disabled) {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #0f172a;
        }

        .btn-outline:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .status-tab-btn {
        padding: 1rem 1.25rem;
        font-weight: 800;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 2px solid transparent;
        transition: all 0.15s ease-in-out;
        white-space: nowrap;
        background: transparent;
        border-top: none;
        border-left: none;
        border-right: none;
        cursor: pointer;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .badge-ready {
        background: #dcfce7;
        color: #15803d;
    }

    .badge-partial {
        background: #fef3c7;
        color: #b45309;
    }

    .badge-none {
        background: #fee2e2;
        color: #b91c1c;
    }

    .badge-pending {
        background: #f3e8ff;
        color: #7e22ce;
    }

    .badge-approved {
        background: #e0f2fe;
        color: #0369a1;
    }

    .badge-setup {
        background: #f1f5f9;
        color: #475569;
    }

    .progress-bar-container {
        width: 100%;
        background-color: #f1f5f9;
        border-radius: 9999px;
        height: 6px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        border-radius: 9999px;
        transition: width 0.3s ease;
    }

    .subject-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.2rem 0.55rem;
        border-radius: 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        background: #f1f5f9;
        color: #334155;
    }

        .subject-pill.missing {
            background: #fff1f2;
            color: #e11d48;
            border: 1px solid #ffe4e6;
        }

    .table-wrap {
        overflow-x: auto;
        min-width: 0;
        max-width: 100%;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        padding: 0.875rem 1.25rem;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
    }

    tbody td {
        padding: 1rem 1.25rem;
        font-size: 0.875rem;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    tbody tr:hover {
        background: rgba(79, 70, 229, 0.02);
    }

    .student-missing-details {
        margin-top: 12px;
        border: 1px solid #fecaca;
        border-radius: 12px;
        background: #fff7f7;
        overflow: hidden;
    }

        .student-missing-details summary {
            list-style: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 11px 13px;
            color: #b91c1c;
            font-size: 11px;
            font-weight: 800;
        }

            .student-missing-details summary::-webkit-details-marker {
                display: none;
            }

            .student-missing-details summary::after {
                content: '⌄';
                font-size: 16px;
                line-height: 1;
                color: #ef4444;
            }

        .student-missing-details[open] summary::after {
            content: '⌃';
        }

    .missing-mark-list {
        border-top: 1px solid #fecaca;
        padding: 10px 13px 12px;
        display: grid;
        gap: 7px;
    }

    .missing-mark-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        font-size: 11px;
        color: #7f1d1d;
    }

        .missing-mark-row strong {
            color: #450a0a;
        }

    .missing-mark-type {
        white-space: nowrap;
        border-radius: 999px;
        padding: 3px 8px;
        background: #fee2e2;
        color: #b91c1c;
        font-size: 10px;
        font-weight: 800;
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        z-index: 999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

    .modal-card {
        background: #fff;
        border-radius: 1.5rem;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border: 1px solid #e2e8f0;
        animation: scaleIn 0.2s ease-out;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0.95);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@media (max-width: 640px) {
        .grid > *, .flex, .card, .approval-hero {
            min-width: 0;
            max-width: 100%;
        }

            .approval-hero .flex {
                flex-wrap: wrap;
            }

            .approval-hero .metric-chip {
                min-width: 0;
            }

        .hub-nav-link {
            padding: 0.65rem 0.75rem;
            font-size: 0.72rem;
            white-space: nowrap;
        }

        .approval-hero {
            padding: 1.25rem 1rem;
            border-radius: 1rem;
            margin-bottom: 1rem;
        }

            .approval-hero h1 {
                font-size: 1.5rem;
                line-height: 1.2;
            }

        .metric-chip {
            flex: 1 1 calc(50% - 0.5rem);
            min-width: 0;
            padding: 0.65rem 0.5rem;
        }

        .card {
            border-radius: 0.85rem;
        }

        .table-wrap {
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
        }

            .table-wrap table {
                min-width: 820px;
            }

            .table-wrap thead th,
            .table-wrap tbody td {
                padding: 0.7rem 0.75rem;
            }

        .status-tab-btn {
            padding: 0.8rem 0.75rem;
            font-size: 0.68rem;
        }

        .modal-backdrop {
            padding: 0.5rem;
            align-items: flex-end;
        }

        .modal-card {
            max-height: calc(100vh - 1rem);
            overflow-y: auto;
            border-radius: 1rem;
        }
    }
</style>

<!-- Grades Hub Navigation Header -->
<div class="hub-nav flex border-b border-slate-200 mb-6 gap-2">
    <a href="/admin/grades/approval" class="hub-nav-link active">
        1. Marks Review &amp; Generation
    </a>
    <a href="/admin/grades/reports" class="hub-nav-link">
        2. Report Approval Queue
    </a>
</div>

<!-- Hero Section -->
<div class="approval-hero shadow-lg">
    <div class="relative z-10">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div>
                <span class="inline-block px-3 py-1 rounded-full bg-white/20 text-white text-[length:0.65rem] font-extrabold uppercase tracking-widest mb-3 border border-white/20">
                    Admin Portal
                </span>
                <h1 class="text-3xl font-black tracking-tight mb-2 text-white">Marks Review &amp; Generation</h1>
                <p class="text-white/80 text-sm font-medium max-w-xl">
                    Check complete class grades. Review missing assignments, tests, or exams from teachers, generate draft report cards, and send them to the approval queue.
                </p>
            </div>

            <div class="flex gap-3 flex-wrap">
                <div class="metric-chip text-center">
                    <div class="text-white/70 text-[length:0.6rem] font-bold uppercase tracking-wider mb-1">Ready to Generate</div>
                    <div class="text-2xl font-black">@generationRoster.Count(r => r.Status == GenerationStatus.Ready)</div>
                    <div class="text-white/60 text-[length:0.55rem] mt-0.5">Students complete</div>
                </div>
                <div class="metric-chip text-center">
                    <div class="text-white/70 text-[length:0.6rem] font-bold uppercase tracking-wider mb-1">Missing Marks</div>
                    <div class="text-2xl font-black">@generationRoster.Count(r => r.Status is GenerationStatus.Partial or GenerationStatus.NoMarks or GenerationStatus.NoSubjectSetup)</div>
                    <div class="text-white/60 text-[length:0.55rem] mt-0.5">Action required</div>
                </div>
                <div class="metric-chip text-center">
                    <div class="text-white/70 text-[length:0.6rem] font-bold uppercase tracking-wider mb-1">Draft Reports</div>
                    <div class="text-2xl font-black">@allCards.Count(c => !c.AdminApproved)</div>
                    <div class="text-white/60 text-[length:0.55rem] mt-0.5">Pending approval</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMsg))
{
    <div class="mb-6 p-4 rounded-2xl text-sm font-bold border @(statusError ? "bg-rose-50 text-rose-700 border-rose-200" : "bg-indigo-50 text-indigo-700 border-indigo-200")">
        <div class="flex items-center gap-2">
            @if (statusError)
            {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
            }
            else
            {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
            }
            <span>@statusMsg</span>
        </div>
    </div>
}

<div class="grid grid-cols-1 xl:grid-cols-4 gap-6 items-start">
    <!-- Filters Panel -->
    <div class="card p-5 xl:col-span-1">
        <div class="border-b border-slate-100 pb-4 mb-4">
            <h3 class="text-base font-extrabold text-slate-900">1. Select Target Class</h3>
            <p class="text-xs text-slate-500 mt-1">Configure level and term parameters to review marks.</p>
        </div>

        <div class="space-y-4">
            <div>
                <label class="form-label">Form</label>
                <select class="form-control" @bind="genForm" @bind:after="OnFormFilterChangedAsync">
                    <option value="0">Select Form</option>
                    @foreach (var form in AvailableForms)
                    {
                        <option value="@form">Form @form</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label">Class</label>
                <select class="form-control" @bind="genClass" disabled="@(genForm <= 0)">
                    <option value="">All Classes</option>
                    @foreach (var className in AvailableClassesForForm)
                    {
                        <option value="@className">@className</option>
                    }
                </select>
            </div>

            @if (genLevel == "olevel")
            {
                <div>
                    <label class="form-label">O-Level Field Filter</label>
                    <select class="form-control" @bind="genField">
                        <option value="">All Fields</option>
                        @foreach (var f in olevelFields)
                        {
                            <option value="@f">@f</option>
                        }
                    </select>
                </div>
            }

            <div>
                <label class="form-label">Academic Term</label>
                <select class="form-control" @bind="genTerm">
                    <option value="Term 1">Term 1</option>
                    <option value="Term 2">Term 2</option>
                    <option value="Term 3">Term 3</option>
                </select>
            </div>

            <div>
                <label class="form-label">Academic Year</label>
                <input class="form-control" type="number" @bind="genYear" min="2020" max="2035" />
            </div>

            <div>
                <div class="flex justify-between items-center mb-1">
                    <label class="form-label mb-0">Coursework Weight (%)</label>
                    <span class="text-xs font-bold text-indigo-600">@genCwWeight% / @(100 - genCwWeight)% Exam</span>
                </div>
                <input class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600" type="range" @bind="genCwWeight" @bind:after="PersistCourseworkWeight" min="0" max="100" step="5" />
            </div>
        </div>

        <div class="mt-6 pt-5 border-t border-slate-100 flex flex-col gap-2">
            <button class="btn-indigo w-full justify-center" disabled="@(string.IsNullOrEmpty(genLevel) || isAnalyzingRoster)" @onclick="RunGenerationRosterAsync">
                @if (isAnalyzingRoster)
                {
                    <svg class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 12a9 9 0 1 1-6.22-8.56" /></svg>
                    <span>Analyzing...</span>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67" /></svg>
                    <span>Preview &amp; Fetch Queue</span>
                }
            </button>

            @if (generationRoster.Any(r => r.Status == GenerationStatus.Ready))
            {
                <button class="btn-outline w-full justify-center !text-emerald-700 !border-emerald-200 hover:!bg-emerald-50"
                        disabled="@(isGenerating)"
                        @onclick="GenerateBulkAsync">
                    @if (isGenerating)
                    {
                        <svg class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 12a9 9 0 1 1-6.22-8.56" /></svg>
                        <span>Generating...</span>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                        <span>Generate @generationRoster.Count(r => r.Status == GenerationStatus.Ready) Ready Reports</span>
                    }
                </button>
            }
        </div>
    </div>

    <!-- Student Queue / Workspace -->
    <div class="card xl:col-span-3">
        <!-- Roster Tabs & Search Bar -->
        <div class="bg-slate-50 border-b border-slate-200 p-4 flex flex-col md:flex-row justify-between items-stretch md:items-center gap-4">
            <div class="flex border-b border-slate-200 overflow-x-auto flex-nowrap md:border-b-0">
                <button class="status-tab-btn @(activeTab == "ready" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-900")"
                        @onclick='() => SetActiveTabAsync("ready")'>
                    Ready for Report (@generationRoster.Count(r => r.Status == GenerationStatus.Ready))
                </button>
                <button class="status-tab-btn @(activeTab == "missing" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-900")"
                        @onclick='() => SetActiveTabAsync("missing")'>
                    Missing Marks (@generationRoster.Count(r => r.Status is GenerationStatus.Partial or GenerationStatus.NoMarks or GenerationStatus.NoSubjectSetup))
                </button>
                <button class="status-tab-btn @(activeTab == "generated" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-900")"
                        @onclick='() => SetActiveTabAsync("generated")'>
                    Generated Drafts (@generationRoster.Count(r => r.Status is GenerationStatus.Pending or GenerationStatus.Approved))
                </button>
                <button class="status-tab-btn @(activeTab == "submissions" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-900")"
                        @onclick='() => SetActiveTabAsync("submissions")'>
                    Teacher Submissions (@FilteredSubmissions.Count())
                </button>
            </div>

            <!-- Contextual Filters inside Queue -->
            <div class="flex items-center gap-2 flex-1 md:flex-initial max-w-sm">
                <svg class="text-slate-400 shrink-0 ml-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input class="form-control !py-1.5 !px-3 !text-xs" type="text"
                       placeholder="@(activeTab == "submissions" ? "Search submissions by subject..." : "Search queue by student name...")"
                       @bind="rosterSearch" @bind:event="oninput" />
            </div>
        </div>

        @if (isAnalyzingRoster)
        {
            <div class="p-16 text-center">
                <svg class="mx-auto mb-4 animate-spin text-indigo-600" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.22-8.56" /></svg>
                <h4 class="text-base font-extrabold text-slate-900">Validating mark coverage...</h4>
                <p class="text-xs text-slate-500 mt-1">Fetching coursework and exam scores, checking subject configurations, and identifying missing marks.</p>
            </div>
        }
        else if (string.IsNullOrEmpty(genLevel))
        {
            <div class="p-16 text-center text-slate-400">
                <svg class="mx-auto mb-4" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="9" y1="9" x2="15" y2="9" /><line x1="9" y1="13" x2="15" y2="13" /><line x1="9" y1="17" x2="13" y2="17" /></svg>
                <h4 class="text-base font-bold text-slate-700">No Academic Level Selected</h4>
                <p class="text-xs text-slate-400 mt-1 max-w-md mx-auto">Please choose an Academic Level and Academic Year from the left panel to load the student marks queue.</p>
            </div>
        }
        else
        {
            <!-- Tab Contents -->
            <div class="table-wrap">
                @if (activeTab == "ready")
                {
                    var readyRows = FilteredRoster.Where(r => r.Status == GenerationStatus.Ready).ToList();
                    if (!readyRows.Any())
                    {
                        <div class="p-12 text-center text-slate-400">
                            <svg class="mx-auto mb-3" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                            <h5 class="text-sm font-extrabold text-slate-800">No Students Ready for Generation</h5>
                            <p class="text-xs text-slate-500 mt-1">Either all report cards are already generated, or students are missing teacher marks.</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3 p-3 sm:p-4">
                            @foreach (var classGroup in readyRows.GroupBy(GetClassLabel).OrderBy(g => g.Key))
                            {
                                <details class="marks-class-group">
                                    <summary class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 cursor-pointer">
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2"><span class="class-chevron text-slate-400">⌄</span><span class="font-extrabold text-slate-900">@classGroup.Key</span></div>
                                            <div class="text-xs text-slate-500 mt-1">@classGroup.Count() student@(classGroup.Count() == 1 ? "" : "s") ready for generation</div>
                                        </div>
                                        <div class="flex flex-wrap gap-2 text-xs font-bold">
                                            <span class="summary-chip">@classGroup.Count() students</span>
                                            <span class="summary-chip summary-chip-muted">0 missing marks</span>
                                        </div>
                                    </summary>
                                    <div class="divide-y divide-slate-100 border-t border-slate-100">
                                        @foreach (var row in classGroup)
                                        {
                                            <div class="flex flex-col lg:flex-row lg:items-center gap-3 p-4">
                                                <div class="min-w-0 flex-1">
                                                    <div class="font-bold text-slate-900 leading-tight">@row.Student.FirstName @row.Student.LastName</div>
                                                    <div class="text-xs text-slate-400 mt-0.5">ID: #@row.Student.Id</div>
                                                </div>
                                                <div class="flex flex-wrap items-center gap-2 text-xs">
                                                    @if (!string.IsNullOrWhiteSpace(row.FieldName))
                                                    {
                                                        <span class="summary-chip text-indigo-600">@row.FieldName</span>
                                                    }
                                                    <span class="badge" style="background:#f1f5f9;color:#334155;">@row.ExpectedSubjectCount subjects</span>
                                                    <span class="badge badge-ready">Ready</span>
                                                </div>
                                                <button class="btn-indigo !py-1.5 !px-3 !text-xs w-full lg:w-auto" disabled="@isGenerating" @onclick="() => OnGenerateClick(row)">Generate Report</button>
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    }
                }
                else if (activeTab == "missing")
                {
                    var missingRows = FilteredRoster.Where(r => r.Status is GenerationStatus.Partial or GenerationStatus.NoMarks or GenerationStatus.NoSubjectSetup).ToList();
                    if (!missingRows.Any())
                    {
                        <div class="p-12 text-center text-slate-400">
                            <svg class="mx-auto mb-3" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
                            <h5 class="text-sm font-extrabold text-slate-800">All Marks Complete!</h5>
                            <p class="text-xs text-slate-500 mt-1">There are no students missing marks for this academic term.</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3 p-3 sm:p-4">
                            @foreach (var classGroup in missingRows.GroupBy(GetClassLabel).OrderBy(g => g.Key))
                            {
                                var missingMarkStudents = classGroup.Count(HasMissingMarks);
                                <details class="marks-class-group">
                                    <summary class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 cursor-pointer">
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2"><span class="class-chevron text-slate-400">⌄</span><span class="font-extrabold text-slate-900">@classGroup.Key</span></div>
                                            <div class="text-xs text-slate-500 mt-1">@classGroup.Count() student@(classGroup.Count() == 1 ? "" : "s") need attention</div>
                                        </div>
                                        <div class="flex flex-wrap gap-2 text-xs font-bold">
                                            <span class="summary-chip">@classGroup.Count() students</span>
                                            <span class="summary-chip @(missingMarkStudents > 0 ? "summary-chip-danger" : "summary-chip-muted")">@missingMarkStudents missing marks</span>
                                        </div>
                                    </summary>
                                    <div class="divide-y divide-slate-100 border-t border-slate-100">
                                        @foreach (var row in classGroup)
                                        {
                                            <div class="p-4">
                                                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
                                                    <div class="min-w-0"><div class="font-bold text-slate-900 leading-tight">@row.Student.FirstName @row.Student.LastName</div><div class="text-xs text-slate-400 mt-0.5">ID: #@row.Student.Id</div></div>
                                                    <div class="text-xs text-slate-500">
                                                        @if (row.Status == GenerationStatus.NoSubjectSetup)
                                                        {
                                                            <span class="text-rose-500 font-bold">Subject setup missing</span>
                                                        }
                                                        else if (!string.IsNullOrWhiteSpace(row.FieldName))
                                                        {

                                                            <span class="text-indigo-600 font-semibold">@row.FieldName</span>
                                                        }
                                                    </div>
                                                </div>
                                                @if (row.Status == GenerationStatus.NoSubjectSetup)
                                                {
                                                    <p class="text-xs text-slate-500 font-medium mt-3">Please assign subjects to this student in academic settings first.</p>
                                                }
                                                else
                                                {
                                                    var missingMarks = row.SubjectCoverage.Where(s => !s.IsComplete).ToList();
                                                    @if (missingMarks.Any())
                                                    {
                                                        <details class="student-missing-details">
                                                            <summary>View @missingMarks.Count missing subject@(missingMarks.Count == 1 ? "" : "s") and marks</summary>
                                                            <div class="missing-mark-list">
                                                                @foreach (var missing in missingMarks)
                                                                {
                                                                    var missingParts = new List<string>();
                                                                    if (!missing.HasCoursework) missingParts.Add("Coursework");
                                                                    if (!missing.HasExam) missingParts.Add("Exam");
                                                                    <div class="missing-mark-row"><strong>@missing.SubjectName</strong><span class="missing-mark-type">Missing: @string.Join(" + ", missingParts)</span></div>
                                                                }
                                                            </div>
                                                        </details>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    }
                }
                else if (activeTab == "generated")
                {
                    var generatedRows = FilteredRoster.Where(r => r.Status is GenerationStatus.Pending or GenerationStatus.Approved).ToList();
                    if (!generatedRows.Any())
                    {
                        <div class="p-12 text-center text-slate-400">
                            <svg class="mx-auto mb-3" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="9" y1="9" x2="15" y2="9" /><line x1="9" y1="13" x2="15" y2="13" /><line x1="9" y1="17" x2="13" y2="17" /></svg>
                            <h5 class="text-sm font-extrabold text-slate-800">No Reports Generated Yet</h5>
                            <p class="text-xs text-slate-500 mt-1">Use the "Ready for Report" tab to generate report cards first.</p>
                        </div>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Student Name</th>
                                    <th>Class &amp; Level</th>
                                    <th>Subjects</th>
                                    <th>Average Score</th>
                                    <th>Status</th>
                                    <th style="text-align:right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in generatedRows)
                                {
                                    var card = row.ExistingCard!;
                                    var avg = card.Subjects?.Any() == true ? card.Subjects.Average(s => s.FinalMark) : 0;
                                    var isFailing = avg < 50;

                                    <tr>
                                        <td>
                                            <div class="font-bold text-slate-900 leading-tight">@row.Student.FirstName @row.Student.LastName</div>
                                            <div class="text-xs text-slate-400 mt-0.5">ID: #@row.Student.Id</div>
                                        </td>
                                        <td>
                                            <div class="font-semibold text-slate-700">Form @row.Student.Form @row.Student.Classroom</div>
                                            <div class="text-xs text-slate-400 mt-0.5">@card.Term @card.TermYear</div>
                                        </td>
                                        <td>
                                            <span class="badge" style="background:#ede9fe;color:#5b21b6;">@(card.Subjects?.Count ?? 0) subjects</span>
                                        </td>
                                        <td>
                                            <span class="font-mono font-bold text-sm" style="color:@(isFailing ? "#dc2626" : "#16a34a")">
                                                @avg.ToString("F1")%
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @row.StatusClass">@row.StatusLabel</span>
                                        </td>
                                        <td style="text-align:right;">
                                            <div class="flex gap-2 justify-end">
                                                <span class="text-[length:0.68rem] font-bold text-slate-400" title="The current report-generation API does not replace existing report cards.">
                                                    Existing report
                                                </span>
                                                @if (row.Status == GenerationStatus.Pending)
                                                {
                                                    <a href="/admin/grades/reports" class="btn-indigo !py-1 !px-2.5 !text-xs !bg-indigo-50 !text-indigo-600 border border-indigo-200 hover:!bg-indigo-100" style="text-decoration:none;">
                                                        Review &amp; Approve &rarr;
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                else if (activeTab == "submissions")
                {
                    if (!FilteredSubmissions.Any())
                    {
                        <div class="p-12 text-center text-slate-400">
                            <svg class="mx-auto mb-3" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M9 17H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4" /><path d="M15 13h6v8H15z" /></svg>
                            <h5 class="text-sm font-extrabold text-slate-800">No Teacher Submissions Found</h5>
                            @if (string.IsNullOrWhiteSpace(genLevel))
                            {
                                <p class="text-xs text-slate-500 mt-1">Select a form and click <strong>Preview &amp; Fetch Queue</strong> first.</p>
                            }
                            else
                            {
                                <p class="text-xs text-slate-500 mt-1">No assessments match the selected form, field, term, and year.</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(submissionStatusMsg))
                            {
                                <p class="text-xs text-amber-600 mt-2 font-semibold">@submissionStatusMsg</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col gap-3 p-3 sm:p-4">
                            @foreach (var teacherGroup in FilteredSubmissions
                                .GroupBy(s => s.TeacherId?.ToString() ?? $"unassigned:{s.TeacherName}")
                                .OrderBy(g => g.First().TeacherName))
                            {
                                var teacher = teacherGroup.First();
                                var teacherSubjects = teacherGroup.Select(s => s.SubjectName).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
                                <details class="rounded-2xl border border-slate-200 bg-white shadow-sm">
                                    <summary class="cursor-pointer list-none px-4 py-3 flex items-center justify-between gap-3 hover:bg-slate-50">
                                        <div class="min-w-0">
                                            <div class="font-bold text-slate-900">@teacher.TeacherName</div>
                                            <div class="text-xs text-slate-500 mt-1">@teacherGroup.Count() submission(s) · @teacherSubjects.Count subject(s) · click to view assessments</div>
                                        </div>
                                        <div class="flex flex-wrap justify-end gap-1.5">
                                            @foreach (var subject in teacherSubjects)
                                            {
                                                <span class="badge" style="background:#eef2ff;color:#4338ca;">@subject</span>
                                            }
                                        </div>
                                    </summary>
                                    <div class="overflow-x-auto border-t border-slate-100">
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th>Subject</th>
                                                    <th>Assessment</th>
                                                    <th>Type</th>
                                                    <th>Weight</th>
                                                    <th>Max Score</th>
                                                    <th>Date</th>
                                                    <th style="text-align:right;">Marks</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var sub in teacherGroup.OrderBy(s => s.SubjectName).ThenBy(s => s.Date))
                                                {
                                                    var typeBg = sub.Type switch
                                                    {
                                                        "Test" => "rgba(245, 158, 11, 0.1)",
                                                        "Exam" => "rgba(139, 92, 246, 0.1)",
                                                        _ => "rgba(59, 130, 246, 0.1)"
                                                    };
                                                    var typeFg = sub.Type switch
                                                    {
                                                        "Test" => "#d97706",
                                                        "Exam" => "#7c3aed",
                                                        _ => "#2563eb"
                                                    };
                                                    <tr>
                                                        <td><div class="font-bold text-slate-900">@sub.SubjectName</div></td>
                                                        <td><span class="font-semibold text-slate-800">@sub.Title</span></td>
                                                        <td><span class="badge" style="background:@typeBg;color:@typeFg">@sub.Type</span></td>
                                                        <td class="font-mono text-sm">@((sub.Weight * 100).ToString("F0"))%</td>
                                                        <td class="font-mono text-sm font-bold">@sub.MaxScore pts</td>
                                                        <td><span class="text-slate-500">@(sub.Date == default ? "Date unavailable" : sub.Date.ToString("dd MMM yyyy"))</span></td>
                                                        <td style="text-align:right;">
                                                            @if (sub.TeacherId.HasValue)
                                                            {
                                                                <a href="@GetTeacherAnalyticsUrl(sub)" class="btn-outline !py-1 !px-2.5 !text-xs" style="text-decoration:none;">View Marks</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-xs text-slate-400">No teacher</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </details>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

<!-- Regenerate Confirmation Modal -->
@if (showRegenModal)
{
    <div class="modal-backdrop" @onclick="() => showRegenModal = false">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="p-6">
                <div class="flex items-center gap-3 text-amber-600 mb-3">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    <h4 class="text-lg font-black text-slate-900">Regenerate Report Card?</h4>
                </div>
                <p class="text-sm text-slate-600 leading-relaxed">
                    A report card already exists for <strong class="text-slate-900">@regenStudentName</strong> for <strong class="text-slate-900">@genTerm @genYear</strong>.
                </p>
                <p class="text-xs text-slate-500 mt-2 leading-relaxed bg-slate-50 border border-slate-100 p-2.5 rounded-xl">
                    Regenerating will override the draft with the latest coursework and exam marks. Report comments are generated automatically.
                </p>

                <div class="mt-6 flex justify-end gap-3">
                    <button class="btn-outline" @onclick="() => showRegenModal = false">Cancel</button>
                    <button class="btn-indigo !bg-amber-600 hover:!bg-amber-700" @onclick="ConfirmRegenAsync">Confirm &amp; Overwrite</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private enum GenerationStatus { Ready, Partial, NoMarks, Pending, Approved, NoSubjectSetup }

    private sealed class GenerationRosterRow
    {
        public Student Student { get; init; } = new();
        public string FieldName { get; init; } = string.Empty;
        public List<SubjectStatus> SubjectCoverage { get; init; } = new();
        public int ExpectedSubjectCount => SubjectCoverage.Count;
        public int CoveredSubjectCount => SubjectCoverage.Count(s => s.IsComplete);
        public int CourseworkSubjectCount => SubjectCoverage.Count(s => s.HasCoursework);
        public int ExamSubjectCount => SubjectCoverage.Count(s => s.HasExam);
        public ReportCardModel? ExistingCard { get; init; }
        public GenerationStatus Status { get; init; }
        public string StatusLabel { get; init; } = string.Empty;
        public string StatusClass { get; init; } = string.Empty;
        public bool CanGenerate { get; init; }
    }

    public class SubjectStatus
    {
        public string SubjectName { get; init; } = string.Empty;
        public bool HasCoursework { get; init; }
        public bool HasExam { get; init; }
        public bool IsComplete => HasCoursework || HasExam;
    }

    public class TeacherSubmissionItem
    {
        public long? TeacherId { get; init; }
        public string TeacherName { get; init; } = "Unassigned teacher";
        public string SubjectName { get; init; } = string.Empty;
        public string Title { get; init; } = string.Empty;
        public string Type { get; init; } = string.Empty; // "Assignment", "Test", "Exam"
        public double Weight { get; init; }
        public double MaxScore { get; init; }
        public DateOnly Date { get; init; }
    }

    // Generation controls state
    private string genLevel = "";
    private string genField = "";
    private string genClass = "";
    private int genForm = 0;
    private string genTerm = GetCurrentTerm();
    private int genYear = DateTime.Now.Year;
    private double genCwWeight = 30;
    private long genStudentId = 0;
    private string rosterSearch = "";
    private string activeTab = "ready";

    // Data
    private List<ReportCardModel> allCards = new();
    private List<Student> allStudents = new();
    private List<Student> eligibleStudents = new();
    private List<GenerationRosterRow> generationRoster = new();
    private List<string> olevelFields = new();
    private IEnumerable<string> AvailableClassesForForm => allStudents
        .Where(s => genForm <= 0 || s.Form == genForm)
        .Select(s => s.Classroom?.Trim())
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Select(c => c!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(c => c);

    private static readonly int[] AvailableForms = { 1, 2, 3, 4, 5, 6 };
    private Dictionary<long, string> studentNames = new();
    private Dictionary<long, string> olevelFieldCache = new();
    private Dictionary<long, List<string>> alevelChoiceCache = new();
    private Dictionary<long, string> teacherNames = new();
    private System.Collections.Concurrent.ConcurrentDictionary<string, List<string>> expectedSubjectCache = new();

    // Loading flags
    private bool isLoadingCards = false;
    private bool isGenerating = false;
    private bool isAnalyzingRoster = false;
    private string statusMsg = "";
    private bool statusError;

    // Regeneration confirm state
    private bool showRegenModal = false;
    private long regenStudentId = 0;
    private string regenStudentName = "";

    // Teacher Submissions Data
    private List<TeacherSubmissionItem> teacherSubmissions = new();
    private bool isLoadingSubmissions = false;
    private string submissionStatusMsg = "";

    private IEnumerable<GenerationRosterRow> FilteredRoster =>
        generationRoster.Where(r =>
            string.IsNullOrWhiteSpace(rosterSearch) ||
            $"{r.Student.FirstName} {r.Student.LastName}".Contains(rosterSearch, StringComparison.OrdinalIgnoreCase) ||
            (r.Student.Classroom ?? string.Empty).Contains(rosterSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<TeacherSubmissionItem> FilteredSubmissions =>
        teacherSubmissions.Where(s =>
            string.IsNullOrWhiteSpace(rosterSearch) ||
            s.TeacherName.Contains(rosterSearch, StringComparison.OrdinalIgnoreCase) ||
            s.SubjectName.Contains(rosterSearch, StringComparison.OrdinalIgnoreCase) ||
            s.Title.Contains(rosterSearch, StringComparison.OrdinalIgnoreCase));

    private bool dataLoadAttempted;
    private int queueLoadVersion;

    private const string CourseworkWeightStorageKey = "paa.admin.courseworkWeightPercent";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", CourseworkWeightStorageKey);
            if (double.TryParse(stored, out var savedWeight))
                genCwWeight = Math.Clamp(savedWeight, 0, 100);
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || dataLoadAttempted) return;
        dataLoadAttempted = true;

        await Task.WhenAll(LoadStudentsAsync(), LoadFieldsAsync(), LoadAlevelChoicesAsync());
        StateHasChanged();
    }

    private async Task LoadStudentsAsync()
    {
        try
        {
            allStudents = await StudentProfileService.GetStudentsAsync();
            studentNames = allStudents
                .GroupBy(s => (long)s.Id)
                .ToDictionary(g => g.Key, g => $"{g.First().FirstName} {g.First().LastName}".Trim());
        }
        catch
        {
            allStudents = new();
            studentNames = new();
        }
    }

    private async Task PersistCourseworkWeight()
    {
        genCwWeight = Math.Clamp(genCwWeight, 0, 100);
        await JS.InvokeVoidAsync("localStorage.setItem", CourseworkWeightStorageKey, genCwWeight.ToString());
    }

    private async Task LoadAlevelChoicesAsync()
    {
        try
        {
            var choices = await SubjectService.GetStudentALevelSubjectChoicesAsync();
            alevelChoiceCache = choices
                .GroupBy(c => c.StudentId)
                .ToDictionary(
                    g => g.Key,
                    g => g.SelectMany(c => c.Subjects ?? new List<string>())
                          .Where(s => !string.IsNullOrWhiteSpace(s))
                          .Distinct(StringComparer.OrdinalIgnoreCase)
                          .ToList());
        }
        catch { alevelChoiceCache = new(); }
    }

    private async Task LoadFieldsAsync()
    {
        try
        {
            var fields = await OlevelClassService.GetAllOlevelFieldsAsync();
            olevelFields = fields.Select(f => f.Field ?? "").Where(f => !string.IsNullOrWhiteSpace(f)).Distinct().OrderBy(f => f).ToList();
        }
        catch { olevelFields = new() { "Sciences", "Commercials", "Arts" }; }
    }

    private async Task OnLevelChangedAsync()
    {
        var requestVersion = ++queueLoadVersion;
        genStudentId = 0;
        generationRoster.Clear();
        teacherSubmissions.Clear();
        expectedSubjectCache.Clear();
        genClass = "";
        genForm = 0;
        eligibleStudents = new();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnFormFilterChangedAsync()
    {
        // Class names can be reused between forms (for example Form 1 A2 and
        // Form 2 A2), so a previous class selection is no longer unambiguous.
        genLevel = genForm switch
        {
            >= 1 and <= 4 => "form1to4",
            5 or 6 => "alevel",
            _ => ""
        };
        genClass = "";
        generationRoster.Clear();
        teacherSubmissions.Clear();
        expectedSubjectCache.Clear();
        eligibleStudents = new();
        statusMsg = "Select the remaining filters, then click Preview & Fetch Queue.";
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadQueueAsync()
    {
        if (string.IsNullOrWhiteSpace(genLevel)) return;

        var requestVersion = ++queueLoadVersion;
        if (activeTab == "submissions")
            await LoadTeacherSubmissionsAsync(requestVersion);
        else
            await BuildGenerationRosterAsync(requestVersion);
    }

    private async Task SetActiveTabAsync(string tab)
    {
        var requestVersion = ++queueLoadVersion;
        activeTab = tab;
        rosterSearch = "";
        await InvokeAsync(StateHasChanged);

        // Switching tabs must load its data. Previously the submissions tab
        // only changed the active view, leaving teacherSubmissions empty until
        // the user manually ran the queue fetch again.
        if (tab == "submissions" && !string.IsNullOrWhiteSpace(genLevel))
            await LoadTeacherSubmissionsAsync(requestVersion);
    }

    private Task RunGenerationRosterAsync()
    {
        var requestVersion = ++queueLoadVersion;
        return BuildGenerationRosterAsync(requestVersion);
    }

    private static List<Student> FilterStudentsForLevel(IEnumerable<Student> students, string level) => level switch
    {
        "form1to4" => students.Where(s => s.Form is >= 1 and <= 4).ToList(),
        "olevel" => students.Where(s => s.Form is 3 or 4).ToList(),
        "alevel" => students.Where(s => s.Form is 5 or 6).ToList(),
        _ => new()
    };

    private async Task BuildGenerationRosterAsync(int requestVersion = 0)
    {
        if (string.IsNullOrWhiteSpace(genLevel))
            return;

        expectedSubjectCache.Clear();

        isAnalyzingRoster = true;
        statusMsg = "";
        generationRoster.Clear();
        eligibleStudents = FilterStudentsForLevel(allStudents, genLevel);

        if (!string.IsNullOrWhiteSpace(genClass))
            eligibleStudents = eligibleStudents
                .Where(s => string.Equals(s.Classroom, genClass, StringComparison.OrdinalIgnoreCase))
                .ToList();

        if (genForm <= 0)
            return;

        eligibleStudents = eligibleStudents
            .Where(s => s.Form == genForm)
            .ToList();

        // Filter by fields if olevel and field filter set
        if (genLevel == "olevel" && !string.IsNullOrWhiteSpace(genField))
        {
            var fieldMatches = await Task.WhenAll(eligibleStudents.Select(async s =>
                (Student: s, Field: await ResolveFieldForStudentAsync(s))));
            eligibleStudents = fieldMatches
                .Where(x => string.Equals(x.Field, genField, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.Student)
                .ToList();
        }

        await WarmExpectedSubjectCacheAsync(eligibleStudents);

        StateHasChanged();

        try
        {
            await LoadCardsForStudentsAsync(eligibleStudents, requestVersion);

            if (requestVersion != 0 && requestVersion != queueLoadVersion)
                return;

            var rows = await Task.WhenAll(eligibleStudents.Select(BuildRosterRowAsync));
            if (requestVersion != 0 && requestVersion != queueLoadVersion)
                return;
            generationRoster = rows
                .OrderBy(r => r.Status)
                .ThenBy(r => r.Student.LastName)
                .ThenBy(r => r.Student.FirstName)
                .ToList();

        }
        catch (Exception ex)
        {
            statusMsg = $"Could not analyze the generation queue. ({ex.Message})";
            statusError = true;
        }
        finally
        {
            isAnalyzingRoster = false;
            StateHasChanged();
        }
    }

    private async Task LoadCardsForStudentsAsync(List<Student> students, int requestVersion = 0)
    {
        isLoadingCards = true;
        StateHasChanged();
        try
        {
            var pending = await AdminGradesService.GetPendingReportCardsAsync() ?? new();
            var loadedCards = new List<ReportCardModel>(pending);

            const int BatchSize = 10;
            for (int i = 0; i < students.Count; i += BatchSize)
            {
                if (requestVersion != 0 && requestVersion != queueLoadVersion)
                    return;

                var batch = students.Skip(i).Take(BatchSize).ToList();
                var tasks = batch.Select(async s =>
                {
                    try
                    {
                        return await AdminGradesService.GetStudentReportCardsAsync(s.Id);
                    }
                    catch
                    {
                        return null;
                    }
                });
                var results = await Task.WhenAll(tasks);
                foreach (var result in results)
                {
                    if (result != null)
                    {
                        foreach (var card in result)
                        {
                            if (!loadedCards.Any(c => c.Id == card.Id))
                            {
                                loadedCards.Add(card);
                            }
                        }
                    }
                }
            }

            if (requestVersion == 0 || requestVersion == queueLoadVersion)
                allCards = loadedCards;
        }
        catch
        {
            allCards = new();
        }
        finally
        {
            isLoadingCards = false;
            StateHasChanged();
        }
    }

    private async Task<GenerationRosterRow> BuildRosterRowAsync(Student student)
    {
        var field = await ResolveFieldForStudentAsync(student);
        var expectedSubjects = await GetExpectedSubjectsAsync(student, field);
        var (cwSubjects, examSubjects) = await GetMarkCoverageAsync(student, field);

        // Start with expected subjects, then also include any subjects with marks recorded
        var allSubjectNames = new List<string>(expectedSubjects);
        foreach (var cw in cwSubjects)
        {
            if (!allSubjectNames.Any(s => SubjectMatches(s, cw)))
                allSubjectNames.Add(cw);
        }
        foreach (var ex in examSubjects)
        {
            if (!allSubjectNames.Any(s => SubjectMatches(s, ex)))
                allSubjectNames.Add(ex);
        }

        var subjectsStatus = new List<SubjectStatus>();
        foreach (var subName in allSubjectNames)
        {
            subjectsStatus.Add(new SubjectStatus
            {
                SubjectName = subName,
                HasCoursework = cwSubjects.Any(c => SubjectMatches(c, subName)),
                HasExam = examSubjects.Any(e => SubjectMatches(e, subName))
            });
        }

        var existingCard = allCards.FirstOrDefault(card =>
            card.StudentId == student.Id &&
            string.Equals(card.Term, genTerm, StringComparison.OrdinalIgnoreCase) &&
            card.TermYear == genYear);

        var status = GenerationStatus.NoMarks;
        var label = "Missing Marks";
        var statusClass = "badge-none";
        var canGenerate = false;

        int expectedCount = allSubjectNames.Count;
        int coveredCount = subjectsStatus.Count(s => s.IsComplete);

        if (existingCard?.AdminApproved == true)
        {
            status = GenerationStatus.Approved;
            label = "Approved & Released";
            statusClass = "badge-approved";
            canGenerate = false;
        }
        else if (existingCard != null)
        {
            status = GenerationStatus.Pending;
            label = "Pending Approval";
            statusClass = "badge-pending";
            canGenerate = true;
        }
        else if (expectedCount == 0)
        {
            status = GenerationStatus.NoSubjectSetup;
            label = "No Subject Setup";
            statusClass = "badge-setup";
            canGenerate = false;
        }
        else if (coveredCount >= expectedCount)
        {
            status = GenerationStatus.Ready;
            label = "Ready";
            statusClass = "badge-ready";
            canGenerate = true;
        }
        else if (coveredCount > 0 || subjectsStatus.Any(s => s.HasCoursework || s.HasExam))
        {
            status = GenerationStatus.Partial;
            label = "Partial Marks";
            statusClass = "badge-partial";
            canGenerate = false;
        }
        else
        {
            status = GenerationStatus.NoMarks;
            label = "No Marks";
            statusClass = "badge-none";
            canGenerate = false;
        }

        return new GenerationRosterRow
        {
            Student = student,
            FieldName = field,
            SubjectCoverage = subjectsStatus,
            ExistingCard = existingCard,
            Status = status,
            StatusLabel = label,
            StatusClass = statusClass,
            CanGenerate = canGenerate
        };
    }

    private async Task WarmExpectedSubjectCacheAsync(IEnumerable<Student> students)
    {
        // Forms 1–4 subjects are now resolved per student from the class
        // offering and the student's opt-out choices. There is no global
        // subject cache to warm for these forms.
        await Task.CompletedTask;
    }

    private async Task<string> ResolveFieldForStudentAsync(Student student)
    {
        if (student.Form is not 3 and not 4)
            return string.Empty;

        if (olevelFieldCache.TryGetValue(student.Id, out var cached))
            return cached;

        try
        {
            var field = (await OlevelClassService.GetStudentOlevelFieldAsync(student.Id))?.Trim('"') ?? string.Empty;
            olevelFieldCache[student.Id] = field;
            return field;
        }
        catch { return string.Empty; }
    }

    private async Task<List<string>> GetExpectedSubjectsAsync(Student student, string field)
    {
        var cacheKey = student.Form is >= 1 and <= 4
            ? $"form1to4:{student.Id}"
            : string.Empty;

        if (!string.IsNullOrEmpty(cacheKey) && expectedSubjectCache.TryGetValue(cacheKey, out var cached))
            return cached;

        try
        {
            if (student.Form is >= 1 and <= 4)
            {
                var choices = await SubjectService.GetForm1to4StudentSubjectsAsync(student.Id);
                if (choices?.Subjects?.Any() == true)
                {
                    var result = choices.Subjects
                        .Where(s => !string.IsNullOrWhiteSpace(s))
                        .Select(s => s.Trim())
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .ToList();
                    expectedSubjectCache[cacheKey] = result;
                    return result;
                }

                var classSetup = await SubjectService.GetForm1to4ClassSubjectsAsync(student.Form ?? 0, student.Classroom ?? string.Empty);
                var fallback = classSetup?.Subjects?
                    .Where(s => !string.IsNullOrWhiteSpace(s))
                    .Select(s => s.Trim())
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList() ?? new();
                if (fallback.Count == 0)
                {
                    var allClassSubjects = await SubjectService.GetAllForm1to4ClassSubjectsAsync();
                    if (allClassSubjects?.Any() == true)
                    {
                        var matchedClass = allClassSubjects.FirstOrDefault(c =>
                            c.Form == (student.Form ?? 0) &&
                            ClassLabelsMatch(c.ClassName ?? string.Empty, student.Classroom ?? string.Empty, student.Form ?? 0));

                        if (matchedClass?.Subjects?.Any() == true)
                        {
                            fallback = matchedClass.Subjects
                                .Where(s => !string.IsNullOrWhiteSpace(s))
                                .Select(s => s.Trim())
                                .Distinct(StringComparer.OrdinalIgnoreCase)
                                .ToList();
                        }
                    }
                }

                expectedSubjectCache[cacheKey] = fallback;
                return fallback;
            }

            if (alevelChoiceCache.TryGetValue(student.Id, out var selected))
                return selected.Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        }
        catch { }

        return new();
    }

    private async Task<(HashSet<string> CwSubjects, HashSet<string> ExamSubjects)> GetMarkCoverageAsync(Student student, string field)
    {
        var termNumber = ParseTermNumber(genTerm);

        // Fields are optional in this system — a mark should count toward a
        // student's subject coverage no matter which field value (if any) it
        // was filed under on the backend. Query every plausible field variant
        // instead of gating on one, and union whatever comes back, so coverage
        // is decided purely by matching student → subject, not by field.
        var fieldCandidates = new List<string> { "default", "" };
        if (!string.IsNullOrWhiteSpace(field))
            fieldCandidates.Add(field);
        fieldCandidates = fieldCandidates.Distinct(StringComparer.OrdinalIgnoreCase).ToList();

        var cwSubjects = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var examSubjects = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        void AddCw(CourseworkMarksResponse? resp)
        {
            if (resp?.CourseMarks == null) return;
            foreach (var entry in resp.CourseMarks)
            {
                if (!string.IsNullOrWhiteSpace(entry.Key) && entry.Value?.Any() == true)
                    cwSubjects.Add(entry.Key.Trim());
            }
        }

        void AddExam(ExamMarksResponse? resp)
        {
            if (resp?.MarksBySubject == null) return;
            foreach (var entry in resp.MarksBySubject)
            {
                if (!string.IsNullOrWhiteSpace(entry.Key) && entry.Value?.Any() == true)
                    examSubjects.Add(entry.Key.Trim());
            }
        }

        // IMPORTANT: each field candidate is fetched independently, with its own
        // try/catch. A backend failure for one field variant (e.g. an O-Level
        // "field" value that a given endpoint doesn't support yet) must not
        // discard marks that were successfully returned by the other variants
        // ("default" / ""). Previously all candidate calls were awaited together
        // via a single Task.WhenAll wrapped in one outer catch: if any single
        // task faulted, the whole method fell into that catch and returned
        // completely empty coverage sets, making subjects that genuinely had
        // marks recorded show up as "missing" for O-Level students specifically
        // (they're the only ones with a third, field-specific candidate).
        var cwTasks = fieldCandidates.Select(async f =>
        {
            try { return await AdminGradesService.GetCourseworkMarksAsync(student.Id, termNumber, genYear, f); }
            catch { return null; }
        });
        var examTasks = fieldCandidates.Select(async f =>
        {
            try { return await AdminGradesService.GetExamMarksAsync(student.Id, termNumber, genYear, f); }
            catch { return null; }
        });

        var cwResults = await Task.WhenAll(cwTasks);
        var examResults = await Task.WhenAll(examTasks);

        foreach (var r in cwResults) AddCw(r);
        foreach (var r in examResults) AddExam(r);

        return (cwSubjects, examSubjects);
    }

    private static bool SubjectMatches(string? a, string? b)
    {
        if (string.IsNullOrWhiteSpace(a) || string.IsNullOrWhiteSpace(b))
            return false;

        var cleanA = a.Trim();
        var cleanB = b.Trim();

        if (string.Equals(cleanA, cleanB, StringComparison.OrdinalIgnoreCase))
            return true;

        static string Normalize(string s)
        {
            var lower = s.ToLowerInvariant()
                .Replace("-", " ")
                .Replace("_", " ");
            lower = System.Text.RegularExpressions.Regex.Replace(lower, @"\bmaths\b", "mathematics");
            lower = System.Text.RegularExpressions.Regex.Replace(lower, @"\beng\b", "english");
            lower = System.Text.RegularExpressions.Regex.Replace(lower, @"\beng\s+lang\b", "english language");
            lower = System.Text.RegularExpressions.Regex.Replace(lower, @"\benglish\s+language\b", "english");
            lower = System.Text.RegularExpressions.Regex.Replace(lower, @"\bgeog\b", "geography");
            lower = System.Text.RegularExpressions.Regex.Replace(lower, @"\bhist\b", "history");
            lower = System.Text.RegularExpressions.Regex.Replace(lower, @"\blit\b", "literature");
            lower = System.Text.RegularExpressions.Regex.Replace(lower, @"\bliterature\s+in\s+english\b", "literature");
            lower = System.Text.RegularExpressions.Regex.Replace(lower, @"\bscience\b", "combined science");
            return System.Text.RegularExpressions.Regex.Replace(lower, @"\s+", "");
        }

        return string.Equals(Normalize(cleanA), Normalize(cleanB), StringComparison.OrdinalIgnoreCase);
    }

    private static bool ClassLabelsMatch(string left, string right, int form)
    {
        static string Normalize(string value, int form)
        {
            var text = value.Trim().ToLowerInvariant()
                .Replace("form", "").Replace("class", "")
                .Replace("-", "").Replace("_", "").Replace(" ", "");
            if (form > 0)
                text = text.Replace(form.ToString(), "");
            return text;
        }

        return string.Equals(left.Trim(), right.Trim(), StringComparison.OrdinalIgnoreCase) ||
               Normalize(left, form) == Normalize(right, form);
    }

    private async Task LoadTeacherSubmissionsAsync(int requestVersion = 0)
    {
        if (string.IsNullOrEmpty(genLevel)) return;
        var levelSnapshot = genLevel;
        var fieldSnapshot = genField;
        var termSnapshot = genTerm;
        var yearSnapshot = genYear;
        isLoadingSubmissions = true;
        teacherSubmissions.Clear();
        submissionStatusMsg = "";
        StateHasChanged();

        try
        {
            var teachersTask = TeacherService.GetTeachersAsync();

            // O-Level assessment routes are field-aware. Keep the selected
            // field in the request so the admin sees the same records as staff.
            var assignmentsTask = AdminGradesService.GetAllAssignmentsForLevelAsync(levelSnapshot, field: fieldSnapshot);
            var testsTask = AdminGradesService.GetAllTestsForLevelAsync(levelSnapshot, field: fieldSnapshot);
            var examsTask = AdminGradesService.GetAllExamsForLevelAsync(levelSnapshot, field: fieldSnapshot);

            await Task.WhenAll(teachersTask, assignmentsTask, testsTask, examsTask);

            if (requestVersion != 0 && requestVersion != queueLoadVersion)
                return;

            teacherNames = teachersTask.Result
                .ToDictionary(t => t.Id, t => $"{t.FirstName} {t.LastName}".Trim());

            var assignments = assignmentsTask.Result ?? new();
            var tests = testsTask.Result ?? new();
            var exams = examsTask.Result ?? new();
            var returnedCount = assignments.Count + tests.Count + exams.Count;

            var (startMonth, endMonth) = GradeHelper.TermMonthRange(termSnapshot);

            bool IsCalendarTermDate(DateOnly? date)
                => date.HasValue
                    && date.Value.Month >= startMonth
                    && date.Value.Month <= endMonth
                    && date.Value.Year == yearSnapshot;

            var returnedDates = assignments.Select(a => a.DueDate)
                .Concat(tests.Select(t => t.TestDate))
                .Concat(exams.Select(e => e.ExamDate))
                .Where(date => date.HasValue)
                .ToList();
            var showReturnedRecordsDespiteDateMismatch = returnedCount > 0
                && returnedDates.Any()
                && !returnedDates.Any(IsCalendarTermDate);

            bool IsInTermRange(DateOnly? date)
            {
                // Older assessment records may not have a date populated. Keep them visible
                // for review instead of silently treating them as another term.
                if (!date.HasValue)
                    return true;

                return showReturnedRecordsDespiteDateMismatch || IsCalendarTermDate(date);
            }

            foreach (var a in assignments)
            {
                if (IsInTermRange(a.DueDate))
                {
                    teacherSubmissions.Add(new TeacherSubmissionItem
                    {
                        TeacherId = a.TeacherId,
                        TeacherName = GetTeacherName(a.TeacherId),
                        SubjectName = a.SubjectName ?? $"Subject #{a.SubjectId}",
                        Title = a.Title ?? "Assignment",
                        Type = "Assignment",
                        Weight = a.Weight,
                        MaxScore = a.MaxScore,
                        Date = a.DueDate ?? default
                    });
                }
            }

            foreach (var t in tests)
            {
                if (IsInTermRange(t.TestDate))
                {
                    teacherSubmissions.Add(new TeacherSubmissionItem
                    {
                        TeacherId = t.TeacherId,
                        TeacherName = GetTeacherName(t.TeacherId),
                        SubjectName = t.SubjectName ?? $"Subject #{t.SubjectId}",
                        Title = t.Title ?? "Test",
                        Type = "Test",
                        Weight = t.Weight,
                        MaxScore = t.MaxScore,
                        Date = t.TestDate ?? default
                    });
                }
            }

            foreach (var e in exams)
            {
                if (IsInTermRange(e.ExamDate))
                {
                    teacherSubmissions.Add(new TeacherSubmissionItem
                    {
                        TeacherId = e.TeacherId,
                        TeacherName = GetTeacherName(e.TeacherId),
                        SubjectName = e.SubjectName ?? $"Subject #{e.SubjectId}",
                        Title = e.Title ?? "Exam",
                        Type = "Exam",
                        Weight = e.Weight,
                        MaxScore = e.MaxScore,
                        Date = e.ExamDate ?? default
                    });
                }
            }

            if (showReturnedRecordsDespiteDateMismatch)
                submissionStatusMsg = $"The API returned {returnedCount} assessment(s), but their saved dates do not match {termSnapshot} {yearSnapshot}. They are shown for review; please verify the dates saved by the teacher.";
            else if (teacherSubmissions.Count == 0 && returnedCount > 0)
                submissionStatusMsg = $"The API returned {returnedCount} assessment(s), but none are dated within {termSnapshot} {yearSnapshot}. Check the assessment dates or term saved by the teacher.";
            else if (returnedCount == 0)
                submissionStatusMsg = "The assessment endpoints returned no assignments, tests, or exams for this level and field.";
        }
        catch
        {
            submissionStatusMsg = "The assessment request failed. Check the assessment endpoint response in the Railway logs.";
        }
        finally
        {
            isLoadingSubmissions = false;
            StateHasChanged();
        }
    }

