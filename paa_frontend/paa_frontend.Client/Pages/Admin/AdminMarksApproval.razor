                    "Consistent effort on daily homework exercises and coursework projects will support academic recovery.",
                    "The student should consult with the subject teacher regularly to ensure coursework meets expected standards."
                };
                balance = cwLowOptions[(int)(balanceSeed % (uint)cwLowOptions.Length)];
            }
        }

        var feedbackSentence = string.IsNullOrWhiteSpace(teacherFeedback)
            ? string.Empty
            : $"The recorded Staff Marks feedback is also noted: {teacherFeedback.Trim().TrimEnd('.')}.";
        return string.Join(" ", new[] { first, balance, feedbackSentence }.Where(s => !string.IsNullOrWhiteSpace(s)));
    }

    private static string GetCurrentTerm() => DateTime.Now.Month switch
    {
        <= 4 => "Term 1",
        <= 8 => "Term 2",
        _ => "Term 3"
    };

    private static int ParseTermNumber(string term) => term switch
    {
        "Term 1" => 1,
        "Term 2" => 2,
        "Term 3" => 3,
        _ => 1
    };

    private string GetStudentName(long id)
        => studentNames.TryGetValue(id, out var name) ? name : $"Student #{id}";

    private static string GetClassLabel(GenerationRosterRow row)
        => $"Form {row.Student.Form} {(string.IsNullOrWhiteSpace(row.Student.Classroom) ? "Unassigned class" : row.Student.Classroom.Trim())}";

    private static bool HasMissingMarks(GenerationRosterRow row)
        => row.Status is GenerationStatus.Partial or GenerationStatus.NoMarks or GenerationStatus.NoSubjectSetup
            || row.SubjectCoverage.Any(s => !s.IsComplete);

