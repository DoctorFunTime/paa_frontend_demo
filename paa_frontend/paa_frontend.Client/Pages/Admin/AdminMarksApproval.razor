                balance = cwMidOptions[(int)(balanceSeed % (uint)cwMidOptions.Length)];
            }
            else
            {
                var cwLowOptions = new[]
                {
                    "More consistent coursework submission and active participation in class activities are advised.",
                    "Regular completion of assignments and seeking timely help will support subject progress.",
                    "Punctual submission of all coursework tasks and careful attention to guidelines will help lift grades.",
                    "The student is urged to seek feedback on draft assignments to improve coursework quality.",
                    "Dedication to completing every assigned project and task will build a stronger academic foundation.",
