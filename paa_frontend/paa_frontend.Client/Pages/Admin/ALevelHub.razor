@page "/admin/academics/alevel"
@namespace paa_frontend.Client.Pages.Admin
@layout paa_frontend.Client.Layout.AdminPortalLayout
@using paa_frontend.Client.Services.Admin
@using static paa_frontend.Shared.Models.Admin.AlevelClassesModel
@inject AlevelClassServiceClient AClassService
@inject paa_frontend.Client.Services.StudentProfileServiceClient StudentProfileService
@inject StudentSubjectServiceClient SubjectService
@inject NavigationManager Nav

<style>
  .hub-hero{background:linear-gradient(135deg,#2e1065 0%,#4c1d95 45%,#6d28d9 100%);border-radius:1.5rem;padding:1.75rem 2rem;color:#fff;margin-bottom:2rem;position:relative;overflow:hidden}
  .hub-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 80% 50%,rgba(255,255,255,0.06) 0%,transparent 60%);border-radius:inherit}
  .hub-hero-content{position:relative;z-index:1}
  .metric-strip{display:grid;gap:.6rem;grid-template-columns:repeat(3,minmax(0,1fr))}
  .metric-chip{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);border-radius:1rem;padding:.9rem 1rem;backdrop-filter:blur(10px)}
  .chart-card{background:rgba(255,255,255,.78);backdrop-filter:blur(10px);border:1px solid #e2e8f0;border-radius:1.5rem;padding:1.25rem;box-shadow:0 1px 2px rgba(15,23,42,.04)}
  .progress-rail{height:.95rem;border-radius:9999px;background:#e2e8f0;overflow:hidden;border:1px solid rgba(148,163,184,.2)}
  .progress-rail > span{display:block;height:100%;border-radius:9999px}
  @@media(max-width:768px){.metric-strip{grid-template-columns:1fr}}
  .tab-btn { padding: 0.75rem 1.5rem; font-weight: 800; font-size: 0.875rem; border-radius: 0.75rem; transition: all 0.2s; }
  .tab-btn.active { background: #6d28d9; color: white; box-shadow: 0 4px 6px -1px rgba(109, 40, 217, 0.3); }
  .tab-btn.inactive { background: white; color: #64748b; border: 1px solid #e2e8f0; }
  .tab-btn.inactive:hover { background: #f8fafc; color: #475569; border-color: #cbd5e1; }
</style>

<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-slate-500 font-medium mb-6">
    <a href="/admin" class="hover:text-violet-600 transition-colors">Dashboard</a>
    <span class="text-slate-300">&rsaquo;</span>
    <a href="/admin/academics" class="hover:text-violet-600 transition-colors">Academics</a>
    <span class="text-slate-300">&rsaquo;</span>
    <span class="text-slate-800 font-bold">A-Level</span>
</div>

<!-- Hero -->
<div class="hub-hero shadow-lg">
    <div class="hub-hero-content flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <span class="inline-block px-3 py-1 rounded-full bg-white/20 text-white text-[length:0.65rem] font-extrabold uppercase tracking-widest mb-3 backdrop-blur-md border border-white/20">Form 5 &amp; 6</span>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-2">A-Level Management</h1>
            <p class="text-white/80 text-sm font-medium max-w-lg">Central hub for managing A-Level academic structures including class presets, subject catalogues, and student assignments.</p>
        </div>
        <div class="metric-strip w-full lg:w-[34rem]">
            <div class="metric-chip">
                <div class="text-white/70 text-[length:0.65rem] font-bold uppercase tracking-widest mb-1">Curriculum Footprint</div>
                <div class="text-xl font-black tracking-tight">@($"{subjectAmounts?.Count ?? 0} active subjects")</div>
                <div class="text-xs text-white/75 mt-1">Subjects currently used in student choices</div>
            </div>
            <div class="metric-chip">
                <div class="text-white/70 text-[length:0.65rem] font-bold uppercase tracking-widest mb-1">Class Mix</div>
                <div class="text-xl font-black tracking-tight">@($"{classAmounts?.Count ?? 0} active class groups")</div>
                <div class="text-xs text-white/75 mt-1">Form and classroom combinations in use</div>
            </div>
            <div class="metric-chip">
                <div class="text-white/70 text-[length:0.65rem] font-bold uppercase tracking-widest mb-1">Student Load</div>
                <div class="text-xl font-black tracking-tight">@($"{totalALevelStudents} students")</div>
                <div class="text-xs text-white/75 mt-1">Across the A-Level programme</div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(pageStatus))
{
    <div class="mb-5 p-4 rounded-2xl text-sm font-bold border @(pageError ? "bg-rose-50 text-rose-700 border-rose-200" : "bg-violet-50 text-violet-700 border-violet-200")">
        @pageStatus
    </div>
}

<!-- Navigation Tabs -->
<div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-8 bg-slate-50/50 p-2 rounded-2xl border border-slate-200/60 shadow-sm">
    <button class="tab-btn @(activeTab == "Overview" ? "active" : "inactive")" @onclick='() => activeTab = "Overview"'>Overview</button>
    <button class="tab-btn @(activeTab == "Classes" ? "active" : "inactive")" @onclick='() => activeTab = "Classes"'>Class Presets</button>
    <button class="tab-btn @(activeTab == "Subjects" ? "active" : "inactive")" @onclick='() => activeTab = "Subjects"'>Subjects Catalogue</button>
    <button class="tab-btn @(activeTab == "Students" ? "active" : "inactive")" @onclick='() => activeTab = "Students"'>Students</button>
</div>

<!-- Tab Content -->
<div class="animate-fade-in">
    @if (activeTab == "Overview")
    {
        <div class="grid grid-cols-1 xl:grid-cols-[1.1fr_0.9fr] gap-6 mb-6">
            @if (isLoading)
            {
                <div class="chart-card animate-pulse">
                    <div class="h-4 w-48 bg-slate-200 rounded mb-6"></div>
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-24 h-3 bg-slate-200 rounded"></div>
                            <div class="flex-1 h-3.5 bg-slate-100 rounded"></div>
                            <div class="w-8 h-3 bg-slate-200 rounded"></div>
                        </div>
                    }
                </div>
            }
            else if (classAmounts != null && classAmounts.Any())
            {
                int maxAmt = classAmounts.Max(a => a.Amount);
                <div class="chart-card">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-lg font-black text-slate-900 mb-1">Students by Class</h2>
                            <p class="text-xs font-medium text-slate-500">A clearer picture of where A-Level demand is concentrated by form and classroom.</p>
                        </div>
                        <div class="w-10 h-10 rounded-2xl bg-violet-50 text-violet-600 flex items-center justify-center">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        </div>
                    </div>
                    
                    <div class="space-y-4">
                        @foreach (var row in classAmounts)
                        {
                            double pct = maxAmt > 0 ? (row.Amount / (double)maxAmt) * 100 : 0;
                            <div class="flex items-center gap-4 group">
                                <div class="w-24 shrink-0 flex items-center gap-2">
                                    <span class="w-7 py-0.5 rounded bg-slate-100 text-center text-[length:0.6rem] font-extrabold text-slate-600 border border-slate-200">F@(row.Form)</span>
                                    <span class="text-xs font-bold text-slate-700 truncate">@(string.IsNullOrEmpty(row.ClassName) ? "No class set" : row.ClassName)</span>
                                </div>
                                <div class="flex-1 progress-rail shadow-inner">
                                    <span class="transition-all duration-1000 relative overflow-hidden group-hover:opacity-80" style="width:@(pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;background:linear-gradient(90deg, #8b5cf6, #6d28d9);"></span>
                                </div>
                                <div class="w-10 text-right shrink-0">
                                    <span class="text-xs font-black text-slate-900">@row.Amount</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="chart-card text-center flex flex-col items-center justify-center min-h-[300px]">
                    <div class="w-14 h-14 bg-slate-100 text-slate-400 rounded-2xl flex items-center justify-center mb-4">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    </div>
                    <h3 class="text-sm font-extrabold text-slate-900 mb-1">No Headcount Data</h3>
                    <p class="text-xs text-slate-500">No students are currently assigned to A-Level classes.</p>
                </div>
            }

            @if (isLoading)
            {
                <div class="chart-card animate-pulse">
                    <div class="h-4 w-48 bg-slate-200 rounded mb-6"></div>
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-24 h-3 bg-slate-200 rounded"></div>
                            <div class="flex-1 h-3.5 bg-slate-100 rounded"></div>
                            <div class="w-8 h-3 bg-slate-200 rounded"></div>
                        </div>
                    }
                </div>
            }
            else if (subjectAmounts != null && subjectAmounts.Any())
            {
                int maxSubjAmt = subjectAmounts.Max(kv => kv.Value);
                <div class="chart-card">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-lg font-black text-slate-900 mb-1">Subject Popularity</h2>
                            <p class="text-xs font-medium text-slate-500">Which subjects are carrying the heaviest enrollment across student selections.</p>
                        </div>
                        <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                        </div>
                    </div>
                    
                    <div class="space-y-4 max-h-[400px] overflow-y-auto pr-2 custom-scrollbar">
                        @foreach (var kv in subjectAmounts.Take(10))
                        {
                            double pct = maxSubjAmt > 0 ? (kv.Value / (double)maxSubjAmt) * 100 : 0;
                            <div class="flex items-center gap-4 group">
                                <div class="w-28 shrink-0">
                                    <span class="text-xs font-bold text-slate-700 truncate block">@kv.Key</span>
                                </div>
                                <div class="flex-1 progress-rail shadow-inner">
                                    <span class="transition-all duration-1000 relative overflow-hidden group-hover:opacity-80" style="width:@(pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;background:linear-gradient(90deg, #3b82f6, #1d4ed8);"></span>
                                </div>
                                <div class="w-10 text-right shrink-0">
                                    <span class="text-xs font-black text-slate-900">@kv.Value</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="chart-card text-center flex flex-col items-center justify-center min-h-[300px]">
                    <div class="w-14 h-14 bg-slate-100 text-slate-400 rounded-2xl flex items-center justify-center mb-4">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    </div>
                    <h3 class="text-sm font-extrabold text-slate-900 mb-1">No Subjects Data</h3>
                    <p class="text-xs text-slate-500">No students are currently assigned to subjects.</p>
                </div>
            }
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-[0.95fr_1.05fr] gap-6">
            <div class="chart-card">
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h2 class="text-lg font-black text-slate-900 mb-1">Form Balance</h2>
                        <p class="text-xs font-medium text-slate-500">How A-Level enrollment is split between Form 5 and Form 6.</p>
                    </div>
                    <div class="w-10 h-10 rounded-2xl bg-fuchsia-50 text-fuchsia-600 flex items-center justify-center">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 4-6"/></svg>
                    </div>
                </div>
                @{
                    var form5Total = classAmounts?.Where(a => a.Form == 5).Sum(a => a.Amount) ?? 0;
                    var form6Total = classAmounts?.Where(a => a.Form == 6).Sum(a => a.Amount) ?? 0;
                    var totalForms = form5Total + form6Total;
                    var form5Pct = totalForms > 0 ? form5Total / (double)totalForms * 100d : 0d;
                    var form6Pct = totalForms > 0 ? form6Total / (double)totalForms * 100d : 0d;
                }
                <div class="progress-rail h-5 mb-5">
                    <span class="flex" style="width:100%;background:transparent;">
                        <span style="width:@(form5Pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;display:block;height:100%;background:linear-gradient(90deg,#c084fc,#7c3aed)"></span>
                        <span style="width:@(form6Pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;display:block;height:100%;background:linear-gradient(90deg,#60a5fa,#2563eb)"></span>
                    </span>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-3">
                        <div>
                            <div class="text-sm font-black text-slate-900">Form 5</div>
                            <div class="text-xs text-slate-500">Entry into A-Level specialization</div>
                        </div>
                        <div class="text-right">
                            <div class="text-sm font-black text-slate-900">@form5Total</div>
                            <div class="text-[length:0.65rem] uppercase tracking-widest text-slate-400">@($"{form5Pct:0}%")</div>
                        </div>
                    </div>
                    <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-3">
                        <div>
                            <div class="text-sm font-black text-slate-900">Form 6</div>
                            <div class="text-xs text-slate-500">Final-year exam cohort</div>
                        </div>
                        <div class="text-right">
                            <div class="text-sm font-black text-slate-900">@form6Total</div>
                            <div class="text-[length:0.65rem] uppercase tracking-widest text-slate-400">@($"{form6Pct:0}%")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="chart-card">
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h2 class="text-lg font-black text-slate-900 mb-1">Programme Snapshot</h2>
                        <p class="text-xs font-medium text-slate-500">A quick visual read of how broad the current A-Level setup is.</p>
                    </div>
                    <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 2v20"/><path d="M2 12h20"/><circle cx="12" cy="12" r="9"/></svg>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="rounded-2xl border border-slate-200 bg-white p-4">
                        <div class="text-[length:0.65rem] uppercase tracking-widest font-bold text-slate-400 mb-2">Class Presets</div>
                        <div class="text-2xl font-black text-slate-900">@(classNames?.Count ?? 0)</div>
                        <div class="text-xs text-slate-500 mt-1">Configured A-Level class names</div>
                    </div>
                    <div class="rounded-2xl border border-slate-200 bg-white p-4">
                        <div class="text-[length:0.65rem] uppercase tracking-widest font-bold text-slate-400 mb-2">Top Subject</div>
                        <div class="text-base font-black text-slate-900">@(subjectAmounts?.Any() == true ? subjectAmounts.First().Key : "No subject data")</div>
                        <div class="text-xs text-slate-500 mt-1">Most frequently chosen right now</div>
                    </div>
                    <div class="rounded-2xl border border-slate-200 bg-white p-4">
                        <div class="text-[length:0.65rem] uppercase tracking-widest font-bold text-slate-400 mb-2">Choice Volume</div>
                        <div class="text-2xl font-black text-slate-900">@((subjectAmounts?.Sum(kv => kv.Value)) ?? 0)</div>
                        <div class="text-xs text-slate-500 mt-1">Total subject selections counted</div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeTab == "Classes")
    {
        <ALevelClasses />
    }
    else if (activeTab == "Subjects")
    {
        <ALevelSubjects />
    }
    else if (activeTab == "Students")
    {
        <ALevelStudents OnChanged="RefreshOverviewDataAsync" />
    }
    else if (activeTab == "Assessments")
    {
        <AdminAssessmentsBrowser Level="alevel" AccentColor="#6d28d9" />
    }
</div>

@code {
    private string activeTab = "Overview";
    private List<AlevelClassName>? classNames;
    private List<AlevelClassAmount>? classAmounts;
    private Dictionary<string, int>? subjectAmounts;
    private int totalALevelStudents = 0;
    private bool isLoading = true;
    private string pageStatus = string.Empty;
    private bool pageError;

    protected override async Task OnInitializedAsync() => await RefreshOverviewDataAsync();

    private async Task RefreshOverviewDataAsync()
    {
        isLoading = true;
        try
        {
            var namesTask = AClassService.GetAllAlevelClassNamesAsync();
            var studentsTask = StudentProfileService.GetStudentsAsync();
            var choicesTask = SubjectService.GetStudentALevelSubjectChoicesAsync();

            await Task.WhenAll(namesTask, studentsTask, choicesTask);
            
            classNames = namesTask.Result;
            
            var aLevelStudents = studentsTask.Result
                .Where(s => s.Form == 5 || s.Form == 6)
                .ToList();
                
            totalALevelStudents = aLevelStudents.Count;

            classAmounts = aLevelStudents
                .GroupBy(s => new { s.Form, s.Classroom })
                .Select(g => new AlevelClassAmount 
                { 
                    Form = g.Key.Form ?? 0, 
                    ClassName = string.IsNullOrWhiteSpace(g.Key.Classroom) ? "No class set" : g.Key.Classroom, 
                    Amount = g.Count() 
                })
                .Where(a => a.Form > 0)
                .OrderBy(a => a.Form)
                .ThenBy(a => a.ClassName)
                .ToList();

            var choices = choicesTask.Result;
            var subjectCounts = new Dictionary<string, int>();
            
            foreach (var choice in choices)
            {
                foreach (var subj in choice.Subjects)
                {
                    if (subjectCounts.ContainsKey(subj)) subjectCounts[subj]++;
                    else subjectCounts[subj] = 1;
                }
            }
            subjectAmounts = subjectCounts.OrderByDescending(kv => kv.Value).ToDictionary(kv => kv.Key, kv => kv.Value);
            pageStatus = string.Empty;
            pageError = false;
        }
        catch
        {
            classNames = new();
            classAmounts = new();
            subjectAmounts = new();
            pageStatus = "Some A-Level data could not be loaded right now. Please refresh and try again.";
            pageError = true;
        }
        finally { isLoading = false; }
    }
}
