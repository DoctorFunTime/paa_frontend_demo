@code {
    // ── Events / context ────────────────────────────────────────────────
    private List<EntitlementEvent> activeEvents = new();
    private string selectedContext = "FEES";

    // ── Mode / state ────────────────────────────────────────────────────
    private bool isVerifying;
    private bool webNfcSupported;
    private bool isWebNfcActive;
    private string nfcRingClass = "ring-idle";

    // ── Results ─────────────────────────────────────────────────────────
    private FinanceValidationResult? lastResult;
    private string errorMessage = string.Empty;

    // ── DotNetReference ──────────────────────────────────────────────────
    private DotNetObjectReference<StudentPassScanner>? scannerReference;

    // ── History ──────────────────────────────────────────────────────────
    private record ScanEntry(string Label, bool Allowed, string Reason, DateTime At);
    private readonly List<ScanEntry> scanHistory = new();

    // ── Lifecycle ────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        scannerReference = DotNetObjectReference.Create(this);
        activeEvents = new();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        webNfcSupported = await JS.InvokeAsync<bool>("studentPassScanner.isWebNfcSupported");
        if (webNfcSupported)
        {
            await StartWebNfcAsync();
        }
        StateHasChanged();
    }

    // ── NFC Scanning Controls ────────────────────────────────────────────

    private async Task StartWebNfcAsync()
    {
        errorMessage = string.Empty;
        if (!webNfcSupported)
        {
            errorMessage = "Web NFC is not supported on this device/browser.";
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("studentPassScanner.startWebNfc", scannerReference);
            isWebNfcActive = true;
            nfcRingClass = "ring-idle";
        }
        catch (JSException ex)
        {
            errorMessage = ex.Message;
            isWebNfcActive = false;
        }
        StateHasChanged();
    }

    private async Task StopWebNfcAsync()
    {
        if (isWebNfcActive)
            await JS.InvokeVoidAsync("studentPassScanner.stopWebNfc");

        isWebNfcActive = false;
        StateHasChanged();
    }

    [JSInvokable]
    public Task ReceiveNfcCode(string nfcCode) => ProcessScanAsync(nfcCode);

    // ── Core verification: calls finance backend ─────────────────────────

    public async Task ProcessScanAsync(string nfcCode)
    {
        if (isVerifying || string.IsNullOrWhiteSpace(nfcCode)) return;

        isVerifying = true;
        nfcRingClass = "ring-active";
        lastResult = null;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var result = await FinanceService.ValidateCardAsync(nfcCode.Trim());

            if (result == null)
            {
                errorMessage = $"No finance validation response for card {nfcCode}.";
                nfcRingClass = "ring-idle";
                return;
            }

            lastResult = result;
            nfcRingClass = result.Allowed ? "ring-ok" : "ring-err";

            var label = result.StudentId.HasValue ? $"Student {result.StudentId.Value}" : nfcCode;
            scanHistory.Insert(0, new ScanEntry(label, result.Allowed, result.Reason, DateTime.Now));
        }
        catch (Exception ex)
        {
            errorMessage = $"Verification failed: {ex.Message}";
            nfcRingClass = "ring-idle";
        }
        finally
        {
            isVerifying = false;
            StateHasChanged();

            // Hold result on screen for 4 s then reset
            await Task.Delay(4000);
            lastResult = null;
            nfcRingClass = "ring-idle";
            StateHasChanged();
        }
    }

    // ── Reason mapping ───────────────────────────────────────────────────

    private string ReasonToMessage(string reason) => reason switch
    {
        "No account associated with this card" => "Card not registered in finance.",
        "Account is blocked" => "Account suspended. See finance office.",
        "Insufficient funds" => "Outstanding fees owed.",
        "Special pass already scanned today" => "Special pass already used today.",
        "Pass already scanned today" => "Already scanned today.",
        "Validation could not be completed" => "Validation error. Contact admin.",
        _ when reason.StartsWith("Special pass accepted:") => reason,
        _ => reason
    };

    public void Dispose() => scannerReference?.Dispose();
}
