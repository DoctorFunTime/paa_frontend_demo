@page "/under-maintenance"
@layout paa_frontend.Client.Layout.EmptyLayout

<PageTitle>Maintenance in Progress | PrimeApp Demo</PageTitle>

<div class="maintenance-container">
    <!-- Animated background bubbles/tools -->
    <div class="floating-bg-elements">
        <div class="floating-item item-wrench">🔧</div>
        <div class="floating-item item-gear">⚙️</div>
        <div class="floating-item item-hammer">🔨</div>
        <div class="floating-item item-sparkle">✨</div>
        <div class="floating-item item-nut">🔩</div>
    </div>

    <!-- Main Card -->
    <div class="maintenance-card">
        <!-- Logo -->
        <img src="/images/demo-logo.svg" alt="PrimeApp Demo logo" class="school-logo animate-pulse" />

        <!-- Cartoon Animation Area -->
        <div class="cartoon-canvas">
            <!-- Animated SVG Scene -->
            <svg viewBox="0 0 400 300" class="cartoon-svg" width="100%" height="240">
                <!-- Shadow/Platform -->
                <ellipse cx="200" cy="270" rx="120" ry="12" fill="rgba(15, 23, 42, 0.08)" />

                <!-- The Console/Server Rack -->
                <rect x="140" y="120" width="120" height="130" rx="15" fill="#1e293b" stroke="#334155" stroke-width="6" />
                <!-- Screen on Console -->
                <rect x="155" y="135" width="90" height="50" rx="8" fill="#0f172a" />
                
                <!-- Screen Status Codes / Code Lines -->
                <rect x="165" y="145" width="40" height="4" rx="2" fill="#10b981" class="pulse-light" />
                <rect x="165" y="153" width="70" height="4" rx="2" fill="#6366f1" />
                <rect x="165" y="161" width="55" height="4" rx="2" fill="#f59e0b" />
                <rect x="165" y="169" width="30" height="4" rx="2" fill="#ef4444" />
                
                <!-- Blinking LED lights -->
                <circle cx="160" cy="210" r="6" fill="#ef4444" class="blink-led-red" />
                <circle cx="180" cy="210" r="6" fill="#10b981" class="blink-led-green" />
                <circle cx="200" cy="210" r="6" fill="#3b82f6" class="blink-led-blue" />

                <!-- Console Buttons -->
                <rect x="220" y="202" width="25" height="15" rx="4" fill="#475569" />
                <circle cx="232" cy="210" r="3" fill="#cbd5e1" />

                <!-- Big Spinning Gear -->
                <g class="gear gear-big" transform="translate(100, 110)">
                    <circle cx="0" cy="0" r="32" fill="#94a3b8" />
                    <!-- Teeth -->
                    @for (int i = 0; i < 8; i++)
                    {
                        var angle = i * 45;
                        <rect x="-8" y="-40" width="16" height="16" rx="3" fill="#94a3b8" transform="rotate(@angle, 0, 0)" />
                    }
                    <circle cx="0" cy="0" r="14" fill="#f8fafc" />
                </g>

                <!-- Small Spinning Gear -->
                <g class="gear gear-small" transform="translate(142, 66)">
                    <circle cx="0" cy="0" r="20" fill="#cbd5e1" />
                    <!-- Teeth -->
                    @for (int i = 0; i < 6; i++)
                    {
                        var angle = i * 60;
                        <rect x="-5" y="-25" width="10" height="10" rx="2" fill="#cbd5e1" transform="rotate(@angle, 0, 0)" />
                    }
                    <circle cx="0" cy="0" r="8" fill="#f8fafc" />
                </g>

                <!-- Floating Cartoon Robot (Mascot) -->
                <g class="robot-bob">
                    <!-- Robot Body -->
                    <rect x="260" y="60" width="60" height="50" rx="12" fill="#3b82f6" stroke="#1d4ed8" stroke-width="4" />
                    <!-- Screen/Face -->
                    <rect x="270" y="68" width="40" height="25" rx="6" fill="#0f172a" />
                    <!-- Blinking Eyes -->
                    <circle cx="282" cy="80" r="4" fill="#60a5fa" class="robot-eye" />
                    <circle cx="298" cy="80" r="4" fill="#60a5fa" class="robot-eye" />
                    <!-- Antenna -->
                    <line x1="290" y1="60" x2="290" y2="40" stroke="#1d4ed8" stroke-width="4" />
                    <circle cx="290" cy="38" r="6" fill="#ef4444" class="antenna-glow" />
                    <!-- Floating jets/exhaust -->
                    <path d="M 280 112 Q 290 130 300 112 Z" fill="#f59e0b" class="robot-jet" />
                    <!-- Robot Arm with Swinging Wrench -->
                    <g class="robot-arm">
                        <!-- Arm segment -->
                        <rect x="235" y="80" width="30" height="10" rx="5" fill="#2563eb" transform="rotate(-15, 260, 85)" />
                        <!-- Wrench -->
                        <g class="swinging-wrench">
                            <path d="M -10 -5 L 20 -5 L 20 5 L -10 5 Z" fill="#94a3b8" />
                            <circle cx="20" cy="0" r="8" fill="#94a3b8" />
                            <circle cx="20" cy="0" r="4" fill="#f8fafc" />
                            <path d="M -12 -12 L -6 -6 L -18 0 L -6 6 L -12 12 C -20 8 -20 -8 -12 -12 Z" fill="#94a3b8" />
                        </g>
                    </g>
                </g>
            </svg>
        </div>

        <!-- Content -->
        <h1 class="maintenance-title">We're Tuning Things Up!</h1>
        <p class="maintenance-sub">
            The PrimeApp Demo portal is temporarily undergoing planned maintenance. We're polishing the database gears and will be back shortly!
        </p>

        <!-- Status Details -->
        <div class="status-panel">
            <div class="status-row">
                <span class="status-label">Current Status:</span>
                <span class="status-badge">Optimizing Server Performance</span>
            </div>
            <div class="status-bar-bg">
                <div class="status-bar-fill" style="width: 82%;"></div>
            </div>
            <div class="status-row text-xs mt-1">
                <span class="text-slate-400">Database migration (82% complete)</span>
                <span class="font-bold text-slate-600">Est: ~15 mins</span>
            </div>
        </div>

        <!-- Actions -->
        <div class="action-row">
            <button class="btn-refresh" @onclick="RefreshPage">
                <svg class="refresh-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                Check Status
            </button>
            <a href="/" class="btn-back">Go to Safety</a>
        </div>
    </div>
</div>

<style>
    /* Styling System */
    .maintenance-container {
        min-height: 100vh;
        width: 100%;
        background-color: #F8FAFC;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        position: relative;
        font-family: 'Outfit', 'Inter', system-ui, sans-serif;
        overflow: hidden;
    }

    /* Background animations */
    .floating-bg-elements {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .floating-item {
        position: absolute;
        font-size: 24px;
        opacity: 0.15;
    }

    .item-wrench { top: 15%; left: 10%; animation: float-bubble 12s ease-in-out infinite alternate; }
    .item-gear { top: 25%; right: 12%; animation: float-bubble 16s ease-in-out infinite alternate-reverse; font-size: 32px; }
    .item-hammer { bottom: 20%; left: 15%; animation: float-bubble 14s ease-in-out infinite alternate; }
    .item-sparkle { top: 60%; right: 20%; animation: float-bubble 10s ease-in-out infinite alternate; }
    .item-nut { bottom: 15%; right: 40%; animation: float-bubble 18s ease-in-out infinite alternate-reverse; }

    @@keyframes float-bubble {
        0% { transform: translateY(0) rotate(0deg); }
        100% { transform: translateY(-40px) rotate(360deg); }
    }

    /* Premium glassmorphic card */
    .maintenance-card {
        position: relative;
        z-index: 10;
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
        border-radius: 32px;
        padding: 40px;
        max-width: 520px;
        width: 100%;
        text-align: center;
        display: flex;
        flex-col: column;
        flex-direction: column;
        align-items: center;
        animation: card-appear 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes card-appear {
        0% { transform: translateY(30px); opacity: 0; }
        100% { transform: translateY(0); opacity: 1; }
    }

    .school-logo {
        height: 60px;
        width: auto;
        object-contain: contain;
        margin-bottom: 12px;
        filter: drop-shadow(0 4px 6px rgba(0,0,0,0.05));
    }

    /* Cartoon SVG styles and keyframes */
    .cartoon-canvas {
        width: 100%;
        max-width: 380px;
        margin-bottom: 10px;
    }

    .cartoon-svg {
        overflow: visible;
    }

    /* Gears */
    .gear-big {
        transform-origin: 100px 110px;
        animation: spin-clockwise 10s linear infinite;
    }

    .gear-small {
        transform-origin: 142px 66px;
        animation: spin-counter 6s linear infinite;
    }

    @@keyframes spin-clockwise {
        from { transform: translate(100px, 110px) rotate(0deg); }
        to { transform: translate(100px, 110px) rotate(360deg); }
    }

    @@keyframes spin-counter {
        from { transform: translate(142px, 66px) rotate(0deg); }
        to { transform: translate(142px, 66px) rotate(-360deg); }
    }

    /* Robot bobbing animation */
    .robot-bob {
        animation: robot-float 3.5s ease-in-out infinite alternate;
    }

    @@keyframes robot-float {
        0% { transform: translateY(0px) translateX(0px); }
        100% { transform: translateY(-12px) translateX(2px); }
    }

    /* Jet flames pulse */
    .robot-jet {
        animation: jet-pulse 0.3s ease-in-out infinite alternate;
        transform-origin: 290px 112px;
    }

    @@keyframes jet-pulse {
        0% { transform: scaleY(0.85) scaleX(0.95); opacity: 0.8; }
        100% { transform: scaleY(1.2) scaleX(1.05); opacity: 1; }
    }

    /* Swinging Wrench Arm */
    .robot-arm {
        transform-origin: 260px 85px;
        animation: arm-move 2.5s ease-in-out infinite alternate;
    }

    .swinging-wrench {
        transform-origin: 235px 80px;
        transform: translate(220px, 80px) rotate(-30deg);
        animation: wrench-swing 2.5s ease-in-out infinite alternate;
    }

    @@keyframes arm-move {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(15deg); }
    }

    @@keyframes wrench-swing {
        0% { transform: translate(220px, 80px) rotate(-15deg); }
        100% { transform: translate(220px, 80px) rotate(35deg); }
    }

    /* Blink LEDs */
    .blink-led-red { animation: led-blink 0.8s infinite alternate; }
    .blink-led-green { animation: led-blink 1.2s infinite alternate; }
    .blink-led-blue { animation: led-blink 1.6s infinite alternate; }

    @@keyframes led-blink {
        0% { opacity: 0.3; }
        100% { opacity: 1; }
    }

    .pulse-light {
        animation: led-blink 2s infinite alternate;
    }

    /* Robot Eye blink */
    .robot-eye {
        animation: eye-blink 4s infinite;
    }

    @@keyframes eye-blink {
        0%, 95%, 100% { transform: scaleY(1); }
        97% { transform: scaleY(0.1); }
    }

    .antenna-glow {
        animation: led-blink 0.5s infinite alternate;
    }

    /* Typography */
    .maintenance-title {
        font-size: 28px;
        font-weight: 900;
        color: #0F172A;
        letter-spacing: -0.8px;
        margin-bottom: 12px;
    }

    .maintenance-sub {
        font-size: 14px;
        font-weight: 500;
        color: #64748B;
        line-height: 1.6;
        margin-bottom: 24px;
        max-width: 440px;
    }

    /* Status Bar Panel */
    .status-panel {
        width: 100%;
        background: rgba(15, 23, 42, 0.03);
        border: 1px solid rgba(15, 23, 42, 0.05);
        border-radius: 20px;
        padding: 16px 20px;
        margin-bottom: 30px;
        text-align: left;
    }

    .status-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .status-label {
        font-size: 11px;
        font-weight: 800;
        color: #94A3B8;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .status-badge {
        font-size: 11px;
        font-weight: 700;
        color: #2563EB;
        background: #EFF6FF;
        padding: 4px 10px;
        border-radius: 12px;
        border: 1px solid #DBEAFE;
    }

    .status-bar-bg {
        width: 100%;
        height: 8px;
        background: #E2E8F0;
        border-radius: 10px;
        overflow: hidden;
    }

    .status-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #3B82F6 0%, #6366F1 100%);
        border-radius: 10px;
        animation: progress-slide 2.5s ease-in-out infinite alternate;
    }

    /* Action Buttons */
    .action-row {
        display: flex;
        gap: 12px;
        width: 100%;
    }

    .btn-refresh {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 24px;
        background: #0F172A;
        color: #FFFFFF;
        border: none;
        border-radius: 16px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    }

    .btn-refresh:hover {
        background: #1E293B;
        transform: translateY(-1px);
    }

    .refresh-icon {
        transition: transform 0.6s ease;
    }

    .btn-refresh:active .refresh-icon {
        transform: rotate(360deg);
    }

    .btn-back {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 24px;
        background: #FFFFFF;
        color: #475569;
        border: 1px solid #E2E8F0;
        border-radius: 16px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-back:hover {
        background: #F8FAFC;
        color: #0F172A;
        border-color: #CBD5E1;
        transform: translateY(-1px);
    }

    /* Responsiveness */
    @@media (max-width: 640px) {
        .maintenance-card {
            padding: 30px 20px;
            border-radius: 24px;
        }

        .maintenance-title {
            font-size: 22px;
        }

        .action-row {
            flex-direction: column;
        }

        .btn-refresh, .btn-back {
            width: 100%;
        }
    }
</style>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void RefreshPage()
    {
        // Simply reloads the component to check state
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
