    private async Task LoadAttendanceForCurrentCardAsync()
    {
        attendanceTotal = 0; attendancePresent = 0; attendancePercent = 0;
        if (CurrentCard == null) return;

        try
        {
            var range = GradeHelper.TermMonthRange(CurrentCard.Term ?? string.Empty);
            var start = new DateOnly(CurrentCard.TermYear, range.Start, 1);
            var end = new DateOnly(CurrentCard.TermYear, range.End, DateTime.DaysInMonth(CurrentCard.TermYear, range.End));

            var records = await AttendanceService.GetRecordsByPersonAndDateRangeAsync(Me.Id, start, end);
            var sessions = await AttendanceService.GetSessionsByDateRangeAsync(start, end);
            if (records != null)
            {
                var sessionDateMap = new Dictionary<long, DateOnly>();
                if (sessions != null)
                {
                    foreach (var session in sessions)
                        sessionDateMap[session.Id] = session.Date;
                }

                var datedRecords = records
                    .Where(r => sessionDateMap.ContainsKey(r.SessionId))
                    .GroupBy(r => sessionDateMap[r.SessionId])
                    .Select(g => g.First())
                    .ToList();

                attendanceTotal = datedRecords.Count;
                attendancePresent = datedRecords.Count(r =>
                    string.Equals(r.Status, "Present", StringComparison.OrdinalIgnoreCase));
                attendancePercent = attendanceTotal > 0 ? (int)(attendancePresent * 100 / attendanceTotal) : 0;
            }
        }
        catch { }
    }

    private async Task RefreshCurrentCardAsync()
    {
        _currentCardCache = allReportCards.FirstOrDefault(
            rc => string.Equals(rc.Term, selectedTerm, StringComparison.OrdinalIgnoreCase) && rc.TermYear == selectedTermYear);

        _currentSubjectsCache = _currentCardCache?.Subjects ?? new List<ReportCardSubjectModel>();
        _avgMarkCache = _currentSubjectsCache.Any() ? _currentSubjectsCache.Average(s => s.FinalMark) : 0;

        subjectsRecorded = _currentSubjectsCache.Count;
        subjectsPassed = _currentSubjectsCache.Count(s => s.FinalMark >= 50);

        try { await LoadAttendanceForCurrentCardAsync(); }
        catch { }

        try { await LoadPositionInFormAsync(); }
        catch { positionInForm = null; }

        try { await LoadDetailedFeedbackAsync(); }
        catch { }
    }

    private Dictionary<string, List<ExamMarkDTO>> examFeedbackBySubject = new();

    // ── CHANGED: was List<double>, now List<MarkEntry> ──
    private Dictionary<string, List<MarkEntry>> courseworkMarksBySubject = new();

    private bool isLoadingDetailedFeedback = false;
    private HashSet<string> expandedSubjects = new();

    private void ToggleSubject(string subject)
    {
        if (expandedSubjects.Contains(subject))
            expandedSubjects.Remove(subject);
        else
            expandedSubjects.Add(subject);
    }

    private async Task LoadDetailedFeedbackAsync()
    {
        examFeedbackBySubject.Clear();
        courseworkMarksBySubject.Clear();
        if (CurrentCard == null) return;
        isLoadingDetailedFeedback = true;
        StateHasChanged();
        try
        {
            int termInt = selectedTerm == "Term 1" ? 1 : selectedTerm == "Term 2" ? 2 : selectedTerm == "Term 3" ? 3 : 1;
            int year = selectedTermYear;

            string field = "default";
            if (Me.Form == 3 || Me.Form == 4)
            {
                if (!string.IsNullOrWhiteSpace(Me.Classroom))
                {
                    if (Me.Classroom.Contains("Sciences", StringComparison.OrdinalIgnoreCase)) field = "Sciences";
                    else if (Me.Classroom.Contains("Commercials", StringComparison.OrdinalIgnoreCase)) field = "Commercials";
                    else if (Me.Classroom.Contains("Arts", StringComparison.OrdinalIgnoreCase)) field = "Arts";
                }
            }

            var examTask = GradesService.GetExamMarksAsync(Me.Id, termInt, year, field);
            var cwTask = GradesService.GetCourseworkMarksAsync(Me.Id, termInt, year, field);

            await Task.WhenAll(examTask, cwTask);

            var examResponse = await examTask;
            if (examResponse?.MarksBySubject != null)
                examFeedbackBySubject = examResponse.MarksBySubject;

            // ── CHANGED: assign directly; types now match ──
            var cwResponse = await cwTask;
            if (cwResponse?.CourseMarks != null)
                courseworkMarksBySubject = cwResponse.CourseMarks;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading detailed feedback: {ex.Message}");
        }
        finally
        {
            isLoadingDetailedFeedback = false;
            StateHasChanged();
        }
    }

    private async Task LoadPositionInFormAsync()
    {
        positionInForm = null;
        if (CurrentCard == null) return;

        var allStudents = await StudentService.GetStudentsAsync();
        var formMates = allStudents
            .Where(s => s.Id != 0 && s.Form == (CurrentCard.StudentForm ?? Me.Form))
            .ToList();

        if (!formMates.Any()) return;

        var averages = new List<(long StudentId, double Average)>();

        foreach (var batch in formMates.Chunk(5))
        {
            var batchResults = await Task.WhenAll(batch.Select(async student =>
            {
                try
                {
                    var cards = await GradesService.GetReportCardsAsync(student.Id);
                    var matchingCard = cards?.FirstOrDefault(rc =>
                        rc.Term == CurrentCard.Term &&
                        rc.TermYear == CurrentCard.TermYear);

                    if (matchingCard?.Subjects?.Any() == true)
                        return (StudentId: (long)student.Id, Average: matchingCard.Subjects.Average(s => s.FinalMark), HasData: true);
                }
                catch { }
                return (StudentId: (long)student.Id, Average: 0.0, HasData: false);
            }));

            averages.AddRange(batchResults.Where(r => r.HasData).Select(r => (r.StudentId, r.Average)));
        }

        if (!averages.Any()) return;

        var ranked = averages
            .OrderByDescending(x => x.Average)
            .ThenBy(x => x.StudentId)
            .ToList();

        var index = ranked.FindIndex(x => x.StudentId == Me.Id);
        if (index >= 0)
            positionInForm = index + 1;
    }

    private static string OrdinalSuffix(int number)
    {
        var absNumber = Math.Abs(number);
        var lastTwoDigits = absNumber % 100;

        if (lastTwoDigits is 11 or 12 or 13)
            return "th";

        return (absNumber % 10) switch
        {
            1 => "st",
            2 => "nd",
            3 => "rd",
            _ => "th"
        };
    }

    private static string FormatClassroom(int? form, string? classroom)
    {
        if (form.HasValue && !string.IsNullOrWhiteSpace(classroom))
        {
            if (classroom.StartsWith("Form", StringComparison.OrdinalIgnoreCase))
                return classroom;
            return $"Form {form} {classroom}";
        }
        if (form.HasValue) return $"Form {form}";
        return classroom ?? string.Empty;
    }
