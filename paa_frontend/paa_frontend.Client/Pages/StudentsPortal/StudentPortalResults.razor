@code {

    private MarkupString SvgText(double x, double y, string content, string fill,
       string anchor = "middle", double fontSize = 7, string fontWeight = "normal", double opacity = 1)
    {
        var safeContent = System.Net.WebUtility.HtmlEncode(content);
        var text = $"<text x=\"{x.ToString("F1")}\" y=\"{y.ToString("F1")}\" text-anchor=\"{anchor}\" font-size=\"{fontSize}\" fill=\"{fill}\" font-weight=\"{fontWeight}\" opacity=\"{opacity}\">{safeContent}</text>";
        return (MarkupString)text;
    }

    private string GetHeadmasterRemarks(int passed, int recorded, double overallAvg, string? firstName, long studentId, string term, int year)
    {
        var name = string.IsNullOrWhiteSpace(firstName) ? "The student" : firstName.Trim();
        double passRate = recorded > 0 ? ((double)passed / recorded) * 100.0 : 0.0;

        string[] remarksPool;

        if (passRate >= 100.0)
        {
            remarksPool = new[]
            {
                $"A distinguished academic performance across the board. By securing a flawless 100% pass rate ({passed} of {recorded} subjects passed) with an overall average of {overallAvg:F1}%, {name} has demonstrated exemplary scholarly discipline, intellectual versatility, and steadfast commitment to academic excellence. Such comprehensive attainment reflects both rigorous preparation and admirable work habits. The college commends this outstanding dedication and encourages {name} to maintain this trajectory of distinction in future terms.",
                $"An exceptional term of academic achievement characterized by complete subject mastery. Achieving a 100% pass rate in all {recorded} recorded disciplines alongside an impressive overall average of {overallAvg:F1}% is a testament to {name}'s intellectual maturity, focus, and scholarly diligence. {name} has set an inspiring standard of academic citizenship within the college, demonstrating deep syllabus engagement. We anticipate continued academic leadership and distinction from {name} as studies progress.",
                $"With an unblemished 100% pass rate across all {recorded} assessed disciplines and an overall average of {overallAvg:F1}%, {name} has delivered an all-around impressive performance this term. Maintaining such high quality and consistency across diverse syllabus demands reflects superior academic discipline, analytical precision, and personal responsibility. The administration extends warmest congratulations and looks forward to seeing {name} build upon this stellar foundation.",
                $"Superb performance throughout the academic session. Attaining passes in all {recorded} subjects with an overall average of {overallAvg:F1}% represents total curricular mastery and well-rounded intellectual engagement. {name} approaches scholarly obligations with maturity, self-direction, and consistent poise under assessment conditions. Continued application of these high standards will ensure sustained distinction throughout {name}'s academic journey."
            };
        }
        else if (passRate >= 80.0)
        {
            remarksPool = new[]
            {
                $"A thoroughly solid and encouraging academic term, achieving a {passRate:F0}% pass rate ({passed} of {recorded} subjects passed) alongside an overall average of {overallAvg:F1}%. {name} has established a dependable foundation across the majority of the curriculum, showcasing positive intellectual aptitude and reliable assessment execution. With targeted consolidation and enhanced examination technique in the remaining growth areas, {name} possesses the capability to attain complete distinction across the entire subject profile.",
                $"Commendable academic effort has yielded a strong {passRate:F0}% subject pass rate ({passed} of {recorded} subjects passed) and a respectable overall average of {overallAvg:F1}%. {name} displays clear academic capability and a positive disposition toward learning. To convert this solid achievement into full mastery across all registered subjects, {name} is urged to apply the same disciplined work habits seen in strong subjects to those areas requiring reinforcement.",
                $"A very positive academic standing, marked by success in {passed} out of {recorded} subjects ({passRate:F0}% pass rate) and a commendable average of {overallAvg:F1}%. {name} demonstrates admirable perseverance and a solid grasp of core syllabus competencies. Addressing minor conceptual gaps and engaging in proactive revision will comfortably propel {name} into top-tier attainment across all disciplines.",
                $"Solid achievement across the curriculum with a {passRate:F0}% pass rate and an average of {overallAvg:F1}%. {name} demonstrates clear competence in the vast majority of evaluated topics, reflecting steady application and classroom engagement. Sustained focus on past-paper technique in the few lagging subjects will help ensure 100% completion in the coming term."
            };
        }
        else if (passRate >= 60.0)
        {
            remarksPool = new[]
            {
                $"A satisfactory academic outcome with a {passRate:F0}% pass rate ({passed} of {recorded} subjects completed successfully) and an overall average of {overallAvg:F1}%. While {name} demonstrates commendable ability in several core disciplines, the disparity across subjects highlights the necessity of a more balanced revision strategy and greater daily consistency. Establishing a structured independent study timetable and consulting subject teachers promptly will ensure steady progression and academic stability.",
                $"The results reflect an emerging academic standard, securing passes in {passed} out of {recorded} evaluated subjects ({passRate:F0}% pass rate) alongside an average of {overallAvg:F1}%. {name} is clearly capable of sound academic work; however, focused attention and timely remediation in the underperforming subjects will be crucial to prevent cumulative gaps. Dedicated revision and active classroom engagement are strongly recommended next term.",
                $"{name} has demonstrated workable competence in passing {passed} out of {recorded} subjects ({passRate:F0}%), achieving an overall average of {overallAvg:F1}%. To consolidate this foundation and elevate the overall profile, {name} must eliminate inconsistency by applying uniform effort across both coursework assignments and examination preparations. The college remains committed to supporting {name} in realizing full potential."
            };
        }
        else if (passRate >= 40.0)
        {
            remarksPool = new[]
            {
                $"This term's results highlight notable academic challenges that require focused and coordinated intervention. With a pass rate of {passRate:F0}% ({passed} of {recorded} subjects passed) and an overall average of {overallAvg:F1}%, it is imperative that {name} establishes a disciplined daily study timetable, attends teacher consultations regularly, and focuses on core syllabus mastery. With targeted remedial support and redoubled personal commitment, {name} can overcome these foundational hurdles and make meaningful academic recovery.",
                $"The current performance ({passRate:F0}% pass rate with {passed} of {recorded} subjects passed, {overallAvg:F1}% average) underscores urgent areas for remedial focus. {name} possesses the potential for better outcomes, but immediate improvement in assignment submission, structured past-paper revision, and proactive engagement with academic tutors is essential. A focused partnership between student, parents, and faculty will be key to re-establishing momentum."
            };
        }
        else
        {
            remarksPool = new[]
            {
                $"Academic attainment this term is below the expected institutional standard, with a pass rate of {passRate:F0}% ({passed} of {recorded} subjects passed) and an overall average of {overallAvg:F1}%. An urgent academic review and structured remediation plan are required. {name} must prioritize daily revision, clarify foundational misunderstandings directly with subject teachers, and commit to thorough preparation for all continuous assessments. The college stands ready to assist {name} in rebuilding academic confidence and progress.",
                $"The recorded results ({passRate:F0}% pass rate, {overallAvg:F1}% overall average) indicate critical foundational deficits across multiple disciplines. Immediate academic counseling and consistent tutorial attendance are strongly urged. {name} is encouraged to approach this setback with renewed determination, adopting methodical study routines to reverse this trend and achieve the passing benchmark in the coming session."
            };
        }

        var seed = HashCode.Combine(studentId, term, year, passed, (int)Math.Round(overallAvg));
        var index = (int)((uint)seed % (uint)remarksPool.Length);
        return remarksPool[index];
    }

