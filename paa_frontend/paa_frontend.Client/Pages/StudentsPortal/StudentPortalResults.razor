    private IEnumerable<ReportCardModel> AnalyticsCards => allReportCards
        .Where(rc => rc.TermYear == analyticsYear)
        .OrderBy(rc => TermNumber(rc.Term));

    private IEnumerable<int> AnalyticsYears => allReportCards
        .Select(rc => rc.TermYear).Distinct().OrderByDescending(y => y);

    private double AnalyticsYearAverage => AnalyticsCards
        .Where(rc => rc.Subjects?.Any() == true)
        .SelectMany(rc => rc.Subjects!)
        .Select(s => s.FinalMark).DefaultIfEmpty().Average();

    private List<SubjectProgressRow> SubjectProgressRows =>
        AnalyticsCards.SelectMany((card, index) => index == 0 || card.Subjects == null ? Enumerable.Empty<SubjectProgressRow>() :
            card.Subjects.Select(subject =>
            {
                var previous = AnalyticsCards.ElementAt(index - 1).Subjects?.FirstOrDefault(s => s.SubjectName == subject.SubjectName);
                var from = previous?.FinalMark ?? subject.FinalMark;
                return new SubjectProgressRow(subject.SubjectName ?? "Subject", from, subject.FinalMark, subject.FinalMark - from);
            }))
        .GroupBy(x => x.Subject).Select(g => g.Last()).OrderByDescending(x => Math.Abs(x.Delta)).ToList();

    private int AnalyticsImprovedCount => SubjectProgressRows.Count(x => x.Delta > 0.05);
    private int AnalyticsDroppedCount => SubjectProgressRows.Count(x => x.Delta < -0.05);
    private List<SubjectMatrixRow> SubjectTermMatrix
    {
        get
        {
            var cards = AnalyticsCards.ToList();
            var subjects = cards.Where(c => c.Subjects != null)
                .SelectMany(c => c.Subjects!)
                .Select(s => s.SubjectName ?? "Subject")
                .Distinct()
                .OrderBy(s => s)
                .ToList();

            var rows = new List<SubjectMatrixRow>();
            foreach (var subj in subjects)
            {
                var marks = cards.Select(card => card.Subjects?.FirstOrDefault(s => s.SubjectName == subj)?.FinalMark).ToList();
                rows.Add(new SubjectMatrixRow(subj, marks));
            }
            return rows;
        }
    }

    private sealed record SubjectMatrixRow(string Subject, List<double?> Marks);

    private sealed record SubjectProgressRow(string Subject, double From, double To, double Delta);

    protected override Task OnInitializedAsync()
