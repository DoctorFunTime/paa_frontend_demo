@page "/portal/results"
@namespace paa_frontend.Client.Pages.Portal
@layout paa_frontend.Client.Layout.StudentPortalLayout
@using paa_frontend.Shared.Models
@using paa_frontend.Client.Services.StaffPortal
@using paa_frontend.Client.Services.Admin
@using static paa_frontend.Shared.Models.StudentProfileModel
@inject AssessmentServiceClient AssessmentService
@inject GradesServiceClient GradesService
@inject FinanceServiceClient FinanceService
@inject StudentProfileServiceClient StudentService
@inject StudentSubjectServiceClient SubjectService
@inject OlevelClassServiceClient OlevelClassService
@inject AttendanceServiceClient AttendanceService
@inject IJSRuntime JS
@inject NavigationManager Nav

@{
    var pageTitle = "Results";
}
<CascadingValue Name="PageTitle" Value="@pageTitle">

    <style>
            /* ─── RESULTS GRID & FLAT UI ─── */
            .portal-grid {
                display: grid;
                grid-template-columns: minmax(0, 1fr);
                gap: 30px;
                padding: 0 28px 40px;
                margin-top: 18px;
            }

            .col-8 {
                grid-column: 1 / -1;
                order: 2;
            }

            .col-4 {
                grid-column: 1 / -1;
                order: 1;
            }

            .portal-grid, .col-8, .col-4 {
                min-width: 0;
            }

            /* ─── BANNER OVERRIDES (Specific for Results) ─── */
            .banner-outer {
                background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 55%, #4338ca 100%);
                border: 0;
                box-shadow: 0 12px 28px rgba(15,23,42,0.16);
                color: #fff;
                padding: 24px 32px 32px;
                position: relative;
                overflow: hidden;
                border-radius: 28px;
                margin: 16px 16px 0;
            }

                .banner-outer::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    right: 0;
                    width: 450px;
                    height: 100%;
                    background-image: url("data:image/svg+xml,%3Csvg width='32' height='55' viewBox='0 0 32 55' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cpath d='M16 9.613L32 18.846v18.468l-16 9.233-16-9.233V18.846zm0 1.155l-15 8.658v17.316l15 8.658 15-8.658V19.426zM15 48.24l-14-8.08V23.84l14-8.08v32.48zm2-32.48l14 8.08v16.32l-14 8.08V15.76z' fill='%23000000' fill-opacity='0.05'/%3E%3C/g%3E%3C/svg%3E");
                    -webkit-mask-image: linear-gradient(to left, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);
                    mask-image: linear-gradient(to left, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);
                    pointer-events: none;
                }

            .banner-inner {
                position: relative;
                z-index: 1;
                display: flex;
                align-items: center;
                gap: 24px;
                max-width: 1400px;
                margin: 0 auto;
            }

            .banner-avatar {
                width: 80px;
                height: 80px;
                background: rgba(255,255,255,0.1);
                border: 2px solid rgba(255,255,255,0.2);
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
                font-weight: 800;
                color: #fff;
            }

            .banner-name {
                font-size: 32px;
                font-weight: 800;
                letter-spacing: -1px;
                margin-bottom: 4px;
                color: #fff;
            }

            .banner-meta {
                display: flex;
                gap: 16px;
                margin-bottom: 12px;
            }

            .banner-meta-item {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: 13px;
                color: rgba(255,255,255,0.82);
                font-weight: 600;
            }

            .banner-badges {
                display: flex;
                gap: 8px;
            }

            .banner-badge {
                padding: 4px 10px;
                border-radius: 8px;
                font-size: 11px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .top-level-tabs {
                margin: 28px 28px 0;
            }

            .col-8.glass-card {
                padding: 26px !important;
            }

            .banner-stats {
                margin-left: auto;
                display: flex;
                gap: 40px;
            }

            .banner-stat {
                text-align: right;
            }

            .banner-stat-label {
                font-size: 11px;
                font-weight: 800;
                color: rgba(255,255,255,0.68);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 6px;
            }

            .banner-stat-val {
                font-size: 32px;
                font-weight: 800;
                font-family: 'DM Mono', monospace;
                line-height: 1;
            }

            /* ─── DE-BOXED SECTIONS ─── */
            .section-label {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 11px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                color: var(--ink3);
                margin-bottom: 20px;
            }

            .section-divider {
                height: 1px;
                background: #f0f0f0;
                margin: 40px 0;
            }

            /* ─── TAB NAV (FLAT) ─── */
            .tab-row {
                display: flex;
                gap: 24px;
                border-bottom: 2px solid #f0f0f0;
                margin-bottom: 32px;
            }

            .tab-link {
                padding: 12px 4px;
                font-size: 14px;
                font-weight: 700;
                color: var(--ink3);
                cursor: pointer;
                border-bottom: 2px solid transparent;
                transition: all 0.2s;
                margin-bottom: -2px;
            }

                .tab-link:hover {
                    color: var(--ink);
                }

                .tab-link.active {
                    color: var(--red);
                    border-bottom-color: var(--red);
                }

            .skeleton {
                display: block;
                background: linear-gradient(90deg, rgba(226,232,240,.72) 25%, rgba(248,250,252,.98) 50%, rgba(226,232,240,.72) 75%);
                background-size: 200% 100%;
                animation: results-skeleton 1.25s ease-in-out infinite;
            }

            .results-initial-loading { padding: 28px 16px; display:flex; flex-direction:column; gap:14px; max-width:680px; margin:0 auto; }
            .results-loading-welcome { display:flex; align-items:center; gap:12px; padding:16px 18px; background:#fff; border:1px solid rgba(148,163,184,.2); border-radius:18px; box-shadow:0 8px 24px rgba(15,23,42,.05); color:var(--ink); }
            .results-loading-welcome strong { display:block; font-size:15px; }
            .results-loading-welcome small { display:block; margin-top:3px; color:var(--ink3); font-size:12px; }
            .results-spinner { width:22px; height:22px; flex:0 0 22px; border:3px solid #e2e8f0; border-top-color:var(--red); border-radius:50%; animation:results-spin .8s linear infinite; }
            @@keyframes results-spin { to { transform:rotate(360deg); } }

            .results-loading-card {
                min-height: 240px;
                display: flex;
                flex-direction: column;
                justify-content: center;
                gap: 14px;
                padding: 28px;
                border: 1px solid rgba(148,163,184,.18);
                border-radius: 20px;
                background: rgba(255,255,255,.58);
            }

            .results-loading-label {
                color: rgba(255,255,255,0.72);
                font-size: 13px;
                font-weight: 700;
                text-align: center;
            }

            .results-filter-grid {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 18px;
            }

            .results-filter-fields {
                display: grid;
                grid-template-columns: minmax(150px, 1fr) 120px;
                gap: 10px;
                width: min(100%, 430px);
            }

            .results-year-input {
                appearance: textfield;
            }

            @@keyframes results-skeleton {
                from {
                    background-position: 200% 0;
                }

                to {
                    background-position: -200% 0;
                }
            }

            /* ─── FLAT DATA TABLES ─── */
            .flat-table {
                width: 100%;
                border-collapse: collapse;
            }

                .flat-table th {
                    padding: 12px 10px;
                    text-align: left;
                    font-size: 11px;
                    font-weight: 800;
                    color: var(--ink3);
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    border-bottom: 2px solid #f0f0f0;
                }

                .flat-table td {
                    padding: 16px 10px;
                    border-bottom: 1px solid #f8f8f8;
                    font-size: 14px;
                    color: var(--ink2);
                    vertical-align: middle;
                }

                .flat-table tr:last-child td {
                    border-bottom: none;
                }

            .grade-pill {
                padding: 4px 12px;
                border-radius: 8px;
                font-family: 'DM Mono', monospace;
                font-size: 16px;
                font-weight: 800;
            }

            .mark-display {
                font-family: 'DM Mono', monospace;
                font-weight: 700;
                font-size: 15px;
            }

            /* ─── PERFORMANCE BOX (RIGHT SIDE) ─── */
            .perf-box {
                background: transparent;
                padding: 0px;
            }

            .metric-item {
                margin-bottom: 28px;
            }

                .metric-item:last-child {
                    margin-bottom: 0;
                }

            .metric-label {
                font-size: 11px;
                font-weight: 800;
                color: rgba(255,255,255,0.72);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 10px;
                display: block;
            }

            .metric-val {
                font-size: 28px;
                font-weight: 800;
                color: var(--ink);
                font-family: 'DM Mono', monospace;
                line-height: 1;
            }

            .metric-sub {
                font-size: 12px;
                font-weight: 600;
                color: var(--ink3);
                margin-top: 6px;
            }

            .history-card {
                display: flex;
                align-items: center;
                padding: 24px;
                background: rgba(255,255,255,0.3);
                border-radius: 16px;
                border: 1px solid rgba(255,255,255,0.4);
                gap: 20px;
            }

            .history-icon {
                width: 48px;
                height: 48px;
                background: rgba(255,255,255,0.5);
                border: 1px solid rgba(255,255,255,0.5);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--red);
                flex-shrink: 0;
            }

            .history-copy {
                flex: 1;
                min-width: 0;
            }

            .history-stats {
                text-align: right;
                flex-shrink: 0;
            }

            /* ─── ACTION INPUTS ─── */
            .flat-select {
                width: 100%;
                padding: 14px 18px;
                background: rgba(255,255,255,0.45);
                border: 1px solid rgba(255,255,255,0.4);
                border-radius: 12px;
                font-size: 14px;
                font-weight: 700;
                color: var(--ink);
                outline: none;
                appearance: none;
                cursor: pointer;
                transition: all 0.2s;
            }

                .flat-select:focus {
                    border-color: var(--red);
                    box-shadow: 0 0 0 4px rgba(200,16,46,0.05);
                }

            /* ─── BUTTONS ─── */
            .primary-btn {
                width: 100%;
                padding: 16px;
                background: var(--red);
                color: white;
                border: none;
                border-radius: 14px;
                font-size: 15px;
                font-weight: 800;
                cursor: pointer;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                box-shadow: 0 8px 24px rgba(200,16,46,0.15);
            }

                .primary-btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 12px 32px rgba(200,16,46,0.25);
                }

                .primary-btn:disabled {
                    opacity: 0.6;
                    cursor: not-allowed;
                    transform: none;
                }

            /* ─── MOBILE ─── */
            @@media (max-width: 1100px) {
                .portal-grid {
                    grid-template-columns: 1fr;
                    padding: 0 14px 24px;
                    gap: 16px;
                    margin-top: 0;
                }

                .col-8, .col-4 {
                    grid-column: span 1;
                }

                .banner-outer {
                    margin: 12px 12px 0;
                    padding: 20px;
                    border-radius: 22px;
                }

                .banner-inner {
                    flex-direction: column;
                    text-align: center;
                    gap: 16px;
                }

                .banner-meta, .banner-badges {
                    justify-content: center;
                    flex-wrap: wrap;
                }

                .banner-stats {
                    margin-left: 0;
                    justify-content: center;
                    width: 100%;
                    margin-top: 24px;
                }

                .banner-avatar {
                    margin: 0 auto;
                }

                .portal-grid > .glass-card {
                    margin-top: 0 !important;
                    width: 100%;
                    overflow: hidden;
                    padding: 18px !important;
                }

                .portal-grid {
                    gap: 24px;
                }

                .tab-row {
                    gap: 8px;
                    overflow-x: auto;
                    padding-bottom: 6px;
                    scrollbar-width: none;
                }

                    .tab-row::-webkit-scrollbar {
                        display: none;
                    }

                .tab-link {
                    white-space: nowrap;
                    font-size: 12px;
                    padding: 10px 2px;
                    flex: 0 0 auto;
                }

                .perf-box {
                    position: static !important;
                }

                .metric-val {
                    font-size: 22px;
                    overflow-wrap: anywhere;
                }

                .flat-table {
                    display: block;
                    width: 100%;
                    overflow-x: auto;
                    white-space: nowrap;
                }

                .history-card {
                    flex-direction: column;
                    align-items: flex-start;
                    padding: 18px;
                    gap: 14px;
                }

                .history-stats {
                    text-align: left;
                }
            }

            @@media (max-width: 640px) {
                .results-filter-grid {
                    align-items: stretch;
                    flex-direction: column;
                    gap: 8px;
                }

                .results-filter-fields {
                    width: 100%;
                    grid-template-columns: minmax(0, 1fr) 112px;
                }

                .portal-grid {
                    padding-left: 10px;
                    padding-right: 10px;
                }

                    .portal-grid > .glass-card {
                        padding: 14px !important;
                        border-radius: 20px;
                    }

                .banner-name {
                    font-size: 26px;
                }

                .banner-stats {
                    gap: 20px;
                }

                .banner-stat-val {
                    font-size: 24px;
                }

                .banner-meta-item {
                    font-size: 12px;
                }
            }
    </style>

    <style>
            .print-area {
                position: relative;
                width: 100%;
                margin: 0 auto;
            }

            .report-a4-wrapper {
                position: relative;
                z-index: 1;
                display: flex;
                justify-content: center;
                width: 100%;
                overflow-x: auto;
            }

            .report-a4 {
                width: 100%;
                max-width: 100%;
                background: transparent;
                color: var(--ink);
                position: relative;
                margin: 0 auto;
            }

            .report-watermark {
                position: absolute;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0.10;
                pointer-events: none;
                z-index: 0;
            }

                .report-watermark img {
                    width: 95%;
                    max-width: 220mm;
                    height: auto;
                    filter: grayscale(1);
                }

            .report-header {
                display: flex;
                align-items: center;
                gap: 18px;
            }

            .report-logo {
                width: 84px;
                height: auto;
                object-fit: contain;
            }

            .report-title {
                font-size: 20px;
                font-weight: 800;
            }

            .report-meta {
                margin-left: auto;
                text-align: right;
                font-size: 12px;
                color: var(--ink3);
            }

            .report-summary-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0,1fr));
                gap: 12px;
                margin-bottom: 24px;
            }

            .report-summary-card {
                padding: 12px 14px;
                background: rgba(249,249,249,0.72);
                border: 1px solid rgba(255,255,255,0.55);
                border-radius: 10px;
                backdrop-filter: blur(2px);
            }

            .report-totals-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0,1fr));
                gap: 12px;
                margin-top: 24px;
            }

            .report-comment-box {
                margin-top: 40px;
                padding: 16px;
                background: rgba(249,249,249,0.72);
                border: 1px solid rgba(255,255,255,0.55);
                border-radius: 8px;
                font-size: 13px;
                backdrop-filter: blur(2px);
            }

            .report-table-wrap {
                width: 100%;
                overflow-x: auto;
            }

                .report-table-wrap .flat-table {
                    min-width: 640px;
                }

            @@media (max-width: 900px) {
                .print-area {
                    transform-origin: top left;
                    transform: none;
                    width: 100%;
                    margin-bottom: 0;
                }

                .report-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 12px;
                }

                .report-meta {
                    margin-left: 0;
                    text-align: left;
                }

                .report-summary-grid {
                    grid-template-columns: 1fr 1fr;
                }

                .report-totals-grid {
                    grid-template-columns: 1fr;
                }

                .report-header > div:first-of-type {
                    width: 100%;
                }
            }

            @@media (max-width: 640px) {
                .print-area {
                    transform: none;
                    width: 100%;
                    margin-bottom: 0;
                }

                .report-a4-wrapper {
                    justify-content: flex-start;
                    overflow-x: hidden;
                    padding-bottom: 8px;
                }

                .report-a4 {
                    width: 100%;
                    max-width: 100%;
                    padding: 10px 0;
                }

                .report-summary-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 8px;
                }

                .report-logo {
                    width: 64px;
                }

                .flat-table th, .flat-table td {
                    font-size: 12px;
                }

                .report-watermark img {
                    width: 85%;
                }

                /* ── Report card cert frame on mobile (screen only) ── */
                .cert-border-wrap {
                    border-radius: 0;
                }

                .cert-frame {
                    padding: 14px 12px 10px;
                    outline-offset: -8px;
                    border-radius: 4px;
                }

                .cert-corner {
                    width: 32px;
                    height: 32px;
                }

                /* ── Report table: horizontal scroll on mobile ── */
                .report-table-wrap {
                    overflow-x: auto;
                    -webkit-overflow-scrolling: touch;
                    margin: 0 -4px;
                    padding: 0 4px 6px;
                }

                .report-table-wrap .flat-table {
                    min-width: 480px;
                    font-size: 11px;
                }

                .report-table-wrap .flat-table th,
                .report-table-wrap .flat-table td {
                    padding: 10px 6px;
                    font-size: 11px;
                }

                /* ── Report summary/totals strips ── */
                .report-totals-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 8px;
                }

                .report-summary-card {
                    padding: 10px 12px;
                }

                /* ── Report comment box ── */
                .report-comment-box {
                    margin-top: 16px;
                    padding: 12px;
                    font-size: 12px;
                }

                /* ── Cert title block ── */
                .cert-title-block {
                    padding-bottom: 10px !important;
                    margin-bottom: 2px !important;
                }

                /* ── Filter card ── */
                .report-filter-card {
                    padding: 14px 14px;
                }

                .results-filter-fields {
                    grid-template-columns: 1fr 88px;
                    width: 100%;
                }

                .flat-select {
                    padding: 12px 14px;
                    font-size: 13px;
                }

                /* ── Print button ── */
                .primary-btn {
                    font-size: 13px;
                    padding: 13px;
                }
            }


            /* (Cleaned up legacy print block 2) */
    </style>

    <style>
            /* === CERTIFICATE BORDER === */
            .cert-border-wrap {
                position: relative;
                background: white;
            }

            .cert-corner {
                position: absolute;
                width: 46px;
                height: 46px;
                pointer-events: none;
            }

                .cert-corner svg {
                    width: 100%;
                    height: 100%;
                }

                .cert-corner.tl {
                    top: 4px;
                    left: 4px;
                }

                .cert-corner.tr {
                    top: 4px;
                    right: 4px;
                    transform: scaleX(-1);
                }

                .cert-corner.bl {
                    bottom: 4px;
                    left: 4px;
                    transform: scaleY(-1);
                }

                .cert-corner.br {
                    bottom: 4px;
                    right: 4px;
                    transform: scale(-1,-1);
                }

            .cert-frame {
                border: 2px solid #1a7f52;
                outline: 5px solid rgba(26,127,82,0.15);
                outline-offset: -12px;
                border-radius: 4px;
                padding: 18px 20px 14px;
                position: relative;
                background: white;
            }

            .cert-footer {
                margin-top: 16px;
                padding-top: 10px;
                border-top: 1px dashed rgba(26,127,82,0.35);
                text-align: center;
                font-size: 9px;
                color: #9ca3af;
                letter-spacing: 0.6px;
                text-transform: uppercase;
                line-height: 1.8;
            }
            /* Analytics charts */
            .chart-bar-wrap {
                width: 100%;
                overflow-x: hidden;
            }

                .chart-bar-wrap svg {
                    width: 100%;
                    display: block;
                }

            .subj-bar-row {
                display: grid;
                grid-template-columns: minmax(90px, 1.4fr) 1fr 44px;
                gap: 8px;
                align-items: center;
                margin-bottom: 10px;
            }

                .subj-bar-row:last-child {
                    margin-bottom: 0;
                }

            .subj-bar-label {
                font-size: 11px;
                font-weight: 700;
                color: var(--ink);
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .subj-bar-track {
                background: #eef2f7;
                height: 9px;
                border-radius: 99px;
                overflow: hidden;
                position: relative;
            }

            .subj-bar-fill {
                height: 100%;
                border-radius: 99px;
            }

            .subj-bar-val {
                font-size: 11px;
                font-weight: 800;
                font-family: 'DM Mono', monospace;
                text-align: right;
            }

            .grade-dist-row {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 7px;
                font-size: 11px;
            }

            .grade-dist-badge {
                width: 26px;
                height: 26px;
                border-radius: 6px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
                font-size: 12px;
                flex-shrink: 0;
            }

            .grade-dist-bar-track {
                flex: 1;
                background: #eef2f7;
                height: 9px;
                border-radius: 99px;
                overflow: hidden;
            }

            .grade-dist-bar-fill {
                height: 100%;
                border-radius: 99px;
            }

            .grade-dist-count {
                width: 30px;
                text-align: right;
                font-weight: 700;
