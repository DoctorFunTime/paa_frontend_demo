                            }

                            .analytics-year-select {
                                width: 130px;
                                background: white;
                            }

                            .analytics-stat-grid {
                                display: grid;
                                grid-template-columns: repeat(3, minmax(0,1fr));
                                gap: 12px;
                                margin-bottom: 18px;
                            }

                            .analytics-stat {
                                padding: 15px;
                            }

                                .analytics-stat span, .analytics-stat small {
                                    display: block;
                                    color: var(--ink3);
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                .analytics-stat strong {
                                    display: block;
                                    margin: 6px 0 3px;
                                    font: 800 25px 'DM Mono', monospace;
                                    color: var(--ink);
                                }

                            .positive {
                                color: #087f52 !important;
                            }

                            .negative {
                                color: #c8102e !important;
                            }

