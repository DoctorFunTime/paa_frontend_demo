    @if (isLoading)
    {
        <div class="results-initial-loading" role="status" aria-live="polite">
            <div class="results-loading-welcome"><span class="results-spinner"></span><div><strong>Preparing your results</strong><small>We’re securely loading your latest approved report card…</small></div></div>
            <!-- Banner shimmer -->
            <div class="skeleton" style="height:110px; border-radius:20px;"></div>
            <!-- Tab bar shimmer -->
            <div style="display:flex; gap:10px;">
                <div class="skeleton" style="height:38px; border-radius:99px; flex:0 0 110px;"></div>
                <div class="skeleton" style="height:38px; border-radius:99px; flex:0 0 90px;"></div>
            </div>
            <!-- Cards shimmer -->
            <div class="skeleton" style="height:80px; border-radius:16px;"></div>
            <div class="skeleton" style="height:160px; border-radius:16px;"></div>
            <div class="skeleton" style="height:120px; border-radius:16px;"></div>
            <div class="skeleton" style="height:80px; border-radius:16px;"></div>
        </div>
    }
    <div class="results-page-wrap @(isPrintingReport ? "print-report-active" : "") @(isPrintingAnalytics ? "print-analytics-active" : "")" style="display:@(isLoading ? "none" : "");">

        <!-- 1. STUDENT BANNER (HEADER ANCHOR) -->
        <div class="banner-outer no-print">
            <div class="banner-glow"></div>
            <div class="banner-inner a1">
                <div class="banner-avatar">@StudentInitials</div>
                <div class="banner-info">
                    <div class="banner-name">@Me.FirstName @Me.LastName</div>
                    <div class="banner-meta">
                        <span class="banner-meta-item">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 19V5a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v14" /><line x1="6" y1="11" x2="6" y2="11" /><line x1="10" y1="11" x2="10" y2="11" /><line x1="14" y1="11" x2="14" y2="11" /></svg>
                            Academic Results · @SelectedTermLabel
                        </span>
                        <span class="banner-meta-item">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                            @FormatClassroom(Me.Form, Me.Classroom)
                        </span>
                    </div>
                    <div class="banner-badges">
                        <span class="banner-badge" style="background:rgba(248,113,113,0.22);color:#ffe4e6;">Performance: @(AvgMark >= 75 ? "EXCELLENT" : AvgMark >= 50 ? "SATISFACTORY" : "UNSATISFACTORY")</span>
                        <span class="banner-badge" style="background:rgba(255,255,255,0.12);color:rgba(255,255,255,0.86);">ID @Me.Id</span>
                    </div>
                </div>

                <div class="banner-stats">
                    <div class="banner-stat">
                        <div class="banner-stat-label">Average Mark</div>
                        <div class="banner-stat-val" style="color:@(AvgMark >= 50 ? "#6ee7b7" : "#ff8a8a");">
                            @AvgMark.ToString("F0")%
                        </div>
                    </div>
                    <div class="banner-stat">
                        <div class="banner-stat-label">Pass Count</div>
                        <div class="banner-stat-val" style="color:#fff;">
                            @(CurrentCard?.Subjects?.Count(s => s.FinalMark >= 50) ?? 0)
                            <span style="font-size:14px;color:rgba(255,255,255,0.68);vertical-align:middle;margin-left:4px;">/ @(CurrentCard?.Subjects?.Count ?? 0)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(loadError))
        {
            <div class="status-banner error a1" style="margin: 20px 40px -20px 40px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                <span class="status-banner-text">@loadError</span>
                <button class="status-banner-close" @onclick="() => loadError = string.Empty">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                </button>
            </div>
        }

        <div class="tab-row no-print top-level-tabs">
            <div class="tab-link @(activeTab == "reportcard" ? "active" : "")" @onclick='async () => await OnTabSelected("reportcard")'>Official Report Card</div>
            <div class="tab-link @(activeTab == "analytics" ? "active" : "")" @onclick='async () => await OnTabSelected("analytics")'>Analytics</div>
        </div>

        <div class="results-main-wrapper a2 glass-card" style="margin-top:28px;">

            <!-- TAB CONTENT -->
            @if (activeTab == "marks")
            {
                <div class="section-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><line x1="10" y1="9" x2="8" y2="9" /></svg>
                    Current Term Performance
                </div>

                @if (isLoading)
                {
                    <div class="results-loading-card">
                        @for (int i = 0; i < 6; i++)
                        {
                            <div class="skeleton" style="height:54px;border-radius:12px;"></div>
                        }
                        <div class="results-loading-label">Loading your approved marks…</div>
                    </div>
                }
                else if (CurrentCard?.Subjects == null || !CurrentCard.Subjects.Any())
                {
                    <div style="padding:60px 40px;text-align:center;background:#fcfcfc;border-radius:24px;">
                        <div style="font-size:14px;font-weight:700;color:var(--ink2);margin-bottom:8px;">No approved marks yet for this term</div>
                        <div style="font-size:12.5px;color:var(--ink3);line-height:1.6;">Marks become visible here once your teacher has submitted them and the admin has reviewed and approved the report.</div>
                    </div>
                }
                else
                {
                    <!-- Term summary strip -->
                    <div class="term-summary-strip" style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px;">
                        @{
                            double termAvg = CurrentCard.Subjects.Average(s => s.FinalMark);
                            int termPassed = CurrentCard.Subjects.Count(s => s.FinalMark >= 50);
                            int termTotal = CurrentCard.Subjects.Count;
                            var termBest = CurrentCard.Subjects.MaxBy(s => s.FinalMark);
                            var termWorst = CurrentCard.Subjects.MinBy(s => s.FinalMark);
                            string termWorstLabel = termWorst?.FinalMark >= 80 ? "Growth Focus" : (termWorst?.FinalMark >= 60 ? "Room for Growth" : "Needs Work");
                            string termWorstColor = termWorst?.FinalMark >= 80 ? "var(--green)" : (termWorst?.FinalMark >= 60 ? "#d97706" : "var(--red)");
                        }
                        <div style="background:rgba(26,79,255,0.05);border:1px solid rgba(26,79,255,0.1);border-radius:12px;padding:12px 14px;">
                            <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.8px;color:var(--ink3);margin-bottom:4px;">Term Average</div>
                            <div style="font-size:22px;font-weight:800;font-family:'DM Mono',monospace;color:@(termAvg >= 50 ? "var(--green)" : "var(--red)");">@termAvg.ToString("F1")%</div>
                        </div>
                        <div style="background:rgba(0,182,122,0.05);border:1px solid rgba(0,182,122,0.12);border-radius:12px;padding:12px 14px;">
                            <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.8px;color:var(--ink3);margin-bottom:4px;">Passed</div>
                            <div style="font-size:22px;font-weight:800;font-family:'DM Mono',monospace;color:var(--green);">@termPassed <span style="font-size:13px;color:var(--ink3);font-weight:600;">/ @termTotal</span></div>
                        </div>
                        <div style="background:rgba(0,0,0,0.02);border:1px solid rgba(0,0,0,0.06);border-radius:12px;padding:12px 14px;">
                            <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.8px;color:var(--ink3);margin-bottom:4px;">Best Subject</div>
                            <div style="font-size:13px;font-weight:800;color:var(--ink);line-height:1.3;">@termBest?.SubjectName</div>
                            <div style="font-size:11px;color:var(--green);font-weight:700;font-family:'DM Mono',monospace;">@termBest?.FinalMark.ToString("F1")%</div>
                        </div>
                        <div style="background:rgba(0,0,0,0.02);border:1px solid rgba(0,0,0,0.06);border-radius:12px;padding:12px 14px;">
                            <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.8px;color:var(--ink3);margin-bottom:4px;">@termWorstLabel</div>
                            <div style="font-size:13px;font-weight:800;color:var(--ink);line-height:1.3;">@termWorst?.SubjectName</div>
                            <div style="font-size:11px;color:@termWorstColor;font-weight:700;font-family:'DM Mono',monospace;">@termWorst?.FinalMark.ToString("F1")%</div>
                        </div>
                    </div>

                    <table class="flat-table">
                        <thead>
                            <tr>
                                <th>Course Subject</th>
                                <th style="text-align:center;">CW (%)</th>
                                <th style="text-align:center;">Exam (%)</th>
                                <th style="text-align:right;">Final (%)</th>
                                <th style="text-align:center;">Grade</th>
                                <th style="text-align:left;">Comment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in CurrentCard.Subjects)
                            {
                                string grade = GradeHelper.ToGrade(r.FinalMark);
                                string gColor = (r.FinalMark >= 50 ? "var(--green)" : "var(--red)");
                                bool isExpanded = expandedSubjects.Contains(r.SubjectName ?? string.Empty);
                                bool hasExams = examFeedbackBySubject.TryGetValue(r.SubjectName ?? string.Empty, out var subjectExams) && subjectExams.Any();
                                // ── CHANGED: now List<MarkEntry> ──
                                bool hasCw = courseworkMarksBySubject.TryGetValue(r.SubjectName ?? string.Empty, out var subjectCw) && subjectCw.Any();

                                <tr @onclick="() => ToggleSubject(r.SubjectName ?? string.Empty)" style="cursor:pointer;transition:background 0.15s;" hover="background:rgba(0,0,0,0.02);">
                                    <td style="font-weight:700;color:var(--ink);">
                                        <div style="display:flex;align-items:center;gap:8px;">
                                            <span style="font-size:10px;display:inline-block;transition:transform 0.15s;transform:@(isExpanded ? "rotate(90deg)" : "rotate(0deg)");color:var(--ink3);">▶</span>
                                            <div>
                                                @r.SubjectName
                                                <div style="margin-top:5px;height:3px;width:100px;background:rgba(0,0,0,0.07);border-radius:4px;overflow:hidden;">
                                                    <div style="height:100%;width:@(Math.Min(r.FinalMark, 100).ToString("F0"))%;background:@(r.FinalMark >= 50 ? "var(--green)" : "var(--red)");border-radius:4px;transition:width 0.4s;"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="text-align:center;font-family:'DM Mono',monospace;color:var(--ink3);">@r.CourseworkMark.ToString("F0")%</td>
                                    <td style="text-align:center;font-family:'DM Mono',monospace;color:var(--ink3);">@r.ExamMark.ToString("F0")%</td>
                                    <td style="text-align:right;font-family:'DM Mono',monospace;font-weight:800;color:var(--ink);font-size:16px;">@r.FinalMark.ToString("F0")%</td>
                                    <td style="text-align:center;">
                                        <span class="grade-pill" style="background:@(r.FinalMark >= 50 ? "rgba(26,127,82,0.1)" : "rgba(200,16,46,0.1)");color:@gColor;">@grade</span>
                                    </td>
                                    <td style="font-size:12.5px;color:var(--ink2);font-style:italic;">
                                        @(string.IsNullOrEmpty(r.Comments) ? "—" : r.Comments)
                                    </td>
                                </tr>

                                @if (isExpanded)
                                {
                                    <tr class="no-print">
                                        <td colspan="6" style="background:rgba(26,79,255,0.015);padding:20px 20px 24px;border-bottom:1px solid rgba(0,0,0,0.04);">

                                            <!-- ─── EXAMS ─── -->
                                            <div style="font-size:11px;font-weight:800;text-transform:uppercase;color:var(--ink3);letter-spacing:0.5px;margin-bottom:10px;display:flex;align-items:center;gap:6px;">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                                                Exam Papers
                                            </div>
                                            @if (hasExams)
                                            {
                                                <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:20px;">
                                                    @foreach (var ex in subjectExams!)
                                                    {
                                                        <div style="background:white;border:1px solid rgba(0,0,0,0.06);border-radius:10px;padding:12px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;box-shadow:0 2px 8px rgba(0,0,0,0.02);">
                                                            <div style="flex:1;min-width:0;">
                                                                <div style="display:flex;align-items:center;gap:6px;">
                                                                    <span style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.5px;color:white;background:var(--blue);padding:2px 7px;border-radius:5px;">EXAM</span>
                                                                    <span style="font-size:13px;font-weight:700;color:var(--ink);">@(ex.ExamTitle ?? "Term Exam")</span>
                                                                </div>
                                                                @if (!string.IsNullOrWhiteSpace(ex.Feedback))
                                                                {
                                                                    <div style="font-size:12.5px;color:var(--ink2);margin-top:6px;font-style:italic;background:#f8fafc;padding:8px 12px;border-radius:8px;border-left:3px solid var(--blue);line-height:1.5;">
                                                                        @ex.Feedback
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div style="font-size:11.5px;color:var(--ink3);margin-top:5px;font-style:italic;">No feedback provided.</div>
                                                                }
                                                            </div>
                                                            <div style="font-family:'DM Mono',monospace;font-size:14px;font-weight:800;color:var(--blue);white-space:nowrap;background:rgba(26,79,255,0.06);padding:4px 10px;border-radius:7px;">
                                                                @((ex.Score ?? 0).ToString("F1"))%
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="font-size:12.5px;color:var(--ink3);font-style:italic;padding:4px 0 16px;">No exam papers recorded for this subject.</div>
                                            }

                                            <!-- ─── COURSEWORK ─── -->
                                            <div style="font-size:11px;font-weight:800;text-transform:uppercase;color:var(--ink3);letter-spacing:0.5px;margin-bottom:10px;display:flex;align-items:center;gap:6px;">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="9" y1="9" x2="15" y2="9" /><line x1="9" y1="13" x2="15" y2="13" /><line x1="9" y1="17" x2="12" y2="17" /></svg>
                                                Coursework (Assignments &amp; Tests)
                                            </div>
                                            @if (hasCw)
                                            {
                                                <div style="display:flex;flex-direction:column;gap:8px;">
                                                    @foreach (var (entry, i) in subjectCw!.Select((s, idx) => (s, idx + 1)))
                                                    {
                                                        <div style="background:white;border:1px solid rgba(0,0,0,0.06);border-radius:10px;padding:12px;display:flex;justify-content:space-between;align-items:center;gap:16px;box-shadow:0 2px 8px rgba(0,0,0,0.02);">
                                                            <div style="font-size:13px;font-weight:700;color:var(--ink);">Coursework Item @i</div>
                                                            <div style="display:flex;align-items:center;gap:8px;">
                                                                <span style="font-size:11px;color:var(--ink3);font-weight:600;">@entry.ActualMark.ToString("F1") / @entry.MaxScore.ToString("F1")</span>
                                                                <div style="font-family:'DM Mono',monospace;font-size:14px;font-weight:800;color:#7c3aed;white-space:nowrap;background:rgba(124,58,237,0.06);padding:4px 10px;border-radius:7px;">
                                                                    @entry.PercentageScore.ToString("F1")%
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="font-size:12.5px;color:var(--ink3);font-style:italic;padding:4px 0;">No coursework recorded for this subject.</div>
                                            }

                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            }

            <!-- REPORT CARD -->
            @if (activeTab == "reportcard")
            {
                <div class="report-filter-card no-print">
                    <div>
                        <div class="report-filter-title">Choose a report</div>
                        <div class="report-filter-help">Select the term and year you want to view or print.</div>
                    </div>
                    <div class="results-filter-fields">
                        <select class="flat-select" @bind="selectedTerm" @bind:after="OnTermChanged" aria-label="Report term">
                            <option>Term 1</option>
                            <option>Term 2</option>
                            <option>Term 3</option>
                        </select>
                        <input class="flat-select results-year-input" type="number" min="2000" max="2100" @bind="selectedTermYear" @bind:after="OnTermChanged" aria-label="Report year" />
                    </div>
                </div>
                @if (isLoading)
                {
                    <div class="results-loading-card">
                        @for (int i = 0; i < 4; i++)
                        {
                            <div class="skeleton" style="height:96px;border-radius:16px;"></div>
                        }
                        <div class="results-loading-label">Loading your report card…</div>
                    </div>
                }
                else if (CurrentCard?.Subjects != null)
                {
                    <div class="no-print" style="display:flex;justify-content:flex-end;margin-bottom:12px;">
                        <button class="primary-btn" @onclick="PrintReport" style="width:auto;padding-left:24px;padding-right:24px;">Print Report</button>
                    </div>

                    <div class="report-card-print-shell print-area">
                        <div class="report-a4-wrapper">
                            <div class="cert-border-wrap">
                                <!-- Certificate corner ornaments -->
                                <div class="cert-corner tl"><svg viewBox="0 0 48 48" fill="none"><path d="M2 46V12C2 6.48 6.48 2 12 2H46" stroke="#1a7f52" stroke-width="2.5" stroke-linecap="round" /><circle cx="8" cy="8" r="3" fill="#1a7f52" opacity=".6" /></svg></div>
                                <div class="cert-corner tr"><svg viewBox="0 0 48 48" fill="none"><path d="M2 46V12C2 6.48 6.48 2 12 2H46" stroke="#1a7f52" stroke-width="2.5" stroke-linecap="round" /><circle cx="8" cy="8" r="3" fill="#1a7f52" opacity=".6" /></svg></div>
                                <div class="cert-corner bl"><svg viewBox="0 0 48 48" fill="none"><path d="M2 46V12C2 6.48 6.48 2 12 2H46" stroke="#1a7f52" stroke-width="2.5" stroke-linecap="round" /><circle cx="8" cy="8" r="3" fill="#1a7f52" opacity=".6" /></svg></div>
                                <div class="cert-corner br"><svg viewBox="0 0 48 48" fill="none"><path d="M2 46V12C2 6.48 6.48 2 12 2H46" stroke="#1a7f52" stroke-width="2.5" stroke-linecap="round" /><circle cx="8" cy="8" r="3" fill="#1a7f52" opacity=".6" /></svg></div>
                                <div class="cert-frame">
                                    <div class="report-a4">
                                        <div class="report-watermark">
                                            <img src="/images/demo-logo.svg" alt="PrimeApp Demo" class="watermark-logo-img" />
                                        </div>

                                        <div class="cert-title-block" style="text-align:center;padding-bottom:16px;margin-bottom:4px;border-bottom:1px dashed rgba(26,127,82,0.35);">
                                            <img src="/images/demo-logo.svg" alt="PrimeApp Demo" class="print-logo" style="width:60px;height:60px;object-fit:contain;margin:0 auto 10px;" />
                                            <div style="font-size:1.45rem;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:#0f172a;">PrimeApp Demo</div>
                                            <div style="font-size:0.72rem;font-weight:600;color:#64748b;margin-top:5px;letter-spacing:0.5px;">Equipping youngsters to compete internationally</div>
                                        </div>

                                        <div class="text-center w-full py-2 mb-2">
                                            <h3 class="text-lg font-black text-emerald-700 uppercase tracking-widest">Academic Performance Report</h3>
                                            <div class="text-[10px] text-slate-500 mt-1">@SelectedTermLabel &nbsp;•&nbsp; Issued @DateTime.Now.ToString("dd MMM yyyy")</div>
                                        </div>

                                        <div style="height:12px"></div>

                                        <div class="report-summary-grid">
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">Student</div>
                                                <div style="font-size:13px;font-weight:800;color:var(--ink);">@CurrentCard.StudentFirstName @CurrentCard.StudentLastName</div>
                                            </div>
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">Form &amp; Class</div>
                                                <div style="font-size:14px;font-weight:800;color:var(--ink);">@CurrentStudentFormLabel</div>
                                            </div>
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">Term</div>
                                                <div style="font-size:14px;font-weight:800;color:var(--ink);">@SelectedTermLabel</div>
                                            </div>
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">Position In Form</div>
                                                <div style="font-size:14px;font-weight:800;color:var(--ink);">@(positionInForm.HasValue ? $"{positionInForm.Value}{OrdinalSuffix(positionInForm.Value)}" : "Not available")</div>
                                            </div>
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">Attendance</div>
                                                <div style="font-size:14px;font-weight:800;color:var(--ink);">@(attendanceTotal > 0 ? $"{attendancePercent}% ({attendancePresent}/{attendanceTotal})" : "Not available")</div>
                                            </div>
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">CW / Exam Weight</div>
                                                <div style="font-size:14px;font-weight:800;color:var(--ink);">@((CurrentCard.CourseworkWeight ?? 0.3) * 100)% / @((1 - (CurrentCard.CourseworkWeight ?? 0.3)) * 100)%</div>
                                            </div>
                                        </div>

                                        <div class="report-table-wrap">
                                            <table class="flat-table">
                                                <thead>
                                                    <tr>
                                                        <th>Subject</th>
                                                        <th style="text-align:center;">CW (%)</th>
                                                        <th style="text-align:center;">Exam (%)</th>
                                                        <th style="text-align:center;">Final (%)</th>
                                                        <th style="text-align:center;">Grade</th>
                                                        <th style="text-align:left;">Comments</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var r in CurrentCard.Subjects)
                                                    {
                                                        string g = GradeHelper.ToGrade(r.FinalMark);
                                                        string gc = (r.FinalMark >= 50 ? "var(--green)" : "var(--red)");
                                                        <tr>
                                                            <td style="font-weight:700;color:var(--ink);">@r.SubjectName</td>
                                                            <td style="text-align:center;color:var(--ink3);font-family:'DM Mono',monospace;">@r.CourseworkMark.ToString("F1")</td>
                                                            <td style="text-align:center;color:var(--ink3);font-family:'DM Mono',monospace;">@r.ExamMark.ToString("F1")</td>
                                                            <td style="text-align:center;font-weight:800;color:var(--ink);font-family:'DM Mono',monospace;font-size:15px;">@r.FinalMark.ToString("F1")</td>
                                                            <td style="text-align:center;"><span class="grade-pill" style="background:@(r.FinalMark >= 50 ? "rgba(26,127,82,0.1)" : "rgba(200,16,46,0.1)");color:@gc;">@g</span></td>
                                                            <td style="font-size:12px;color:var(--ink2);font-style:italic;">@(string.IsNullOrEmpty(r.Comments) ? "—" : r.Comments)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="report-totals-grid report-summary-strip">
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">Subjects Recorded</div>
                                                <div style="font-size:18px;font-weight:800;color:var(--ink);">@subjectsRecorded</div>
                                            </div>
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">Subjects Passed</div>
                                                <div style="font-size:18px;font-weight:800;color:var(--green);">@subjectsPassed</div>
                                            </div>
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">Subjects Failed</div>
                                                <div style="font-size:18px;font-weight:800;color:var(--red);">@(subjectsRecorded - subjectsPassed)</div>
                                            </div>
                                        </div>
                                        @{
                                            double reportAvg = CurrentCard.Subjects?.Any() == true ? CurrentCard.Subjects.Average(s => s.FinalMark) : 0;
                                            var reportBest = CurrentCard.Subjects?.MaxBy(s => s.FinalMark);
                                            var reportWorst = CurrentCard.Subjects?.MinBy(s => s.FinalMark);
                                            string repWorstLabel = reportWorst?.FinalMark >= 80 ? "Growth Focus" : (reportWorst?.FinalMark >= 60 ? "Room for Growth" : "Needs Improvement");
                                            string repWorstColor = reportWorst?.FinalMark >= 80 ? "var(--green)" : (reportWorst?.FinalMark >= 60 ? "#d97706" : "var(--red)");
                                        }
                                        <div class="report-totals-grid report-summary-strip" style="margin-top:10px;">
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">Overall Average</div>
                                                <div style="font-size:18px;font-weight:800;color:@(reportAvg >= 50 ? "var(--green)" : "var(--red)");font-family:'DM Mono',monospace;">@reportAvg.ToString("F1")%</div>
                                                <div style="font-size:10px;color:var(--ink3);margin-top:3px;font-weight:600;">@GradeHelper.ToGrade(reportAvg) overall</div>
                                            </div>
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">Best Subject</div>
                                                <div style="font-size:13px;font-weight:800;color:var(--ink);">@reportBest?.SubjectName</div>
                                                <div style="font-size:10px;color:var(--green);font-weight:700;margin-top:3px;">@reportBest?.FinalMark.ToString("F1")%</div>
                                            </div>
                                            <div class="report-summary-card">
                                                <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--ink3);margin-bottom:6px;">@repWorstLabel</div>
                                                <div style="font-size:13px;font-weight:800;color:var(--ink);">@reportWorst?.SubjectName</div>
                                                <div style="font-size:10px;color:@repWorstColor;font-weight:700;margin-top:3px;">@reportWorst?.FinalMark.ToString("F1")%</div>
                                            </div>
                                        </div>

                                        <div class="report-comment-box">
                                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;">
                                                <div style="font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:1px;color:#1a7f52;display:flex;align-items:center;gap:6px;">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#1a7f52" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                                                    Headmaster's Remarks
                                                </div>
                                                <div style="font-size:9px;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:0.5px;">
                                                    Pass Rate: @((subjectsRecorded > 0 ? ((double)subjectsPassed / subjectsRecorded * 100.0) : 0.0).ToString("F0"))% (@subjectsPassed / @subjectsRecorded passes)
                                                </div>
                                            </div>
                                            <div style="font-size:11px;color:var(--ink2);line-height:1.5;font-weight:500;text-align:justify;">
                                                @GetHeadmasterRemarks(subjectsPassed, subjectsRecorded, reportAvg, CurrentCard.StudentFirstName, CurrentCard.StudentId, CurrentCard.Term, CurrentCard.TermYear)
                                            </div>
                                        </div>
                                    </div> <!-- /report-a4 -->
                                    <div class="cert-footer">
                                        &copy; @DateTime.Now.Year PrimeApp Demo &nbsp;&bull;&nbsp; All Rights Reserved &nbsp;&bull;&nbsp; Demo Academic Performance Report &nbsp;&bull;&nbsp; Fictional data · Demonstration only
                                    </div>
                                </div> <!-- /cert-frame -->
                            </div> <!-- /cert-border-wrap -->
                        </div> <!-- /report-a4-wrapper -->
                    </div> <!-- /report-card-print-shell -->
                }
                else
                {
                    <div style="padding:60px 40px;text-align:center;background:#fcfcfc;border-radius:24px;">
                        <div style="font-size:14px;font-weight:700;color:var(--ink2);margin-bottom:8px;">No report card available for this term</div>
                        <div style="font-size:12.5px;color:var(--ink3);line-height:1.6;">Your report card for this term has not been released yet. Please check back later or contact the school office for assistance.</div>
                    </div>
                }
            }

            <!-- ANALYTICS -->
            @if (activeTab == "analytics")
            {
                <div class="analytics-heading">
                    <div><div class="analytics-kicker">Understand progress</div><h2>Learning analytics</h2><p>Green means the mark improved. Red means it dropped. Use these views to celebrate progress and spot where support may help.</p></div>
                    <select class="flat-select analytics-year-select" @bind="analyticsYear" aria-label="Analytics year">
                        @foreach (var year in AnalyticsYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>

                @if (!AnalyticsCards.Any())
                {
                    <div class="empty-analytics">No results are available for this year yet.</div>
                }
                else
                {
                    <!-- PRINT ANALYTICS SHELL OVERLAY -->
                    <div class="analytics-print-shell print-analytics-shell-overlay">
                        <div class="cert-border-wrap">
                            <!-- cert corners -->
                            <div class="cert-corner tl"><svg viewBox="0 0 48 48" fill="none"><path d="M2 46V12C2 6.48 6.48 2 12 2H46" stroke="#1a7f52" stroke-width="2.5" stroke-linecap="round" /><circle cx="8" cy="8" r="3" fill="#1a7f52" opacity=".6" /></svg></div>
                            <div class="cert-corner tr"><svg viewBox="0 0 48 48" fill="none"><path d="M2 46V12C2 6.48 6.48 2 12 2H46" stroke="#1a7f52" stroke-width="2.5" stroke-linecap="round" /><circle cx="8" cy="8" r="3" fill="#1a7f52" opacity=".6" /></svg></div>
                            <div class="cert-corner bl"><svg viewBox="0 0 48 48" fill="none"><path d="M2 46V12C2 6.48 6.48 2 12 2H46" stroke="#1a7f52" stroke-width="2.5" stroke-linecap="round" /><circle cx="8" cy="8" r="3" fill="#1a7f52" opacity=".6" /></svg></div>
                            <div class="cert-corner br"><svg viewBox="0 0 48 48" fill="none"><path d="M2 46V12C2 6.48 6.48 2 12 2H46" stroke="#1a7f52" stroke-width="2.5" stroke-linecap="round" /><circle cx="8" cy="8" r="3" fill="#1a7f52" opacity=".6" /></svg></div>
                            <div class="cert-frame">
                                <!-- Analytics Print Header (visible only in print) -->
                                <div style="display:none;" class="analytics-print-header">
                                    <div style="display:flex;align-items:center;gap:14px;padding-bottom:12px;border-bottom:2px dashed rgba(26,127,82,0.3);margin-bottom:14px;">
                                        <img src="/images/demo-logo.svg" alt="PrimeApp Demo" class="print-logo" style="width:56px;height:auto;object-fit:contain;" />
                                        <div>
                                            <div style="font-size:16px;font-weight:900;text-transform:uppercase;color:#0f172a;">PrimeApp Demo</div>
                                            <div style="font-size:10px;color:#64748b;margin-top:2px;">Equipping youngsters to compete internationally</div>
                                        </div>
                                        <div style="margin-left:auto;text-align:right;font-size:10px;color:#475569;">
                                            <div style="font-weight:800;font-size:13px;color:#1a7f52;">Learning Analytics</div>
                                            <div>@Me.FirstName @Me.LastName</div>
                                            <div>Year @analyticsYear</div>
                                            <div>@DateTime.Now.ToString("dd MMM yyyy")</div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Watermark for analytics print -->
                                <div class="report-watermark">
                                    <img src="/images/demo-logo.svg" alt="" class="watermark-logo-img" />
                                </div>
                                <div style="position:relative;z-index:1;">

                                    <div class="analytics-stat-grid">
                                        <div class="analytics-stat"><span>Year average</span><strong>@AnalyticsYearAverage.ToString("F1")%</strong><small>Across all available terms</small></div>
                                        <div class="analytics-stat"><span>Improving subjects</span><strong class="positive">@AnalyticsImprovedCount</strong><small>Compared with the previous term</small></div>
                                        <div class="analytics-stat"><span>Subjects to watch</span><strong class="negative">@AnalyticsDroppedCount</strong><small>Small support can make a difference</small></div>
                                        @{
                                            var allSubjects2 = AnalyticsCards.Where(rc => rc.Subjects?.Any() == true).SelectMany(rc => rc.Subjects!).GroupBy(s => s.SubjectName).ToList();
                                            int passCount2 = allSubjects2.Count(g => g.Average(s => s.FinalMark) >= 50);
                                            int failCount2 = allSubjects2.Count - passCount2;
                                            int totalSubj2 = allSubjects2.Count;
                                            double passRate2 = totalSubj2 > 0 ? (passCount2 * 100.0 / totalSubj2) : 0;
                                        }
                                        <div class="analytics-stat"><span>Pass rate</span><strong style="color:@(passRate2 >= 50 ? "var(--green)" : "var(--red)")">@passRate2.ToString("F0")%</strong><small>@passCount2 of @totalSubj2 subjects passing</small></div>
                                        <div class="analytics-stat"><span>Terms recorded</span><strong>@AnalyticsCards.Count()</strong><small>In @analyticsYear</small></div>
                                        @{
                                            var bestCard2 = AnalyticsCards.Where(rc => rc.Subjects?.Any() == true).OrderByDescending(rc => rc.Subjects!.Average(s => s.FinalMark)).FirstOrDefault();
                                        }
                                        <div class="analytics-stat"><span>Best term</span><strong style="font-size:16px;">@(bestCard2 != null ? bestCard2.Term : "—")</strong><small>@(bestCard2?.Subjects?.Any() == true ? bestCard2.Subjects.Average(s => s.FinalMark).ToString("F1") + "% avg" : "")</small></div>
                                    </div>

                                    <!-- TERM AVERAGE BAR CHART -->
                                    @{
                                        var termCards2 = AnalyticsCards.ToList();
                                        double maxAvg2 = termCards2.Where(rc => rc.Subjects?.Any() == true).Select(rc => rc.Subjects!.Average(s => s.FinalMark)).DefaultIfEmpty(100).Max();
                                        double chartMax2 = Math.Max(maxAvg2, 10);
                                    }
                                    @if (termCards2.Any())
                                    {
                                        <div class="analytics-card">
                                            <div class="analytics-card-head"><div><h3>Term performance overview</h3><p>Average mark per term for @analyticsYear. The 50% line marks the pass threshold.</p></div></div>
                                            <div class="chart-bar-wrap" style="padding-top:4px;">
                                                <svg viewBox="0 0 300 100" preserveAspectRatio="none" style="width:100%;height:90px;overflow:visible;">
                                                    <!-- Pass line at 50% -->
                                                    @{
                                                        double passY2 = 90 - (50.0 / 100.0 * 80);
                                                    }
                                                    <line x1="0" y1="@passY2.ToString("F1")" x2="300" y2="@passY2.ToString("F1")" stroke="#c8102e" stroke-width="0.8" stroke-dasharray="4 3" opacity="0.5" />
                                                    @SvgText(295, passY2 - 2, "50%", "#c8102e", anchor: "end", fontSize: 6, opacity: 0.7)
                                                    @{
                                                        var termPoints2 = new List<(double X, double Y, double Avg, string Term)>();
                                                        for (int ti = 0; ti < termCards2.Count; ti++)
                                                        {
                                                            var tc = termCards2[ti];
                                                            double avg2 = tc.Subjects?.Any() == true ? tc.Subjects.Average(s => s.FinalMark) : 0;
                                                            double ptX = (termCards2.Count == 1 ? 150 : (ti * 280.0 / (termCards2.Count - 1) + 10));
                                                            double ptY = 90 - (avg2 / 100.0 * 80);
                                                            termPoints2.Add((ptX, ptY, avg2, tc.Term ?? ""));
                                                        }
                                                        string linePts2 = string.Join(" ", termPoints2.Select(p => $"{p.X.ToString("F1")},{p.Y.ToString("F1")}"));
                                                    }
                                                    <polyline points="@linePts2" fill="none" stroke="#1a7f52" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
                                                    @foreach (var p2 in termPoints2)
                                                    {
                                                        string ptColor2 = p2.Avg >= 50 ? "#1a7f52" : "#c8102e";
                                                        <circle cx="@p2.X.ToString("F1")" cy="@p2.Y.ToString("F1")" r="3.2" fill="white" stroke="@ptColor2" stroke-width="2" />
                                                        @SvgText(p2.X, p2.Y - 7, $"{p2.Avg:F0}%", ptColor2, fontWeight: "bold")
                                                        @SvgText(p2.X, 98, p2.Term, "#64748b")
                                                    }
                                                </svg>
                                            </div>
                                        </div>
                                    }

                                    <!-- SUBJECT MARKS ACROSS TERMS -->
                                    @{
                                        var matrixRows2 = SubjectTermMatrix;
                                        var matrixTerms2 = AnalyticsCards.ToList();
                                    }
                                    @if (matrixRows2.Any() && matrixTerms2.Count > 1)
                                    {
                                        <div class="analytics-card">
                                            <div class="analytics-card-head"><div><h3>Subject marks across terms</h3><p>Each subject's mark side by side, term by term, so improvement is easy to spot.</p></div></div>

                                            <div class="report-table-wrap" style="margin-bottom:18px;">
                                                <table class="flat-table subject-matrix-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Subject</th>
                                                            @foreach (var mt in matrixTerms2)
                                                            {
                                                                <th style="text-align:center;">@mt.Term</th>
                                                            }
                                                            <th style="text-align:center;">Trend</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var row2 in matrixRows2)
                                                        {
                                                            var known2 = row2.Marks.Where(m => m.HasValue).Select(m => m!.Value).ToList();
                                                            double trendDelta2 = known2.Count >= 2 ? known2.Last() - known2.First() : 0;
                                                            <tr>
                                                                <td style="font-weight:700;color:var(--ink);">@row2.Subject</td>
                                                                @foreach (var mk in row2.Marks)
                                                                {
                                                                    <td style="text-align:center;font-family:'DM Mono',monospace;font-weight:700;color:@(mk.HasValue ? (mk.Value >= 50 ? "var(--green)" : "var(--red)") : "var(--ink3)");">@(mk.HasValue ? mk.Value.ToString("F0") + "%" : "—")</td>
                                                                }
                                                                <td style="text-align:center;">
                                                                    @if (known2.Count >= 2)
                                                                    {
                                                                        <span style="font-weight:800;font-size:12px;color:@(trendDelta2 >= 0 ? "var(--green)" : "var(--red)");">@(trendDelta2 >= 0 ? "▲" : "▼") @Math.Abs(trendDelta2).ToString("F0")%</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span style="color:var(--ink3);">—</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            <!-- Multi-line chart: one line per subject -->
                                            @{
                                                string[] palette2 = new[] { "#1a7f52", "#1d4ed8", "#c2410c", "#7c3aed", "#c8102e", "#0891b2", "#a16207", "#be185d" };
                                            }
                                            <div class="chart-bar-wrap" style="padding-top:6px;">
                                                <svg viewBox="0 0 300 120" preserveAspectRatio="none" style="width:100%;height:120px;overflow:visible;">
                                                    @{
                                                        double passY3 = 100 - (50.0 / 100.0 * 85);
                                                    }
                                                    <line x1="0" y1="@passY3.ToString("F1")" x2="300" y2="@passY3.ToString("F1")" stroke="#c8102e" stroke-width="0.8" stroke-dasharray="4 3" opacity="0.4" />
                                                    @SvgText(295, passY3 - 2, "50%", "#c8102e", anchor: "end", fontSize: 6, opacity: 0.6)
                                                    @for (int si = 0; si < matrixRows2.Count; si++)
                                                    {
                                                        var srow2 = matrixRows2[si];
                                                        string lineColor2 = palette2[si % palette2.Length];
                                                        var pts2 = new List<(double X, double Y)>();
                                                        for (int ti = 0; ti < srow2.Marks.Count; ti++)
                                                        {
                                                            if (!srow2.Marks[ti].HasValue) continue;
                                                            double px = (matrixTerms2.Count == 1 ? 150 : (ti * 280.0 / (matrixTerms2.Count - 1) + 10));
                                                            double py = 100 - (srow2.Marks[ti]!.Value / 100.0 * 85);
                                                            pts2.Add((px, py));
                                                        }
                                                        string linePts3 = string.Join(" ", pts2.Select(p => $"{p.X.ToString("F1")},{p.Y.ToString("F1")}"));
                                                        <polyline points="@linePts3" fill="none" stroke="@lineColor2" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" opacity="0.9" />
                                                        @foreach (var pt2 in pts2)
                                                        {
                                                            <circle cx="@pt2.X.ToString("F1")" cy="@pt2.Y.ToString("F1")" r="2.4" fill="@lineColor2" />
                                                        }
                                                    }
                                                    @for (int ti = 0; ti < matrixTerms2.Count; ti++)
                                                    {
                                                        double lx = (matrixTerms2.Count == 1 ? 150 : (ti * 280.0 / (matrixTerms2.Count - 1) + 10));
                                                        @SvgText(lx, 114, matrixTerms2[ti].Term, "#64748b")
                                                    }
                                                </svg>
                                            </div>
                                            <div class="chart-legend-row">
                                                @for (int si = 0; si < matrixRows2.Count; si++)
                                                {
                                                    string legColor2 = palette2[si % palette2.Length];
                                                    <span class="chart-legend-item"><i style="background:@legColor2;"></i>@matrixRows2[si].Subject</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- SUBJECT PERFORMANCE BARS -->
                                    @{
                                        var latestSubjects2 = (AnalyticsCards.LastOrDefault()?.Subjects ?? CurrentCard?.Subjects ?? new List<ReportCardSubjectModel>()).OrderByDescending(s => s.FinalMark).ToList();
                                    }
                                    @if (latestSubjects2.Any())
                                    {
                                        <div class="analytics-card">
                                            <div class="analytics-card-head"><div><h3>Subject performance</h3><p>Final marks per subject — most recent term. Green ≥ 50%, red below pass.</p></div></div>
                                            @foreach (var subj2 in latestSubjects2)
                                            {
                                                string sc2 = subj2.FinalMark >= 50 ? "#1a7f52" : "#c8102e";
                                                <div class="subj-bar-row">
                                                    <div class="subj-bar-label">@subj2.SubjectName</div>
                                                    <div class="subj-bar-track">
                                                        <div class="subj-bar-fill" style="width:@subj2.FinalMark.ToString("F0")%;background:@sc2;"></div>
                                                    </div>
                                                    <div class="subj-bar-val" style="color:@sc2;">@subj2.FinalMark.ToString("F0")%</div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- GRADE DISTRIBUTION -->
                                    @{
                                        var allMarks2 = AnalyticsCards.Where(rc => rc.Subjects?.Any() == true).SelectMany(rc => rc.Subjects!).Select(s => s.FinalMark).ToList();
                                        int gdA = allMarks2.Count(m => m >= 80);
                                        int gdB = allMarks2.Count(m => m >= 65 && m < 80);
                                        int gdC = allMarks2.Count(m => m >= 50 && m < 65);
                                        int gdD = allMarks2.Count(m => m >= 40 && m < 50);
                                        int gdF = allMarks2.Count(m => m < 40);
                                        int gdTotal = allMarks2.Count;
                                    }
                                    @if (gdTotal > 0)
                                    {
                                        <div class="analytics-card">
                                            <div class="analytics-card-head"><div><h3>Grade distribution</h3><p>Across all subjects and terms recorded for @analyticsYear.</p></div></div>
                                            @foreach (var (grade, count, bg, fg) in new[] {
                                ("A (80%+)", gdA, "rgba(26,127,82,0.1)", "#1a7f52"),
                                ("B (65–79%)", gdB, "rgba(37,99,235,0.1)", "#1d4ed8"),
                                ("C (50–64%)", gdC, "rgba(202,138,4,0.1)", "#92400e"),
                                ("D (40–49%)", gdD, "rgba(249,115,22,0.1)", "#c2410c"),
                                ("F (<40%)", gdF, "rgba(200,16,46,0.1)", "#c8102e")
                            })
                                            {
                                                double pct = gdTotal > 0 ? (count * 100.0 / gdTotal) : 0;
                                                <div class="grade-dist-row">
                                                    <div class="grade-dist-badge" style="background:@bg;color:@fg;">@grade.Split(" ")[0]</div>
                                                    <div style="flex:1;min-width:0;">
                                                        <div style="font-size:10px;color:var(--ink3);margin-bottom:3px;">@grade</div>
                                                        <div class="grade-dist-bar-track"><div class="grade-dist-bar-fill" style="width:@pct.ToString("F0")%;background:@fg;opacity:0.75;"></div></div>
                                                    </div>
                                                    <div class="grade-dist-count">@count</div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- SUBJECT PROGRESS CARD (existing) -->
                                    <div class="analytics-card">
                                        <div class="analytics-card-head"><div><h3>Subject progress</h3><p>How each subject changed from one term to the next.</p></div><span class="legend"><i class="legend-up"></i>Improved <i class="legend-down"></i>Dropped</span></div>
                                        <div class="progress-list">
                                            @foreach (var row in SubjectProgressRows)
                                            {
                                                <div class="progress-row"><div class="progress-subject"><strong>@row.Subject</strong><span>@row.From.ToString("F0")% → @row.To.ToString("F0")%</span></div><div class="progress-track"><div class="progress-fill @(row.Delta >= 0 ? "up" : "down")" style="width:@Math.Min(Math.Abs(row.Delta) * 4 + 8, 100).ToString("F0")%"></div></div><b class="delta @(row.Delta >= 0 ? "positive" : "negative")">@(row.Delta >= 0 ? "+" : "")@row.Delta.ToString("F1")%</b></div>
                                            }
                                        </div>
                                    </div>

                                    <!-- TESTS AND EXAMS -->
                                    <div class="analytics-card">
                                        <div class="analytics-card-head"><div><h3>Tests and exams</h3><p>Choose a term, then open a subject to see the recorded assessments and feedback.</p></div><div class="assessment-filters"><select class="flat-select" @bind="selectedTerm" @bind:after="OnTermChanged"><option>Term 1</option><option>Term 2</option><option>Term 3</option></select><input class="flat-select results-year-input" type="number" @bind="selectedTermYear" @bind:after="OnTermChanged" /></div></div>
                                        <div class="assessment-list">
                                            @foreach (var subject in (CurrentCard?.Subjects ?? new List<ReportCardSubjectModel>()).OrderBy(s => s.SubjectName))
                                            {
                                                var open = expandedSubjects.Contains(subject.SubjectName ?? string.Empty);
                                                <button type="button" class="assessment-item" @onclick="() => ToggleSubject(subject.SubjectName ?? string.Empty)"><span><strong>@subject.SubjectName</strong><small>@(open ? "Hide assessment details" : "Show assessment details")</small></span><span class="assessment-mark">@subject.FinalMark.ToString("F0")% <em>@(open ? "⌃" : "⌄")</em></span></button>
                                                @if (open)
                                                {
                                                    <div class="assessment-detail assessment-detail-stack"><span>Coursework total <b>@subject.CourseworkMark.ToString("F1")%</b></span><span>Exam total <b>@subject.ExamMark.ToString("F1")%</b></span><span>Grade <b>@GradeHelper.ToGrade(subject.FinalMark)</b></span>
                                                        @if (examFeedbackBySubject.TryGetValue(subject.SubjectName ?? string.Empty, out var exams) && exams.Any())
                                                        { <div class="assessment-breakdown"><strong>Individual exams</strong>@foreach (var exam in exams) { <div><span>@(exam.ExamTitle ?? "Exam")</span><b>@(exam.Score?.ToString("F1") ?? "—")%</b></div> }</div> }
                                                        @if (courseworkMarksBySubject.TryGetValue(subject.SubjectName ?? string.Empty, out var coursework) && coursework.Any())
                                                        { <div class="assessment-breakdown"><strong>Individual coursework/tests</strong>@foreach (var mark in coursework) { <div><span>Recorded assessment</span><b>@mark.PercentageScore.ToString("F1")%</b></div> }</div> }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <!-- Print button (no-print) -->
                                    <div class="no-print" style="display:flex;justify-content:flex-end;margin-top:8px;margin-bottom:4px;">
                                        <button class="analytics-print-btn" @onclick="PrintAnalytics">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                                            Print Analytics
                                        </button>
                                    </div>

                                    <!-- Analytics print footer -->
                                    <div class="cert-footer">
                                        &copy; @DateTime.Now.Year PrimeApp Demo &nbsp;&bull;&nbsp; All Rights Reserved &nbsp;&bull;&nbsp; Confidential Academic Document &nbsp;&bull;&nbsp; Fictional data · Demonstration only
                                    </div>

                                </div> <!-- /relative z-1 -->
                            </div> <!-- /cert-frame -->
                        </div> <!-- /cert-border-wrap -->
                    </div> <!-- /analytics-print-shell print-analytics-shell-overlay -->
                }
            }

            <style>
                            .report-filter-card, .analytics-card, .analytics-stat {
