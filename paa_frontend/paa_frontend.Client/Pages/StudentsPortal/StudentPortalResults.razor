                                margin: 0;
                                color: var(--ink);
                                font-size: 16px;
                            }

                            .chart-legend-row {
                                display: flex;
                                flex-wrap: wrap;
                                gap: 12px 18px;
                                margin-top: 12px;
                                padding-top: 12px;
                                border-top: 1px solid #f0f0f0;
                            }

                            .chart-legend-item {
                                display: inline-flex;
                                align-items: center;
                                gap: 6px;
                                font-size: 11px;
                                font-weight: 700;
                                color: var(--ink2);
                            }

