        StateHasChanged();
    }

    private async Task LoadStudentAsync()
    {
        try
        {
            var userIdStr = await JS.InvokeAsync<string>("sessionStorage.getItem", "primeappDemo.userId");
            if (int.TryParse(userIdStr, out int realUserId))
                Me.Id = realUserId;

            var student = await StudentService.GetStudentAsync(Me.Id);
            if (student != null) Me = student;
        }
        catch { }
    }

    private async Task LoadReportCardsAsync()
    {
        isLoading = true;
        loadError = string.Empty;
        try
        {
            var cards = await GradesService.GetReportCardsAsync(Me.Id);
            allReportCards = cards ?? new();

            // Open the most recently released report by default. Previously
            // this page was hard-coded to Term 2 2026, so a newly approved
            // Term 3 report appeared to be missing until the student changed
            // the term selector manually.
            var latestCard = allReportCards
                .OrderByDescending(rc => rc.TermYear)
                .ThenByDescending(rc => TermNumber(rc.Term))
                .FirstOrDefault();
            if (latestCard != null)
            {
                selectedTerm = latestCard.Term ?? selectedTerm;
                selectedTermYear = latestCard.TermYear;
                analyticsYear = latestCard.TermYear;
            }

            _reportAverages.Clear();
            foreach (var rc in allReportCards)
            {
                if (rc?.Id != null)
                {
                    var avg = rc.Subjects != null && rc.Subjects.Any() ? rc.Subjects.Average(s => s.FinalMark) : 0;
                    _reportAverages[rc.Id.Value] = avg;
                }
            }

            await RefreshCurrentCardAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Could not load results. ({ex.Message})";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static int TermNumber(string? term) => term switch
