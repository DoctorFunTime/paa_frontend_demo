@page "/portal/personal-finance"
@namespace paa_frontend.Client.Pages.Portal
@layout paa_frontend.Client.Layout.StudentPortalLayout
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Routing
@using paa_frontend.Shared.Models
@using static paa_frontend.Shared.Models.StudentProfileModel
@inject IJSRuntime JS
@inject StudentProfileServiceClient StudentService
@inject FinanceServiceClient FinanceService
@inject NavigationManager Nav

<style>
    /* ── PAGE SHELL ── */
    .finance-page {
        padding: 16px 16px 60px;
        max-width: 1100px;
        margin: 0 auto;
    }

    /* ── PAGE HEADER ── */
    .page-header {
        margin-bottom: 20px;
    }

    .page-title {
        font-size: 24px;
        font-weight: 800;
        color: #111827;
        letter-spacing: -0.5px;
    }

    .page-sub {
        font-size: 13px;
        color: #374151;
        margin-top: 3px;
        font-weight: 500;
    }

    /* ── PAYNOW HERO CARD ── */
    .paynow-hero {
        background: linear-gradient(135deg, #111827 0%, #1F2937 100%);
        border-radius: 24px;
        padding: 28px 32px;
        margin-bottom: 20px;
        color: #ffffff;
        box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    }

    .paynow-hero-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 22px;
    }

    .paynow-hero-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .paynow-hero-title {
        font-size: 18px;
        font-weight: 800;
        letter-spacing: -0.3px;
    }

    .paynow-hero-sub {
        font-size: 12px;
        color: rgba(255,255,255,0.7);
        font-weight: 500;
        margin-top: 3px;
    }

    .paynow-form-row {
        display: flex;
        gap: 14px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .paynow-field {
        flex: 1;
        min-width: 160px;
    }

    .paynow-label {
        display: block;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: rgba(255,255,255,0.6);
        margin-bottom: 7px;
    }

    .paynow-input-wrap {
        position: relative;
    }

    .paynow-prefix {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 16px;
        font-weight: 800;
        color: rgba(255,255,255,0.4);
        pointer-events: none;
    }

    .paynow-input {
        width: 100%;
        padding: 13px 14px 13px 34px;
        background: rgba(255,255,255,0.1);
        border: 1.5px solid rgba(255,255,255,0.2);
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        color: #ffffff;
        outline: none;
        transition: border 0.15s, background 0.15s;
        box-sizing: border-box;
    }

        .paynow-input::placeholder {
            color: rgba(255,255,255,0.35);
        }

        .paynow-input:focus {
            border-color: rgba(255,255,255,0.5);
            background: rgba(255,255,255,0.15);
            box-shadow: 0 0 0 4px rgba(255,255,255,0.08);
        }

    .paynow-input-no-prefix {
        padding-left: 14px;
    }

    .paynow-submit {
        padding: 13px 24px;
        background: #ffffff;
        color: #111827;
        border: none;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 9px;
        white-space: nowrap;
        transition: opacity 0.15s, transform 0.1s;
        flex-shrink: 0;
    }

        .paynow-submit:hover:not(:disabled) {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        .paynow-submit:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

    .paynow-balance-hint {
        margin-top: 10px;
        font-size: 11px;
        color: rgba(255,255,255,0.55);
        font-weight: 500;
    }

        .paynow-balance-hint strong {
            color: #FCA5A5;
        }

        .paynow-balance-hint button {
            color: #FCA5A5;
            background: none;
            border: none;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: underline;
            padding: 0;
            margin-left: 6px;
        }

    /* ── PAYNOW RESULT (inside hero) ── */
    .paynow-result {
        margin-top: 18px;
        padding: 14px 18px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }

        .paynow-result.success {
            background: rgba(22,163,74,0.2);
            border: 1px solid rgba(22,163,74,0.4);
            color: #BBF7D0;
        }

        .paynow-result.error {
            background: rgba(220,38,38,0.2);
            border: 1px solid rgba(220,38,38,0.4);
            color: #FECACA;
        }

        .paynow-result.pending {
            background: rgba(234,179,8,0.2);
            border: 1px solid rgba(234,179,8,0.4);
            color: #FEF08A;
        }

    .paynow-result-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 6px;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 8px;
    }

    .paynow-result.success .paynow-result-badge {
        background: rgba(22,163,74,0.4);
        color: #BBF7D0;
    }

    .paynow-result.error .paynow-result-badge {
        background: rgba(220,38,38,0.4);
        color: #FECACA;
    }

    .paynow-result.pending .paynow-result-badge {
        background: rgba(234,179,8,0.4);
        color: #FEF08A;
    }

    .paynow-result-ref {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
        font-weight: 700;
        margin-top: 4px;
    }

    .paynow-result-msg {
        margin-top: 4px;
        font-size: 11px;
        font-weight: 500;
        line-height: 1.6;
    }

    .paynow-result-actions {
        margin-top: 10px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .paynow-action-btn {
        padding: 7px 14px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        border: 1.5px solid;
        transition: opacity 0.12s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: transparent;
        color: #ffffff;
    }

        .paynow-action-btn.green {
            border-color: rgba(74,222,128,0.5);
            color: #BBF7D0;
        }

        .paynow-action-btn.slate {
            border-color: rgba(255,255,255,0.3);
            color: rgba(255,255,255,0.8);
        }

        .paynow-action-btn:hover {
            opacity: 0.8;
        }

    /* ── VALIDATION ERROR ── */
    .paynow-validation {
        margin-top: 10px;
        padding: 10px 14px;
        background: rgba(220,38,38,0.2);
        border: 1px solid rgba(220,38,38,0.4);
        border-radius: 10px;
        font-size: 11px;
        font-weight: 600;
        color: #FECACA;
    }

    /* ── SUMMARY CARDS ── */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .summary-card {
        background: rgba(255,255,255,0.88);
        backdrop-filter: blur(20px) saturate(150%);
        -webkit-backdrop-filter: blur(20px) saturate(150%);
        border: 1px solid rgba(255,255,255,0.6);
        border-top: 1px solid rgba(255,255,255,0.9);
        border-radius: 20px;
        padding: 18px 20px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
    }

    .summary-card-label {
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #6B7280;
        margin-bottom: 8px;
    }

    .summary-card-val {
        font-size: 26px;
        font-weight: 800;
        font-family: 'DM Mono', monospace;
        line-height: 1;
        color: #111827;
    }

    .summary-card-sub {
        font-size: 11px;
        color: #4B5563;
        margin-top: 6px;
        font-weight: 500;
    }

    /* ── SHARED PANEL SHELL ── */
    .panel {
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid #E5E7EB;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
        overflow: hidden;
        margin-top: 18px;
    }

    .panel-header {
        padding: 18px 24px;
        border-bottom: 1px solid #F3F4F6;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .panel-title {
        font-size: 15px;
        font-weight: 800;
        color: #111827;
    }

    .panel-subtitle {
        font-size: 11px;
        color: #6B7280;
        font-weight: 500;
        margin-top: 3px;
    }

    /* ── STUDENT INFO BAR ── */
    .student-info-bar {
        padding: 14px 24px;
        background: #F9FAFB;
        border-bottom: 1px solid #F3F4F6;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .student-info-name {
        font-size: 15px;
        font-weight: 800;
        color: #111827;
    }

    .student-info-sub {
        font-size: 12px;
        color: #6B7280;
        font-weight: 500;
        margin-top: 2px;
    }

    .balance-badge {
        padding: 6px 14px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 800;
        font-family: 'DM Mono', monospace;
    }

        .balance-badge.owed {
            background: #FEF2F2;
            color: #DC2626;
            border: 1px solid rgba(220,38,38,0.2);
        }

        .balance-badge.clear {
            background: #F0FDF4;
            color: #16A34A;
            border: 1px solid rgba(22,163,74,0.2);
        }

        .balance-badge.credit {
            background: #EFF6FF;
            color: #2563EB;
            border: 1px solid rgba(37,99,235,0.2);
        }

    /* ── TABLE ── */
    .stmt-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .stmt-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .stmt-table thead th {
            padding: 11px 16px;
            text-align: left;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #6B7280;
            background: #F9FAFB;
            border-bottom: 2px solid #F3F4F6;
            white-space: nowrap;
        }

            .stmt-table thead th.text-right {
                text-align: right;
            }

        .stmt-table tbody tr {
            border-bottom: 1px solid #F3F4F6;
            transition: background 0.15s;
        }

            .stmt-table tbody tr:hover {
                background: #FAFAFA;
            }

        .stmt-table tbody td {
            padding: 12px 16px;
            color: #374151;
            vertical-align: middle;
        }

            .stmt-table tbody td.text-right {
                text-align: right;
            }

            .stmt-table tbody td.debit {
                color: #DC2626;
                font-weight: 700;
            }

            .stmt-table tbody td.credit {
                color: #16A34A;
                font-weight: 700;
            }

            .stmt-table tbody td.balance-col {
                font-weight: 800;
                font-family: 'DM Mono', monospace;
            }

            .stmt-table tbody td.balance-owed {
                color: #DC2626;
            }

            .stmt-table tbody td.balance-credit {
                color: #2563EB;
            }

            .stmt-table tbody td.balance-nil {
                color: #16A34A;
            }

        .stmt-table .ref-text {
            font-family: 'DM Mono', monospace;
            font-size: 11px;
            color: #6B7280;
        }

        .stmt-table .date-text {
            font-size: 12px;
            white-space: nowrap;
            color: #6B7280;
        }

    /* ── FOOTER TOTALS ── */
    .stmt-footer {
        padding: 14px 24px;
        border-top: 2px solid #F3F4F6;
        background: #F9FAFB;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 32px;
        flex-wrap: wrap;
    }

    .stmt-footer-item {
        text-align: right;
    }

    .stmt-footer-label {
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #6B7280;
        margin-bottom: 4px;
    }

    .stmt-footer-val {
        font-size: 18px;
        font-weight: 800;
        font-family: 'DM Mono', monospace;
    }

    /* ── PAYMENT HISTORY ROWS ── */
    .payment-row {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 20px;
        border-bottom: 1px solid #F3F4F6;
    }

        .payment-row:last-child {
            border-bottom: none;
        }

    .payment-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #F0FDF4;
        color: #16A34A;
    }

    .payment-desc {
        flex: 1;
        min-width: 0;
    }

    .payment-desc-title {
        font-size: 13px;
        font-weight: 700;
        color: #111827;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .payment-desc-meta {
        font-size: 11px;
        color: #6B7280;
        margin-top: 2px;
    }

    .payment-amount {
        font-size: 14px;
        font-weight: 800;
        color: #16A34A;
        font-family: 'DM Mono', monospace;
        flex-shrink: 0;
    }

    /* ── STATUS CHIP ── */
    .status-chip {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .status-chip.confirmed {
            background: #F0FDF4;
            color: #16A34A;
        }

        .status-chip.pending {
            background: #FEF3C7;
            color: #B45309;
        }

    /* ── EMPTY / LOADING ── */
    .empty-state {
        padding: 48px 24px;
        text-align: center;
        color: #6B7280;
    }

        .empty-state svg {
            margin: 0 auto 14px;
            display: block;
            opacity: 0.3;
        }

        .empty-state p {
            font-size: 13px;
            font-weight: 600;
            color: #374151;
        }

    /* ── SKELETON ── */
    .skeleton {
        background: linear-gradient(90deg,#F1F5F9 25%,#E2E8F0 50%,#F1F5F9 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
        border-radius: 6px;
    }

    @@keyframes shimmer {
        0% {
            background-position: 200% 0
        }

        100% {
            background-position: -200% 0
        }
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg)
        }
    }

    .spin {
        animation: spin 0.75s linear infinite;
    }

    /* ── PRINT ── */
    @@media print {
        .finance-page > *:not(.print-area) {
            display: none !important;
        }

        .no-print {
            display: none !important;
        }

        .panel {
            box-shadow: none;
            border: 1px solid #ccc;
        }
    }

    /* ── MOBILE ── */
    @@media (max-width: 700px) {
        .finance-page {
            padding: 12px 12px 48px;
        }

        .paynow-hero {
            padding: 20px;
        }

        .paynow-form-row {
            flex-direction: column;
            gap: 12px;
        }

        .paynow-field {
            min-width: 100%;
        }

        .paynow-submit {
            width: 100%;
            justify-content: center;
        }

        .summary-grid {
            grid-template-columns: 1fr 1fr;
        }

        .summary-card {
            padding: 14px 16px;
        }

        .summary-card-val {
            font-size: 22px;
        }

        .panel-header {
            padding: 16px;
        }

        .student-info-bar {
            padding: 12px 16px;
        }

        .stmt-table thead th, .stmt-table tbody td {
            padding: 10px 12px;
        }

        .stmt-footer {
            padding: 12px 16px;
            gap: 20px;
        }

        .payment-row {
            padding: 12px 16px;
        }

        .page-title {
            font-size: 20px;
        }
    }

    @@media (max-width: 480px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .stmt-table {
            min-width: 520px;
        }
    }
</style>

@{
    var pageTitle = "Finance";
}

<CascadingValue Name="PageTitle" Value="@pageTitle">
    <div class="finance-page">
        <NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" ConfirmExternalNavigation="IsProcessing" />

        @if (IsProcessing)
        {
            <div style="position: fixed; inset: 0; z-index: 99999; background: rgba(17, 24, 39, 0.7); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; pointer-events: all;">
                <div style="background: #ffffff; border-radius: 24px; padding: 32px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); max-width: 380px; width: 100%; margin: 0 16px; text-align: center; border: 1px solid rgba(229, 231, 235, 1);">
                    @if (processingState == "initiating")
                    {
                        <div style="margin-bottom: 20px;">
                            <svg class="animate-spin" style="height: 48px; width: 48px; margin: 0 auto; color: #10B981;" viewBox="0 0 24 24">
                                <circle style="opacity: 0.25;" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                                <path style="opacity: 0.75;" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                            </svg>
                        </div>
                        <h3 style="font-size: 18px; font-weight: 800; color: #111827; margin-bottom: 8px;">Initiating Payment</h3>
                        <p style="font-size: 14px; color: #6B7280; font-weight: 500; line-height: 1.5; margin: 0;">Communicating with the payment gateway. Please wait...</p>
                    }
                    else if (processingState == "polling")
                    {
                        <div style="margin-bottom: 20px; position: relative; display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; margin-left: auto; margin-right: auto;">
                            <svg class="animate-spin" style="height: 48px; width: 48px; color: #059669;" viewBox="0 0 24 24">
                                <circle style="opacity: 0.25;" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                                <path style="opacity: 0.75;" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                            </svg>
                        </div>
                        <h3 style="font-size: 18px; font-weight: 800; color: #111827; margin-bottom: 8px;">Waiting for Approval</h3>
                        <div style="background: #F9FAFB; border: 1px solid #F3F4F6; border-radius: 16px; padding: 16px; margin-bottom: 16px; text-align: left;">
                            <div style="font-size: 10px; color: #9CA3AF; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Mobile Number</div>
                            <div style="font-size: 14px; font-weight: 800; color: #1F2937;">@paynowMobile</div>
                            <div style="font-size: 10px; color: #9CA3AF; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 12px; margin-bottom: 4px;">Instructions</div>
                            <div style="font-size: 12px; font-weight: 600; color: #4B5563; line-height: 1.5;">A USSD push notification has been sent. Enter your mobile money PIN on your phone to complete the payment.</div>
                        </div>
                        <p style="font-size: 11px; font-weight: 700; color: #9CA3AF; margin-bottom: 24px;">Checking status automatically...</p>
                        <button type="button" style="width: 100%; padding: 12px; border-radius: 12px; border: none; background: #F3F4F6; color: #374151; font-size: 14px; font-weight: 700; cursor: pointer; transition: background 0.2s;" @onclick="CancelPolling">
                            Run in Background
                        </button>
                    }
                    else if (processingState == "success")
                    {
                        <div style="margin-bottom: 20px; height: 64px; width: 64px; background: #D1FAE5; color: #059669; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-left: auto; margin-right: auto;">
                            <svg style="height: 32px; width: 32px;" fill="none" stroke="currentColor" stroke-width="3.5" viewBox="0 0 24 24">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <h3 style="font-size: 18px; font-weight: 800; color: #111827; margin-bottom: 8px;">Payment Confirmed</h3>
                        <p style="font-size: 14px; color: #4B5563; font-weight: 500; line-height: 1.5; margin-bottom: 24px;">@processingStatusMessage</p>
                        <button type="button" style="width: 100%; padding: 12px; border-radius: 12px; border: none; background: #111827; color: #ffffff; font-size: 14px; font-weight: 700; cursor: pointer;" @onclick="CloseModal">
                            Done
                        </button>
                    }
                    else if (processingState == "failed")
                    {
                        <div style="margin-bottom: 20px; height: 64px; width: 64px; background: #FEE2E2; color: #DC2626; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-left: auto; margin-right: auto;">
                            <svg style="height: 32px; width: 32px;" fill="none" stroke="currentColor" stroke-width="3.5" viewBox="0 0 24 24">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </div>
                        <h3 style="font-size: 18px; font-weight: 800; color: #DC2626; margin-bottom: 8px;">Payment Failed</h3>
                        <p style="font-size: 14px; color: #4B5563; font-weight: 500; line-height: 1.5; margin-bottom: 24px;">@processingStatusMessage</p>
                        <button type="button" style="width: 100%; padding: 12px; border-radius: 12px; border: none; background: #111827; color: #ffffff; font-size: 14px; font-weight: 700; cursor: pointer;" @onclick="CloseModal">
                            Close
                        </button>
                    }
                    else if (processingState == "timeout")
                    {
                        <div style="margin-bottom: 20px; height: 64px; width: 64px; background: #FEF3C7; color: #D97706; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-left: auto; margin-right: auto;">
                            <svg style="height: 32px; width: 32px;" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                        <h3 style="font-size: 18px; font-weight: 800; color: #D97706; margin-bottom: 8px;">Polling Timed Out</h3>
                        <p style="font-size: 14px; color: #4B5563; font-weight: 500; line-height: 1.5; margin-bottom: 24px;">We haven't received confirmation yet. The payment may still be processing on your device.</p>
                        <button type="button" style="width: 100%; padding: 12px; border-radius: 12px; border: none; background: #111827; color: #ffffff; font-size: 14px; font-weight: 700; cursor: pointer;" @onclick="CloseModal">
                            Continue in Background
                        </button>
                    }
                </div>
            </div>
        }

        <!-- ── PAGE HEADER ── -->
        <div class="page-header no-print">
            <div class="page-title">My Account Statement</div>
            <div class="page-sub">Live balance, fees history and payment records</div>
        </div>

        @if (!string.IsNullOrEmpty(loadError))
        {
            <div style="margin-bottom:16px;padding:14px 18px;background:#FEF2F2;border:1px solid rgba(220,38,38,0.3);border-radius:16px;color:#991B1B;font-size:13px;font-weight:600;">
                ⚠ @loadError
            </div>
        }

        @if (isLoading)
        {
            <div class="skeleton" style="height:160px;border-radius:24px;margin-bottom:20px;"></div>
            <div class="summary-grid">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="summary-card">
                        <div class="skeleton" style="height:10px;width:60%;margin-bottom:10px;"></div>
                        <div class="skeleton" style="height:26px;width:80%;"></div>
                    </div>
                }
            </div>
            <div class="panel" style="margin-top:0;">
                <div class="empty-state">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                    <p>Loading your account data…</p>
                </div>
            </div>
        }
        else
        {
            <!-- ── PAYNOW PAYMENT PANEL (temporarily hidden) ── -->
            @* @if (false) { *@
            @if (false)
            {
            <div class="paynow-hero no-print">
                <div class="paynow-hero-header">
                    <div class="paynow-hero-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2">
                            <rect x="5" y="2" width="14" height="20" rx="2" />
                            <line x1="12" y1="18" x2="12.01" y2="18" />
                        </svg>
                    </div>
                    <div>
                        <div class="paynow-hero-title">Pay Fees with Paynow</div>
                        <div class="paynow-hero-sub">EcoCash — approve the USSD prompt on your phone</div>
                    </div>
                </div>

                <!-- Result card (shown after submission) -->
                @if (!string.IsNullOrEmpty(paynowResultMessage))
                {
                    <div class="paynow-result @paynowResultCss">
                        <div class="paynow-result-badge">@paynowResultLabel</div>
                        @if (!string.IsNullOrEmpty(paynowReference))
                        {
                            <div class="paynow-result-ref">Reference: @paynowReference</div>
                        }
                        <div class="paynow-result-msg">@paynowResultMessage</div>
                        <div class="paynow-result-actions">
                            @if (!string.IsNullOrEmpty(paynowRedirectUrl))
                            {
                                <a href="@paynowRedirectUrl" target="_blank" class="paynow-action-btn green">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
                                    Open Paynow Page
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(paynowReference))
                            {
                                <button class="paynow-action-btn slate" @onclick="CheckPaynowStatusAsync" disabled="@isCheckingStatus">
                                    @if (isCheckingStatus)
                                    {
                                        <svg class="spin" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 12a9 9 0 1 1-6.219-8.56" stroke-linecap="round" /></svg>
                                        <span>Checking…</span>
                                    }
                                    else
                                    {
                                        <span>↻ Refresh Status</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Form fields -->
                <div class="paynow-form-row" style="display: flex; flex-direction: row; align-items: flex-end; gap: 15px; flex-wrap: wrap; padding-bottom: 25px;">

                    <!-- Amount Field -->
                    <div class="paynow-field" style="flex: 1; min-width: 200px; position: relative; display: flex; flex-direction: column;">
                        <label class="paynow-label">Amount (USD) <span style="color:#FCA5A5;">*</span></label>
                        <div class="paynow-input-wrap">
                            <span class="paynow-prefix">$</span>
                            <input type="number" step="0.01" min="0.01" class="paynow-input"
                                   placeholder="0.00"
                                   @bind="paynowAmountRaw" @bind:event="oninput" />
                        </div>
                        @if (CurrentBalance > 0)
                        {
                            <div class="paynow-balance-hint" style="position: absolute; top: 100%; left: 0; padding-top: 6px; white-space: nowrap;">
                                Balance due: <strong>$@CurrentBalance.ToString("N2")</strong>
                                <button @onclick="FillFullAmount" style="margin-left: 5px; cursor: pointer; background: none; border: none; color: #93C5FD; text-decoration: underline; padding: 0;">Pay full amount</button>
                            </div>
                        }
                        else if (CurrentBalance < 0)
                        {
                            <div class="paynow-balance-hint" style="position: absolute; top: 100%; left: 0; padding-top: 6px; white-space: nowrap; color:rgba(255,255,255,0.5);">
                                You have a credit of <strong style="color:#93C5FD;">$@Math.Abs(CurrentBalance).ToString("N2")</strong>
                            </div>
                        }
                    </div>

                    <!-- Mobile Number Field -->
                    <div class="paynow-field" style="flex: 1; min-width: 200px; position: relative; display: flex; flex-direction: column;">
                        <label class="paynow-label">Mobile Number <span style="color:#FCA5A5;">*</span></label>
                        <div class="paynow-input-wrap" style="position: relative;">
                            <span class="paynow-prefix" style="left:14px;top:50%;transform:translateY(-50%);font-size:16px;font-weight:800;color:rgba(255,255,255,0.4);pointer-events:none;position:absolute;">📱</span>
                            <input type="tel" class="paynow-input"
                                   placeholder="e.g. 0771234567"
                                   style="padding-left:40px;"
                                   @bind="paynowMobile" @bind:event="oninput" />
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button class="paynow-submit" @onclick="SubmitPaynowAsync" disabled="@isPaynowSubmitting" style="height: 42px; white-space: nowrap;">
                        @if (isPaynowSubmitting)
                        {
                            <svg class="spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21 12a9 9 0 1 1-6.219-8.56" stroke-linecap="round" /></svg>
                            <span>Sending…</span>
                        }
                        else
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="5 12 10 17 19 8" /></svg>
                            <span>Pay Now</span>
                        }
                    </button>

                </div>
            </div>
            } <!-- /paynow-hero hidden -->

            <!-- ── SUMMARY CARDS ── -->
            <div class="summary-grid">
                <div class="summary-card">
                    <div class="summary-card-label">Total Charged</div>
                    <div class="summary-card-val">@FormatMoney(TotalCharged)</div>
                    <div class="summary-card-sub">Fees posted to your account</div>
                </div>
                <div class="summary-card">
                    <div class="summary-card-label">Total Paid</div>
                    <div class="summary-card-val">@FormatMoney(TotalPaid)</div>
                    <div class="summary-card-sub">Payments received to date</div>
                </div>
                <div class="summary-card">
                    <div class="summary-card-label">@(CurrentBalance > 0 ? "Amount Due" : CurrentBalance < 0 ? "Credit" : "Balance")</div>
                    <div class="summary-card-val" style="@(CurrentBalance > 0 ? "color:#DC2626;" : CurrentBalance < 0 ? "color:#2563EB;" : "color:#16A34A;")">
                        @(CurrentBalance > 0 ? FormatMoney(CurrentBalance) : CurrentBalance < 0 ? FormatMoney(Math.Abs(CurrentBalance)) : "Settled")
                    </div>
                    <div class="summary-card-sub">@(CurrentBalance > 0 ? "Please pay at your earliest convenience." : CurrentBalance < 0 ? "Advance credit on your account." : "Your account is fully settled.")</div>
                </div>
            </div>

            <!-- ── ACCOUNT STATEMENT ── -->
            <div class="panel print-area" style="margin-top:0;">

                <div class="panel-header">
                    <div>
                        <div class="panel-title">Account Statement</div>
                        <div class="panel-subtitle">Generated @DateTime.Today.ToString("dd MMM yyyy") &middot; PrimeApp Demo</div>
                    </div>
                    <button class="no-print"
                            style="padding:8px 16px;background:#111827;color:white;border:none;border-radius:10px;font-size:12px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:8px;"
                            @onclick="PrintStatement">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                        Print
                    </button>
                </div>

                <div class="student-info-bar">
                    <div>
                        <div class="student-info-name">@Me.FirstName @Me.LastName</div>
                        <div class="student-info-sub">@FormatClassroom(Me.Form, Me.Classroom) &middot; ID: @Me.Id</div>
                    </div>
                    <div class="@($"balance-badge {(CurrentBalance > 0 ? "owed" : CurrentBalance < 0 ? "credit" : "clear")}")">
                        @FormatBalance(CurrentBalance)
                    </div>
                </div>

                @if (!statementRows.Any())
                {
                    <div class="empty-state">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        <p>No transactions found on your account.</p>
                    </div>
                }
                else
                {
                    <div class="stmt-table-wrap">
                        <table class="stmt-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Reference</th>
                                    <th>Description</th>
                                    <th class="text-right">Debit (Fees)</th>
                                    <th class="text-right">Credit (Paid)</th>
                                    <th class="text-right">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in statementRows)
                                {
                                    <tr>
                                        <td class="date-text">@row.When.ToString("dd MMM yyyy")</td>
                                        <td class="ref-text">@row.Reference</td>
                                        <td>@row.Description</td>
                                        <td class="text-right @(row.Charge > 0 ? "debit" : "")">@(row.Charge > 0 ? $"${row.Charge:N2}" : "--")</td>
                                        <td class="text-right @(row.Paid > 0 ? "credit" : "")">@(row.Paid > 0 ? $"${row.Paid:N2}" : "--")</td>
                                        <td class="text-right balance-col @(row.RunningBalance > 0 ? "balance-owed" : row.RunningBalance < 0 ? "balance-credit" : "balance-nil")">
                                            @if (row.RunningBalance > 0)
                                            {
                                                <span>Dr $@row.RunningBalance.ToString("N2")</span>
                                            }
                                            else if (row.RunningBalance < 0)
                                            {
                                                <span>Cr $@Math.Abs(row.RunningBalance).ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span>Nil</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="stmt-footer">
                        <div class="stmt-footer-item">
                            <div class="stmt-footer-label">Total Debits</div>
                            <div class="stmt-footer-val" style="color:#DC2626;">$@TotalCharged.ToString("N2")</div>
                        </div>
                        <div class="stmt-footer-item">
                            <div class="stmt-footer-label">Total Credits</div>
                            <div class="stmt-footer-val" style="color:#16A34A;">$@TotalPaid.ToString("N2")</div>
                        </div>
                        <div class="stmt-footer-item">
                            <div class="stmt-footer-label">Closing Balance</div>
                            <div class="stmt-footer-val" style="@(CurrentBalance > 0 ? "color:#DC2626;" : CurrentBalance < 0 ? "color:#2563EB;" : "color:#16A34A;")">
                                @FormatBalance(CurrentBalance)
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- ── PAYMENT HISTORY ── -->
            @if (paymentHistory.Any())
            {
                <div class="panel no-print">
                    <div class="panel-header">
                        <div>
                            <div class="panel-title">Payment History</div>
                            <div class="panel-subtitle">@paymentHistory.Count payment(s) recorded on your account</div>
                        </div>
                    </div>
                    @foreach (var p in paymentHistory.OrderByDescending(p => ParseDate(p.Date) ?? DateTime.MinValue))
                    {
                        var paidAmt = p.AmountUsd > 0 ? p.AmountUsd : p.Amount;
                        <div class="payment-row">
                            <div class="payment-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                            </div>
                            <div class="payment-desc">
                                <div class="payment-desc-title">@(p.Description ?? "Payment")</div>
                                <div class="payment-desc-meta">
                                    @(ParseDate(p.Date)?.ToString("dd MMM yyyy") ?? "—")
                                    @if (!string.IsNullOrWhiteSpace(p.PaymentReference))
                                    {
                                        <span style="margin-left:8px;font-family:'DM Mono',monospace;">@p.PaymentReference</span>
                                    }
                                    <span class="status-chip @(p.IsConfirmed ? "confirmed" : "pending")" style="margin-left:8px;">
                                        @(p.IsConfirmed ? "Confirmed" : (p.Status ?? "Pending"))
                                    </span>
                                </div>
                            </div>
                            <div class="payment-amount">$@paidAmt.ToString("N2")</div>
                        </div>
                    }
                </div>
            }
        }

    </div>
</CascadingValue>

@code {
    private bool isLoading = true;
    private string loadError = string.Empty;

    private Student Me = new();
    private FinancialStatementDto? statement;
    private List<PaymentRecord> paymentHistory = new();
    private List<StatementRow> statementRows = new();

    // ── Paynow state ──────────────────────────────────────────────────────
    private string paynowAmountRaw = string.Empty;
    private string paynowMobile = string.Empty;
    private bool isPaynowSubmitting = false;
    private bool isCheckingStatus = false;
    private string processingState = "initiating";
    private string processingStatusMessage = string.Empty;
    private bool isPollingCancelled = false;

    private bool IsProcessing => isPaynowSubmitting;

    private void OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (IsProcessing)
        {
            context.PreventNavigation();
        }
    }

    private void CancelPolling()
    {
        isPollingCancelled = true;
        isPaynowSubmitting = false;
    }

    private void CloseModal()
    {
        isPaynowSubmitting = false;
    }
    private string paynowValidationError = string.Empty;
    // result display
    private string paynowResultMessage = string.Empty;
    private string paynowResultCss = string.Empty;
    private string paynowResultLabel = string.Empty;
    private string paynowReference = string.Empty;
    private string paynowRedirectUrl = string.Empty;

    private decimal TotalCharged => ExtractDecimal(statement?.AccountSummary, "totalCharged");
    private decimal TotalPaid => paymentHistory.Sum(p => p.AmountUsd > 0 ? p.AmountUsd : p.Amount);
    private decimal CurrentBalance => ExtractDecimal(statement?.AccountSummary, "balance");

    private sealed class StatementRow
    {
        public DateTime When { get; init; }
        public string Reference { get; init; } = string.Empty;
        public string Description { get; init; } = string.Empty;
        public decimal Charge { get; init; }
        public decimal Paid { get; init; }
        public decimal RunningBalance { get; init; }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────

    private bool dataLoadAttempted;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || dataLoadAttempted) return;
        dataLoadAttempted = true;

        isLoading = true;
        try
        {
            var userIdStr = await JS.InvokeAsync<string>("sessionStorage.getItem", "primeappDemo.userId");
            if (!long.TryParse(userIdStr, out long userId) || userId <= 0)
            {
                loadError = "Could not identify your account. Please log in again.";
                isLoading = false;
                StateHasChanged();
                return;
            }

            var studentTask = StudentService.GetStudentAsync(userId);
            var statementTask = FinanceService.GetFinancialStatementAsync(userId);
            var paymentsTask = FinanceService.GetPaymentHistoryAsync(userId);
            await Task.WhenAll(studentTask, statementTask, paymentsTask);

            if (studentTask.IsCompletedSuccessfully && studentTask.Result is not null) Me = studentTask.Result;
            if (statementTask.IsCompletedSuccessfully) statement = statementTask.Result;
            if (paymentsTask.IsCompletedSuccessfully) paymentHistory = paymentsTask.Result ?? new();

            statementRows = BuildStatementRows(statement, paymentHistory);
        }
        catch (Exception)
        {
            Console.WriteLine($"[Finance] Load error");
            loadError = "Could not load your financial data. Please try refreshing.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ── Paynow submission ─────────────────────────────────────────────────

    private async Task SubmitPaynowAsync()
    {
        paynowValidationError = string.Empty;

        if (!decimal.TryParse(paynowAmountRaw, out var amt) || amt <= 0)
        {
            paynowValidationError = "Please enter a valid amount greater than zero.";
            return;
        }
        if (string.IsNullOrWhiteSpace(paynowMobile))
        {
            paynowValidationError = "A mobile number is required for Paynow mobile payments.";
            return;
        }

        isPaynowSubmitting = true;
        processingState = "initiating";
        try
        {
            var response = await FinanceService.InitiatePaymentAsync(new PaymentRequestDto
            {
                StudentId = Me.Id,
                Amount = amt,
                Currency = "USD",
                PaymentMethod = "PAYNOW_MOBILE",
                MobileNumber = paynowMobile.Trim(),
                Description = $"School fees payment - {DateTime.Today:MMMM yyyy}"
            });

            if (response is null)
            {
                SetResult("error", "Request Failed", "No response received from the payment gateway.");
                processingState = "failed";
                processingStatusMessage = "No response received from the payment gateway.";
                isPaynowSubmitting = false;
                return;
            }

            paynowReference = response.PaymentReference ?? string.Empty;
            paynowRedirectUrl = response.RedirectUrl ?? string.Empty;

            var status = (response.Status ?? string.Empty).ToUpperInvariant();

            if (status is "PAID" or "CONFIRMED")
            {
                SetResult("success", "Payment Confirmed", response.Message ?? "Your payment has been confirmed and your account has been updated.");
                processingState = "success";
                processingStatusMessage = response.Message ?? "Your payment has been confirmed and your account has been updated.";
                await RefreshAsync();
            }
            else if (status is "CREATED" or "SENT" or "AWAITING_DELIVERY" or "PENDING" or "PROCESSING" or "")
            {
                var msg = response.Instructions ?? "A payment prompt has been sent to your phone. Open your USSD menu or wait for the push notification, then approve the payment request.";
                SetResult("pending", "USSD Push Sent", msg);

                // Start polling
                processingState = "polling";
                isPollingCancelled = false;

                int maxAttempts = 20; // 20 attempts * 3s = 60s total
                int attempt = 0;
                bool isComplete = false;

                while (!isPollingCancelled && attempt < maxAttempts && !isComplete)
                {
                    attempt++;
                    await Task.Delay(3000);

                    if (isPollingCancelled) break;

                    try
                    {
                        var data = await FinanceService.CheckPaymentStatusAsync(paynowReference);
                        if (data is not null)
                        {
                            var raw = data.TryGetValue("status", out var sv) ? sv?.ToString() ?? "" : "";
                            var upper = raw.ToUpperInvariant();

                            if (upper is "PAID" or "CONFIRMED" or "SUCCESS")
                            {
                                SetResult("success", "Payment Confirmed", "Your payment has been confirmed. Your account balance has been updated.");
                                processingState = "success";
                                processingStatusMessage = "Your payment has been confirmed. Your account balance has been updated.";
                                await RefreshAsync();
                                isComplete = true;
                            }
                            else if (upper is "FAILED" or "CANCELLED" or "ERROR")
                            {
                                SetResult("error", "Payment Failed", $"Your payment was not completed (status: '{raw}').");
                                processingState = "failed";
                                processingStatusMessage = $"Your payment was not completed (status: '{raw}').";
                                isComplete = true;
                            }
                        }
                    }
                    catch (Exception)
                    {
                        // Ignore temp polling errors
                    }
                }

                if (!isComplete && !isPollingCancelled)
                {
                    processingState = "timeout";
                }
            }
            else
            {
                SetResult("error", $"Status: {response.Status}", response.Message ?? "An unexpected response was received.");
                processingState = "failed";
                processingStatusMessage = response.Message ?? $"An unexpected status was received: {response.Status}";
                isPaynowSubmitting = false;
            }
        }
        catch (Exception ex)
        {
            SetResult("error", "Error", ex.Message);
            processingState = "failed";
            processingStatusMessage = ex.Message;
            isPaynowSubmitting = false;
        }
        finally
        {
            if (processingState == "failed")
            {
                isPaynowSubmitting = false;
            }
        }
    }

    private async Task CheckPaynowStatusAsync()
    {
        if (string.IsNullOrWhiteSpace(paynowReference)) return;
        isCheckingStatus = true;
        try
        {
            var data = await FinanceService.CheckPaymentStatusAsync(paynowReference);
            if (data is null) { paynowResultMessage = "Could not retrieve status. Please try again."; return; }

            var raw = data.TryGetValue("status", out var sv) ? sv?.ToString() ?? "" : "";
            var upper = raw.ToUpperInvariant();
            if (upper is "PAID" or "CONFIRMED" or "SUCCESS")
            {
                SetResult("success", "Payment Confirmed", "Your payment has been confirmed. Your account balance has been updated.");
                await RefreshAsync();
            }
            else if (upper is "PROCESSING" or "PENDING" or "SENT" or "AWAITING_DELIVERY")
            {
                paynowResultMessage = $"Payment is still being processed (status: '{raw}'). Please approve the USSD prompt on your phone if you have not done so yet.";
            }
            else if (upper is "FAILED" or "CANCELLED" or "ERROR")
            {
                SetResult("error", "Payment Failed", $"Your payment was not completed (status: '{raw}'). Please try again or contact the bursar's office.");
            }
            else
            {
                paynowResultMessage = $"Status is currently '{raw}'. Please approve the USSD prompt on your phone if you have not done so yet.";
            }
        }
        catch (Exception ex) { paynowResultMessage = $"Status check failed: {ex.Message}"; }
        finally { isCheckingStatus = false; }
    }

    private async Task RefreshAsync()
    {
        try
        {
            var userIdStr = await JS.InvokeAsync<string>("sessionStorage.getItem", "primeappDemo.userId");
            if (!long.TryParse(userIdStr, out long uid) || uid <= 0) return;
            var st = await FinanceService.GetFinancialStatementAsync(uid);
            var ph = await FinanceService.GetPaymentHistoryAsync(uid);
            if (st is not null) statement = st;
            paymentHistory = ph ?? new();
            statementRows = BuildStatementRows(statement, paymentHistory);
        }
        catch (Exception ex) { Console.WriteLine($"[Finance] Refresh error"); }
    }

    private void SetResult(string css, string label, string message)
    {
        paynowResultCss = css;
        paynowResultLabel = label;
        paynowResultMessage = message;
    }

    private void FillFullAmount() => paynowAmountRaw = CurrentBalance.ToString("N2");

    // ── Statement builder ─────────────────────────────────────────────────

    private static List<StatementRow> BuildStatementRows(FinancialStatementDto? statement, List<PaymentRecord> payments)
    {
        var rows = new List<StatementRow>();
        var running = 0m;
        var totalCharged = ExtractDecimal(statement?.AccountSummary, "totalCharged");

        if (totalCharged > 0)
        {
            running += totalCharged;
            rows.Add(new StatementRow
            {
                When = ParseDate(statement?.GeneratedAt) ?? DateTime.Today,
                Reference = "FEES",
                Description = "School fees charged to account",
                Charge = totalCharged,
                RunningBalance = running
            });
        }

        foreach (var p in payments.OrderBy(p => ParseDate(p.Date) ?? DateTime.Today).ThenBy(p => p.PaymentReference))
        {
            var amt = p.AmountUsd > 0 ? p.AmountUsd : p.Amount;
            running -= amt;
            rows.Add(new StatementRow
            {
                When = ParseDate(p.Date) ?? DateTime.Today,
                Reference = p.PaymentReference ?? string.Empty,
                Description = p.Description ?? "Payment",
                Paid = amt,
                RunningBalance = running
            });
        }

        return rows;
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    private static decimal ExtractDecimal(Dictionary<string, object>? source, string key)
    {
        if (source is null || !source.TryGetValue(key, out var value) || value is null) return 0;
        if (value is JsonElement el)
        {
            if (el.ValueKind == JsonValueKind.Number && el.TryGetDecimal(out var d)) return d;
            if (el.ValueKind == JsonValueKind.String && decimal.TryParse(el.GetString(), out var s)) return s;
        }
        return decimal.TryParse(value.ToString(), out var parsed) ? parsed : 0;
    }

    private static DateTime? ParseDate(string? raw) =>
        DateTime.TryParse(raw, out var parsed) ? parsed : null;

    private static string FormatMoney(decimal amount) => $"${amount:N2}";

    private static string FormatBalance(decimal balance) =>
        balance > 0 ? $"${balance:N2} Due" :
        balance < 0 ? $"Credit ${Math.Abs(balance):N2}" : "Settled";

    private static string FormatClassroom(int? form, string? classroom)
    {
        if (form.HasValue && !string.IsNullOrWhiteSpace(classroom))
            return classroom.StartsWith("Form", StringComparison.OrdinalIgnoreCase) ? classroom : $"Form {form} {classroom}";
        if (form.HasValue) return $"Form {form}";
        return classroom ?? string.Empty;
    }

    private async Task PrintStatement() => await JS.InvokeVoidAsync("window.print");
